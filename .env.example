# Server only. Use an API key restricted to sending emails.
RESEND_API_KEY=
# A sender on a domain verified in Resend (not the recipient's Gmail address).
RESEND_FROM_EMAIL=

# Deployed Google Apps Script web app URL (must end in /exec).
GOOGLE_SHEETS_WEBHOOK_URL=
# Use the same random secret stored as BOOKING_WEBHOOK_SECRET in Apps Script.
GOOGLE_SHEETS_WEBHOOK_SECRET=
