# Server only. Use an API key restricted to sending emails.
RESEND_API_KEY=
# A sender on a domain verified in Resend (not the recipient's Gmail address).
RESEND_FROM_EMAIL=

# Server only. URL del deployment Web App del progetto Apps Script associato al foglio.
GOOGLE_SHEETS_WEBHOOK_URL=
# Deve coincidere con WEBHOOK_SECRET nelle Proprietà script di Apps Script.
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Opzionale. Usare TEST solo in Preview durante il collaudo; in Production omettere o usare REALE.
GOOGLE_SHEETS_RECORD_TYPE=REALE
