---
import BaseLayout from '../../components/BaseLayout.astro';
import CtaArrowIcon from '../../components/CtaArrowIcon.astro';
import GuideRequestForm from '../../components/GuideRequestForm.astro';
import TreatmentPrefooterCta from '../../components/TreatmentPrefooterCta.astro';
import { site } from '../../data/site';
import { guideIndexEntries, guideIndexGroups, guidesIndexPath, requestTreatmentLabels } from '../../data/guides.js';

const title = `Guide e consigli | ${site.name}`;
const description =
  'Guide e approfondimenti dello Studio Dentistico Federzoni Granata su ortodonzia, impianti, protesi, gengive, mandibola e urgenze: risposte chiare prima di una visita a Modena o Reggio Emilia.';
const canonical = new URL(guidesIndexPath, Astro.site || site.source).toString();
const countLabel = (count: number) => (count === 1 ? '1 guida' : `${count} guide`);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', canonical).toString() },
        { '@type': 'ListItem', position: 2, name: 'Guide e consigli', item: canonical },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: 'Guide e consigli',
      description,
      inLanguage: 'it-IT',
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: guideIndexEntries.length,
        itemListElement: guideIndexEntries.map((entry, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: entry.title,
          url: new URL(entry.href, canonical).toString(),
        })),
      },
    },
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath={guidesIndexPath} transparentHeader>
  <div class="guides-index">
    <section class="guides-hero" aria-labelledby="guides-title" data-transparent-header-region>
      <div class="guides-wrap guides-hero-grid">
        <div class="guides-hero-copy">
          <p class="guides-kicker">Informazioni</p>
          <h1 id="guides-title">Guide e consigli</h1>
          <p class="guides-lead">
            Risposte ai dubbi più frequenti prima di una visita: costi, alternative, tempi e segnali da non
            trascurare. Per orientarti con calma e arrivare in studio con le domande giuste.
          </p>
          <p class="guides-hero-count">{countLabel(guideIndexEntries.length)} in {guideIndexGroups.length} argomenti</p>
        </div>

        <GuideRequestForm
          form={{ treatmentLabel: 'Tipo di percorso', treatmentOptions: requestTreatmentLabels }}
          idPrefix="guides-request"
          title="Preferisci parlarne in studio?"
        />
      </div>
    </section>

    <section class="guides-tools" aria-label="Cerca e filtra le guide">
      <div class="guides-wrap guides-tools-inner">
        <form class="guides-search" role="search" action={guidesIndexPath} method="get" data-guides-search>
          <label for="guides-search-input">Cerca una guida</label>
          <div class="guides-search-field">
            <input
              id="guides-search-input"
              type="search"
              name="q"
              placeholder="Per esempio: impianto, gengive, apparecchio"
              autocomplete="off"
              data-guides-search-input
            />
            <button type="submit">Cerca</button>
          </div>
        </form>

        <nav class="guides-categories" aria-label="Argomenti delle guide">
          <p id="guides-categories-title">Argomenti</p>
          <ul aria-labelledby="guides-categories-title">
            {guideIndexGroups.map((group) => (
              <li>
                <a href={`#${group.id}`}>
                  {group.label} <span aria-hidden="true">{group.entries.length}</span>
                  <span class="sr-only">, {countLabel(group.entries.length)}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    <div class="guides-wrap guides-list" data-guides-list data-no-section-reveal>
      <p class="guides-status" role="status" aria-live="polite" data-guides-status></p>

      {guideIndexGroups.map((group) => (
        <section class="guides-group" id={group.id} aria-labelledby={`${group.id}-title`} data-guides-group>
          <header class="guides-group-head">
            <div>
              <h2 id={`${group.id}-title`}>{group.label}</h2>
              <p>{group.description}</p>
            </div>
            <p class="guides-group-count" data-guides-group-count>{countLabel(group.entries.length)}</p>
          </header>

          <ul class="guides-rows">
            {group.entries.map((entry) => (
              <li class="guides-row" data-guides-row data-search-text={`${entry.title} ${entry.summary} ${group.label}`.toLowerCase()}>
                <div class="guides-row-copy">
                  <h3><a href={entry.href}>{entry.title}</a></h3>
                  <p>{entry.summary}</p>
                  <span class="guides-row-tag">{group.label}</span>
                </div>
                <a class="guides-row-action" href={entry.href} aria-label={`Leggi la guida: ${entry.title}`}>
                  Leggi la guida <CtaArrowIcon className="ui-glyph" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <div class="guides-empty" hidden data-guides-empty>
        <h2>Nessuna guida corrisponde alla ricerca</h2>
        <p>
          Prova con un altro termine oppure consulta <a href="/trattamenti/">l’elenco dei trattamenti</a>.
        </p>
        <button type="button" data-guides-reset>Mostra tutte le guide</button>
      </div>

      <p class="guides-treatments-link">
        Cerchi la descrizione di una cura? <a href="/trattamenti/">Vai ai trattamenti dello studio</a>.
      </p>
    </div>

    <TreatmentPrefooterCta
      title="Hai un dubbio che qui non trovi?"
      href="/richiesta/"
      eyebrow="Richiedi una visita"
      lead="Raccontaci la tua esigenza. La segreteria ti ricontatterà per verificare i dettagli e concordare data e orario: l’invio della richiesta non equivale a un appuntamento già fissato."
      ctaLabel="Richiedi una visita"
    />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}></script>
</BaseLayout>

<script>
  // Arricchimento progressivo: senza JavaScript l'elenco resta completo e navigabile con le ancore.
  const normalize = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

  const initGuidesSearch = () => {
    const form = document.querySelector('[data-guides-search]');
    const input = document.querySelector('[data-guides-search-input]');
    const status = document.querySelector('[data-guides-status]');
    const empty = document.querySelector('[data-guides-empty]');
    const reset = document.querySelector('[data-guides-reset]');
    const groups = Array.from(document.querySelectorAll('[data-guides-group]'));
    if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement)) return;

    const apply = () => {
      const terms = normalize(input.value).split(/\s+/).filter(Boolean);
      let visible = 0;

      groups.forEach((group) => {
        let groupVisible = 0;
        group.querySelectorAll('[data-guides-row]').forEach((row) => {
          if (!(row instanceof HTMLElement)) return;
          const text = normalize(row.dataset.searchText || '');
          const match = terms.every((term) => text.includes(term));
          row.hidden = !match;
          if (match) groupVisible += 1;
        });
        if (group instanceof HTMLElement) group.hidden = groupVisible === 0;
        const count = group.querySelector('[data-guides-group-count]');
        if (count) count.textContent = groupVisible === 1 ? '1 guida' : `${groupVisible} guide`;
        visible += groupVisible;
      });

      if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      if (status) {
        status.textContent = terms.length === 0
          ? ''
          : visible === 1 ? '1 guida trovata' : `${visible} guide trovate`;
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      apply();
    });
    input.addEventListener('input', apply);
    reset?.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });

    const initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      apply();
    }
  };

  initGuidesSearch();
</script>

<style>
  .guides-index {
    --gi-dark: var(--brand-primary-dark);
    --gi-accent: var(--brand-blue);
    --gi-cta: var(--brand-cta);
    --gi-cta-hover: var(--brand-cta-hover);
    background: var(--surface-white);
    color: var(--text-dark);
    font-family: Inter, sans-serif;
    letter-spacing: -0.2px;
    word-spacing: 0;
  }

  .guides-wrap {
    width: min(100% - 48px, 1540px);
    margin: 0 auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .guides-hero {
    min-height: clamp(620px, 76svh, 820px);
    display: grid;
    align-items: center;
    background:
      radial-gradient(circle at 20% 82%, rgba(var(--brand-blue-rgb), 0.18), transparent 32%),
      var(--gi-dark);
    color: var(--surface-white);
  }

  .guides-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(360px, 0.65fr);
    gap: clamp(56px, 8vw, 130px);
    align-items: center;
    padding: clamp(150px, 14vw, 205px) 0 clamp(70px, 8vw, 110px);
  }

  .guides-kicker {
    margin: 0 0 20px;
    color: var(--gi-accent);
    font-size: 16px;
    font-weight: 500;
    line-height: 16px;
    text-transform: uppercase;
  }

  .guides-hero h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--surface-white);
    font-size: clamp(62px, 6.7vw, 108px);
    font-weight: 300;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .guides-lead {
    max-width: 860px;
    margin: 34px 0 0;
    color: var(--gi-accent);
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 500;
    line-height: 1.28;
  }

  .guides-hero-count {
    margin: 28px 0 0;
    color: var(--surface-white);
    font-size: 14px;
    line-height: 1.4;
  }

  .guides-tools {
    border-bottom: 1px solid var(--border);
    background: var(--soft-blue-bg);
  }

  .guides-tools-inner {
    display: grid;
    grid-template-columns: minmax(280px, 520px) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: end;
    padding: clamp(32px, 4vw, 56px) 0;
  }

  .guides-search label,
  .guides-categories p {
    display: block;
    margin: 0 0 12px;
    color: var(--gi-dark);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .guides-search-field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--surface-white);
    overflow: hidden;
  }

  .guides-search-field:focus-within {
    border-color: var(--gi-cta);
    outline: 3px solid rgba(var(--brand-cta-rgb), 0.18);
  }

  .guides-search input {
    min-width: 0;
    min-height: 60px;
    border: 0;
    padding: 0 18px;
    background: transparent;
    color: var(--text-dark);
    font: inherit;
    font-size: 16px;
  }

  .guides-search input:focus {
    outline: none;
  }

  .guides-search button {
    min-height: 60px;
    border: 0;
    padding: 0 22px;
    background: var(--gi-cta);
    color: var(--surface-white);
    cursor: pointer;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .guides-search button:hover,
  .guides-search button:focus-visible {
    background: var(--gi-cta-hover);
  }

  .guides-categories ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guides-categories a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 16px;
    background: var(--surface-white);
    color: var(--gi-dark);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
  }

  .guides-categories a span[aria-hidden] {
    color: var(--gi-cta);
    font-size: 13px;
  }

  .guides-categories a:hover,
  .guides-categories a:focus-visible {
    border-color: var(--gi-cta);
    color: var(--gi-cta);
  }

  .guides-categories a:focus-visible {
    outline: 3px solid rgba(var(--brand-cta-rgb), 0.24);
    outline-offset: 2px;
  }

  .guides-list {
    padding: clamp(40px, 5vw, 80px) 0 clamp(64px, 7vw, 110px);
  }

  .guides-status {
    min-height: 1.4em;
    margin: 0 0 8px;
    color: var(--muted-text);
    font-size: 15px;
  }

  .guides-group {
    scroll-margin-top: 140px;
  }

  .guides-group + .guides-group {
    margin-top: clamp(56px, 6vw, 96px);
  }

  .guides-group-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 22px;
    border-bottom: 2px solid rgba(var(--brand-cta-rgb), 0.72);
  }

  .guides-group-head h2 {
    margin: 0;
    color: var(--gi-cta-hover);
    font-size: clamp(30px, 3.2vw, 52px);
    font-weight: 500;
    line-height: 1.08;
  }

  .guides-group-head p {
    margin: 10px 0 0;
    color: var(--muted-text);
    font-size: 17px;
    line-height: 1.45;
  }

  .guides-group-head .guides-group-count {
    flex: 0 0 auto;
    margin: 0;
    color: var(--gi-dark);
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .guides-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guides-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(20px, 4vw, 64px);
    align-items: center;
    padding: clamp(24px, 2.6vw, 36px) 0;
    border-bottom: 1px solid var(--border);
  }

  .guides-row[hidden],
  .guides-group[hidden] {
    display: none;
  }

  .guides-row h3 {
    margin: 0;
    font-size: clamp(21px, 1.8vw, 28px);
    font-weight: 500;
    line-height: 1.2;
  }

  .guides-row h3 a {
    color: var(--gi-dark);
    text-decoration: none;
  }

  .guides-row h3 a:hover,
  .guides-row h3 a:focus-visible {
    color: var(--gi-cta);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .guides-row-copy p {
    max-width: 70ch;
    margin: 10px 0 0;
    color: var(--muted-text);
    font-size: 17px;
    line-height: 1.45;
  }

  .guides-row-tag {
    display: inline-block;
    margin-top: 14px;
    border-radius: 999px;
    padding: 6px 12px;
    background: var(--soft-blue-bg);
    color: var(--gi-cta-hover);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
  }

  .guides-row-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    border: 1px solid var(--gi-cta);
    border-radius: 7px;
    padding: 0 20px;
    color: var(--gi-cta);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .guides-row-action:hover,
  .guides-row-action:focus-visible {
    background: var(--gi-cta);
    color: var(--surface-white);
  }

  .guides-row-action:focus-visible {
    outline: 3px solid rgba(var(--brand-cta-rgb), 0.24);
    outline-offset: 3px;
  }

  .guides-empty {
    padding: clamp(32px, 4vw, 56px);
    background: var(--soft-blue-bg);
  }

  .guides-empty h2 {
    margin: 0 0 10px;
    color: var(--gi-dark);
    font-size: 24px;
    font-weight: 500;
  }

  .guides-empty p {
    margin: 0 0 18px;
    color: var(--muted-text);
    font-size: 17px;
  }

  .guides-empty button {
    min-height: 48px;
    border: 1px solid var(--gi-cta);
    border-radius: 7px;
    padding: 0 18px;
    background: var(--gi-cta);
    color: var(--surface-white);
    cursor: pointer;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .guides-empty a,
  .guides-treatments-link a {
    color: var(--gi-cta);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .guides-treatments-link {
    margin: clamp(40px, 5vw, 64px) 0 0;
    color: var(--muted-text);
    font-size: 17px;
  }

  @media (max-width: 980px) {
    .guides-hero-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .guides-tools-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 720px) {
    .guides-index {
      letter-spacing: -0.16px;
    }

    .guides-wrap {
      width: min(100% - 30px, 1540px);
    }

    .guides-hero {
      min-height: auto;
    }

    .guides-hero-grid {
      gap: 40px;
      padding: 158px 0 58px;
    }

    .guides-kicker {
      margin-bottom: 14px;
      font-size: 14px;
      line-height: 14px;
    }

    .guides-hero h1 {
      max-width: none;
      font-size: 35.1px;
      font-weight: 400;
      line-height: 35.1px;
    }

    .guides-lead {
      margin-top: 24px;
      font-size: 20px;
      line-height: 1.25;
    }

    .guides-group {
      scroll-margin-top: 110px;
    }

    .guides-group-head {
      flex-direction: column;
      align-items: start;
      gap: 12px;
      padding-bottom: 18px;
    }

    .guides-group-head h2 {
      font-size: 28px;
      line-height: 30px;
    }

    .guides-row {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 24px 0;
    }

    .guides-row-action {
      width: 100%;
      box-sizing: border-box;
      min-height: 54px;
    }
  }
</style>
