---
import BaseLayout from '../components/BaseLayout.astro';
import ClinicalCasesCarousel from '../components/ClinicalCasesCarousel.astro';
import { site } from '../data/site';

const heroImages = [
  {
    src: '/assets/chi-siamo/hero-bambina-visita-color.png',
    alt: 'Bambina durante una visita odontoiatrica',
  },
  {
    src: '/assets/chi-siamo/hero-controllo-sorriso.png',
    alt: 'Controllo del sorriso con specchio in studio dentistico',
  },
  {
    src: '/assets/chi-siamo/hero-procedura-clinica.jpg',
    alt: 'Equipe odontoiatrica durante una procedura clinica',
  },
  {
    src: '/assets/original/2021/02/HOME.jpg',
    alt: 'Dottor Stefano Granata e Dottoressa Chiara Federzoni nello studio dentistico',
  },
];

const networkImages = [
  {
    src: '/assets/chi-siamo/network-stefano-granata-relatore.jpg',
    alt: 'Dottor Stefano Granata durante un intervento formativo',
  },
  {
    src: '/assets/chi-siamo/network-raggi-x-impianto.png',
    alt: 'Radiografia dentale con impianto',
  },
  {
    src: '/assets/feature-stack/specialisti-clinica-mobile.jpg',
    alt: 'Equipe odontoiatrica durante un intervento clinico',
  },
];

const officeImages: Record<string, { src: string; alt: string; position: string }> = {
  Modena: {
    src: '/assets/chi-siamo/sede-modena-ambulatorio.png',
    alt: 'Ambulatorio dello Studio Dentistico Federzoni Granata di Modena',
    position: 'center',
  },
  'Reggio Emilia': {
    src: '/assets/original/2022/05/dentista-reggio-emilia-modena-3.jpg',
    alt: 'Studio dentistico Federzoni Granata di Reggio Emilia',
    position: 'center',
  },
};

const officeDetails: Record<string, { label: string; title: string; description: string; cta: string }> = {
  Modena: {
    label: 'Studio Dentistico Federzoni Granata',
    title: 'Studio dentistico a Modena',
    description:
      'Nel cuore di Modena, lo studio accoglie adulti e bambini per visite, prevenzione, odontoiatria digitale e percorsi specialistici coordinati.',
    cta: 'Vai alla sede di Modena',
  },
  'Reggio Emilia': {
    label: 'Studio Dentistico Federzoni Granata',
    title: 'Studio dentistico a Reggio Emilia',
    description:
      'La sede di Reggio Emilia offre lo stesso metodo clinico: diagnosi accurata, tecnologie digitali e continuità nei controlli periodici.',
    cta: 'Vai alla sede di Reggio Emilia',
  },
};

---

<BaseLayout
  title="Chi siamo - Studio dentistico Federzoni Granata"
  description="Conosci lo Studio Dentistico Federzoni Granata, il metodo di lavoro, i valori e le sedi di Modena e Reggio Emilia."
  ogImage="/assets/original/2021/02/HOME.jpg"
  canonicalPath="/chi-siamo/"
  mobileTransparentHeader
>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-wrap about-hero-copy">
        <p class="about-kicker">Studio Dentistico Federzoni Granata</p>
        <h1 id="about-title"><span>Il tuo sorriso,</span><span>la nostra priorità</span></h1>
        <div class="about-lead">
          <p>
            A Modena e Reggio Emilia accompagniamo adulti e bambini in percorsi odontoiatrici fondati su ascolto,
            diagnosi accurata e tecnologie digitali, con un approccio coordinato che segue ogni fase della salute orale.
          </p>
          <p>
            Ogni piano di cura nasce da una valutazione completa: prevenzione, estetica, chirurgia, implantologia,
            ortodonzia e riabilitazioni vengono integrate per proteggere salute, funzione e naturalezza del sorriso,
            con attenzione costante alla relazione e alla continuità nel tempo.
          </p>
        </div>
      </div>

      <div class="hero-image-strip" aria-label="Immagini dello studio">
        {heroImages.map((image) => (
          <figure>
            <img src={image.src} alt={image.alt} loading="eager" />
          </figure>
        ))}
      </div>

      <div class="hero-video-frame">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="Presentazione dello Studio Dentistico Federzoni Granata"
        >
          <source src="/assets/chi-siamo/chi-siamo-hero-mobile.m4v" type="video/mp4" />
        </video>
      </div>
    </section>

    <section class="vision-section" aria-labelledby="vision-title">
      <div class="about-wrap text-stack">
        <article>
          <h2 id="vision-title">La nostra visione.</h2>
          <p>
            All’orizzonte vediamo uno studio odontoiatrico che mette al centro le persone, attraverso una cura sempre
            più specialistica, capace di rispondere alle esigenze cliniche di ogni paziente prendendolo in carico
            completamente dalla prima visita, alla diagnosi digitale, sino al trattamento e ai controlli nel tempo.
          </p>
        </article>

        <article>
          <h2>La nostra missione.</h2>
          <p>
            Tutti i servizi dello Studio Dentistico Federzoni Granata sono finalizzati a costruire un percorso
            ragionato, organizzato ed efficiente per gestire salute orale, benessere e prevenzione dei pazienti, grazie
            alla possibilità di coordinare tecnologie, competenze specialistiche e controlli nel tempo.
          </p>
        </article>
        <a class="vision-more" href="#values-title">Leggi di più <span aria-hidden="true">+</span></a>
      </div>
    </section>

    <section class="values-section" aria-labelledby="values-title">
      <div class="about-wrap values-title-wrap">
        <h2 id="values-title">Lo studio dentistico</h2>
      </div>
      <div class="about-wrap doctor-profiles">
        <article class="doctor-profile doctor-profile-chiara">
          <div class="doctor-profile-copy">
            <p class="doctor-profile-heading">
              <strong>Dottoressa Chiara Federzoni</strong>
              <small>Odontoiatria conservativa, endodonzia e ortodonzia</small>
            </p>
            <div class="doctor-profile-biography">
              <p>
                Laurea con lode in Odontoiatria e Protesi Dentale e abilitazione professionale presso l’Università di
                Modena nel 1987. Laureata frequentatrice: Reparto di Conservativa ed Endodonzia (Dir. Prof. G. Dondi
                Dall’Orologio), Clinica Odontoiatrica dell’Università di Bologna; Department of Orthodontics (Dir.
                Prof. E. Shapiro), Tufts University di Boston; Division d’Orthodontie et de Pédodontie (Dir. Prof. J.P.
                Joho), Université de Genève. Società scientifiche frequentate: Accademia Italiana di Conservativa,
                Società Italiana di Endodonzia, Società Italiana di Ortodonzia. Libera professione presso lo Studio
                dentistico Federzoni Granata di Modena e Reggio Emilia dal 1992, occupandosi di Pedodonzia,
                Ortodonzia, Endodonzia e Conservativa.
              </p>
            </div>
          </div>
          <figure class="doctor-profile-image">
            <picture>
              <source media="(min-width: 721px)" srcset="/assets/chi-siamo/chiara-federzoni-portrait-hd.jpg" />
              <img src="/assets/original/2020/10/Livello-12.jpg" alt="Dottoressa Chiara Federzoni" loading="eager" />
            </picture>
          </figure>
        </article>

        <article class="doctor-profile doctor-profile-stefano">
          <figure class="doctor-profile-image">
            <picture>
              <source media="(min-width: 721px)" srcset="/assets/chi-siamo/stefano-granata-portrait-hd.jpg" />
              <img src="/assets/original/2020/10/Livello-13.jpg" alt="Dottor Stefano Granata" loading="eager" />
            </picture>
          </figure>
          <div class="doctor-profile-copy">
            <p class="doctor-profile-heading">
              <strong>Dottor Stefano Granata</strong>
              <small>Protesi, implantologia e chirurgia computer guidata</small>
            </p>
            <div class="doctor-profile-biography">
              <p>Professore a contratto presso l’Università di Padova dal 2019</p>
              <p>Professore a contratto presso l’Università di Modena e Reggio Emilia 2014-2017</p>
              <p>Specialista in Protesi riconosciuto dall’EPA, European Prosthodontic Association</p>
              <p>Socio attivo AIOP, Accademia Italiana di Odontoiatria Protesica</p>
              <p>Socio attivo IAO, Italian Academy of Osseointegration</p>
              <p>DDS Certified Speaker DDS, Digital Dental Society</p>
              <p>Socio Attivo Onorario DI&amp;RA, DIgital Implant and Restorative Academy</p>
              <p>Socio attivo CAI Academy Computer Aided Implantology</p>
              <p>
                Relatore in corsi e congressi nazionali ed internazionali su argomenti legati alla protesi digitale,
                la chirurgia computer guidata, chirurgia rigenerativa su impianti.
              </p>
              <p>
                <a href="https://pubmed.ncbi.nlm.nih.gov/?term=stefano+granata" target="_blank" rel="noopener noreferrer">
                  Autore di pubblicazioni scientifiche su riviste di fama internazionale
                </a>
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="network-section" aria-labelledby="network-title">
      <div class="about-wrap network-copy">
        <h2 id="network-title"><span>La rete</span><span>odontoiatrica</span></h2>
        <div class="network-paragraphs">
          <p>
            Concepite come studi dentistici integrati, con servizi di diagnostica digitale, prevenzione, chirurgia,
            implantologia, ortodonzia ed estetica dentale che ruotano attorno alla persona, le nostre sedi sono un
            punto di riferimento per la salute del sorriso.
          </p>
          <figure class="network-gallery-mobile-lead">
            <img src={networkImages[0].src} alt={networkImages[0].alt} loading="eager" />
          </figure>
          <p>
            Punto di forza è la continuità nella presa in carico, grazie a una organizzazione condivisa, a
            professionisti coordinati e a strumenti digitali che rendono visite, controlli e trattamenti più chiari e
            precisi nel tempo.
          </p>
        </div>
      </div>

      <div class="network-gallery" aria-label="Ambienti, tecnologia e persone dello studio">
        {networkImages.map((image) => (
          <figure>
            <img src={image.src} alt={image.alt} loading="eager" />
          </figure>
        ))}
      </div>

      <div class="about-wrap network-foot">
        <h3>I nostri studi dentistici a Modena e Reggio Emilia</h3>
        <div class="network-foot-copy">
          <p>
            Un unico metodo clinico, due sedi collegate da diagnosi, tecnologia e continuità organizzativa, per dare
            risposte affidabili e accompagnare ogni paziente nel percorso più adatto.
          </p>
          <a href="#sedi">Scopri le nostre sedi <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="sedi" class="offices-section" aria-labelledby="offices-title">
      <div class="about-wrap offices-head">
        <h2 id="offices-title">Le nostre sedi</h2>
        <p>
          Lo studio riceve in centro a Modena e a Reggio Emilia. In entrambe le sedi trovi gli stessi principi di lavoro:
          visita approfondita, strumenti digitali e comunicazione chiara.
        </p>
      </div>

      <div class="about-wrap office-list">
        {site.offices.map((office, index) => {
          const image = officeImages[office.city] || officeImages.Modena;
          const detail = officeDetails[office.city];

          return (
            <article class:list={['office-feature', index % 2 === 1 && 'office-feature-reverse']}>
              <div class="office-copy">
                <p class="office-city">{detail.label}</p>
                <h3><span>Studio dentistico</span>{' '}<span>a {office.city}</span></h3>
                <p>{detail.description}</p>
                <p>{office.address}</p>
                <div class="office-actions">
                  <a href={office.href}>{detail.cta} <span aria-hidden="true">↗</span></a>
                </div>
              </div>
              <figure class="office-image" style={`--office-position: ${image.position};`}>
                <img src={image.src} alt={image.alt} loading="eager" />
              </figure>
            </article>
          );
        })}
      </div>
    </section>

    <ClinicalCasesCarousel />
  </div>
</BaseLayout>

<script is:inline>
  const aboutHeroVideo = document.querySelector('.hero-video-frame video');

  if (aboutHeroVideo instanceof HTMLVideoElement) {
    const playAboutHeroVideo = () => {
      aboutHeroVideo.muted = true;
      aboutHeroVideo.play().catch(() => {});
    };

    if (aboutHeroVideo.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) {
      playAboutHeroVideo();
    } else {
      aboutHeroVideo.addEventListener('canplay', playAboutHeroVideo, { once: true });
    }

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) playAboutHeroVideo();
    });
  }

</script>

<style>
  .about-page {
    --about-green: var(--brand-primary-dark);
    --about-green-dark: var(--brand-primary-dark);
    --about-blue: var(--brand-blue);
    --about-ink: var(--text-dark);
    --about-muted: var(--muted-text);
    --about-soft: var(--soft-blue-bg);
    --about-soft-blue: var(--soft-blue-bg);
    --about-line: var(--border);
    background: var(--surface-white);
    color: var(--about-ink);
    font-family: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  .about-page :global(a) {
    color: inherit;
  }

  .about-wrap {
    width: min(1120px, calc(100% - 42px));
    margin: 0 auto;
  }

  .about-kicker {
    margin: 0 0 52px;
    color: inherit;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
  }

  .about-hero {
    --hero-strip-cut: 325px;
    padding: 126px 0 0;
    background: linear-gradient(
      to bottom,
      var(--about-green) 0 calc(100% - var(--hero-strip-cut)),
      var(--surface-white) calc(100% - var(--hero-strip-cut)) 100%
    );
    color: var(--surface-white);
    text-align: center;
  }

  .about-hero-copy {
    width: min(1500px, calc(100% - 220px));
    display: grid;
    justify-items: center;
  }

  .about-hero h1,
  .values-section h2,
  .network-section h2,
  .offices-section h2,
  .discover-section h2 {
    margin: 0;
    color: inherit;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .about-hero h1 {
    max-width: none;
    font-size: 5.45rem;
    font-weight: 400;
    line-height: 0.98;
  }

  .about-hero h1 span {
    display: block;
    white-space: nowrap;
  }

  .about-lead {
    max-width: 1420px;
    margin: 68px auto 0;
    color: inherit;
    font-size: 2.02rem;
    font-weight: 400;
    line-height: 1.43;
  }

  .about-lead p {
    margin: 0;
  }

  .about-lead p + p {
    margin-top: 54px;
  }

  .hero-image-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 22px;
    margin-top: 160px;
  }

  .hero-video-frame {
    display: none;
  }

  .hero-image-strip figure,
  .network-gallery figure,
  .office-image {
    margin: 0;
    overflow: hidden;
  }

  .hero-image-strip figure {
    height: clamp(540px, 34vw, 680px);
    background: var(--border);
  }

  .hero-image-strip figure:nth-child(2),
  .hero-image-strip figure:nth-child(4) {
    height: clamp(620px, 38vw, 760px);
  }

  .hero-image-strip img,
  .network-gallery img,
  .office-image img,
  .discover-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-image-strip figure:nth-child(1) img {
    object-position: 62% center;
  }

  .hero-image-strip figure:nth-child(2) img {
    object-position: 49% center;
  }

  .hero-image-strip figure:nth-child(3) img {
    object-position: 46% center;
  }

  .hero-image-strip figure:nth-child(4) img {
    object-position: 70% center;
  }

  .vision-section {
    padding: 100px 0 106px;
    background: var(--surface-white);
  }

  .text-stack {
    width: min(1400px, calc(100% - 220px));
    max-width: none;
    display: grid;
    gap: 142px;
  }

  .text-stack h2 {
    margin: 0 0 60px;
    color: var(--about-green);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 3.65rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .text-stack p {
    max-width: 1360px;
    margin: 0;
    color: var(--text-dark);
    font-size: 2.15rem;
    font-weight: 400;
    line-height: 1.34;
  }

  .vision-more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    margin-top: -22px;
    color: var(--about-green);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }

  .vision-more span {
    width: 25px;
    height: 25px;
    display: inline-grid;
    place-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1;
  }

  .values-section {
    padding: 86px 0 118px;
    background: var(--about-green);
    color: var(--surface-white);
  }

  .values-title-wrap {
    width: min(1576px, calc(100% - 160px));
    margin-bottom: 88px;
    text-align: center;
  }

  .doctor-profiles {
    width: min(1500px, calc(100% - 160px));
    display: grid;
    gap: 120px;
  }

  .values-section h2 {
    color: var(--surface-white);
    font-size: 3.9rem;
    text-align: center;
  }

  .doctor-profile {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
    align-items: center;
    gap: clamp(64px, 7vw, 120px);
  }

  .doctor-profile-stefano {
    grid-template-columns: minmax(420px, 1.1fr) minmax(0, 0.9fr);
  }

  .doctor-profile-copy {
    min-width: 0;
    border-left: 3px solid var(--brand-blue);
    padding-left: clamp(32px, 4vw, 52px);
  }

  .doctor-profile-heading {
    margin: 0 0 28px;
  }

  .doctor-profile-heading strong,
  .doctor-profile-heading small {
    display: block;
  }

  .doctor-profile-heading strong {
    color: var(--brand-blue);
    font-size: clamp(2rem, 2.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .doctor-profile-heading small {
    margin-top: 12px;
    color: var(--surface-white);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .doctor-profile-biography {
    display: grid;
    gap: 16px;
  }

  .doctor-profile-biography p {
    margin: 0;
    color: var(--surface-white);
    font-size: 1.18rem;
    font-weight: 400;
    line-height: 1.55;
  }

  .doctor-profile-biography a {
    color: var(--brand-blue);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .doctor-profile-image {
    width: min(100%, 560px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin: 0;
    background: var(--about-green-dark);
  }

  .doctor-profile-chiara .doctor-profile-image {
    justify-self: end;
  }

  .doctor-profile-stefano .doctor-profile-image {
    justify-self: start;
  }

  .doctor-profile-image picture {
    width: 100%;
    height: 100%;
    display: block;
  }

  .doctor-profile-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .network-section {
    padding: 118px 0 0;
    background: var(--background);
    color: var(--about-green);
  }

  .network-copy {
    width: min(1500px, calc(100% - 220px));
    max-width: none;
    text-align: center;
  }

  .network-section h2 {
    display: grid;
    gap: 4px;
    justify-items: center;
    font-size: 6.1rem;
    font-weight: 400;
    line-height: 0.98;
  }

  .network-section h2 span {
    display: block;
  }

  .network-paragraphs {
    max-width: 1390px;
    margin: 78px auto 0;
  }

  .network-paragraphs p {
    margin: 0 auto;
    color: var(--about-green);
    font-size: 2.05rem;
    font-weight: 400;
    line-height: 1.48;
  }

  .network-paragraphs p + p {
    max-width: 1310px;
    margin-top: 62px;
  }

  .network-gallery-mobile-lead {
    display: none;
  }

  .network-gallery {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px;
    margin-top: 112px;
  }

  .network-gallery figure {
    aspect-ratio: 0.92;
    background: var(--border);
  }

  .network-gallery figure:nth-child(1) img {
    object-position: 48% center;
  }

  .network-gallery figure:nth-child(2) img {
    object-position: 50% center;
  }

  .network-gallery figure:nth-child(3) img {
    object-position: 46% center;
  }

  .network-foot {
    width: min(1720px, calc(100% - 220px));
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(420px, 0.72fr);
    gap: 118px;
    align-items: start;
    padding: 100px 0 118px;
  }

  .network-foot h3 {
    max-width: 880px;
    margin: 0;
    color: var(--about-green);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 3.65rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .network-foot p {
    margin: 0;
    color: var(--muted-text);
    font-size: 1.42rem;
    line-height: 1.45;
  }

  .network-foot a,
  .office-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.34);
    border-radius: 8px;
    padding: 0 18px;
    color: var(--about-green);
    font-size: 0.88rem;
    font-weight: 900;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .network-foot a:hover,
  .office-actions a:hover {
    border-color: var(--blue-dark);
    background: rgba(var(--brand-primary-dark-rgb), 0.06);
    color: var(--about-green);
  }

  .network-foot a {
