---
import BaseLayout from '../components/BaseLayout.astro';
import TreatmentMarketingPage from '../components/TreatmentMarketingPage.astro';
import { site } from '../data/site';
import type { TreatmentMarketingConfig, TreatmentPathwayIconName } from '../data/treatmentMarketing';

const title = `Igiene orale e prevenzione | ${site.name}`;
const description =
  'Percorsi di igiene orale professionale e prevenzione per mantenere denti e gengive in salute nello Studio Dentistico Federzoni Granata.';

const processCards = [
  {
    icon: 'assessment',
    title: 'Valutazione iniziale',
    text: 'Controllo di denti, gengive e abitudini quotidiane per personalizzare la seduta.',
  },
  {
    icon: 'restoration',
    title: 'Igiene professionale',
    text: 'Rimozione di placca, tartaro e pigmentazioni con strumenti scelti in base al caso.',
  },
  {
    icon: 'prevention',
    title: 'Prevenzione su misura',
    text: 'Indicazioni pratiche per mantenere il risultato e programmare i controlli periodici.',
  },
] satisfies Array<{ icon: TreatmentPathwayIconName; title: string; text: string }>;

const faqRows = [
  {
    title: 'Ogni quanto fare l’igiene orale professionale?',
    text: 'La frequenza varia in base alla situazione clinica. In molti casi è consigliato un richiamo ogni sei mesi, ma il piano viene sempre personalizzato.',
  },
  {
    title: 'La seduta è dolorosa?',
    text: 'Di solito no. In caso di gengive infiammate o sensibilità dentale lo studio adatta tempi, strumenti e modalità per rendere la seduta più confortevole.',
  },
  {
    title: 'Serve anche se non ho dolore?',
    text: 'Sì. La prevenzione serve proprio a intercettare problemi prima che diventino sintomatici e a mantenere stabile la salute orale nel tempo.',
  },
];

const config = {
  seoTitle: 'Igiene orale e prevenzione',
  description,
  requestLabel: 'Igiene orale e prevenzione',
  heroTitle: 'Igiene orale e prevenzione',
  kicker: 'Prevenzione odontoiatrica',
  lead:
    'Controlli periodici e sedute professionali personalizzate per mantenere denti e gengive in salute e riconoscere precocemente eventuali problemi.',
  trustItems: [
    'Valutazione iniziale di denti e gengive',
    'Seduta calibrata su sensibilità ed esigenze',
    'Indicazioni e richiami personalizzati',
  ],
  formOptions: [
    'Seduta di igiene orale professionale',
    'Controllo preventivo di denti e gengive',
    'Prevenzione e igiene per un bambino',
    'Voglio prima confrontarmi con un vostro specialista',
  ],
  sections: [
    {
      title: 'A cosa serve',
      paragraphs: [
        'L’igiene orale professionale rimuove placca, tartaro e pigmentazioni che non sempre possono essere eliminati con la sola igiene quotidiana. Aiuta a ridurre l’infiammazione gengivale e a mantenere più facilmente pulite le superfici dentali.',
        'La seduta è anche un momento di prevenzione: permette di controllare denti, gengive e restauri e di riconoscere segnali che meritano un approfondimento prima che diventino sintomatici.',
      ],
    },
    {
      title: 'Per chi è indicato',
      paragraphs: [
        'Il percorso è indicato ad adulti e bambini e viene adattato alla salute orale, alla presenza di tartaro o pigmentazioni, alla sensibilità e alla capacità di mantenere una corretta igiene domiciliare.',
        'Sanguinamento, alito persistente, sensibilità o accumuli visibili meritano una valutazione, ma l’assenza di dolore non esclude la necessità di controlli preventivi.',
      ],
    },
    {
      title: 'Come si svolge e come prepararsi',
      paragraphs: [
        'La seduta inizia con la valutazione di denti e gengive. Placca e tartaro vengono rimossi con strumenti scelti in base al caso; quando indicato, si completa il trattamento con lucidatura e rimozione delle pigmentazioni superficiali.',
        'Non è richiesta una preparazione particolare. È utile segnalare sensibilità, condizioni di salute e farmaci assunti, senza modificare terapie prescritte di propria iniziativa.',
      ],
    },
    {
      title: 'Dopo la seduta',
      paragraphs: [
        'Una lieve sensibilità o un piccolo sanguinamento possono comparire soprattutto quando le gengive sono infiammate. Le indicazioni successive vengono personalizzate in base alla situazione rilevata durante la seduta.',
        'Spazzolino, filo o scovolini e richiami programmati aiutano a mantenere il risultato. La frequenza non è uguale per tutti: viene definita considerando rischio individuale, salute gengivale e qualità dell’igiene quotidiana.',
      ],
    },
  ],
  faqs: faqRows.map((row) => ({ question: row.title, answer: row.text })),
  pathwayTitle: 'Prevenzione costruita su misura',
  pathwayLead:
    'Dalla valutazione iniziale ai richiami, ogni fase viene adattata alle condizioni della bocca e alle abitudini quotidiane.',
  pathwayCards: processCards.map((card) => ({ icon: card.icon, title: card.title, text: card.text })),
  finalKicker: 'Inizia dalla prevenzione',
  finalTitle: 'Costruiamo il tuo percorso di igiene e prevenzione.',
  ogImage: '/assets/original/2022/03/dentista-modena-reggio-emilia.jpg',
} satisfies TreatmentMarketingConfig;

const requestHref = `/richiesta/?trattamento=${encodeURIComponent(config.requestLabel)}`;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={config.ogImage}
  canonicalPath="/igiene-orale-prevenzione/"
  transparentHeader
  headerCtaHref={requestHref}
>
  <TreatmentMarketingPage config={config} />
</BaseLayout>
