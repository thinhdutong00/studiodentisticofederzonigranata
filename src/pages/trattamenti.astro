---
import BaseLayout from '../components/BaseLayout.astro';
import TreatmentIcon from '../components/TreatmentIcon.astro';
import { site } from '../data/site';
import { formatParentheticalDetail } from '../utils/formatParentheticalDetail';

const treatmentOrder = [
  'Igiene orale e Prevenzione',
  'Sbiancamento',
  'Conservativa (otturazioni)',
  'Endodonzia (devitalizzazioni)',
  'Pedodonzia (odontoiatria infantile)',
  'Ortodonzia e Allineatori invisibili (adulti e bimbi)',
  'Estetica diretta (faccette in composito)',
  'Parodontologia (cure gengivali)',
  'Protesi fissa e mobile',
  'Estetica Indiretta (faccette in porcellana)',
  'Chirurgia Stomatologica',
  'Implantologia tradizionale e computer guidata',
  'Gnatologia (disturbi articolazione temporo-mandibolare)',
  'Dispositivi contro il russamento e le apnee notturne',
];

const treatmentMenuLabels: Record<string, string> = {
  'Igiene orale e Prevenzione': 'Igiene e prevenzione',
  'Estetica diretta (faccette in composito)': 'Faccette in composito',
  'Estetica Indiretta (faccette in porcellana)': 'Faccette in ceramica',
  'Ortodonzia e Allineatori invisibili (adulti e bimbi)': 'Ortodonzia e allineatori',
  'Gnatologia (disturbi articolazione temporo-mandibolare)': 'Gnatologia',
  'Dispositivi contro il russamento e le apnee notturne': 'Russamento e apnee',
};

const treatmentDescriptions: Record<string, string> = {
  'Igiene orale e Prevenzione': 'Controlli periodici, igiene professionale e indicazioni personalizzate per proteggere denti e gengive nel tempo.',
  Sbiancamento: 'Trattamenti professionali per migliorare il colore del sorriso in modo controllato e rispettoso dei tessuti dentali.',
  'Conservativa (otturazioni)': 'Otturazioni, restauri e ricostruzioni per recuperare denti danneggiati preservando la struttura naturale.',
  'Endodonzia (devitalizzazioni)': 'Cure canalari e devitalizzazioni per trattare infezioni profonde e salvare il dente quando possibile.',
  'Pedodonzia (odontoiatria infantile)': 'Percorsi dedicati ai bambini, dalla prevenzione alle prime cure, con attenzione a serenità e fiducia.',
  'Ortodonzia e Allineatori invisibili (adulti e bimbi)': 'Soluzioni ortodontiche per adulti e bambini, anche con allineatori trasparenti e piani su misura.',
  'Estetica diretta (faccette in composito)': 'Faccette e restauri diretti in composito per armonizzare forma, proporzioni e naturalezza del sorriso.',
  'Parodontologia (cure gengivali)': 'Diagnosi e terapie per gengive e tessuti di sostegno, pensate per stabilizzare e proteggere il sorriso.',
  'Protesi fissa e mobile': 'Soluzioni protesiche fisse o mobili per recuperare estetica, masticazione e comfort quotidiano.',
  'Estetica Indiretta (faccette in porcellana)': 'Faccette in ceramica e soluzioni estetiche indirette per risultati resistenti, luminosi e naturali.',
  'Chirurgia Stomatologica': 'Interventi chirurgici del cavo orale, comprese estrazioni e procedure specialistiche pianificate con cura.',
  'Implantologia tradizionale e computer guidata': 'Impianti dentali tradizionali o guidati digitalmente per sostituire denti mancanti in modo preciso.',
  'Gnatologia (disturbi articolazione temporo-mandibolare)': 'Valutazione di articolazione, masticazione e bruxismo per migliorare equilibrio e comfort funzionale.',
  'Dispositivi contro il russamento e le apnee notturne': 'Dispositivi intraorali personalizzati per contribuire alla gestione di russamento e apnee notturne.',
};

const iconByHref: Record<string, string> = {
  '/igiene-orale-prevenzione/': 'hygiene',
  '/sbiancamento/': 'whitening',
  '/conservativa-otturazioni/': 'filling',
  '/endodonzia-devitalizzazioni/': 'endodontics',
  '/pedodonzia-odontoiatria-infantile/': 'pediatric',
  '/ortodonzia-allineatori-invisibili/': 'orthodontics',
  '/estetica-diretta-faccette-composito/': 'composite',
  '/parodontologia-cure-gengivali/': 'periodontology',
  '/protesi-fissa-mobile/': 'prosthesis',
  '/estetica-indiretta-faccette-porcellana/': 'ceramic',
  '/chirurgia-stomatologica/': 'surgery',
  '/implantologia-tradizionale-computer-guidata/': 'implantology',
  '/gnatologia-articolazione-temporo-mandibolare/': 'gnathology',
  '/dispositivi-russamento-apnee-notturne/': 'sleep',
};

const treatmentRank = (label: string) => {
  const index = treatmentOrder.indexOf(label);
  return index === -1 ? Number.MAX_SAFE_INTEGER : index;
};

const treatments = site.treatmentMenu
  .flatMap((category) =>
    category.items.map((item) => ({
      ...item,
      title: treatmentMenuLabels[item.label] || formatParentheticalDetail(item.label),
      description: treatmentDescriptions[item.label],
    })),
  )
  .sort((a, b) => treatmentRank(a.label) - treatmentRank(b.label));
---

<BaseLayout
  title={`Trattamenti | ${site.name}`}
  description="Tutti i trattamenti odontoiatrici dello Studio Dentistico Federzoni Granata: prevenzione, estetica, ortodonzia, implantologia, chirurgia e protesi."
  ogImage="/assets/feature-stack/tecnologia-studio.jpg"
  canonicalPath="/trattamenti/"
  transparentHeader
>
  <div class="treatments-page">
    <section class="treatments-hero" aria-labelledby="treatments-title">
      <div class="treatments-hero-panel" data-transparent-header-region>
        <div class="treatments-wrap treatments-hero-copy">
          <h1 id="treatments-title">Odontoiatria completa</h1>
        </div>
      </div>
    </section>

    <section class="treatments-directory" aria-labelledby="directory-title">
      <div class="treatments-wrap">
        <div class="directory-head">
          <div>
            <p class="treatments-kicker">I percorsi dello studio</p>
            <h2 id="directory-title">trattamenti per la tua <span>salute orale</span></h2>
          </div>
        </div>

        <div class="treatment-grid">
          {treatments.map((treatment) => (
            <a class="treatment-card" href={treatment.href}>
              <span class="treatment-icon-wrap">
                <TreatmentIcon icon={iconByHref[treatment.href] || 'hygiene'} />
              </span>
              <h3>{treatment.title}</h3>
              <p>{treatment.description}</p>
            </a>
          ))}

          <aside class="consult-card">
            <p class="consult-label">Valutazione clinica</p>
            <h3>Non sai da dove iniziare?</h3>
            <p>
              Raccontaci cosa ti serve: il team ti aiuta a individuare il percorso più adatto tra prevenzione,
              estetica, ortodonzia, chirurgia o riabilitazione.
            </p>
            <a href="/richiesta/">Richiedi una visita <span aria-hidden="true">↗</span></a>
          </aside>
        </div>

        <div class="directory-foot">
          <a href="/">← Torna alla Home</a>
          <span>{site.name}</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .treatments-page {
    --treatments-hero-bg: var(--blue-dark);
    --treatments-blue: var(--brand-blue);
    --treatments-blue-dark: var(--brand-cta);
    --treatments-ink: var(--text-dark);
    --treatments-muted: var(--muted-text);
    --treatments-soft: var(--background);
    --treatments-line: var(--border);
    --treatments-letter-spacing: -0.2px;
    background: var(--surface-white);
    color: var(--treatments-ink);
    font-family: "Inter", sans-serif;
    letter-spacing: var(--treatments-letter-spacing);
    word-spacing: 0;
  }

  .treatments-page :global(a) {
    color: inherit;
  }

  .treatments-wrap {
    width: min(1500px, calc(100% - 64px));
    margin: 0 auto;
  }

  .treatments-hero {
    background: var(--surface-white);
  }

  .treatments-hero-panel {
    min-height: clamp(460px, 49vw, 620px);
    display: grid;
    align-items: center;
    background: var(--treatments-hero-bg);
    color: var(--surface-white);
  }

  .treatments-kicker {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 0 0 24px;
    color: var(--treatments-blue);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 18px;
    text-transform: uppercase;
  }

  .treatments-kicker::before {
    content: "";
    width: 52px;
    height: 2px;
    background: currentColor;
  }

  .treatments-hero h1 {
    max-width: 1500px;
    margin: 0 auto;
    color: var(--surface-white);
    font-family: "Inter", sans-serif;
    font-size: clamp(56px, 8.7vw, 129.6px);
    font-weight: 400;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 0.9;
    text-align: center;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .treatments-directory {
    padding: 92px 0 104px;
    background:
      radial-gradient(circle at 50% 12%, rgba(var(--soft-blue-bg-rgb), 0.92), transparent 34%),
      linear-gradient(180deg, var(--surface-white) 0%, var(--background) 100%);
  }

  .directory-head {
    max-width: 940px;
    margin: 0 auto clamp(52px, 5vw, 74px);
    text-align: center;
  }

  .directory-head .treatments-kicker {
    justify-content: center;
    gap: 18px;
    margin-bottom: 26px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1;
  }

  .directory-head .treatments-kicker::before,
  .directory-head .treatments-kicker::after {
    content: "";
    width: 38px;
    height: 1px;
    background: currentColor;
  }

  .directory-head h2 {
    margin: 0;
    color: var(--brand-primary-dark);
    font-family: "Inter", sans-serif;
    font-size: clamp(3rem, 5vw, 5.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .directory-head h2 span {
    display: block;
    color: var(--brand-blue);
  }

  .treatment-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  .treatment-card,
  .consult-card {
    min-height: 318px;
    border-radius: 32px;
  }

  .treatment-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--border);
    padding: 34px 36px 38px;
    background: rgba(var(--surface-white-rgb), 0.94);
    color: var(--brand-primary-dark);
    text-decoration: none;
    box-shadow: 0 18px 44px rgba(var(--brand-primary-dark-rgb), 0.035);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .treatment-card:hover,
  .treatment-card:focus-visible {
    border-color: rgba(var(--brand-blue-rgb), 0.72);
    box-shadow: 0 24px 58px rgba(var(--brand-primary-dark-rgb), 0.1);
    transform: translateY(-4px);
  }

  .treatment-card:focus-visible {
    outline: 3px solid rgba(var(--brand-cta-rgb), 0.28);
    outline-offset: 4px;
  }

  .treatment-icon-wrap {
    width: 66px;
    height: 66px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(var(--brand-blue-rgb), 0.12);
    border-radius: 18px;
    background: var(--background);
    color: var(--brand-cta);
    box-shadow: 0 4px 10px rgba(var(--brand-primary-dark-rgb), 0.09);
    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .treatment-card:hover .treatment-icon-wrap,
  .treatment-card:focus-visible .treatment-icon-wrap {
    background: var(--soft-blue-bg);
    color: var(--brand-primary-dark);
    transform: scale(1.04);
  }

  .treatment-card h3 {
    margin: 36px 0 0;
    color: var(--brand-primary-dark);
    font-family: "Inter", sans-serif;
    font-size: clamp(1.25rem, 1.55vw, 1.55rem);
    font-weight: 500;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 1.15;
  }

  .treatment-card p {
    margin: 18px 0 0;
    color: var(--muted-text);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 1.5;
  }

  .consult-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 20px;
    padding: 32px;
    background: var(--treatments-blue-dark);
    color: var(--surface-white);
    box-shadow: 0 24px 62px rgba(21, 90, 148, 0.24);
  }

  .consult-label {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 16px;
    text-transform: uppercase;
  }

  .consult-card h3 {
    max-width: 10ch;
    margin: 0;
    color: var(--surface-white);
    font-family: "Inter", sans-serif;
    font-size: clamp(1.65rem, 2.15vw, 2.25rem);
    font-weight: 500;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 1.25;
  }

  .consult-card p:not(.consult-label) {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 1.45;
  }

  .consult-card a {
    min-height: 68px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border: 1px solid rgba(var(--surface-white-rgb), 0.64);
    border-radius: 12px;
    padding: 0 24px;
    background: var(--surface-white);
    color: var(--treatments-blue-dark);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 16px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .consult-card a:hover {
    background: var(--soft-blue-bg);
    color: var(--treatments-blue-dark);
    transform: translateY(-1px);
  }

  .consult-card a span {
    font-size: 1.45rem;
    line-height: 1;
  }

  .directory-foot {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    margin-top: 70px;
    border-top: 1px solid var(--treatments-line);
    padding-top: 28px;
    color: var(--treatments-muted);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: var(--treatments-letter-spacing);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .directory-foot a {
    text-decoration: none;
  }

  .directory-foot a:hover {
    color: var(--treatments-blue-dark);
  }

  @media (max-width: 1120px) {
    .treatments-hero h1 {
      font-size: 5.4rem;
    }

    .treatment-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .treatments-page {
      --treatments-letter-spacing: -0.16px;
    }

    .treatments-wrap {
      width: min(100% - 30px, 1240px);
    }

    .treatments-hero {
      background: var(--surface-white);
    }

    .treatments-kicker {
      margin-bottom: 18px;
      font-size: 16px;
      line-height: 16px;
    }

    .treatments-kicker::before {
      width: 34px;
    }

    .treatments-hero h1 {
      font-size: clamp(35.1px, 11vw, 50px);
      line-height: 1;
    }

    .treatments-directory {
      padding: 58px 0 68px;
    }

    .directory-head {
      margin-bottom: 40px;
    }

    .directory-head .treatments-kicker {
      gap: 12px;
      margin-bottom: 20px;
      font-size: 11px;
      letter-spacing: 0.16em;
    }

    .directory-head .treatments-kicker::before,
    .directory-head .treatments-kicker::after {
      width: 24px;
    }

    .directory-head h2 {
      font-size: clamp(2.4rem, 12vw, 3.7rem);
      letter-spacing: -0.025em;
      line-height: 1;
    }

    .treatment-grid {
      grid-template-columns: 1fr;
    }

    .treatment-card,
    .consult-card {
      min-height: 0;
      border-radius: 24px;
      padding: 26px;
    }

    .treatment-icon-wrap {
      width: 58px;
      height: 58px;
      border-radius: 16px;
    }

    .treatment-card h3 {
      margin-top: 28px;
      font-size: 20px;
      line-height: 1.25;
    }

    .treatment-card p {
      margin-top: 14px;
      font-size: 14px;
      line-height: 1.45;
    }

    .consult-card h3 {
      max-width: none;
      font-size: 20px;
      line-height: 1.25;
    }

    .directory-foot {
      display: grid;
      margin-top: 48px;
      font-size: 0.78rem;
    }
  }
</style>
