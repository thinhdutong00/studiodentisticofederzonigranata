---
import BaseLayout from '../components/BaseLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import TreatmentMarketingPage from '../components/TreatmentMarketingPage.astro';
import { site } from '../data/site';
import { treatmentMarketingPages } from '../data/treatmentMarketing';

export function getStaticPaths() {
  return [...site.pages, ...site.navigationPages, ...site.treatmentPages]
    .filter((page) => page.path !== '/' && page.path !== '/prima-visita/' && page.path !== '/chi-siamo/' && page.path !== '/orari-e-sedi/' && page.path !== '/trattamenti/' && page.path !== '/igiene-orale-prevenzione/' && page.path !== '/sbiancamento/')
    .map((page) => ({
      params: { slug: page.slug },
      props: { page },
    }));
}

const { page } = Astro.props;

const transparentHeaderPaths = new Set([
  '/urgenze/',
  '/convenzioni/',
  '/estetica/',
  '/modena/',
  '/reggio-emilia/',
  '/video/',
  '/privacy-policy/',
  '/cookie-privacy/',
]);
const treatmentMarketing =
  page.kind === 'treatment' && page.path in treatmentMarketingPages
    ? treatmentMarketingPages[page.path as keyof typeof treatmentMarketingPages]
    : undefined;
const transparentHeader = Boolean(treatmentMarketing) || transparentHeaderPaths.has(page.path);
const layoutTitle = treatmentMarketing ? `${treatmentMarketing.seoTitle} | ${site.name}` : page.title;
const layoutDescription = treatmentMarketing?.description || page.description;
const layoutOgImage = treatmentMarketing?.ogImage || page.ogImage || site.heroImage;
const headerCtaHref = treatmentMarketing
  ? `/richiesta/?trattamento=${encodeURIComponent(treatmentMarketing.requestLabel)}`
  : '/richiesta/';
---

<BaseLayout
  title={layoutTitle}
  description={layoutDescription}
  ogImage={layoutOgImage}
  canonicalPath={page.path}
  transparentHeader={transparentHeader}
  headerCtaHref={headerCtaHref}
>
  {treatmentMarketing ? <TreatmentMarketingPage config={treatmentMarketing} /> : <ContentPage page={page} />}
</BaseLayout>
