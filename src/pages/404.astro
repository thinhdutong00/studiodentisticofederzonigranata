---
import BaseLayout from '../components/BaseLayout.astro';
import { site } from '../data/site';

const title = `Pagina non trovata | ${site.name}`;
const description = 'La pagina richiesta non è disponibile.';
---

<BaseLayout title={title} description={description} canonicalPath="/404">
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="not-found__code">Errore 404</p>
      <h1>Pagina non trovata</h1>
      <p>La pagina che stai cercando non è disponibile o è stata spostata.</p>
      <a class="button" href="/">Torna alla home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100svh - var(--nav-height));
    display: grid;
    place-items: center;
    padding: 88px 0;
    background: var(--background);
  }

  .not-found__inner {
    max-width: 760px;
    text-align: center;
  }

  .not-found__code {
    margin: 0 0 16px;
    color: var(--brand-cta);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.2px;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .not-found__inner > p:not(.not-found__code) {
    max-width: 560px;
    margin: 26px auto 32px;
    color: var(--muted-text);
    font-size: 1.125rem;
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    .not-found {
      padding: 64px 0;
    }

    h1 {
      letter-spacing: -0.16px;
    }
  }
</style>
