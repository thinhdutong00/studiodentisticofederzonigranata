---
import CookieBanner from '../components/CookieBanner.astro';
import Footer from '../components/Footer.astro';
import LandingPatientReviews from '../components/LandingPatientReviews.astro';
import OrthodonticQuiz from '../components/OrthodonticQuiz.astro';
import OrthodonticIntroduction from '../components/OrthodonticIntroduction.astro';
import OrthodonticLinkArrow from '../components/OrthodonticLinkArrow.astro';
import OrthodonticProfessionalSheet from '../components/OrthodonticProfessionalSheet.astro';
import OrthodonticSmileCarousel from '../components/OrthodonticSmileCarousel.astro';
import OrthodonticAgeSection from '../components/OrthodonticAgeSection.astro';
import OrthodonticFinalCta from '../components/OrthodonticFinalCta.astro';
import LandingTreatmentHero from '../components/LandingTreatmentHero.astro';
import LandingBookingDialog from '../components/LandingBookingDialog.astro';
import OrthodonticLandingHeader from '../components/OrthodonticLandingHeader.astro';
import TreatmentStickyCta from '../components/TreatmentStickyCta.astro';
import { featuredPatientReviews } from '../data/reviews';
import { orthodonticReviews } from '../data/orthodonticReviews';
import { site } from '../data/site';
import '../styles/inter-font.css';
import '../styles/visit-landing.css';
import '../styles/orthodontic-landing.css';
import '../styles/orthodontic-desktop.css';

const canonicalPath = '/visita-ortodonzia/';
const canonical = new URL(canonicalPath, site.source).toString();
const title = 'Visita ortodontica a Modena e Reggio Emilia | Federzoni Granata';
const description =
  'Ortodonzia per adulti e bambini a Modena e Reggio Emilia. Valuta apparecchi e allineatori con un piano personalizzato. Richiedi una visita allo Studio Federzoni Granata.';
const heroImagePath = '/assets/optimized/ortodonzia-federzoni-hero-1200.webp';
const heroImageAlt = 'La professionista dello Studio Dentistico Federzoni Granata';
const isIndexable = import.meta.env.PROD && process.env.VERCEL_ENV !== 'preview';
const socialPreviewImage = new URL(heroImagePath, canonical).toString();

const reviewAuthors = new Set(['Francesca Tassinari', 'Rosa Castelluccio', 'Nazareno Colamaria']);
const reviews = featuredPatientReviews.filter((review) => reviewAuthors.has(review.author));

const offices = site.offices;
const orthodonticTreatmentLabel = 'Ortodonzia e Allineatori invisibili (adulti e bimbi)';
const orthodonticRequestHref = `/richiesta/?trattamento=${encodeURIComponent(orthodonticTreatmentLabel)}`;

const footerLinks = [
  { label: 'La tua prima visita', href: '#benefici-ortodontici' },
  { label: 'Prima e dopo', href: '#sorrisi-prima-dopo' },
  { label: 'Questionario ortodontico', href: '#il-tuo-obiettivo' },
  { label: 'Ortodonzia per tutte le età', href: '#ortodonzia-tutte-le-eta' },
  { label: 'Recensioni', href: '#recensioni' },
  { label: 'Domande frequenti', href: '#ortho-faq-title' },
  { label: 'Prenota una visita', href: '#ortho-final' },
];

const faqs = [
  {
    question: 'Gli allineatori trasparenti Invisalign® sono adatti a tutti?',
    answer: 'Gli allineatori trasparenti permettono di correggere numerose problematiche ortodontiche in modo discreto. Tuttavia, non sono indicati per ogni situazione. Durante la visita valuteremo se questa soluzione è adatta a te o se è preferibile un altro trattamento.',
  },
  {
    question: 'Cosa succede durante la prima visita ortodontica?',
    answer: "Ascolteremo ciò che desideri migliorare e valuteremo l'allineamento dei denti, il morso e la salute orale. Ti illustreremo le possibili soluzioni e gli eventuali approfondimenti necessari per definire un piano di trattamento.",
  },
  {
    question: 'Una volta terminato il trattamento, i denti rimarranno allineati?',
    answer: 'Al termine del percorso è prevista una fase di contenzione, fondamentale per aiutare a mantenere il risultato. Ti indicheremo i dispositivi e le attenzioni necessarie per prenderti cura del tuo sorriso anche negli anni successivi.',
  },
  {
    question: 'È possibile allineare i denti anche da adulti?',
    answer: "Assolutamente sì. Non esiste un'età massima prestabilita per iniziare un trattamento ortodontico. La possibilità di intervenire dipende soprattutto dalla salute di denti, gengive e strutture di sostegno.",
  },
  {
    question: 'Quanto tempo serve per ottenere il sorriso desiderato?',
    answer: 'Ogni sorriso ha i suoi tempi. La durata dipende dalla posizione iniziale dei denti, dalla complessità degli spostamenti e dal trattamento scelto. Dopo una valutazione approfondita potremo fornirti una stima realistica.',
  },
  {
    question: 'Quanto costa un trattamento ortodontico?',
    answer: 'Dopo la valutazione ti presenteremo un preventivo chiaro e personalizzato. Offriamo anche soluzioni di pagamento frazionato, per aiutarti a organizzare la spesa e affrontare il percorso con più serenità.',
  },
  {
    question: 'Il trattamento ortodontico fa male?',
    answer: "Durante i primi giorni o dopo alcune regolazioni potresti avvertire una sensazione di pressione o sensibilità ai denti. Generalmente si tratta di fastidi temporanei, legati all'adattamento al dispositivo e ai movimenti dentali.",
  },
  {
    question: 'Dovrò cambiare le mie abitudini quotidiane?',
    answer: "Dipende dal trattamento. Gli allineatori trasparenti sono rimovibili durante i pasti, mentre gli apparecchi fissi richiedono alcune attenzioni nell'alimentazione e nell'igiene orale. Ti spiegheremo come affrontare il percorso nella tua quotidianità.",
  },
];
const structuredFaqs = faqs;

const officeSeoDetails = {
  Modena: {
    streetAddress: 'Via Giovanni Segantini, 25',
    postalCode: '41124',
    addressLocality: 'Modena',
    addressRegion: 'MO',
  },
  'Reggio Emilia': {
    streetAddress: 'Via Guido da Castello 8',
    postalCode: '42121',
    addressLocality: 'Reggio nell’Emilia',
    addressRegion: 'RE',
  },
} as const;

const organizationId = new URL('/#organization', canonical).toString();
const serviceId = `${canonical}#service`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'it-IT',
      dateModified: '2026-10-19',
      primaryImageOfPage: socialPreviewImage,
      about: [
        { '@type': 'MedicalCondition', name: 'Malocclusione dentale' },
        { '@type': 'MedicalTherapy', name: 'Trattamento ortodontico' },
      ],
      mainEntity: { '@id': serviceId },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Ortodonzia e allineatori trasparenti',
      serviceType: 'Valutazione e trattamento ortodontico',
      description,
      url: canonical,
      areaServed: ['Modena', 'Reggio Emilia'],
      provider: { '@id': organizationId },
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: site.name,
      url: site.source,
      logo: new URL(site.logo, site.source).toString(),
      email: site.offices[0]?.email,
      department: offices.map((office) => ({ '@id': `${canonical}#studio-${office.city.toLowerCase().replaceAll(' ', '-')}` })),
    },
    ...offices.map((office) => ({
      '@type': 'Dentist',
      '@id': `${canonical}#studio-${office.city.toLowerCase().replaceAll(' ', '-')}`,
      name: `${site.name} – ${office.city}`,
      url: new URL(office.href, site.source).toString(),
      image: socialPreviewImage,
      telephone: office.phone,
      email: office.email,
      parentOrganization: { '@id': organizationId },
      medicalSpecialty: 'https://schema.org/Dentistry',
      address: {
        '@type': 'PostalAddress',
        ...officeSeoDetails[office.city as keyof typeof officeSeoDetails],
        addressCountry: 'IT',
      },
    })),
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.source },
        { '@type': 'ListItem', position: 2, name: 'Ortodonzia e allineatori trasparenti', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: structuredFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" href="/fonts/inter/inter-latin.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href={heroImagePath} type="image/webp" media="(min-width: 721px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/assets/optimized/ortodonzia-federzoni-hero-720.webp" type="image/webp" media="(max-width: 720px)" fetchpriority="high" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={isIndexable ? 'index,follow,max-image-preview:large' : 'noindex,follow'} />
    <meta name="theme-color" content="#10283D" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it-IT" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/original/2020/10/cropped-favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/original/2020/10/cropped-favicon-180x180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialPreviewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1800" />
    <meta property="og:image:alt" content={heroImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialPreviewImage} />
    <meta name="twitter:image:alt" content={heroImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}></script>
  </head>

  <body class="ortho-landing ortho-landing-main ortho-unified">
    <OrthodonticLandingHeader showExperienceBar mobileSiteMenu unifiedConcept />

    <a class="ortho-skip-link" href="#contenuto">Vai al contenuto</a>
    <main id="contenuto" tabindex="-1">
      <LandingTreatmentHero treatment="ortodonzia" reviewers={orthodonticReviews} />

      <OrthodonticAgeSection />

      <OrthodonticIntroduction>
        <Fragment slot="before-first-visit">
          <section class="ortho-experience-mobile" id="esperienza-studio" aria-labelledby="ortho-experience-over ortho-experience-title">
            <div class="ortho-shell">
              <p class="ortho-experience-over" id="ortho-experience-over">Studio Dentistico Federzoni Granata</p>
              <h2 class="ortho-experience-years" id="ortho-experience-title"><span class="ortho-experience-number">35</span> anni di attività, al servizio del tuo sorriso.</h2>
              <img class="ortho-experience-photo" src="/assets/optimized/ortodonzia-sorriso-specchio-720.webp" srcset="/assets/optimized/ortodonzia-sorriso-specchio-720.webp 720w, /assets/optimized/ortodonzia-sorriso-specchio-1440.webp 1440w" sizes="(max-width: 720px) calc(100vw - 68px), (max-width: 978px) 92vw, 900px" alt="Paziente che osserva il proprio sorriso allo specchio durante una visita nello studio" width="720" height="480" loading="lazy" decoding="async" />
            </div>
          </section>
          <OrthodonticSmileCarousel />
          <OrthodonticQuiz objectivesFirst consultationFlow>
            <img slot="questionnaire-icon" class="ortho-questionnaire-aligner-icon" src="/assets/optimized/ortodonzia-allineatore-quiz-frontale-384.webp" alt="" aria-hidden="true" width="384" height="135" loading="lazy" decoding="async" />
          </OrthodonticQuiz>
        </Fragment>
        <Fragment slot="professional">
          <aside class="ortho-professional" aria-label="La professionista">
            <img src="/assets/optimized/chiara-federzoni-ortodonzia-720.webp" alt="Dottoressa Chiara Federzoni, odontoiatra dello Studio Federzoni Granata" width="720" height="479" loading="lazy" decoding="async" />
            <div>
              <h3><span class="ortho-professional-prefix">Dott.ssa</span> Chiara Federzoni</h3>
              <p>Da oltre 30 anni si occupa di ortodonzia, accompagnando i pazienti attraverso percorsi personalizzati. Laureata con lode in Odontoiatria a Modena nel 1987.</p>
              <a class="ortho-text-link ortho-professional-desktop-link" href="/chi-siamo/">Formazione e percorso professionale <OrthodonticLinkArrow /></a>
              <button class="ortho-text-link ortho-professional-mobile-trigger" type="button" aria-haspopup="dialog" aria-controls="ortho-professional-sheet" aria-expanded="false" data-ortho-professional-open>Formazione e percorso professionale <OrthodonticLinkArrow /></button>
            </div>
          </aside>
        </Fragment>
      </OrthodonticIntroduction>

      <LandingPatientReviews reviews={reviews} mobileCarousel conceptCarousel mobilePopupReviews={orthodonticReviews}>
        <Fragment slot="eyebrow"><span class="ortho-review-eyebrow-desktop">Esperienze dei pazienti</span></Fragment>
        <Fragment slot="title"><span class="ortho-review-title-mobile"><strong class="ortho-review-title-emphasis">Dicono</strong> di noi</span></Fragment>
        <button slot="after-heading" class="ortho-reviews-more" type="button" data-review-sheet-trigger>Leggi di più</button>
        <p slot="after-carousel" class="ortho-review-proof-caption">+ di 200 persone hanno lasciato una recensione positiva con una media di 4,9 stelle</p>
      </LandingPatientReviews>


      <section class="ortho-section ortho-faq" aria-labelledby="ortho-faq-title">
        <div class="ortho-shell ortho-split">
          <div class="ortho-section-heading">
            <p class="ortho-eyebrow">Ortodonzia e allineatori trasparenti</p>
            <h2 id="ortho-faq-title">Domande frequenti</h2>
          </div>
          <div class="ortho-faq-mobile-list">
            {faqs.slice(0, 3).map((faq, index) => (
              <details name="ortho-mobile-faq" open={index === 0}>
                <summary><span>{faq.question}</span><i aria-hidden="true"></i></summary>
                <div class="ortho-faq-mobile-answer"><p>{faq.answer}</p></div>
              </details>
            ))}
            <button class="ortho-cta ortho-faq-read-more" type="button" aria-expanded="false" aria-controls="ortho-mobile-extra-faqs">Leggi di più</button>
            <div id="ortho-mobile-extra-faqs" hidden>
              {faqs.slice(3).map((faq) => (
                <details name="ortho-mobile-faq">
                  <summary><span>{faq.question}</span><i aria-hidden="true"></i></summary>
                  <div class="ortho-faq-mobile-answer"><p>{faq.answer}</p></div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>

      <OrthodonticFinalCta />
    </main>

    <div id="contatti-studio">
      <Footer logoHref={canonicalPath} logoLabel="Landing ortodonzia">
        <Fragment slot="mobile-navigation-links">
          {footerLinks.map(item => <li><a href={item.href}>{item.label}</a></li>)}
        </Fragment>
      </Footer>
    </div>

    <LandingBookingDialog treatment="ortodonzia" />
    <OrthodonticProfessionalSheet bookingHref={orthodonticRequestHref} />
    <TreatmentStickyCta treatment={orthodonticTreatmentLabel} href={orthodonticRequestHref} hideAtFooter={false} mobileLabel="Inizia il tuo percorso" mobileHideFrom="#ortho-final" />
    <CookieBanner />

    <script>
      import { bindOrthodonticMobileMotion } from '../utils/orthodonticMobileMotion';
      bindOrthodonticMobileMotion();

      const quizSection = document.querySelector<HTMLElement>('.ortho-landing-main #il-tuo-obiettivo');
      quizSection?.removeAttribute('aria-labelledby');
      quizSection?.setAttribute('aria-label', 'Questionario ortodontico');
      const reviewsSection = document.querySelector<HTMLElement>('.ortho-landing-main #recensioni');
      const faqSection = document.querySelector<HTMLElement>('.ortho-landing-main .ortho-faq');
      const faqReadMore = faqSection?.querySelector<HTMLButtonElement>('.ortho-faq-read-more');
      const extraFaqs = faqSection?.querySelector<HTMLElement>('#ortho-mobile-extra-faqs');
      if (faqReadMore && extraFaqs) {
        faqReadMore.addEventListener('click', () => {
          extraFaqs.hidden = false;
          faqReadMore.setAttribute('aria-expanded', 'true');
          faqReadMore.hidden = true;
          extraFaqs.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
        }, { once: true });
      }

      const googleRating = reviewsSection?.querySelector<HTMLAnchorElement>('.patient-reviews-rating');
      const footerDescription = document.querySelector<HTMLElement>('.ortho-landing-main #footer .footer-mobile-brand > p');
      if (googleRating && footerDescription) footerDescription.after(googleRating);

      const professionalCta = document.querySelector<HTMLAnchorElement>('.ortho-landing-main #percorso-ortodontico .ortho-personalized-cta');
      professionalCta?.setAttribute('href', '#ortho-final');
      professionalCta?.removeAttribute('data-quiz-cta');
    </script>
  </body>
</html>

<style>
  .ortho-professional-mobile-trigger { display: none; }
  .ortho-personalized-title-mobile { display: none; }
  .ortho-review-title-mobile { display: none; }
  .ortho-reviews-more { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; margin: 18px 0 0; padding: 14px 22px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface-white); color: var(--brand-primary-dark); font: inherit; font-size: 16px; font-weight: 500; line-height: 1; text-transform: uppercase; cursor: pointer; }
  .ortho-reviews-more:hover { border-color: var(--brand-cta); color: var(--brand-cta); }
  .ortho-reviews-more:focus-visible { outline: 3px solid var(--brand-blue); outline-offset: 4px; }
  .ortho-review-proof-caption { display: none; text-decoration: underline; text-underline-offset: 3px; }
  .ortho-questionnaire-aligner-icon { display: none; }
  .ortho-faq-mobile-list { display: none; }
  .ortho-faq-eyebrow-mobile { display: none; }
  .ortho-experience-mobile { display: none; }
  .ortho-hero-eyebrow-mobile { display: none; }
  .ortho-hero-title-mobile { display: none; }
  .ortho-hero-lead-mobile { display: none; }

  @media (max-width: 720px) {
    .ortho-professional-desktop-link { display: none; }
    .ortho-professional-mobile-trigger { display: inline-flex; padding: 0; border: 0; background: transparent; font-family: inherit; text-decoration: underline; cursor: pointer; }
    .ortho-personalized-title-desktop { display: none; }
    .ortho-personalized-title-mobile { display: inline; }
    .ortho-review-title-desktop { display: none; }
    .ortho-review-title-mobile { display: inline; }
    .ortho-faq-eyebrow-desktop { display: none; }
    .ortho-faq-eyebrow-mobile { display: inline; }
    .ortho-review-eyebrow-desktop { display: none; }
    .ortho-experience-mobile {
      display: block;
      padding: 56px 0 0;
      background: var(--surface-white);
      color: var(--brand-primary-dark);
      text-align: left;
    }
    .ortho-experience-over { margin: 0; color: var(--brand-cta); font-size: 16px; line-height: 1.3; }
    .ortho-experience-years {
      display: flow-root;
      margin: 10px 0 0;
      font-size: clamp(21px, 6.14vw, 24px);
      font-weight: 400;
      line-height: 1.3;
      letter-spacing: -.16px;
    }
    .ortho-experience-number {
      float: left;
      margin: 4px 12px 0 0;
      font-size: clamp(76px, 23.5vw, 92px);
      font-weight: 500;
      line-height: .9;
    }
    .ortho-experience-photo { display: block; width: 100%; height: auto; margin-top: 28px; border-radius: 18px; }
    :global(.ortho-landing-main #percorso-ortodontico) { padding-top: 32px; }
    :global(.ortho-landing-main #percorso-ortodontico .ortho-professional > img) { width: 104px; height: 136px; }
    :global(.ortho-landing-main #percorso-ortodontico .ortho-eyebrow),
    :global(.ortho-landing-main #percorso-ortodontico .ortho-intro-lead),
    :global(.ortho-landing-main #percorso-ortodontico .ortho-personalized-steps) { display: none; }
    .ortho-hero-eyebrow-desktop { display: none; }
    .ortho-hero-overlay .ortho-hero-eyebrow-mobile {
      position: absolute;
      z-index: 1;
      top: 0;
      left: 0;
      display: block;
      width: fit-content;
      max-width: calc(100% - 28px);
      margin: 0;
      padding: 8px 18px 6px 22px;
      border-radius: 0 18px 0 0;
      background: var(--surface-white);
      color: var(--text-dark);
      font-size: 11px;
      line-height: 1.3;
      transform: translateY(-100%);
    }
    .ortho-hero-eyebrow-mobile::before,
    .ortho-hero-eyebrow-mobile::after {
      position: absolute;
      width: 18px;
      height: 18px;
      background: radial-gradient(circle at 100% 0, transparent 17px, var(--surface-white) 18px);
      content: '';
      pointer-events: none;
    }
    .ortho-hero-eyebrow-mobile::before { top: 0; left: 0; transform: translateY(-100%); }
    .ortho-hero-eyebrow-mobile::after { bottom: 0; left: 100%; }
    .ortho-hero-title-desktop { display: none; }
    .ortho-hero-title-mobile { display: inline; text-transform: none; }
    .ortho-hero-title-mobile strong { font-weight: 700; }
    .ortho-hero-title-context { color: var(--brand-primary-dark); }
    .ortho-hero-lead-desktop { display: none; }
    .ortho-hero-lead-mobile { display: block; }

    .ortho-hero-invisalign { font-weight: 700; }

    :global(.ortho-landing-main #recensioni) {
      position: relative;
      overflow: clip;
      isolation: isolate;
      background: var(--soft-blue-bg);
      color: var(--brand-primary-dark);
    }
    :global(.ortho-landing-main #recensioni::before) {
      content: '';
      position: absolute;
      z-index: 0;
      top: 0;
      right: 0;
      height: 100%;
      aspect-ratio: 488 / 496;
      background: url('/assets/decorations/google-g-white.svg') center / contain no-repeat;
      transform: translateX(33.333333%);
      pointer-events: none;
    }
    :global(.ortho-landing-main #recensioni > .landing-shell) { position: relative; z-index: 1; }
    .ortho-review-proof-caption {
      display: block;
      margin: 16px 0 0;
      color: var(--muted-text);
      font-size: 11px;
      font-weight: 400;
      line-height: 1.5;
      text-align: center;
    }
    :global(.ortho-landing-main #recensioni .patient-reviews-intro h2) { color: var(--brand-primary-dark); }
    :global(.ortho-landing-main #recensioni :is(.patient-review, .patient-reviews-rating)) { border-color: var(--border); background: var(--surface-white); color: var(--brand-primary-dark); }
    :global(.ortho-landing-main #recensioni .patient-review blockquote) { color: var(--text-dark); }
    :global(.ortho-landing-main #recensioni .patient-review footer strong) { color: var(--brand-primary-dark); }
    :global(.ortho-landing-main #recensioni :is(.patient-review footer small, .patient-reviews-rating-caption)) { color: var(--muted-text); }
    :global(.ortho-landing-main #recensioni .patient-reviews-link) { color: var(--brand-cta); }
