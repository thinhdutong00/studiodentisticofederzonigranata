---
import CookieBanner from '../components/CookieBanner.astro';
import Footer from '../components/Footer.astro';
import HomeLocations from '../components/HomeLocations.astro';
import LandingPatientReviews from '../components/LandingPatientReviews.astro';
import OrthodonticQuiz from '../components/OrthodonticQuiz.astro';
import OrthodonticIntroduction from '../components/OrthodonticIntroduction.astro';
import OrthodonticLinkArrow from '../components/OrthodonticLinkArrow.astro';
import OrthodonticSmileCarousel from '../components/OrthodonticSmileCarousel.astro';
import OrthodonticAgeSection from '../components/OrthodonticAgeSection.astro';
import OrthodonticConsultationForm from '../components/OrthodonticConsultationForm.astro';
import OrthodonticPaths from '../components/OrthodonticPaths.astro';
import OrthodonticLandingHeader from '../components/OrthodonticLandingHeader.astro';
import TreatmentStickyCta from '../components/TreatmentStickyCta.astro';
import { featuredPatientReviews } from '../data/reviews';
import { orthodonticReviews } from '../data/orthodonticReviews';
import { site } from '../data/site';
import { treatmentMarketingPages } from '../data/treatmentMarketing';
import '../styles/inter-font.css';
import '../styles/visit-landing.css';
import '../styles/orthodontic-landing.css';

const canonicalPath = '/visita-ortodonzia/';
const canonical = new URL(canonicalPath, site.source).toString();
const title = 'Visita ortodontica a Modena e Reggio Emilia | Federzoni Granata';
const description =
  'Ortodonzia per adulti a Modena e Reggio Emilia. Valuta apparecchi e allineatori con un piano personalizzato. Richiedi una visita allo Studio Federzoni Granata.';
const heroImagePath = '/assets/optimized/ortodonzia-sorriso-studio-1920.webp';
const heroImageSet = '/assets/optimized/ortodonzia-sorriso-studio-720.webp 720w, /assets/optimized/ortodonzia-sorriso-studio-1440.webp 1440w, /assets/optimized/ortodonzia-sorriso-studio-1920.webp 1920w, /assets/optimized/ortodonzia-sorriso-studio-2400.webp 2400w';
const heroImageSizes = '(max-width: 720px) calc(100vw - 24px), (max-width: 1000px) calc(140vw - 67.2px), (max-width: 1696px) calc(112vw - 53.76px), 1846px';
const heroMobileVideoPath = '/assets/optimized/ortodonzia-hero-mobile-montaggio-720p.mp4';
const heroMobilePosterPath = '/assets/optimized/ortodonzia-hero-mobile-montaggio-poster.webp';
const isIndexable = import.meta.env.PROD && process.env.VERCEL_ENV !== 'preview';
const socialPreviewImage = new URL(heroImagePath, canonical).toString();

const reviewAuthors = new Set(['Francesca Tassinari', 'Rosa Castelluccio', 'Nazareno Colamaria']);
const reviews = featuredPatientReviews.filter((review) => reviewAuthors.has(review.author));

const offices = site.offices;
const orthodonticTreatmentLabel = 'Ortodonzia e Allineatori invisibili (adulti e bimbi)';
const orthodonticRequestHref = new URL(`/richiesta/?trattamento=${encodeURIComponent(orthodonticTreatmentLabel)}`, site.source).toString();

const methodSteps = [
  { title: 'Analisi', text: 'Valutiamo posizione dei denti, occlusione e condizioni del cavo orale.' },
  { title: 'Pianificazione', text: 'Individuiamo le opzioni di trattamento sulla base degli accertamenti necessari.' },
  { title: 'Percorso', text: 'Condividiamo obiettivi, tempi indicativi, attenzioni quotidiane, controlli e mantenimento.' },
];

const faqs = [
  { question: 'Quanto dura il trattamento?', answer: 'Dipende dalla situazione iniziale e dai movimenti necessari. Dopo la visita e gli accertamenti viene condivisa una stima, da verificare nei controlli anche in base alla risposta individuale e all’uso del dispositivo.' },
  { question: 'Quali soluzioni sono disponibili?', answer: 'Lo studio utilizza apparecchi fissi e allineatori trasparenti. Il fisso rimane sui denti; gli allineatori sono rimovibili e richiedono un uso costante. La scelta dipende dalle indicazioni cliniche e dai movimenti necessari.' },
  { question: 'Quanto può incidere sulla quotidianità?', answer: 'Servono cura dell’igiene, uso del dispositivo e controlli programmati. Possono comparire fastidi durante l’adattamento. Alimentazione, gestione degli allineatori e contenzione finale vengono spiegate secondo il piano individuale.' },
  { question: 'Come vengono definiti i costi?', answer: 'Dopo la valutazione viene presentato un preventivo personalizzato, con le prestazioni previste. Complessità del caso, dispositivo e percorso necessario incidono sul costo. Il questionario raccoglie la richiesta di visita.' },
];
const mobileFaqs = treatmentMarketingPages['/ortodonzia-allineatori-invisibili/'].faqs;
const structuredFaqs = [
  ...faqs,
  ...mobileFaqs.filter((item) => !faqs.some((faq) => faq.question === item.question)),
];

const officeSeoDetails = {
  Modena: {
    streetAddress: 'Via Giovanni Segantini, 25',
    postalCode: '41124',
    addressLocality: 'Modena',
    addressRegion: 'MO',
  },
  'Reggio Emilia': {
    streetAddress: 'Via Guido da Castello 8',
    postalCode: '42121',
    addressLocality: 'Reggio nell’Emilia',
    addressRegion: 'RE',
  },
} as const;

const organizationId = new URL('/#organization', canonical).toString();
const serviceId = `${canonical}#service`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'it-IT',
      dateModified: '2026-10-13',
      primaryImageOfPage: socialPreviewImage,
      about: [
        { '@type': 'MedicalCondition', name: 'Malocclusione dentale' },
        { '@type': 'MedicalTherapy', name: 'Trattamento ortodontico' },
      ],
      mainEntity: { '@id': serviceId },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Ortodonzia e allineatori trasparenti',
      serviceType: 'Valutazione e trattamento ortodontico',
      description,
      url: canonical,
      areaServed: ['Modena', 'Reggio Emilia'],
      provider: { '@id': organizationId },
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: site.name,
      url: site.source,
      logo: new URL(site.logo, site.source).toString(),
      email: site.offices[0]?.email,
      department: offices.map((office) => ({ '@id': `${canonical}#studio-${office.city.toLowerCase().replaceAll(' ', '-')}` })),
    },
    ...offices.map((office) => ({
      '@type': 'Dentist',
      '@id': `${canonical}#studio-${office.city.toLowerCase().replaceAll(' ', '-')}`,
      name: `${site.name} – ${office.city}`,
      url: new URL(office.href, site.source).toString(),
      image: socialPreviewImage,
      telephone: office.phone,
      email: office.email,
      parentOrganization: { '@id': organizationId },
      medicalSpecialty: 'https://schema.org/Dentistry',
      address: {
        '@type': 'PostalAddress',
        ...officeSeoDetails[office.city as keyof typeof officeSeoDetails],
        addressCountry: 'IT',
      },
    })),
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.source },
        { '@type': 'ListItem', position: 2, name: 'Ortodonzia e allineatori trasparenti', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: structuredFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" href="/fonts/inter/inter-latin.woff2" type="font/woff2" crossorigin />
    <link
      rel="preload"
      as="image"
      href={heroImagePath}
      type="image/webp"
      media="(min-width: 721px)"
      imagesrcset={heroImageSet}
      imagesizes={heroImageSizes}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={heroMobilePosterPath}
      type="image/webp"
      media="(max-width: 720px)"
      fetchpriority="high"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={isIndexable ? 'index,follow,max-image-preview:large' : 'noindex,follow'} />
    <meta name="theme-color" content="#10283D" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it-IT" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/original/2020/10/cropped-favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/original/2020/10/cropped-favicon-180x180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialPreviewImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1280" />
    <meta property="og:image:alt" content="Paziente sorridente durante una visita nello studio dentistico" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialPreviewImage} />
    <meta name="twitter:image:alt" content="Paziente sorridente durante una visita nello studio dentistico" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}></script>
  </head>

  <body class="ortho-landing ortho-landing-main">
    <OrthodonticLandingHeader showExperienceBar mobileSiteMenu />

    <a class="ortho-skip-link" href="#contenuto">Vai al contenuto</a>
    <main id="contenuto" tabindex="-1">
      <section class="landing-hero ortho-hero ortho-hero-overlay" aria-labelledby="landing-title" data-treatment-sticky-hero>
        <div class="landing-shell landing-hero-shell">
          <div class="landing-hero-stage">
            <div class="ortho-hero-photo-frame">
              <picture>
                <source media="(max-width: 720px)" type="image/webp" srcset={heroMobilePosterPath} />
                <img class="landing-hero-photo" src={heroImagePath} srcset={heroImageSet} sizes={heroImageSizes} alt="Ortodonzia: sorrisi e allineatori trasparenti" width="1920" height="1280" loading="eager" decoding="async" fetchpriority="high" />
              </picture>
              <video
                class="ortho-hero-mobile-video"
                data-src={heroMobileVideoPath}
                data-poster={heroMobilePosterPath}
                width="1280"
                height="720"
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                tabindex="-1"
                disablepictureinpicture
                disableremoteplayback
                controlslist="nodownload nofullscreen noplaybackrate noremoteplayback"
                aria-label="Scene di sorrisi e vita quotidiana"
              ></video>
              <p class="landing-hero-eyebrow ortho-hero-eyebrow-mobile">Ortodonzia · Modena e Reggio Emilia</p>
              <script is:inline>
                (() => {
                  const video = document.querySelector('.ortho-hero-mobile-video');
                  if (!(video instanceof HTMLVideoElement)) return;

                  const mobile = window.matchMedia('(max-width: 720px)');
                  let visible = true;
                  const playVideo = () => {
                    if (!mobile.matches || document.hidden || !visible || !video.hasAttribute('src')) return;
                    video.muted = true;
                    video.defaultMuted = true;
                    video.controls = false;
                    video.play().catch(() => {});
                  };
                  const syncVideo = () => {
                    if (mobile.matches) {
                      if (!video.hasAttribute('src')) {
                        video.poster = video.dataset.poster;
                        video.src = video.dataset.src;
                        video.load();
                      }
                      playVideo();
                    } else if (video.hasAttribute('src')) {
                      video.pause();
                      video.removeAttribute('src');
                      video.removeAttribute('poster');
                      video.load();
                    }
                  };

                  // Start as the hero HTML is parsed, without waiting for page scripts or images.
                  syncVideo();
                  video.addEventListener('canplay', playVideo);
                  video.addEventListener('pause', playVideo);
                  mobile.addEventListener('change', syncVideo);
                  window.addEventListener('pageshow', syncVideo);
                  document.addEventListener('visibilitychange', () => {
                    if (document.hidden) video.pause();
                    else playVideo();
                  });
                  document.addEventListener('pointerdown', playVideo, { once: true, passive: true });

                  if ('IntersectionObserver' in window) {
                    const observer = new IntersectionObserver(([entry]) => {
                      visible = Boolean(entry?.isIntersecting);
                      if (visible) playVideo();
                      else video.pause();
                    }, { threshold: 0.01 });
                    observer.observe(video);
                  }
                })();
              </script>
            </div>
            <div class="landing-hero-panel ortho-hero-copy">
              <p class="landing-hero-eyebrow ortho-hero-eyebrow-desktop">Ortodonzia per adulti · Modena e Reggio Emilia</p>
              <h1 id="landing-title">
                <span class="ortho-hero-title-desktop">Il sorriso che desideri, la naturalezza che cerchi.</span>
                <span class="ortho-hero-title-mobile"><span class="ortho-hero-title-context">Non Esiste Un</span> <strong>Sorriso Perfetto</strong>. <span class="ortho-hero-title-context">Esiste</span> <strong>Quello Che Ti Valorizza.</strong></span>
              </h1>
              <p class="ortho-hero-lead">
                <span class="ortho-hero-lead-desktop">Sorridere nelle fotografie, ridere con gli amici e guardarti allo specchio sentendoti davvero a tuo agio. Con un percorso ortodontico personalizzato puoi prenderti cura dell'armonia del tuo sorriso e avvicinarti a quello che hai sempre desiderato.</span>
                <span class="ortho-hero-lead-mobile">
                  Allinea i tuoi denti con gli allineatori trasparenti <strong class="ortho-hero-invisalign">Invisalign®</strong>, apparecchi tradizionali o linguali. Scopri il percorso ortodontico più adatto a te, pensato per la tua salute, estetica e funzionalità orale.
                </span>
              </p>
              <a class="ortho-cta ortho-hero-quiz-link" href="#il-tuo-obiettivo" data-quiz-cta>Prenota una visita ortodontica <span aria-hidden="true">↗</span></a>
              <OrthodonticConsultationForm treatmentLabel={orthodonticTreatmentLabel} variant="hero" submitLabel="Prenota una visita ortodontica" />
            </div>
          </div>
        </div>
      </section>

      <OrthodonticIntroduction>
        <Fragment slot="after-benefits">
          <OrthodonticSmileCarousel />
          <OrthodonticAgeSection />
        </Fragment>
      </OrthodonticIntroduction>

      <OrthodonticPaths />

      <section class="ortho-section ortho-method" aria-labelledby="ortho-method-title">
        <div class="ortho-shell">
          <div class="ortho-method-heading">
            <div class="ortho-section-heading">
              <p class="ortho-eyebrow">Il metodo dello studio</p>
              <h2 id="ortho-method-title">Prima del trattamento, una valutazione precisa.</h2>
              <p>La scelta del dispositivo segue lo studio del caso. Valutiamo denti, morso e salute della bocca, poi confrontiamo le alternative indicate con le tue esigenze.</p>
            </div>
            <aside class="ortho-professional" aria-label="Il professionista">
              <img src="/assets/optimized/chiara-federzoni-ortodonzia-720.webp" alt="Dottoressa Chiara Federzoni, odontoiatra dello Studio Federzoni Granata" width="720" height="479" loading="lazy" decoding="async" />
              <div>
                <h3>Dott.ssa Chiara Federzoni</h3>
                <p>Odontoiatra, laureata con lode a Modena nel 1987. Si occupa di ortodonzia nello studio dal 1992.</p>
                <a class="ortho-text-link" href="/chi-siamo/">Formazione e percorso professionale <OrthodonticLinkArrow /></a>
              </div>
            </aside>
          </div>
          <ol class="ortho-method-steps">
            {methodSteps.map((step, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
          </ol>
        </div>
      </section>

      <LandingPatientReviews reviews={reviews} mobileCarousel mobilePopupReviews={orthodonticReviews}>
        <Fragment slot="eyebrow"><span class="ortho-review-eyebrow-desktop">Esperienze dei pazienti</span><span class="ortho-review-eyebrow-mobile">Su di noi</span></Fragment>
        <Fragment slot="title">I <span class="ortho-review-title-emphasis">nostri pazienti</span> dicono</Fragment>
      </LandingPatientReviews>
      <OrthodonticQuiz mobileObjectivesFirst>
        <svg slot="questionnaire-icon" class="ortho-questionnaire-check-icon" viewBox="0 0 48 48" width="56" height="56" fill="none" aria-hidden="true" focusable="false">
          <rect x="5" y="6" width="38" height="36" rx="5" />
          <path d="M5 18h38M5 30h38M20 6v36M25 12h12M25 24h12M25 36h12" />
          <path class="ortho-questionnaire-checks" d="m10 12 3 3 4-5m-7 14 3 3 4-5m-7 14 3 3 4-5" />
        </svg>
      </OrthodonticQuiz>

      <section class="ortho-section ortho-faq" aria-labelledby="ortho-faq-title">
        <div class="ortho-shell ortho-split">
          <div class="ortho-section-heading">
            <p class="ortho-eyebrow"><span class="ortho-faq-eyebrow-desktop">Tempi, impegno e costi</span><span class="ortho-faq-eyebrow-mobile">Il tuo percorso ortodontico</span></p>
            <h2 id="ortho-faq-title">Domande frequenti</h2>
            <p>Indicazioni per orientarti nella scelta. Durante la visita potrai capire cosa richiederebbe il percorso nella tua situazione.</p>
          </div>
          <div class="ortho-faq-list">
            {faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}
          </div>
          <div class="ortho-faq-mobile-list">
            {mobileFaqs.map((faq, index) => (
              <details name="ortho-mobile-faq" open={index === 0}>
                <summary><span>{faq.question}</span><i aria-hidden="true"></i></summary>
                <div class="ortho-faq-mobile-answer"><p>{faq.answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="ortho-section ortho-final ortho-final-with-instruments" id="ortho-final" aria-labelledby="ortho-final-title">
        <div class="ortho-shell ortho-final-copy">
          <p class="ortho-eyebrow">Richiedi una visita ortodontica</p>
          <h2 id="ortho-final-title">Il primo passo è conoscere la tua situazione.</h2>
          <p>Una visita ortodontica permette di valutare le caratteristiche del tuo sorriso e comprendere quali percorsi possono essere indicati.</p>
          <a class="ortho-cta" href="#il-tuo-obiettivo" data-quiz-cta>Richiedi una visita ortodontica <span aria-hidden="true">↗</span></a>
        </div>
        <OrthodonticConsultationForm treatmentLabel={orthodonticTreatmentLabel} />
      </section>
      <HomeLocations />
    </main>

    <div id="contatti-studio"><Footer /></div>

    <TreatmentStickyCta treatment={orthodonticTreatmentLabel} href={orthodonticRequestHref} hideAtFooter={false} />
    <CookieBanner />

    <script>
      import { bindOrthodonticMobileMotion } from '../utils/orthodonticMobileMotion';
      bindOrthodonticMobileMotion();

      const quizSection = document.querySelector<HTMLElement>('.ortho-landing-main #il-tuo-obiettivo');
      const smileSection = document.querySelector<HTMLElement>('.ortho-landing-main #sorrisi-prima-dopo');
      const finalSection = document.querySelector<HTMLElement>('.ortho-landing-main #ortho-final');

      if (quizSection && smileSection) {
        const desktopPosition = document.createComment('Original quiz position');
        quizSection.before(desktopPosition);
        const mobileViewport = window.matchMedia('(max-width: 720px)');
        // Move the existing section so keyboard and reading order follow the layout.
        const updateQuizPosition = () => {
          const anchor = mobileViewport.matches ? smileSection : desktopPosition;
          anchor.after(quizSection);
          finalSection?.setAttribute('aria-labelledby', mobileViewport.matches ? 'ortho-consultation-title' : 'ortho-final-title');

          if (mobileViewport.matches) {
            quizSection.removeAttribute('aria-labelledby');
            quizSection.setAttribute('aria-label', 'Questionario ortodontico');
          } else {
            quizSection.setAttribute('aria-labelledby', 'orthodontic-objectives-title');
            quizSection.removeAttribute('aria-label');
          }
        };

        updateQuizPosition();
        mobileViewport.addEventListener('change', updateQuizPosition);
      }

      const professional = document.querySelector<HTMLElement>('.ortho-landing-main .ortho-professional');
      const personalizedSteps = document.querySelector<HTMLElement>('.ortho-landing-main #percorso-ortodontico .ortho-personalized-steps');
      if (professional && personalizedSteps) {
        const originalProfessionalPosition = document.createComment('Original professional position');
        professional.before(originalProfessionalPosition);
        const professionalViewport = window.matchMedia('(max-width: 720px)');
        const updateProfessionalPosition = () => {
          if (professionalViewport.matches) personalizedSteps.before(professional);
          else originalProfessionalPosition.after(professional);
        };
        updateProfessionalPosition();
        professionalViewport.addEventListener('change', updateProfessionalPosition);
      }
    </script>
  </body>
</html>

<style>
  .ortho-questionnaire-check-icon { display: none; }
  .ortho-faq-mobile-list { display: none; }
  .ortho-faq-eyebrow-mobile { display: none; }
  .ortho-review-eyebrow-mobile { display: none; }
  .ortho-hero-eyebrow-mobile { display: none; }
  .ortho-hero-mobile-video { display: none; }
  .ortho-hero-title-mobile { display: none; }
  .ortho-hero-lead-mobile { display: none; }

  @media (max-width: 720px) {
    .ortho-faq-eyebrow-desktop { display: none; }
    .ortho-faq-eyebrow-mobile { display: inline; }
    .ortho-review-eyebrow-desktop { display: none; }
    .ortho-review-eyebrow-mobile { display: inline; }
    .ortho-hero-eyebrow-desktop { display: none; }
    .ortho-hero-overlay .ortho-hero-eyebrow-mobile {
      position: absolute;
      z-index: 1;
      bottom: 0;
      left: 0;
      display: block;
      width: fit-content;
      max-width: calc(100% - 28px);
      margin: 0;
      padding: 8px 18px 6px 22px;
      border-radius: 0 18px 0 0;
      background: var(--surface-white);
      color: var(--text-dark);
      font-size: 11px;
      line-height: 1.3;
    }
    .ortho-hero-eyebrow-mobile::before,
    .ortho-hero-eyebrow-mobile::after {
      position: absolute;
      width: 18px;
      height: 18px;
      background: radial-gradient(circle at 100% 0, transparent 17px, var(--surface-white) 18px);
      content: '';
      pointer-events: none;
    }
    .ortho-hero-eyebrow-mobile::before { top: 0; left: 0; transform: translateY(-100%); }
    .ortho-hero-eyebrow-mobile::after { bottom: 0; left: 100%; }
    .ortho-hero-title-desktop { display: none; }
    .ortho-hero-title-mobile { display: inline; text-transform: none; }
    .ortho-hero-title-mobile strong { font-weight: 700; }
    .ortho-hero-title-context { color: var(--brand-primary-dark); }
    .ortho-hero-lead-desktop { display: none; }
    .ortho-hero-lead-mobile { display: block; }

    .ortho-hero-invisalign { font-weight: 700; }

    :global(.ortho-landing-main #recensioni .patient-reviews-description) { display: none; }

    :global(.ortho-landing-main #contenuto :is(#landing-title, #ortho-personalized-title, #ortho-faq-title)) {
      color: var(--brand-cta);
    }

    :global(.ortho-landing-main .ortho-hero-copy > .landing-hero-eyebrow),
    :global(.ortho-landing-main #percorso-ortodontico .ortho-eyebrow),
    :global(.ortho-landing-main .ortho-faq .ortho-eyebrow) {
      color: var(--text-dark);
    }

    .ortho-faq { background: var(--surface-white); }
