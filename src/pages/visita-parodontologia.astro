    z-index: 2;
    right: -32px;
    bottom: 26px;
    width: min(260px, 72%);
    padding: 18px 20px;
    border-radius: 4px;
    background: var(--brand-primary-dark);
    color: var(--surface-white);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
  }

  .landing-method-copy h2 {
    max-width: 11ch;
  }

  .landing-method-lead {
    max-width: 650px;
    margin: 24px 0 0;
    color: var(--muted-text);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.5;
  }

  .landing-method-list {
    display: grid;
    gap: 0;
    margin-top: 34px;
    border-top: 1px solid var(--border);
  }

  .landing-method-list article {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }

  .landing-method-list article > span {
    color: var(--brand-blue);
    font-size: 12px;
    font-weight: 600;
  }

  .landing-method-list h3 {
    margin: 0 0 5px;
    color: var(--brand-primary-dark);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
  }

  .landing-method-list p {
    margin: 0;
    color: var(--muted-text);
    font-size: 14px;
    line-height: 1.5;
  }

  .landing-text-link {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    margin-top: 30px;
    color: var(--brand-cta);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }

  .landing-text-link span {
    font-size: 22px;
    font-weight: 400;
    transition: transform 160ms ease;
  }

  .landing-text-link:hover span {
    transform: translateX(4px);
  }

  .landing-process {
    background: var(--soft-blue-bg);
  }

  .landing-section-heading-centered {
    display: block;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .landing-process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 66px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: process;
  }

  .landing-process-grid li {
    position: relative;
    min-height: 240px;
    padding: 0 44px;
    border-right: 1px solid #cadfea;
  }

  .landing-process-grid li:first-child {
    padding-left: 0;
  }

  .landing-process-grid li:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .landing-process-number {
    color: var(--brand-blue);
    font-size: 62px;
    font-weight: 300;
    line-height: 1;
  }

  .landing-process-grid h3 {
    margin: 28px 0 10px;
    color: var(--brand-primary-dark);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.2;
  }

  .landing-process-grid p {
    margin: 0;
    color: var(--muted-text);
    font-size: 14px;
    line-height: 1.55;
  }

  .landing-process-cta {
    display: grid;
    justify-items: center;
    margin-top: 42px;
    text-align: center;
  }

  .landing-button {
    min-width: 280px;
    padding: 0 28px;
  }

  .landing-process-cta p {
    margin: 13px 0 0;
    color: var(--muted-text);
    font-size: 12px;
  }

  .landing-reviews {
    background: var(--brand-primary-dark);
    color: var(--surface-white);
  }

  .landing-reviews-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 48px;
  }

  .landing-reviews-heading h2 {
    max-width: 13ch;
    color: var(--surface-white);
  }

  .landing-reviews-heading > p {
    max-width: 310px;
    margin: 0 0 6px;
    color: rgba(255, 255, 255, 0.65);
    font-size: 14px;
  }

  .landing-review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 52px;
  }

  .landing-review-card {
    display: flex;
    min-height: 330px;
    flex-direction: column;
    padding: 30px;
    border: 1px solid rgba(217, 231, 242, 0.18);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.055);
  }

  .landing-review-stars {
    color: #f5c768;
    font-size: 15px;
    letter-spacing: 3px;
  }

  .landing-review-card blockquote {
    flex: 1;
    margin: 24px 0 30px;
    color: var(--surface-white);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
  }

  .landing-review-card footer {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .landing-review-card footer > span {
    display: inline-flex;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--brand-blue);
    color: var(--brand-primary-dark);
    font-size: 12px;
    font-weight: 700;
  }

  .landing-review-card footer p {
    display: grid;
    gap: 2px;
    margin: 0;
  }

  .landing-review-card footer strong {
    font-size: 13px;
    font-weight: 600;
  }

  .landing-review-card footer small {
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
  }

  .landing-faq {
    background: var(--surface-white);
  }

  .landing-faq-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(60px, 9vw, 120px);
    align-items: start;
  }

  .landing-faq-heading {
    position: sticky;
    top: 120px;
  }

  .landing-faq-intro {
    max-width: 360px;
    margin-top: 22px;
  }

  .landing-faq-source {
    max-width: 360px;
    margin: 18px 0 0;
    color: var(--muted-text);
    font-size: 12px;
    line-height: 1.55;
  }

  .landing-faq-source a {
    color: var(--brand-cta);
    font-weight: 500;
    text-underline-offset: 3px;
  }

  .landing-faq-list {
    border-top: 1px solid var(--border);
  }

  .landing-faq-list details {
    border-bottom: 1px solid var(--border);
  }

  .landing-faq-list summary {
    position: relative;
    padding: 25px 52px 25px 0;
    color: var(--brand-primary-dark);
    cursor: pointer;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.35;
    list-style: none;
  }

  .landing-faq-list summary::-webkit-details-marker {
    display: none;
  }

  .landing-faq-list summary::before,
  .landing-faq-list summary::after {
    position: absolute;
    top: 50%;
    right: 4px;
    width: 16px;
    height: 1px;
    background: var(--brand-cta);
    content: '';
    transition: transform 160ms ease;
  }

  .landing-faq-list summary::after {
    transform: rotate(90deg);
  }

  .landing-faq-list details[open] summary::after {
    transform: rotate(0deg);
  }

  .landing-faq-list details p {
    max-width: 720px;
    margin: -6px 0 25px;
    padding-right: 42px;
    color: var(--muted-text);
    font-size: 15px;
    line-height: 1.6;
  }

  .landing-final-cta {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 8vw, 116px) 0;
    background: var(--surface-white);
  }

  .landing-final-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.72fr);
    gap: clamp(56px, 7vw, 112px);
    align-items: end;
    padding: clamp(54px, 6.5vw, 88px);
    border: 1px solid rgba(94, 154, 204, 0.24);
    background:
      radial-gradient(circle at 100% 0%, rgba(94, 154, 204, 0.24), transparent 42%),
      linear-gradient(135deg, #10283d 0%, #10283d 68%, #0b2133 100%);
    box-shadow: 0 28px 70px rgba(16, 40, 61, 0.18);
  }

  .landing-final-panel::before {
    position: absolute;
    z-index: -1;
    top: -230px;
    right: -160px;
    width: 460px;
    height: 460px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    box-shadow:
      0 0 0 64px rgba(94, 154, 204, 0.055),
      0 0 0 128px rgba(94, 154, 204, 0.035);
    content: '';
    pointer-events: none;
  }

  .landing-final-copy::before {
    display: block;
    width: 58px;
    height: 2px;
    margin-bottom: 28px;
    background: var(--brand-blue);
    content: '';
  }

  .landing-final-cta .landing-kicker {
    color: var(--brand-blue);
  }

  .landing-final-cta h2 {
    max-width: 10.5ch;
    color: var(--surface-white);
  }

  .landing-final-action {
    position: relative;
    z-index: 1;
  }

  .landing-final-action > p {
    margin: 0 0 30px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.55;
  }

  .landing-final-button {
    display: inline-flex;
    min-height: 60px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 8px 8px 8px 24px;
    background: var(--surface-white);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.16);
    color: var(--brand-primary-dark);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: normal;
    line-height: 16px;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .landing-final-button:hover {
    background: var(--soft-blue-bg);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px);
  }

  .landing-final-button:focus-visible {
    outline: 3px solid rgba(94, 154, 204, 0.55);
    outline-offset: 4px;
  }

  .landing-final-button-icon {
    display: grid;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    place-items: center;
    background: var(--brand-cta);
    color: var(--surface-white);
    transition: background 180ms ease;
  }

  .landing-final-button:hover .landing-final-button-icon {
    background: var(--brand-cta-hover);
  }

  .landing-final-button-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .landing-final-reassurance {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.4;
  }

  .landing-final-reassurance span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .landing-final-reassurance span::before {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand-blue);
    content: '';
  }

  .container {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto;
  }

  .site-footer {
    position: relative;
    --footer-line: rgba(var(--brand-blue-rgb), 0.28);
    --footer-letter-spacing: -0.2px;
    background: var(--blue-dark);
    color: var(--soft-blue-bg);
    font-family: "Inter", sans-serif;
    letter-spacing: var(--footer-letter-spacing);
    word-spacing: 0;
  }

  .footer-shell {
    width: min(100% - 124px, 1828px);
    padding: 0;
  }

  .footer-mobile {
    display: none;
  }

  .site-footer h2,
  .site-footer h3 {
    color: var(--aqua);
  }

  .site-footer h2 {
    margin: 0 0 36px;
    font-family: "Inter", sans-serif;
    font-size: clamp(1.25rem, 1.35vw, 1.5rem);
    font-weight: 500;
    letter-spacing: var(--footer-letter-spacing);
    line-height: 1.25;
  }

  .site-footer p {
    color: rgba(255, 255, 255, 0.78);
  }

  .site-footer a {
    color: var(--soft-blue-bg);
    font-weight: 400;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--aqua);
  }

  .footer-menu-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--footer-line);
  }

  .footer-links {
    min-height: 492px;
    padding: clamp(58px, 4.8vw, 88px) clamp(36px, 3.2vw, 58px);
    border-right: 1px solid var(--footer-line);
  }

  .footer-links:last-child {
    border-right: 0;
  }

  .footer-links ul {
    display: grid;
    gap: 17px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: var(--footer-letter-spacing);
    line-height: 1.5;
  }

  .footer-social-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--footer-line);
  }

  .footer-social-block {
    min-height: 152px;
    display: grid;
    grid-template-columns: minmax(300px, 0.82fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(22px, 2.4vw, 42px);
    padding: 36px clamp(36px, 3.2vw, 58px);
  }

  .footer-social-block + .footer-social-block {
    border-left: 1px solid var(--footer-line);
  }

  .footer-social-block h2 {
    margin: 0;
  }

  .footer-social {
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    align-items: center;
  }

  .footer-social a {
    min-width: 42px;
    min-height: 42px;
    display: inline-grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: var(--footer-letter-spacing);
    line-height: 1;
  }

  .footer-social a:hover {
    border-color: var(--aqua);
  }

  .footer-article-block > a {
    justify-self: end;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: var(--footer-letter-spacing);
    line-height: 1.5;
  }

  .footer-bottom {
    padding: 34px 0 40px;
    border-top: 0;
  }

  .footer-bottom-inner {
    width: min(100% - 124px, 1828px);
    display: grid;
    grid-template-columns: minmax(240px, 1fr) minmax(0, 1.2fr) auto;
    gap: 18px 28px;
    align-items: start;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: var(--footer-letter-spacing);
    line-height: 1.5;
  }

  .footer-bottom-inner a {
    font-weight: 400;
  }

  .footer-policy-separator {
    display: inline-block;
    margin: 0 0.42em;
  }

  .footer-policy-separator::before {
    content: "·";
  }

  .footer-cookie-settings {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 400;
    text-decoration: underline;
    cursor: pointer;
  }

  .footer-cookie-settings:hover,
  .footer-cookie-settings:focus-visible {
    color: var(--surface-white);
  }

  .footer-copyright-mobile,
  .footer-powered {
    display: none;
  }

  @media (max-width: 1160px) {
    .footer-shell,
    .footer-bottom-inner {
      width: min(100% - 48px, 1828px);
    }

    .footer-menu-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-links:nth-child(2n) {
      border-right: 0;
    }

    .footer-social-row,
    .footer-bottom-inner {
      grid-template-columns: 1fr;
    }

    .footer-social-block + .footer-social-block {
      border-left: 0;
      border-top: 1px solid var(--footer-line);
    }

    .footer-article-block > a {
      justify-self: start;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      --footer-letter-spacing: -0.16px;
    }

    .footer-shell,
    .footer-bottom-inner {
      width: min(100% - 32px, 1828px);
    }

    .footer-desktop {
      display: none;
    }

    .footer-mobile {
      display: block;
      padding-top: 42px;
    }

    .footer-mobile-brand {
      padding-bottom: 34px;
      border-bottom: 1px solid var(--footer-line);
    }

    .footer-mobile-logo {
      width: min(100%, 310px);
      display: block;
    }

    .footer-mobile-logo img {
      width: 100%;
      height: auto;
      display: block;
      filter: brightness(0) invert(1);
    }

    .footer-mobile-brand p {
      max-width: 34ch;
      margin: 22px 0 0;
      color: rgba(255, 255, 255, 0.78);
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.5;
    }

    .footer-mobile-section {
      padding: 30px 0;
      border-bottom: 1px solid var(--footer-line);
    }

    .footer-mobile-section h2 {
      margin: 0 0 22px;
      font-size: 1.18rem;
      font-weight: 500;
      line-height: 1.25;
    }

    .footer-mobile-navigation {
      display: grid;
      gap: 15px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer-mobile-navigation a,
    .footer-mobile-content > a {
      font-size: 1rem;
      line-height: 1.45;
    }

    .footer-mobile-contact-list {
      display: grid;
      gap: 28px;
    }

    .footer-mobile-contact-item {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
    }

    .footer-mobile-contact-icon {
      width: 24px;
      height: 24px;
      margin-top: 2px;
      fill: none;
      stroke: var(--brand-blue);
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .footer-mobile-contact-values {
      min-width: 0;
      display: grid;
      gap: 10px;
    }

    .footer-mobile-contact-values > span {
      color: var(--brand-blue);
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: normal;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .footer-mobile-contact-values a {
      display: grid;
      gap: 3px;
      overflow-wrap: anywhere;
      font-size: 0.98rem;
      line-height: 1.45;
    }

    .footer-mobile-contact-values a strong {
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.82rem;
      font-weight: 500;
    }

    .footer-mobile-hours {
      display: grid;
      gap: 16px;
    }

    .footer-mobile-hours > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 16px;
      align-items: baseline;
      color: rgba(255, 255, 255, 0.82);
      font-size: 0.98rem;
      line-height: 1.4;
    }

    .footer-mobile-hours strong {
      color: var(--soft-blue-bg);
      font-weight: 500;
      text-align: right;
    }

    .footer-mobile-content {
      border-bottom: 0;
    }

    .footer-menu-grid {
      grid-template-columns: 1fr;
      border-left: 0;
      border-bottom: 1px solid var(--footer-line);
    }

    .footer-links {
      min-height: auto;
      border-right: 0;
      border-top: 1px solid var(--footer-line);
      padding: 34px 0;
    }

    .footer-links:first-child {
      border-top: 0;
    }

    .footer-social-block {
      grid-template-columns: 1fr;
      padding: 30px 0;
    }

    .footer-social-row {
      border-left: 0;
      border-right: 0;
    }

    .footer-social {
      flex-wrap: wrap;
    }

    .footer-bottom {
      padding: 30px 0;
    }

    .footer-bottom-inner {
      justify-items: center;
      text-align: center;
    }

    .footer-note {
      order: 1;
    }

    .footer-copyright {
      order: 2;
    }

    .footer-legal {
      order: 3;
    }

    .footer-copyright-desktop {
      display: none;
    }

    .footer-copyright-mobile,
    .footer-powered {
      display: block;
    }

    .footer-powered {
      order: 4;
      color: var(--surface-white);
    }

    .footer-powered strong {
      font-weight: 700;
    }

    .footer-powered sup {
      margin-left: 0.12em;
      font-size: 0.62em;
      line-height: 0;
      text-transform: uppercase;
    }

    .footer-policy-separator::before {
      content: "|";
    }
  }

  .landing-mobile-cta {
    display: none;
  }

  @media (max-width: 1000px) {
    .landing-hero-stage {
      min-height: 620px;
    }

    .landing-hero-panel {
      width: min(62%, 590px);
    }

    .landing-hero h1 {
      font-size: clamp(40px, 5.3vw, 52px);
    }

    .landing-overview-shell {
      width: min(100% - 48px, 900px);
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .landing-overview-form {
      max-width: 560px;
    }

    .landing-overview-content h2 {
      max-width: 22ch;
      font-size: clamp(38px, 4.8vw, 48px);
    }

    .landing-overview-features {
      column-gap: 44px;
    }

    .landing-depth {
      padding-bottom: 96px;
    }

    .landing-depth-shell {
      width: min(100% - 48px, 900px);
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .landing-depth-copy,
