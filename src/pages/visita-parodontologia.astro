---
import BookingFeedback from '../components/BookingFeedback.astro';
import BookingFields from '../components/BookingFields.astro';
import BookingPrivacy from '../components/BookingPrivacy.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Footer from '../components/Footer.astro';
import { featuredPatientReviews } from '../data/reviews';
import { site } from '../data/site';
import '../styles/inter-font.css';

const canonicalPath = '/visita-parodontologia/';
const canonical = new URL(canonicalPath, site.source).toString();
const title = 'Parodontologia Modena e Reggio Emilia | Federzoni Granata';
const description =
  'Valutazione parodontale per gengive che sanguinano, recessioni e parodontite a Modena e Reggio Emilia. Richiedi un ricontatto allo Studio Federzoni Granata.';
const heroImagePath = '/assets/optimized/parodontologia-equipe-clinica.webp';
const socialPreviewImage = new URL('/assets/menu/casi-clinici-parodontologia.png', canonical).toString();

const reviewAuthors = new Set(['Francesca Tassinari', 'Rosa Castelluccio', 'Umberto Salatino']);
const reviews = featuredPatientReviews.filter((review) => reviewAuthors.has(review.author));

const offices = site.offices;

const valuePoints = [
  {
    number: '01',
    title: 'Sanguinamento e gonfiore',
    text: 'Gengive che sanguinano durante lo spazzolamento o appaiono gonfie indicano un’infiammazione da valutare, anche in assenza di dolore.',
  },
  {
    number: '02',
    title: 'Gengive ritirate',
    text: 'Una radice più esposta può causare sensibilità e far apparire il dente più lungo. La causa e il tipo di recessione guidano le possibili soluzioni.',
  },
  {
    number: '03',
    title: 'Denti mobili o spostati',
    text: 'La mobilità o il cambiamento di posizione di un dente possono segnalare una perdita di supporto e richiedono un inquadramento parodontale.',
  },
  {
    number: '04',
    title: 'Alito persistente e familiarità',
    text: 'Alitosi che non si risolve, precedenti problemi gengivali o casi di parodontite in famiglia sono informazioni utili durante la valutazione.',
  },
];

const processSteps = [
  {
    title: 'Controllo dell’infiammazione',
    text: 'Indicazioni di igiene personalizzate e gestione dei fattori di rischio aiutano a ridurre placca e infiammazione.',
  },
  {
    title: 'Terapia non chirurgica',
    text: 'Quando indicato, placca e tartaro vengono rimossi professionalmente anche sotto gengiva, nelle aree interessate.',
  },
  {
    title: 'Rivalutazione e mantenimento',
    text: 'La risposta viene misurata prima di decidere eventuali ulteriori terapie e la frequenza dei richiami nel tempo.',
  },
];

const faqs = [
  {
    question: 'Le gengive che sanguinano indicano sempre parodontite?',
    answer:
      'Non necessariamente. Il sanguinamento può essere associato a una gengivite superficiale, ma può comparire anche nella parodontite. Esame clinico, sondaggio parodontale e, quando indicate, radiografie permettono di distinguere le condizioni.',
  },
  {
    question: 'Qual è la differenza tra gengivite, parodontite e “piorrea”?',
    answer:
      'La gengivite interessa i tessuti gengivali superficiali e può regredire quando l’infiammazione viene controllata. La parodontite comporta invece una perdita del supporto che mantiene i denti stabili. “Piorrea” è un termine tradizionale, oggi sostituito da diagnosi parodontali più precise.',
  },
  {
    question: 'La parodontite può essere curata?',
    answer:
      'Può essere trattata e, in molti casi, stabilizzata. Il supporto già perso non torna automaticamente alla situazione iniziale e la malattia può riattivarsi: per questo igiene quotidiana, rivalutazioni e richiami personalizzati restano essenziali.',
  },
  {
    question: 'Un dente mobile deve sempre essere estratto?',
    answer:
      'No. La decisione dipende dal supporto residuo, dal controllo dell’infiammazione, dalla funzione e dalla risposta alla terapia. La valutazione serve anche a capire quali denti possono essere mantenuti in modo ragionevole.',
  },
  {
    question: 'Ogni quanto servono i controlli parodontali?',
    answer:
      'Non esiste una frequenza uguale per tutti. Dopo la terapia viene definito un programma di mantenimento considerando diagnosi, rischio individuale, igiene, fumo, condizioni generali e stabilità raggiunta.',
  },
];

const officeSeoDetails = {
  Modena: {
    streetAddress: 'Via Giovanni Segantini, 25',
    postalCode: '41124',
    addressLocality: 'Modena',
    addressRegion: 'MO',
  },
  'Reggio Emilia': {
    streetAddress: 'Via Guido da Castello 8',
    postalCode: '42121',
    addressLocality: 'Reggio nell’Emilia',
    addressRegion: 'RE',
  },
} as const;

const organizationId = new URL('/#organization', canonical).toString();
const serviceId = `${canonical}#service`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'it-IT',
      dateModified: '2026-10-06',
      primaryImageOfPage: socialPreviewImage,
      about: [
        { '@type': 'MedicalCondition', name: 'Parodontite' },
        { '@type': 'MedicalCondition', name: 'Gengivite' },
      ],
      mainEntity: { '@id': serviceId },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Parodontologia e cure gengivali',
      serviceType: 'Valutazione e terapia parodontale',
      description,
      url: canonical,
      areaServed: ['Modena', 'Reggio Emilia'],
      provider: { '@id': organizationId },
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: site.name,
      url: site.source,
      logo: new URL(site.logo, site.source).toString(),
      email: site.offices[0]?.email,
      department: offices.map((office) => ({ '@id': `${canonical}#studio-${office.city.toLowerCase().replaceAll(' ', '-')}` })),
    },
    ...offices.map((office) => ({
      '@type': 'Dentist',
      '@id': `${canonical}#studio-${office.city.toLowerCase().replaceAll(' ', '-')}`,
      name: `${site.name} – ${office.city}`,
      url: new URL(office.href, site.source).toString(),
      image: socialPreviewImage,
      telephone: office.phone,
      email: office.email,
      parentOrganization: { '@id': organizationId },
      medicalSpecialty: 'https://schema.org/Dentistry',
      address: {
        '@type': 'PostalAddress',
        ...officeSeoDetails[office.city as keyof typeof officeSeoDetails],
        addressCountry: 'IT',
      },
    })),
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.source },
        { '@type': 'ListItem', position: 2, name: 'Parodontologia e cure gengivali', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" href="/fonts/inter/inter-latin.woff2" type="font/woff2" crossorigin />
    <link
      rel="preload"
      as="image"
      href={heroImagePath}
      type="image/webp"
      fetchpriority="high"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#10283D" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it-IT" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/original/2020/10/cropped-favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/original/2020/10/cropped-favicon-180x180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialPreviewImage} />
    <meta property="og:image:width" content="1448" />
    <meta property="og:image:height" content="1086" />
    <meta property="og:image:alt" content="Valutazione parodontale delle gengive" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialPreviewImage} />
    <meta name="twitter:image:alt" content="Valutazione parodontale delle gengive" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}></script>
  </head>

  <body>
    <header class="landing-header">
      <div class="landing-shell landing-header-inner">
        <a class="landing-logo" href="/" aria-label={`${site.name} — Home`}>
          <img
            src={site.logo}
            srcset="/assets/optimized/studio-dentistico-federzoni-granata-300.webp 300w, /assets/optimized/studio-dentistico-federzoni-granata.webp 400w"
            sizes="(max-width: 720px) 204px, 286px"
            alt={site.name}
            width="400"
            height="52"
          />
        </a>

        <div class="landing-header-actions">
          <span class="landing-header-locations">Modena · Reggio Emilia</span>
          <a class="landing-header-cta" href="#richiedi">Richiedi una valutazione</a>
        </div>
      </div>
    </header>

    <main>
      <section class="landing-hero" aria-labelledby="landing-title">
        <div class="landing-shell landing-hero-shell">
          <div class="landing-hero-stage">
            <img
              class="landing-hero-photo"
              src={heroImagePath}
              alt="Equipe odontoiatrica dello Studio Federzoni Granata durante un trattamento"
              width="1080"
              height="1350"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />

            <div class="landing-hero-panel">
              <p class="landing-hero-eyebrow">Parodontologia · Modena e Reggio Emilia</p>
              <h1 id="landing-title">
                Soffri di “piorrea” o hai gengive che sanguinano?
              </h1>
              <p class="landing-hero-lead">
                Una valutazione parodontale aiuta a diagnosticare e trattare la parodontite, con l’obiettivo di
                proteggere i denti naturali.
              </p>
              <a class="landing-hero-link" href="#richiedi">
                <span>Richiedi una valutazione</span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M5 5h10v10M15 5 5 15"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="landing-overview" aria-labelledby="landing-overview-title">
        <div class="landing-shell landing-overview-shell">
          <div class="landing-overview-aside">
            <p class="landing-overview-label">Parodontologia</p>

            <aside class="landing-form-card landing-overview-form" id="richiedi" aria-labelledby="landing-form-title">
              <p class="landing-form-kicker">Parla con la segreteria</p>
              <h2 id="landing-form-title">Richiedi una valutazione parodontale</h2>
              <p class="landing-form-intro">
                Lascia i tuoi recapiti e la sede preferita. Ti ricontatteremo per comprendere l’esigenza e concordare
                l’appuntamento.
              </p>

              <form data-contact-form data-booking-kind="callback" action="/api/booking" method="post">
                <BookingFields />
                <input type="hidden" name="message" value="Richiesta di valutazione parodontale dalla landing Google Ads" />

                <div class="landing-form-fields">
                  <label for="landing-full-name">
                    Nome e cognome
                    <input
                      id="landing-full-name"
                      type="text"
                      name="fullName"
                      autocomplete="name"
                      maxlength="120"
                      placeholder="Come possiamo chiamarti?"
                      required
                    />
                  </label>

                  <label for="landing-phone">
                    Telefono
                    <input
                      id="landing-phone"
                      type="tel"
                      name="phone"
                      autocomplete="tel"
                      minlength="6"
                      maxlength="30"
                      placeholder="Il numero su cui ricontattarti"
                      required
                    />
                  </label>

                  <label for="landing-office">
                    Sede preferita
                    <select id="landing-office" name="office" required>
                      <option value="">Scegli la sede</option>
                      {offices.map((office) => <option value={office.city}>{office.city}</option>)}
                    </select>
                  </label>
                </div>

                <BookingPrivacy />
                <button class="landing-form-submit" type="submit">
                  Richiedi la valutazione
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4"></path>
                  </svg>
                </button>
                <p class="landing-form-note">
                  L’invio non conferma automaticamente l’appuntamento. Giorno e orario saranno concordati con la
                  segreteria.
                </p>
                <BookingFeedback />
              </form>
            </aside>
          </div>

          <div class="landing-overview-content">
            <h2 id="landing-overview-title">
              Un percorso parodontale costruito su diagnosi, terapia per fasi e mantenimento nel tempo.
            </h2>
            <a class="landing-button landing-overview-cta" href="#richiedi">Richiedi una valutazione</a>

            <div class="landing-overview-features" aria-label="Elementi del percorso parodontale">
              <article class="landing-overview-feature">
                <svg class="landing-overview-icon" viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M20 12h24a4 4 0 0 1 4 4v36H16V16a4 4 0 0 1 4-4Z"></path>
                  <path d="M25 12V8h14v4M23 25h18M23 33h18M23 41h10"></path>
                  <path class="landing-overview-icon-accent" d="m25 24 3 3 6-7"></path>
                </svg>
                <div>
                  <h3>Valutazione parodontale</h3>
                  <p>Anamnesi, sondaggio e radiografie quando indicate.</p>
                </div>
              </article>

              <article class="landing-overview-feature">
                <svg class="landing-overview-icon" viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M15 49h34M20 43V30M29 43V22M38 43V15M47 43V26"></path>
                  <path class="landing-overview-icon-accent" d="m17 23 10-8 9 5 12-10"></path>
                  <path d="m43 10h5v5"></path>
                </svg>
                <div>
                  <h3>Diagnosi misurabile</h3>
                  <p>Tasche, sanguinamento, recessioni e mobilità.</p>
                </div>
              </article>

              <article class="landing-overview-feature">
                <svg class="landing-overview-icon" viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M22 11c-7 0-12 5-12 13 0 7 4 11 6 17 2 6 1 13 6 13 4 0 4-11 10-11s6 11 10 11c5 0 4-7 6-13 2-6 6-10 6-17 0-8-5-13-12-13-5 0-7 3-10 3s-5-3-10-3Z"></path>
                  <path class="landing-overview-icon-accent" d="M18 31c4 2 8 3 14 3s10-1 14-3"></path>
                  <path d="M25 19c2 1 4 2 7 2"></path>
                </svg>
                <div>
                  <h3>Terapia non chirurgica</h3>
                  <p>Rimozione professionale di placca e tartaro sottogengivale.</p>
                </div>
              </article>

              <article class="landing-overview-feature">
                <svg class="landing-overview-icon" viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M32 54a22 22 0 1 0-22-22"></path>
                  <path d="M10 19v13h13"></path>
                  <path class="landing-overview-icon-accent" d="m22 33 7 7 14-16"></path>
                </svg>
                <div>
                  <h3>Rivalutazione clinica</h3>
                  <p>Per misurare la risposta e definire i passi successivi.</p>
                </div>
              </article>

              <article class="landing-overview-feature">
                <svg class="landing-overview-icon" viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M32 54c11-7 19-17 19-29a10 10 0 0 0-19-5 10 10 0 0 0-19 5c0 12 8 22 19 29Z"></path>
                  <path class="landing-overview-icon-accent" d="M22 32h6l3-7 5 15 3-8h5"></path>
                </svg>
                <div>
                  <h3>Mantenimento personalizzato</h3>
                  <p>Richiami definiti in base al rischio individuale.</p>
                </div>
              </article>

              <article class="landing-overview-feature">
                <svg class="landing-overview-icon" viewBox="0 0 64 64" aria-hidden="true">
                  <path d="M32 55s17-14 17-29a17 17 0 1 0-34 0c0 15 17 29 17 29Z"></path>
                  <circle class="landing-overview-icon-accent" cx="32" cy="26" r="6"></circle>
                  <path d="M24 47h16"></path>
                </svg>
                <div>
                  <h3>Due sedi</h3>
                  <p>Modena e Reggio Emilia.</p>
                </div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="landing-depth" aria-labelledby="landing-depth-title">
        <div class="landing-depth-shell">
          <article class="landing-depth-copy">
            <h2 id="landing-depth-title">
              Quando l’infiammazione scende sotto gengiva, una semplice pulizia può non bastare.
            </h2>

            <div class="landing-depth-text">
              <p>
                La parodontite interessa i tessuti profondi che sostengono il dente. Per questo l’igiene professionale
                di routine non sostituisce una diagnosi parodontale né, quando indicata, la terapia sottogengivale.
              </p>
              <p>
                Il trattamento in studio è solo una parte del percorso. Anche l’igiene quotidiana a casa, eseguita con
                strumenti e tecniche adatti, contribuisce a controllare la placca e a mantenere nel tempo i risultati
                raggiunti.
              </p>
              <p>
                Sondaggio, sanguinamento, recessioni e mobilità aiutano a capire dove è presente l’infiammazione e a
                definire controlli e richiami in base al rischio individuale.
              </p>
              <p class="landing-depth-emphasis">
                Non è una questione di colpa: la parodontite è una malattia complessa e può evolvere anche senza dolore.
              </p>
              <p>
                Un percorso costruito su misurazioni cliniche, terapia per fasi e mantenimento aiuta a intervenire dove
                serve e a proteggere i denti naturali.
              </p>
            </div>
          </article>

          <figure class="landing-depth-media">
            <img
              src="/assets/original/2022/03/dentista-modena-reggio-emilia.jpg"
              alt="Professionisti dello Studio Dentistico Federzoni Granata durante la valutazione di immagini cliniche"
              width="1200"
              height="652"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </section>

      <section class="landing-section landing-value" aria-labelledby="landing-value-title">
        <div class="landing-shell">
          <div class="landing-section-heading">
            <p class="landing-kicker landing-kicker-dark">Quando richiedere un controllo parodontale</p>
            <h2 id="landing-value-title">Segnali delle gengive<br />che è utile non ignorare.</h2>
            <p>
              Sanguinamento, recessioni o mobilità non permettono da soli di formulare una diagnosi. Servono misurazioni
              cliniche per capire se si tratta di gengivite, parodontite o di un’altra condizione.
            </p>
          </div>

          <div class="landing-value-grid">
            {valuePoints.map((point) => (
              <article class="landing-value-card">
                <span>{point.number}</span>
                <h3>{point.title}</h3>
                <p>{point.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="landing-section landing-method" aria-labelledby="landing-method-title">
        <div class="landing-shell landing-method-grid">
          <div class="landing-method-image">
            <img
              src="/assets/original/2026/04/BEA08719-3-scaled.jpg"
              alt="Esame radiografico digitale nello Studio Dentistico Federzoni Granata"
              width="1600"
              height="1615"
              loading="lazy"
              decoding="async"
            />
            <span>Diagnosi basata su misurazioni cliniche</span>
          </div>

          <div class="landing-method-copy">
            <p class="landing-kicker landing-kicker-dark">La diagnosi parodontale</p>
            <h2 id="landing-method-title">Non basta guardare le gengive.</h2>
            <p class="landing-method-lead">
              Per definire presenza, estensione e gravità della malattia si integrano anamnesi, sondaggio, mobilità,
              sanguinamento e immagini radiografiche quando necessarie.
            </p>

            <div class="landing-method-list">
              <article>
                <span aria-hidden="true">01</span>
                <div>
                  <h3>Anamnesi e fattori di rischio</h3>
                  <p>Consideriamo sintomi, familiarità, fumo, diabete, farmaci, terapie precedenti e qualità dell’igiene.</p>
                </div>
              </article>
              <article>
                <span aria-hidden="true">02</span>
                <div>
                  <h3>Sondaggio parodontale</h3>
                  <p>Una sonda millimetrata misura tasche, recessioni e sanguinamento attorno ai denti in modo sistematico.</p>
                </div>
              </article>
              <article>
                <span aria-hidden="true">03</span>
                <div>
                  <h3>Radiografie quando indicate</h3>
                  <p>Le immagini aiutano a valutare il supporto osseo e completano i dati clinici, senza sostituirli.</p>
                </div>
              </article>
            </div>

            <a class="landing-text-link" href="#richiedi">
              Richiedi una valutazione parodontale
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <section class="landing-section landing-process" aria-labelledby="landing-process-title">
        <div class="landing-shell">
          <div class="landing-section-heading landing-section-heading-centered">
            <p class="landing-kicker landing-kicker-dark">Come si tratta la parodontite</p>
            <h2 id="landing-process-title">Un percorso per fasi, con rivalutazioni.</h2>
          </div>

          <ol class="landing-process-grid">
            {processSteps.map((step, index) => (
              <li>
                <span class="landing-process-number">{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>

          <div class="landing-process-cta">
            <a class="landing-button" href="#richiedi">Richiedi una valutazione</a>
            <p>Il piano dipende da diagnosi, estensione della malattia e risposta ai primi interventi.</p>
          </div>
        </div>
      </section>

      <section class="landing-section landing-reviews" aria-labelledby="landing-reviews-title">
        <div class="landing-shell">
          <div class="landing-reviews-heading">
            <div>
              <p class="landing-kicker">Esperienze dei pazienti</p>
              <h2 id="landing-reviews-title">La fiducia si costruisce nel tempo.</h2>
            </div>
            <p>Testimonianze pubblicate sul profilo Google dello studio.</p>
          </div>

          <div class="landing-review-grid">
            {reviews.map((review) => (
              <article class="landing-review-card">
                <div class="landing-review-stars" aria-label={`${review.rating} stelle su 5`}>
