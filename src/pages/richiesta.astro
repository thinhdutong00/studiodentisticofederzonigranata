</style>

<script>
  const form = document.querySelector('[data-request-form]');
  const configEl = document.getElementById('request-config');

  if (form instanceof HTMLFormElement && configEl?.textContent) {
    const config = JSON.parse(configEl.textContent);
    const steps = Array.from(form.querySelectorAll('[data-step]'));
    const progressBar = form.querySelector('[data-progress-bar]');
    const stepCount = form.querySelector('[data-step-count]');
    const errorBox = form.querySelector('[data-request-error]');
    const topBackButton = document.querySelector('[data-request-back]');
    const bookingEyebrow = document.querySelector('[data-booking-eyebrow]');
    const submitButton = form.querySelector('[data-submit-request]');
    const nextButton = form.querySelector('[data-request-next]');
    const selectedTreatment = form.querySelector('[data-selected-treatment]');
    const detailStepTitle = form.querySelector('[data-detail-step-title]');
    const problemOptions = form.querySelector('[data-problem-options]');
    const detailStep = form.querySelector('[data-step-key="treatmentDetail"]');
    const conditionalOtherStep = form.querySelector('[data-conditional-other]');
    const otherRequest = form.querySelector('[data-other-request]');
    const calendarGrid = form.querySelector('[data-calendar-grid]');
    const calendarTitle = form.querySelector('[data-calendar-title]');
    const calendarPrev = form.querySelector('[data-calendar-prev]');
    const calendarNext = form.querySelector('[data-calendar-next]');
    const selectedDateLabel = form.querySelector('[data-selected-date]');
    const slotGrid = form.querySelector('[data-slot-grid]');
    const privacyConsent = form.querySelector('[data-privacy-consent]');
    const fields = {
      treatment: form.querySelector('[data-field="treatment"]'),
      treatmentCategory: form.querySelector('[data-field="treatmentCategory"]'),
      problem: form.querySelector('[data-field="problem"]'),
      ageRange: form.querySelector('[data-field="ageRange"]'),
      office: form.querySelector('[data-field="office"]'),
      preferredDate: form.querySelector('[data-field="preferredDate"]'),
      preferredTime: form.querySelector('[data-field="preferredTime"]'),
    };

    const state = {
      step: 0,
      treatmentId: '',
      treatment: '',
      categoryLabel: '',
      problem: '',
      ageRange: '',
      office: '',
      preferredDate: '',
      preferredTime: '',
    };
    let autoAdvanceTimer = 0;
    const usesMobilePillFlow = () => window.matchMedia('(max-width: 720px)').matches;

    const otherTreatmentId = 'altro';
    const needsOtherDetails = () => state.treatmentId === otherTreatmentId;
    const getActiveSteps = () =>
      steps.filter((step) => {
        if (step === detailStep) return !needsOtherDetails();
        if (step === conditionalOtherStep) return needsOtherDetails();
        return true;
      });

    const formatMonth = new Intl.DateTimeFormat('it-IT', { month: 'long', year: 'numeric' });
    const formatDay = new Intl.DateTimeFormat('it-IT', { weekday: 'long', day: 'numeric', month: 'long' });
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const dateKey = (date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const dateFromKey = (key) => {
      const [year, month, day] = key.split('-').map(Number);
      return new Date(year, month - 1, day);
    };

    const availableDates = [];
    for (let offset = 1; offset <= 45; offset += 1) {
      const candidate = new Date(today);
      candidate.setDate(today.getDate() + offset);
      const day = candidate.getDay();
      if (day !== 0 && day !== 6) {
        availableDates.push(dateKey(candidate));
      }
    }

    const availableDateSet = new Set(availableDates);
    const minDate = dateFromKey(availableDates[0]);
    const maxDate = dateFromKey(availableDates[availableDates.length - 1]);
    let visibleMonth = new Date(minDate.getFullYear(), minDate.getMonth(), 1);

    const setError = (message = '') => {
      if (errorBox) {
        errorBox.textContent = message;
      }
    };

    const syncHiddenFields = () => {
      if (fields.treatment) fields.treatment.value = state.treatment;
      if (fields.treatmentCategory) fields.treatmentCategory.value = state.categoryLabel;
      if (fields.problem) fields.problem.value = state.problem;
      if (fields.ageRange) fields.ageRange.value = state.ageRange;
      if (fields.office) fields.office.value = state.office;
      if (fields.preferredDate) fields.preferredDate.value = state.preferredDate;
      if (fields.preferredTime) fields.preferredTime.value = state.preferredTime;
    };

    const renderProblemOptions = () => {
      if (!problemOptions) return;
      const options = config.detailOptionsByTreatment[state.treatmentId] || [];

      problemOptions.innerHTML = '';
      options.forEach((option) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'choice-btn';
        button.dataset.choice = 'problem';
        button.textContent = option;
        button.setAttribute('aria-pressed', String(state.problem === option));
        if (state.problem === option) {
          button.classList.add('is-selected');
        }
        problemOptions.append(button);
      });
    };

    const renderSlots = () => {
      if (!slotGrid) return;
      slotGrid.innerHTML = '';
      config.timeSlots.forEach((slot) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'slot-btn';
        button.dataset.timeSlot = slot;
        button.textContent = slot;
        button.setAttribute('aria-pressed', String(state.preferredTime === slot));
        if (state.preferredTime === slot) {
          button.classList.add('is-selected');
        }
        slotGrid.append(button);
      });
    };

    const renderCalendar = () => {
      if (!calendarGrid || !calendarTitle) return;
      calendarGrid.innerHTML = '';
      calendarTitle.textContent = formatMonth.format(visibleMonth);

      const year = visibleMonth.getFullYear();
      const month = visibleMonth.getMonth();
      const firstDay = new Date(year, month, 1);
      const firstWeekday = (firstDay.getDay() + 6) % 7;
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      for (let i = 0; i < firstWeekday; i += 1) {
        const empty = document.createElement('span');
        empty.className = 'calendar-empty';
        calendarGrid.append(empty);
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const date = new Date(year, month, day);
        const key = dateKey(date);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'date-btn';
        button.dataset.date = key;
        button.textContent = String(day);
        button.disabled = !availableDateSet.has(key);
        button.setAttribute('aria-label', formatDay.format(date));
        button.setAttribute('aria-pressed', String(state.preferredDate === key));
        if (state.preferredDate === key) {
          button.classList.add('is-selected');
        }
        calendarGrid.append(button);
      }

      const previousMonth = new Date(year, month - 1, 1);
      const nextMonth = new Date(year, month + 1, 1);
      if (calendarPrev instanceof HTMLButtonElement) {
        calendarPrev.disabled = previousMonth < new Date(minDate.getFullYear(), minDate.getMonth(), 1);
      }
      if (calendarNext instanceof HTMLButtonElement) {
        calendarNext.disabled = nextMonth > new Date(maxDate.getFullYear(), maxDate.getMonth(), 1);
      }
    };

    const updateSelectedDateLabel = () => {
      if (!selectedDateLabel) return;
      selectedDateLabel.textContent = state.preferredDate
        ? formatDay.format(dateFromKey(state.preferredDate))
        : 'Nessuna data selezionata';
    };

    const isCurrentStepComplete = () => {
      const currentStep = getActiveSteps()[state.step];
      const stepKey = currentStep?.dataset.stepKey;

      if (stepKey === 'treatment') return Boolean(state.treatment);
      if (stepKey === 'treatmentDetail') return Boolean(state.problem);
      if (stepKey === 'otherDetails') {
        return otherRequest instanceof HTMLTextAreaElement && otherRequest.value.trim().length >= 10;
      }
      if (stepKey === 'ageRange') return Boolean(state.ageRange);
      if (stepKey === 'schedule') return Boolean(state.office && state.preferredDate && state.preferredTime);
      return true;
    };

    const syncNextButton = () => {
      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = !isCurrentStepComplete();
      }
    };

    const renderStep = () => {
      const activeSteps = getActiveSteps();
      state.step = Math.max(0, Math.min(state.step, activeSteps.length - 1));
      const currentStep = activeSteps[state.step];

      steps.forEach((step) => {
        const isActive = step === currentStep;
        step.toggleAttribute('hidden', !isActive);
        step.classList.toggle('is-active', isActive);
      });

      if (progressBar instanceof HTMLElement) {
        progressBar.style.width = `${((state.step + 1) / activeSteps.length) * 100}%`;
      }
      if (stepCount) {
        stepCount.textContent = `Step ${state.step + 1} di ${activeSteps.length}`;
      }
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.hidden = state.step !== activeSteps.length - 1;
      }
      if (nextButton instanceof HTMLButtonElement) {
        nextButton.hidden = state.step === activeSteps.length - 1;
      }
      if (topBackButton instanceof HTMLElement) {
        topBackButton.hidden = state.step === 0;
      }
      if (bookingEyebrow) {
        bookingEyebrow.textContent = currentStep?.dataset.stepLabel || '';
      }

      setError();
      syncNextButton();
    };

    const goToStep = (stepIndex) => {
      window.clearTimeout(autoAdvanceTimer);
      const activeSteps = getActiveSteps();
      state.step = Math.max(0, Math.min(stepIndex, activeSteps.length - 1));
      renderStep();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const autoAdvance = () => {
      window.clearTimeout(autoAdvanceTimer);
      autoAdvanceTimer = window.setTimeout(() => {
        goToStep(state.step + 1);
      }, 170);
    };

    const leaveForm = () => {
      if (window.history.length > 1) {
        window.history.back();
        return;
      }

      window.location.href = '/';
    };

    const selectChoice = (button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const choiceType = button.dataset.choice;

      if (choiceType === 'treatment') {
        state.treatmentId = button.dataset.treatmentId || '';
        state.treatment = button.dataset.treatmentLabel || '';
        state.categoryLabel = button.dataset.categoryLabel || '';
        state.problem = '';

        if (otherRequest instanceof HTMLTextAreaElement) {
          otherRequest.required = needsOtherDetails();
          if (!needsOtherDetails()) {
            otherRequest.value = '';
            otherRequest.classList.remove('is-invalid');
          }
        }

        form.querySelectorAll('[data-choice="treatment"]').forEach((option) => {
          const isSelected = option === button;
          option.classList.toggle('is-selected', isSelected);
          option.setAttribute('aria-pressed', String(isSelected));
        });

        if (selectedTreatment) {
          selectedTreatment.textContent = `Trattamento scelto: ${state.treatment}`;
        }
        if (detailStepTitle) {
          detailStepTitle.textContent = `Che cosa desideri approfondire per ${state.treatment.toLowerCase()}?`;
        }
        renderProblemOptions();
      }

      if (choiceType === 'problem') {
        state.problem = button.textContent?.trim() || '';
        form.querySelectorAll('[data-choice="problem"]').forEach((option) => {
          const isSelected = option === button;
          option.classList.toggle('is-selected', isSelected);
          option.setAttribute('aria-pressed', String(isSelected));
        });
      }

      if (choiceType === 'ageRange') {
        state.ageRange = button.dataset.value || button.textContent?.trim() || '';
        form.querySelectorAll('[data-choice="ageRange"]').forEach((option) => {
          const isSelected = option === button;
          option.classList.toggle('is-selected', isSelected);
          option.setAttribute('aria-pressed', String(isSelected));
        });
      }

      if (choiceType === 'office') {
        state.office = button.dataset.value || button.textContent?.trim() || '';
        form.querySelectorAll('[data-choice="office"]').forEach((option) => {
          const isSelected = option === button;
          option.classList.toggle('is-selected', isSelected);
          option.setAttribute('aria-pressed', String(isSelected));
        });
      }

      syncHiddenFields();
      setError();
      syncNextButton();
    };

    const normalizeLabel = (value = '') =>
      value
        .toString()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();

    const preselectTreatmentFromUrl = () => {
      const requestedTreatment = new URLSearchParams(window.location.search).get('trattamento');
      if (!requestedTreatment) return;

      const normalizedRequest = normalizeLabel(requestedTreatment);
      const matchingTreatment = config.treatments.find((treatment) =>
        [treatment.label, ...(treatment.aliases || [])].some(
          (alias) => normalizeLabel(alias) === normalizedRequest
        )
      );
      if (!matchingTreatment) return;

      const matchingButton = Array.from(form.querySelectorAll('[data-choice="treatment"]')).find((button) => {
        if (!(button instanceof HTMLButtonElement)) return false;
        return button.dataset.treatmentId === matchingTreatment.id;
      });

      if (matchingButton instanceof HTMLButtonElement) {
        selectChoice(matchingButton);
        state.step = Math.min(1, getActiveSteps().length - 1);
      }
    };

    const markInvalid = (input, invalid) => {
      if (input instanceof HTMLElement) {
        input.classList.toggle('is-invalid', invalid);
      }
    };

    const validateContactStep = () => {
      const fullName = form.elements.namedItem('fullName');
      const phone = form.elements.namedItem('phone');
      const email = form.elements.namedItem('email');
      const emailValue = email instanceof HTMLInputElement ? email.value.trim() : '';
      const isEmailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailValue);

      const missingName = !(fullName instanceof HTMLInputElement) || fullName.value.trim().length < 2;
      const missingPhone = !(phone instanceof HTMLInputElement) || phone.value.trim().length < 6;
      const missingEmail = !isEmailValid;
      const missingPrivacy = !(privacyConsent instanceof HTMLInputElement) || !privacyConsent.checked;

      markInvalid(fullName, missingName);
      markInvalid(phone, missingPhone);
      markInvalid(email, missingEmail);
      if (privacyConsent instanceof HTMLInputElement) {
        if (missingPrivacy) {
          privacyConsent.setAttribute('aria-invalid', 'true');
        } else {
          privacyConsent.removeAttribute('aria-invalid');
        }
      }

      if (missingName || missingPhone || missingEmail || missingPrivacy) {
        if (!missingName && !missingPhone && !missingEmail && missingPrivacy) {
          setError('Accetta l’informativa privacy per inviare la richiesta.');
          return false;
        }
        setError('Compila nome, telefono ed email per inviare la richiesta.');
        return false;
      }

      return true;
    };

    const validateCurrentStep = () => {
      const currentStep = getActiveSteps()[state.step];
      const stepKey = currentStep?.dataset.stepKey;

      if (stepKey === 'treatment' && !state.treatment) {
        setError('Seleziona un trattamento per continuare.');
        return false;
      }
      if (stepKey === 'treatmentDetail' && !state.problem) {
        setError('Seleziona l’opzione più vicina alla tua richiesta.');
        return false;
      }
      if (stepKey === 'otherDetails') {
        const otherRequestValue = otherRequest instanceof HTMLTextAreaElement ? otherRequest.value.trim() : '';
        const missingOtherRequest = otherRequestValue.length < 10;
        markInvalid(otherRequest, missingOtherRequest);

        if (missingOtherRequest) {
          setError('Raccontaci brevemente di che cosa hai bisogno.');
          return false;
        }
      }
      if (stepKey === 'ageRange' && !state.ageRange) {
        setError('Seleziona una fascia d’età per continuare.');
        return false;
      }
      if (stepKey === 'schedule' && (!state.office || !state.preferredDate || !state.preferredTime)) {
        setError('Scegli una sede, una data e una fascia oraria preferita.');
        return false;
      }
      if (stepKey === 'contact') {
        return validateContactStep();
      }

      setError();
      return true;
    };

    form.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const choiceButton = target.closest('[data-choice]');
      if (choiceButton) {
        selectChoice(choiceButton);
        const choiceType = choiceButton.getAttribute('data-choice');
        if (
          usesMobilePillFlow() &&
          (
            choiceType === 'treatment' ||
            choiceType === 'problem' ||
            choiceType === 'ageRange' ||
            (choiceType === 'office' && state.preferredDate && state.preferredTime)
          )
        ) {
          autoAdvance();
        }
        return;
      }

      const otherNextButton = target.closest('[data-request-other-next]');
      if (otherNextButton && validateCurrentStep()) {
        goToStep(state.step + 1);
        return;
      }

      const dateButton = target.closest('[data-date]');
      if (dateButton instanceof HTMLButtonElement && !dateButton.disabled) {
        state.preferredDate = dateButton.dataset.date || '';
        state.preferredTime = '';
        syncHiddenFields();
        renderCalendar();
        renderSlots();
        updateSelectedDateLabel();
        setError();
        syncNextButton();
        return;
      }

      const slotButton = target.closest('[data-time-slot]');
      if (slotButton instanceof HTMLButtonElement) {
        state.preferredTime = slotButton.dataset.timeSlot || '';
        syncHiddenFields();
        renderSlots();
        setError();
        syncNextButton();
        if (usesMobilePillFlow() && state.office && state.preferredDate && state.preferredTime) {
          autoAdvance();
        }
      }
    });

    nextButton?.addEventListener('click', () => {
      if (validateCurrentStep()) {
        goToStep(state.step + 1);
      }
    });

    topBackButton?.addEventListener('click', (event) => {
      event.preventDefault();
      if (state.step === 0) {
        leaveForm();
        return;
      }

      goToStep(state.step - 1);
    });

    calendarPrev?.addEventListener('click', () => {
      visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1);
      renderCalendar();
    });

    calendarNext?.addEventListener('click', () => {
      visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1);
      renderCalendar();
    });

    form.addEventListener('input', (event) => {
      markInvalid(event.target, false);
      if (event.target === privacyConsent && privacyConsent instanceof HTMLInputElement) {
        privacyConsent.removeAttribute('aria-invalid');
      }
      setError();
      syncNextButton();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!validateCurrentStep()) return;

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = 'Invio in corso';
      }

      window.location.href = '/thank-you-page/';
    });

    preselectTreatmentFromUrl();
    renderProblemOptions();
    renderCalendar();
    renderSlots();
    updateSelectedDateLabel();
    syncHiddenFields();
    renderStep();
  }
</script>
