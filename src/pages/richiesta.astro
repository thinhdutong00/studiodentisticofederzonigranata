---
import BaseLayout from '../components/BaseLayout.astro';
import { bookingAgeRangeOptions } from '../data/bookingForms';
import { site } from '../data/site';
import '../styles/booking-questionnaire.css';

const title = `Richiedi una valutazione - ${site.name}`;
const description =
  'Scegli il trattamento, indica il problema e invia una richiesta di appuntamento allo Studio Dentistico Federzoni Granata.';

const treatmentOptions = [
  {
    id: 'igiene',
    label: 'Igiene orale e prevenzione',
    categoryLabel: 'Prevenzione',
    aliases: ['Igiene orale e Prevenzione', 'Igiene orale e prevenzione'],
  },
  {
    id: 'sbiancamento',
    label: 'Sbiancamento dentale',
    categoryLabel: 'Estetica',
    aliases: ['Sbiancamento', 'Sbiancamento dentale'],
  },
  {
    id: 'faccette',
    label: 'Faccette dentali',
    categoryLabel: 'Estetica',
    aliases: [
      'Faccette dentali',
      'Estetica diretta (faccette in composito)',
      'Estetica Indiretta (faccette in porcellana)',
    ],
  },
  {
    id: 'otturazioni',
    label: 'Carie e otturazioni',
    categoryLabel: 'Conservativa',
    aliases: ['Conservativa', 'Conservativa (otturazioni)', 'Carie e otturazioni'],
  },
  {
    id: 'devitalizzazione',
    label: 'Devitalizzazione',
    categoryLabel: 'Endodonzia',
    aliases: ['Endodonzia', 'Endodonzia (devitalizzazioni)', 'Devitalizzazione'],
  },
  {
    id: 'pedodonzia',
    label: 'Odontoiatria infantile',
    categoryLabel: 'Pedodonzia',
    aliases: ['Pedodonzia', 'Pedodonzia (odontoiatria infantile)', 'Odontoiatria infantile'],
  },
  {
    id: 'ortodonzia',
    label: 'Ortodonzia e allineatori',
    categoryLabel: 'Ortodonzia',
    aliases: [
      'Ortodonzia',
      'Ortodonzia e allineatori',
      'Ortodonzia e Allineatori invisibili (adulti e bimbi)',
    ],
  },
  {
    id: 'gnatologia',
    label: 'Disturbi della mandibola e ATM',
    categoryLabel: 'Gnatologia',
    aliases: ['Gnatologia', 'Gnatologia (disturbi articolazione temporo-mandibolare)'],
  },
  {
    id: 'russamento-apnee',
    label: 'Russamento e apnee notturne',
    categoryLabel: 'Disturbi del sonno',
    aliases: ['Russamento e apnee notturne', 'Dispositivi contro il russamento e le apnee notturne'],
  },
  {
    id: 'gengive',
    label: 'Cura delle gengive',
    categoryLabel: 'Parodontologia',
    aliases: ['Parodontologia', 'Parodontologia (cure gengivali)', 'Cura delle gengive'],
  },
  {
    id: 'protesi',
    label: 'Protesi dentali',
    categoryLabel: 'Protesi',
    aliases: ['Protesi', 'Protesi fissa e mobile', 'Protesi dentali'],
  },
  {
    id: 'chirurgia',
    label: 'Chirurgia orale',
    categoryLabel: 'Chirurgia',
    aliases: ['Chirurgia Stomatologica', 'Chirurgia orale'],
  },
  {
    id: 'implantologia',
    label: 'Implantologia',
    categoryLabel: 'Implantologia',
    aliases: ['Implantologia', 'Implantologia tradizionale e computer guidata'],
  },
  {
    id: 'altro',
    label: 'Altro',
    categoryLabel: 'Altra esigenza',
    aliases: ['Altro'],
  },
];

const specialistOption = 'Voglio prima confrontarmi con un vostro specialista';
const detailOptionsByTreatment = {
  igiene: [
    'Seduta di igiene orale professionale',
    'Controllo preventivo di denti e gengive',
    'Prevenzione e igiene per un bambino',
    specialistOption,
  ],
  sbiancamento: [
    'Sbiancamento professionale in studio',
    'Sbiancamento domiciliare controllato',
    'Vorrei capire quale soluzione è più adatta a me',
    specialistOption,
  ],
  faccette: [
    'Faccette in composito',
    'Faccette in ceramica',
    specialistOption,
  ],
  otturazioni: [
    'Sospetta carie o sensibilità da controllare',
    'Vecchia otturazione da controllare o sostituire',
    'Dente scheggiato o usurato da ricostruire',
    specialistOption,
  ],
  devitalizzazione: [
    'Dolore o sensibilità persistente',
    'Devitalizzazione già consigliata',
    'Controllo di un dente già devitalizzato',
    specialistOption,
  ],
  pedodonzia: [
    'Prima visita del bambino',
    'Controllo, igiene o prevenzione',
    'Dolore, carie o trauma dentale',
    specialistOption,
  ],
  ortodonzia: [
    'Allineatori trasparenti',
    'Apparecchio ortodontico tradizionale',
    'Valutazione ortodontica per un bambino o ragazzo',
    specialistOption,
  ],
  gnatologia: [
    'Dolore, rumori o blocchi della mandibola',
    'Bruxismo, serramento o usura dei denti',
    'Valutazione del morso e della funzione',
    specialistOption,
  ],
  'russamento-apnee': [
    'Russamento abituale da valutare',
    'Apnea notturna già diagnosticata',
    'Valutazione per un dispositivo intraorale',
    specialistOption,
  ],
  gengive: [
    'Gengive che sanguinano o sono infiammate',
    'Recessione gengivale o denti che si muovono',
    'Mantenimento dopo una terapia parodontale',
    specialistOption,
  ],
  protesi: [
    'Protesi fissa: corona o ponte',
    'Protesi mobile',
    'Controllo o riparazione di una protesi esistente',
    specialistOption,
  ],
  chirurgia: [
    'Dente del giudizio',
    'Estrazione o residuo radicolare',
    'Valutazione di una lesione o procedura orale',
    specialistOption,
  ],
  implantologia: [
    'Sostituire un singolo dente',
    'Sostituire più denti o un’intera arcata',
    'Valutare implantologia computer guidata',
    specialistOption,
  ],
};

const requestConfig = {
  treatments: treatmentOptions,
  detailOptionsByTreatment,
  timeSlots: ['09:00', '10:00', '11:00', '14:30', '15:30', '16:30', '17:30'],
};
const offices = site.offices.map((office) => office.city);

const requestConfigJson = JSON.stringify(requestConfig).replace(/</g, '\\u003c');
---

<BaseLayout title={title} description={description} ogImage={site.heroImage} canonicalPath="/richiesta/">
  <section class="request-page booking-questionnaire" aria-labelledby="request-questionnaire-title">
    <div class="request-shell">
      <form class="request-form" data-request-form novalidate>
        <script id="request-config" type="application/json" set:html={requestConfigJson}></script>
        <input type="hidden" name="treatment" data-field="treatment" />
        <input type="hidden" name="treatmentCategory" data-field="treatmentCategory" />
        <input type="hidden" name="problem" data-field="problem" />
        <input type="hidden" name="ageRange" data-field="ageRange" />
        <input type="hidden" name="office" data-field="office" />
        <input type="hidden" name="preferredDate" data-field="preferredDate" />
        <input type="hidden" name="preferredTime" data-field="preferredTime" />

        <div class="request-progress" aria-hidden="true">
          <span data-progress-bar></span>
        </div>

        <header class="request-head booking-questionnaire-heading">
          <p class="booking-questionnaire-eyebrow" data-booking-eyebrow>Scegli il trattamento</p>
          <h1 id="request-questionnaire-title">Anamnesi</h1>
        </header>

        <p class="request-step-count" data-step-count>Step 1 di 5</p>

        <fieldset class="request-step is-active" data-step="0" data-step-key="treatment" data-step-label="Scegli il trattamento">
          <legend>
            <span class="quiz-kicker">Trattamento</span>
            <strong id="request-step-title">Quale trattamento vuoi richiedere?</strong>
          </legend>

          <div class="quiz-options quiz-options-treatments">
            {treatmentOptions.map((item) => (
              <button
                class="choice-btn"
                type="button"
                data-choice="treatment"
                data-treatment-id={item.id}
                data-category-label={item.categoryLabel}
                data-treatment-label={item.label}
              >
                {item.label}
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset class="request-step" data-step="1" data-step-key="treatmentDetail" data-step-label="Approfondisci la richiesta" hidden>
          <legend>
            <span class="quiz-kicker">Approfondimento</span>
            <strong data-detail-step-title>Raccontaci meglio il trattamento che cerchi</strong>
          </legend>

          <p class="selected-summary" data-selected-treatment>Trattamento non ancora selezionato.</p>
          <div class="quiz-options quiz-options-large" data-problem-options></div>
        </fieldset>

        <fieldset class="request-step" data-step="2" data-step-key="otherDetails" data-step-label="Raccontaci la tua esigenza" data-conditional-other hidden>
          <legend>
            <span class="quiz-kicker">Raccontaci di più</span>
            <strong>Di che cosa hai bisogno?</strong>
          </legend>

          <div class="field-grid request-other-field-grid">
            <label class="field-wide">
              <span>Descrivi brevemente la tua richiesta</span>
              <textarea
                name="otherRequest"
                rows="6"
                minlength="10"
                placeholder="Raccontaci che cosa ti serve o quale problema vorresti risolvere"
                data-other-request
              ></textarea>
            </label>
          </div>

          <div class="request-other-actions">
            <button class="request-btn request-btn-primary booking-conditional-next" type="button" data-request-other-next>
              Conferma dettagli <span class="ui-glyph module-cta-glyph" aria-hidden="true">↗</span>
            </button>
          </div>
        </fieldset>

        <fieldset class="request-step" data-step="3" data-step-key="ageRange" data-step-label="Fascia d’età" hidden>
          <legend>
            <span class="quiz-kicker">Fascia d’età</span>
            <strong>Qual è la fascia d’età della persona da visitare?</strong>
          </legend>

          <div class="quiz-options">
            {bookingAgeRangeOptions.map((option) => (
              <button class="choice-btn" type="button" data-choice="ageRange" data-value={option}>
                {option}
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset class="request-step" data-step="4" data-step-key="schedule" data-step-label="Preferenze per la visita" hidden>
          <legend>
            <span class="quiz-kicker">Sede, data e orario</span>
            <strong>Dove e quando preferiresti venire in studio?</strong>
          </legend>

          <div class="request-office-choice">
            <h2>Sede preferita</h2>
            <div class="quiz-options request-office-options">
              {offices.map((office) => (
                <button class="choice-btn" type="button" data-choice="office" data-value={office}>
                  {office}
                </button>
              ))}
            </div>
          </div>

          <div class="date-time-grid">
            <div class="calendar-card">
              <div class="calendar-head">
                <button class="calendar-nav" type="button" data-calendar-prev aria-label="Mese precedente"><span class="ui-glyph module-calendar-glyph" aria-hidden="true">‹</span></button>
                <p class="calendar-title" data-calendar-title></p>
                <button class="calendar-nav" type="button" data-calendar-next aria-label="Mese successivo"><span class="ui-glyph module-calendar-glyph" aria-hidden="true">›</span></button>
              </div>
              <div class="calendar-weekdays" aria-hidden="true">
                <span>Lun</span>
                <span>Mar</span>
                <span>Mer</span>
                <span>Gio</span>
                <span>Ven</span>
                <span>Sab</span>
                <span>Dom</span>
              </div>
              <div class="calendar-grid" data-calendar-grid></div>
            </div>

            <div class="slot-card">
              <p class="slot-title">Orario preferito</p>
              <p class="slot-date" data-selected-date>Nessuna data selezionata</p>
              <div class="slot-grid" data-slot-grid></div>
            </div>
          </div>
        </fieldset>

        <fieldset class="request-step" data-step="5" data-step-key="contact" data-step-label="I tuoi dati" hidden>
          <legend>
            <span class="quiz-kicker">Contatti</span>
            <strong>Lasciaci i tuoi dati</strong>
          </legend>

          <div class="field-grid">
            <label>
              <span>Nome intero</span>
              <input type="text" name="fullName" autocomplete="name" required />
            </label>
            <label>
              <span>Numero di telefono</span>
              <input type="tel" name="phone" autocomplete="tel" required />
            </label>
            <label class="field-wide">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label class="field-wide">
              <span>Dettagli prima della visita <em>facoltativo</em></span>
              <textarea name="details" rows="4"></textarea>
            </label>
          </div>

          <label class="booking-privacy-consent">
            <input type="checkbox" name="privacyConsent" required data-privacy-consent />
            <span>
              Ho letto l’<a href="/privacy-policy/" target="_blank" rel="noopener noreferrer">informativa privacy</a>
              e acconsento al trattamento dei dati per essere ricontattato in merito alla richiesta.
            </span>
          </label>
        </fieldset>

        <p class="request-error" data-request-error role="alert" aria-live="polite"></p>

        <div class="request-actions">
          <a class="multistep-backbar" href="/" data-request-back hidden>
            <span class="ui-glyph module-back-glyph" aria-hidden="true">‹</span>
            <strong>Indietro</strong>
          </a>
          <button class="request-btn request-btn-primary booking-desktop-next" type="button" data-request-next>
            Continua <span class="ui-glyph module-cta-glyph" aria-hidden="true">↗</span>
          </button>
          <button class="request-btn request-btn-primary" type="submit" data-submit-request hidden>Invia la richiesta <span class="ui-glyph module-cta-glyph" aria-hidden="true">↗</span></button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<style is:global>
  body {
    background: var(--surface-white);
  }

  .site-header {
    display: none !important;
  }

  .multistep-backbar {
    min-height: clamp(88px, 8vw, 112px);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 clamp(24px, 4vw, 52px);
    background: var(--brand-primary-dark);
    color: var(--surface-white);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }

  .multistep-backbar .module-back-glyph {
    width: 1em;
    height: 1em;
    display: inline-grid;
    flex: 0 0 1em;
    place-items: center;
    font-size: 1.45em;
    font-weight: 400;
    line-height: 1;
  }

  .multistep-backbar strong {
    font: inherit;
  }

  .multistep-backbar:hover,
  .multistep-backbar:focus-visible {
    background: var(--brand-cta-hover);
    color: var(--surface-white);
  }

  .request-page {
    min-height: calc(100vh - var(--nav-height));
    padding: clamp(28px, 5vw, 58px) 0 78px;
    background: var(--surface-white);
    color: var(--text-dark);
  }

  .request-shell {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .quiz-kicker {
    display: block;
    margin: 0 0 10px;
    color: var(--brand-cta);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .request-form {
    position: relative;
    min-height: calc(100vh - var(--nav-height) - 136px);
    padding: 0;
    background: transparent;
  }

  .request-progress {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--border);
  }

  .request-progress span {
    display: block;
    width: 25%;
    height: 100%;
    border-radius: inherit;
    background: var(--brand-cta);
    transition: width 220ms ease;
  }

  .request-step-count {
    margin: 20px 0 28px;
    color: var(--muted-text);
    font-weight: 900;
  }

  .request-step {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .request-step[hidden] {
    display: none;
  }

  .request-step legend {
    width: 100%;
    margin: 0 0 26px;
    padding: 0;
  }

  .request-step legend strong {
    display: block;
    max-width: 820px;
    color: var(--brand-primary-dark);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.12;
  }

  .treatment-groups {
    display: grid;
    gap: 18px;
  }

  .treatment-group {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px;
    background: var(--surface-white);
  }

  .treatment-group h2 {
    margin: 0 0 14px;
    color: var(--brand-primary-dark);
    font-size: 1.04rem;
    line-height: 1.25;
  }

  .quiz-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .quiz-options-large {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .choice-btn,
  .date-btn,
  .slot-btn {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface-white);
    color: var(--text-dark);
    font: inherit;
    font-weight: 900;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .choice-btn {
    min-height: 68px;
    padding: 18px;
  }

  .choice-btn:hover,
  .date-btn:hover,
  .slot-btn:hover {
    border-color: rgba(var(--brand-cta-rgb), 0.42);
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(15, 31, 99, 0.08);
  }

  .choice-btn.is-selected,
  .date-btn.is-selected,
  .slot-btn.is-selected {
    border-color: var(--brand-cta);
    background: var(--brand-cta);
    color: var(--surface-white);
    box-shadow: 0 18px 34px rgba(var(--brand-cta-rgb), 0.22);
  }

  .selected-summary {
    display: inline-flex;
    max-width: 100%;
    margin: 0 0 22px;
    border-radius: 999px;
    padding: 10px 16px;
    background: var(--soft-blue-bg);
    color: var(--brand-cta);
    font-weight: 900;
  }

  .date-time-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    gap: 22px;
  }

  .calendar-card,
  .slot-card {
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 20px;
    background: var(--surface-white);
  }

  .calendar-head {
    display: grid;
    grid-template-columns: 42px 1fr 42px;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .calendar-title,
  .slot-title,
  .slot-date {
    margin: 0;
    color: var(--brand-primary-dark);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 900;
    line-height: 1.25;
    text-align: center;
  }

  .calendar-nav {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    padding: 0;
    background: var(--surface-white);
    color: var(--brand-cta);
    cursor: pointer;
  }

  .calendar-nav .module-calendar-glyph {
    width: 24px;
    height: 24px;
    display: inline-grid;
    place-items: center;
    font-size: 25.6px;
    font-weight: 400;
    line-height: 24px;
  }

  .calendar-nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .calendar-weekdays,
  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 8px;
  }

  .calendar-weekdays {
    margin-bottom: 8px;
    color: var(--muted-text);
    font-size: 0.78rem;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
  }

  .date-btn {
    min-height: 52px;
    padding: 0;
    text-align: center;
  }

  .date-btn:disabled {
    border-color: transparent;
    background: transparent;
    color: var(--border);
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .calendar-empty {
    min-height: 52px;
  }

  .slot-card {
    display: flex;
    flex-direction: column;
  }

  .slot-title {
    text-align: left;
  }

  .slot-date {
    margin-top: 8px;
    color: var(--muted-text);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 0.96rem;
    text-align: left;
  }

  .slot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 22px;
  }

  .slot-btn {
    min-height: 48px;
    padding: 10px;
    text-align: center;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .field-grid label {
    display: grid;
    gap: 8px;
    color: var(--text-dark);
    font-weight: 900;
  }

  .field-grid label span {
    line-height: 1.25;
  }

  .field-grid em {
    color: var(--muted-text);
    font-style: normal;
    font-weight: 700;
  }

  .field-wide {
    grid-column: 1 / -1;
  }

  .field-grid input,
  .field-grid textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 15px 16px;
    background: var(--surface-white);
    color: var(--text-dark);
    font: inherit;
    font-weight: 700;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .field-grid textarea {
    resize: vertical;
  }

  .field-grid input:focus,
  .field-grid textarea:focus {
    border-color: var(--brand-cta);
    background: var(--surface-white);
    box-shadow: 0 0 0 4px rgba(var(--brand-cta-rgb), 0.1);
  }

  .field-grid .is-invalid {
    border-color: var(--error);
    box-shadow: 0 0 0 4px rgba(var(--error-rgb), 0.1);
  }

  .privacy-copy {
    margin: 18px 0 0;
    color: var(--muted-text);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .request-error {
    min-height: 26px;
    margin: 24px 0 0;
    color: var(--error);
    font-weight: 900;
  }

  .request-actions {
    display: flex;
    flex-wrap: wrap;
