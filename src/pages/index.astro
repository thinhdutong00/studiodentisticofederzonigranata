---
import BaseLayout from '../components/BaseLayout.astro';
import ScrapedHome from '../components/ScrapedHome.astro';
import { site } from '../data/site';

const page = site.pages.find((item) => item.path === '/');
if (!page) throw new Error('Homepage data not found');
---

<BaseLayout title={page.title} description={page.description} ogImage={page.ogImage || site.heroImage} canonicalPath="/" transparentHeader>
  <ScrapedHome />
</BaseLayout>
