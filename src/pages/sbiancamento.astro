---
import BaseLayout from '../components/BaseLayout.astro';
import TreatmentPathwayIcon from '../components/TreatmentPathwayIcon.astro';
import TreatmentPrefooterCta from '../components/TreatmentPrefooterCta.astro';
import { site } from '../data/site';
import type { TreatmentPathwayIconName } from '../data/treatmentMarketing';

const title = `Sbiancamento dentale | ${site.name}`;
const description =
  'Sbiancamento dentale professionale a Modena e Reggio Emilia: valutazione iniziale, trattamento personalizzato e indicazioni per mantenere il risultato.';

const informationSections = [
  {
    title: 'A cosa serve',
    paragraphs: [
      'Lo sbiancamento dentale professionale serve a rendere più luminoso il colore naturale dei denti e ad attenuare pigmentazioni accumulate nel tempo. Il risultato viene calibrato sul sorriso della persona, senza inseguire un bianco artificiale o uguale per tutti.',
      'Prima del trattamento controlliamo denti, gengive, vecchie otturazioni e sensibilità. Corone, faccette e ricostruzioni non cambiano colore con lo sbiancamento: riconoscerle in anticipo permette di pianificare un risultato più armonico.',
    ],
  },
  {
    title: 'Per chi è indicato',
    paragraphs: [
      'Può essere indicato quando il sorriso appare più scuro o presenta pigmentazioni legate a caffè, tè, fumo, alimentazione o al naturale passare del tempo. La visita aiuta a distinguere le macchie superficiali dalle variazioni di colore che richiedono un approccio diverso.',
      'Carie, infiammazione gengivale, forte sensibilità o restauri visibili possono richiedere prima altri interventi. Per questo l’idoneità e le aspettative vengono sempre valutate prima di iniziare.',
    ],
  },
  {
    title: 'Come si svolge e come prepararsi',
    paragraphs: [
      'Il percorso parte da una valutazione clinica e, quando necessario, da una seduta di igiene professionale. In base al caso possiamo considerare una procedura in studio, un trattamento domiciliare controllato con mascherine personalizzate oppure un percorso combinato.',
      'Prima di cominciare spieghiamo tempi, modalità di applicazione e comportamento da seguire. Fotografie e rilevazione del colore iniziale aiutano a osservare il cambiamento in modo realistico e condiviso.',
    ],
  },
  {
    title: 'Dopo il trattamento',
    paragraphs: [
      'Nei giorni successivi può comparire una sensibilità temporanea, generalmente gestibile seguendo le indicazioni ricevute. È utile curare l’igiene quotidiana e limitare per il periodo consigliato fumo, bevande e alimenti molto pigmentanti.',
      'Il risultato non è permanente: abitudini, alimentazione e caratteristiche individuali influenzano la durata. I controlli periodici permettono di capire se e quando sia opportuno programmare un richiamo.',
    ],
  },
  {
    title: 'Domande frequenti',
    faqs: [
      {
        question: 'Lo sbiancamento rovina lo smalto?',
        answer:
          'Un trattamento professionale viene scelto e controllato dopo avere valutato la salute della bocca. Con prodotti e tempi appropriati non si basa sulla rimozione dello smalto, ma sull’azione dei principi sbiancanti sui pigmenti.',
      },
      {
        question: 'Quanto diventano bianchi i denti?',
        answer:
          'La risposta varia da persona a persona e dipende dal colore di partenza, dal tipo di pigmentazione e dalla struttura del dente. L’obiettivo è ottenere un miglioramento naturale e coerente con il viso.',
      },
      {
        question: 'Otturazioni, corone e faccette cambiano colore?',
        answer:
          'No. I materiali da restauro non rispondono allo sbiancamento come i denti naturali. Se sono visibili nel sorriso, ne teniamo conto già in fase di pianificazione.',
      },
      {
        question: 'Quanto dura il risultato?',
        answer:
          'La durata dipende da igiene, fumo, alimentazione e caratteristiche individuali. Una buona routine, i controlli e gli eventuali richiami concordati aiutano a mantenerlo nel tempo.',
      },
    ],
  },
];

const pathwayCards = [
  {
    icon: 'assessment',
    title: 'Valutiamo il sorriso',
    text: 'Colore di partenza, salute orale, restauri presenti, sensibilità e obiettivi personali.',
  },
  {
    icon: 'whitening',
    title: 'Scegliamo il percorso',
    text: 'Tempi e modalità vengono definiti in base alle caratteristiche della bocca e alla vita quotidiana.',
  },
  {
    icon: 'monitoring',
    title: 'Controlliamo il risultato',
    text: 'Indicazioni post-trattamento e controlli aiutano a proteggere comfort, naturalezza e durata.',
  },
] satisfies Array<{ icon: TreatmentPathwayIconName; title: string; text: string }>;
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/assets/menu/casi-clinici-estetica.jpg"
  canonicalPath="/sbiancamento/"
  transparentHeader
  headerCtaHref="/richiesta/?trattamento=Sbiancamento"
>
  <article class="whitening-page">
    <section class="whitening-hero" aria-labelledby="whitening-title" data-transparent-header-region>
      <div class="whitening-wrap whitening-hero-grid">
        <div class="whitening-hero-copy">
          <p class="whitening-kicker">Estetica del sorriso</p>
          <h1 id="whitening-title">Sbiancamento dentale</h1>
          <p class="whitening-lead">
            Un percorso professionale per rendere il sorriso più luminoso, rispettando il colore
            naturale dei denti e le caratteristiche di ogni persona.
          </p>
          <ul class="whitening-trust-list" aria-label="Caratteristiche del percorso">
            <li>Valutazione clinica prima del trattamento</li>
            <li>Piano personalizzato</li>
            <li>Sedi a Modena e Reggio Emilia</li>
          </ul>
        </div>

        <form class="whitening-form" aria-labelledby="whitening-form-title" aria-describedby="whitening-form-note">
          <p class="whitening-form-eyebrow">Richiedi una valutazione</p>
          <h2 id="whitening-form-title">Parliamo del tuo sorriso</h2>

          <label for="whitening-office">Sede preferita</label>
          <div class="whitening-select-wrap">
            <select id="whitening-office" name="office">
              <option value="">Scegli una sede</option>
              {site.offices.map((office) => <option value={office.city}>{office.city}</option>)}
            </select>
          </div>

          <label for="whitening-path">Tipo di percorso</label>
          <div class="whitening-select-wrap">
            <select id="whitening-path" name="path">
              <option value="">Da valutare insieme</option>
              <option value="studio">Trattamento in studio</option>
              <option value="domiciliare">Trattamento domiciliare controllato</option>
            </select>
          </div>

          <button type="button" aria-disabled="true">Richiedi informazioni <span aria-hidden="true">↗</span></button>
          <p class="whitening-form-note" id="whitening-form-note">
            Modulo dimostrativo: l’invio non è ancora attivo.
          </p>
        </form>
      </div>
    </section>

    <section class="whitening-information" aria-label="Informazioni sullo sbiancamento dentale">
      <div class="whitening-wrap">
        {informationSections.map((section, index) => (
          <details class="whitening-detail" open={index === 0}>
            <summary>
              <span>{section.title}</span>
              <i aria-hidden="true"></i>
            </summary>
            <div class="whitening-detail-content">
              {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              {section.faqs && (
                <div class="whitening-faq-grid">
                  {section.faqs.map((item) => (
                    <article>
                      <h3>{item.question}</h3>
                      <p>{item.answer}</p>
                    </article>
                  ))}
                </div>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="whitening-pathway" aria-labelledby="whitening-pathway-title">
      <div class="whitening-wrap">
        <div class="whitening-section-heading">
          <p class="whitening-kicker">Un percorso chiaro</p>
          <h2 id="whitening-pathway-title">Prima il sorriso, poi il trattamento</h2>
          <p>
            Lo sbiancamento è una scelta estetica, ma parte sempre da una valutazione clinica.
            Così possiamo chiarire possibilità, limiti e aspettative prima di iniziare.
          </p>
        </div>

        <div class="whitening-pathway-grid">
          {pathwayCards.map((card) => (
            <article>
              <TreatmentPathwayIcon name={card.icon} />
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>

        <div class="whitening-pathway-action">
          <a href="/richiesta/?trattamento=Sbiancamento">Prenota visita <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <TreatmentPrefooterCta
      title="Valutiamo come rendere più luminoso il tuo sorriso."
      href="/richiesta/?trattamento=Sbiancamento"
    />
  </article>
</BaseLayout>

<style>
  .whitening-page {
    --whitening-dark: var(--brand-primary-dark);
    --whitening-accent: var(--brand-blue);
    --whitening-cta: var(--brand-cta);
    --whitening-cta-hover: var(--brand-cta-hover);
    --whitening-line: rgba(var(--brand-cta-rgb), 0.72);
    --whitening-letter-spacing: -0.2px;
    background: var(--surface-white);
    color: var(--text-dark);
    font-family: Inter, sans-serif;
    letter-spacing: var(--whitening-letter-spacing);
    word-spacing: 0;
  }

  .whitening-wrap {
    width: min(100% - 48px, 1540px);
    margin: 0 auto;
  }

  .whitening-hero {
    min-height: clamp(690px, 82svh, 900px);
    display: grid;
    align-items: center;
    background:
      radial-gradient(circle at 20% 82%, rgba(var(--brand-blue-rgb), 0.18), transparent 32%),
      var(--whitening-dark);
    color: var(--surface-white);
  }

  .whitening-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(360px, 0.65fr);
    gap: clamp(56px, 8vw, 130px);
    align-items: center;
    padding: clamp(150px, 14vw, 205px) 0 clamp(70px, 8vw, 110px);
  }

  .whitening-hero-copy {
    max-width: 980px;
  }

  .whitening-kicker,
  .whitening-form-eyebrow {
    margin: 0 0 20px;
    color: var(--whitening-accent);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 16px;
    text-transform: uppercase;
  }

  .whitening-hero h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--surface-white);
    font-family: Inter, sans-serif;
    font-size: clamp(64px, 7vw, 112px);
    font-weight: 300;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .whitening-lead {
    max-width: 920px;
    margin: 36px 0 0;
    color: var(--whitening-accent);
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 500;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 1.28;
  }

  .whitening-trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 34px 0 0;
    padding: 0;
    color: var(--surface-white);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    list-style: none;
  }

  .whitening-trust-list li {
    position: relative;
    padding-left: 17px;
  }

  .whitening-trust-list li::before {
    content: "";
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--whitening-accent);
  }

  .whitening-form {
    align-self: center;
    padding: clamp(28px, 3vw, 42px);
    border-radius: 10px;
    background: var(--surface-white);
    box-shadow: 0 22px 70px rgba(5, 20, 33, 0.22);
    color: var(--text-dark);
  }

  .whitening-form-eyebrow {
    margin-bottom: 10px;
    color: var(--whitening-cta);
  }

  .whitening-form h2 {
    margin: 0 0 30px;
    color: var(--whitening-dark);
    font-size: clamp(28px, 2.25vw, 36px);
    font-weight: 500;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 1.15;
  }

  .whitening-form label {
    display: block;
    margin: 18px 0 8px;
    color: var(--muted-text);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
  }

  .whitening-select-wrap {
    position: relative;
  }

  .whitening-select-wrap::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 20px;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--whitening-dark);
    border-bottom: 2px solid var(--whitening-dark);
    pointer-events: none;
    transform: translateY(-70%) rotate(45deg);
  }

  .whitening-form select {
    width: 100%;
    min-height: 62px;
    appearance: none;
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0 52px 0 18px;
    background: var(--surface-white);
    color: var(--text-dark);
    font: inherit;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: var(--whitening-letter-spacing);
  }

  .whitening-form select:focus-visible {
    border-color: var(--whitening-cta);
    outline: 3px solid rgba(var(--brand-cta-rgb), 0.18);
  }

  .whitening-form button {
    width: 100%;
    min-height: 64px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    border: 1px solid var(--whitening-cta);
    border-radius: 7px;
    padding: 0 20px;
    background: var(--whitening-cta);
    color: var(--surface-white);
    font-family: Inter, sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 16px;
    text-transform: uppercase;
    cursor: not-allowed;
  }

  .whitening-form button span {
    font-size: 22px;
  }

  .whitening-form-note {
    margin: 14px 0 0;
    color: var(--muted-text);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
  }

  .whitening-information {
    padding: clamp(70px, 7vw, 108px) 0;
    background: var(--surface-white);
  }

  .whitening-detail {
    border-bottom: 2px solid var(--whitening-line);
  }

  .whitening-detail:first-child {
    border-top: 2px solid var(--whitening-line);
  }

  .whitening-detail summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px;
    gap: 24px;
    align-items: center;
    padding: clamp(24px, 3vw, 42px) 0;
    color: var(--whitening-cta-hover);
    cursor: pointer;
    font-size: clamp(36px, 4vw, 64px);
    font-weight: 500;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 1.08;
    list-style: none;
  }

  .whitening-detail summary::-webkit-details-marker {
    display: none;
  }

  .whitening-detail summary:focus-visible {
    outline: 3px solid rgba(var(--brand-cta-rgb), 0.24);
    outline-offset: 7px;
  }

  .whitening-detail i {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--whitening-cta);
  }

  .whitening-detail i::before,
  .whitening-detail i::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 15px;
    height: 2px;
    background: var(--surface-white);
    transform: translate(-50%, -50%);
  }

  .whitening-detail i::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: opacity 140ms ease;
  }

  .whitening-detail[open] i::after {
    opacity: 0;
  }

  .whitening-detail-content {
    max-width: 1040px;
    padding: 0 0 clamp(36px, 5vw, 70px);
  }

  .whitening-detail-content > p {
    margin: 0;
    color: var(--text-dark);
    font-size: clamp(18px, 1.55vw, 24px);
    font-weight: 400;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 1.48;
  }

  .whitening-detail-content > p + p {
    margin-top: 18px;
  }

  .whitening-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .whitening-faq-grid article {
    padding: 26px;
    background: var(--soft-blue-bg);
  }

  .whitening-faq-grid h3 {
    margin: 0 0 12px;
    color: var(--whitening-dark);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 1.25;
  }

  .whitening-faq-grid p {
    margin: 0;
    color: var(--text-dark);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  .whitening-pathway {
    padding: clamp(72px, 8vw, 120px) 0;
    background: var(--soft-blue-bg);
  }

  .whitening-section-heading {
    max-width: 1050px;
  }

  .whitening-section-heading h2 {
    max-width: 15ch;
    margin: 0;
    color: var(--whitening-dark);
    font-size: clamp(42px, 5.2vw, 78px);
    font-weight: 400;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 1;
    text-transform: uppercase;
  }

  .whitening-section-heading > p:last-child {
    max-width: 850px;
    margin: 28px 0 0;
    color: var(--muted-text);
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 400;
    line-height: 1.45;
  }

  .whitening-pathway-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: clamp(44px, 6vw, 78px);
  }

  .whitening-pathway-grid article {
    min-height: 310px;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 3vw, 40px);
    background: var(--surface-white);
  }

  .whitening-pathway-grid h3 {
    max-width: 11ch;
    margin: auto 0 14px;
    color: var(--whitening-dark);
    font-size: clamp(26px, 2.2vw, 34px);
    font-weight: 500;
    letter-spacing: var(--whitening-letter-spacing);
    line-height: 1.12;
  }

  .whitening-pathway-grid p {
    max-width: 34ch;
    margin: 0;
    color: var(--muted-text);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
  }

  .whitening-pathway-action {
    display: none;
  }

  @media (max-width: 980px) {
    .whitening-hero-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .whitening-hero-copy {
      max-width: 820px;
    }

    .whitening-form {
      width: min(100%, 660px);
    }

    .whitening-pathway-grid {
      grid-template-columns: 1fr;
    }

    .whitening-pathway-grid article {
      min-height: 240px;
    }
  }

  @media (max-width: 720px) {
    .whitening-page,
    .whitening-page * {
      font-family: Inter, sans-serif !important;
    }

    .whitening-page {
      --whitening-letter-spacing: -0.16px;
      letter-spacing: var(--whitening-letter-spacing);
      word-spacing: 0;
    }

    .whitening-wrap {
      width: min(100% - 30px, 1540px);
    }

    .whitening-hero {
      min-height: auto;
    }

    .whitening-hero-grid {
      gap: 40px;
      padding: 158px 0 58px;
    }

    .whitening-kicker,
    .whitening-form-eyebrow {
      font-size: 14px;
      font-weight: 500;
      letter-spacing: var(--whitening-letter-spacing);
      line-height: 14px;
    }

    .whitening-kicker {
      margin-bottom: 14px;
    }

    .whitening-form-eyebrow {
      margin-bottom: 10px;
    }

    .whitening-hero h1 {
      max-width: none;
      font-size: 35.1px;
      font-weight: 400;
      letter-spacing: var(--whitening-letter-spacing);
      line-height: 35.1px;
      overflow-wrap: anywhere;
    }

    .whitening-lead {
      margin-top: 24px;
      font-size: 20px;
      line-height: 1.25;
    }

    .whitening-trust-list {
      display: grid;
      gap: 8px;
      margin-top: 24px;
    }

    .whitening-form {
      padding: 24px 20px;
      border-radius: 8px;
    }

    .whitening-form h2 {
      margin-bottom: 24px;
      font-size: 28px;
      line-height: 32px;
    }

    .whitening-form select,
    .whitening-form button {
      min-height: 58px;
    }

    .whitening-information {
      padding: 58px 0;
    }

    .whitening-detail summary {
      grid-template-columns: minmax(0, 1fr) 32px;
      gap: 16px;
      padding: 24px 0;
      font-size: 28px;
      line-height: 30px;
    }

    .whitening-detail i {
      width: 30px;
      height: 30px;
    }

    .whitening-detail-content {
      padding-bottom: 36px;
    }

    .whitening-detail-content > p {
      font-size: 17px;
      line-height: 25px;
    }

    .whitening-faq-grid {
      grid-template-columns: 1fr;
    }

    .whitening-faq-grid article {
      padding: 22px 20px;
    }

    .whitening-faq-grid h3 {
      font-size: 20px;
      line-height: 25px;
    }

    .whitening-faq-grid p {
      font-size: 16px;
      line-height: 24px;
    }

    .whitening-pathway {
      padding: 58px 0;
    }

    .whitening-section-heading h2 {
      font-size: 30px;
      line-height: 30px;
    }

    .whitening-section-heading > p:last-child {
      margin-top: 20px;
      font-size: 17px;
      line-height: 25px;
    }

    .whitening-pathway-grid {
      gap: 12px;
      margin-top: 36px;
    }

    .whitening-pathway-grid article {
      min-height: 250px;
      padding: 24px;
    }

    .whitening-pathway-grid h3 {
      margin-bottom: 12px;
      font-size: 28px;
      line-height: 28px;
    }

    .whitening-pathway-grid p {
      font-size: 14px;
      line-height: 18px;
    }

    .whitening-pathway-action {
      display: block;
      margin-top: 32px;
    }

    .whitening-pathway-action a {
      width: 100%;
      min-height: 56px;
      display: inline-flex;
