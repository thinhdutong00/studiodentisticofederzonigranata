---
import OrthodonticArchDiagram from './OrthodonticArchDiagram.astro';

interface Props { variant: 'bleeding' | 'recession' | 'mobility' | 'breath'; }
const { variant } = Astro.props;
// Keep the shared arch's crowns, perspective and linework for the dental signs.
// The breath choice uses an anatomical profile in the same monochrome line style.
const centralIncisor = 'M105 97C104 78 110 51 122 51C135 51 141 76 141 98Q141 106 132 106L114 106Q105 106 105 97Z';
const exposedIncisor = 'M105 97C103 78 104 53 109 37C113 25 130 25 135 38C140 52 143 79 141 98Q141 106 132 106H114Q105 106 105 97Z';
const modifiesIncisor = variant === 'recession' || variant === 'mobility';
const maskId = `periodontal-quiz-${variant}-tooth`;
const rootShadeId = 'periodontal-quiz-recession-root-shade';
const gumShadeId = 'periodontal-quiz-recession-gum-shade';
---

<svg class="periodontal-symptom-diagram" viewBox="0 0 280 180" width="280" height="180" fill="none" aria-hidden="true" focusable="false">
  {variant === 'breath' ? <g stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <!-- Lower-face profile with labial contours, jaw and a discreet cheek shadow. -->
    <path d="M119 20C123 35 127 47 140 57L162 70C168 75 165 79 157 79L144 80C140 84 142 88 146 91L151 94Q154 97 148 99" />
    <path d="M150 104Q154 108 148 112L141 116C147 125 149 137 139 143C131 148 120 149 109 150L103 164" />
    <path d="M48 109C61 132 82 146 109 150" />
    <path d="M93 62C112 66 122 77 123 89C119 99 115 106 117 116C112 115 109 107 112 98C116 85 108 73 93 62Z" fill="#000" fill-opacity=".07" stroke="none" />
    <path d="M130 101Q139 98 148 99L150 104Q140 103 130 101Z" fill="#000" fill-opacity=".13" stroke-width="1.6" />
    <path d="M145 70Q149 68 153 71M135 122Q140 124 140 130" stroke-width="1.6" />
    <!-- Discrete exhalation lines, rather than a cartoon cloud. -->
    <path d="M176 83C190 83 195 72 210 72S232 78 247 73M182 98C201 98 216 91 233 95L254 100M175 113C191 112 198 124 214 124S237 119 247 126" />
  </g> : <>
    {modifiesIncisor && <defs>
      <mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="0" width="280" height="180">
        <rect width="280" height="180" fill="white" />
        <path d={centralIncisor} fill="black" stroke="black" stroke-width="5" />
      </mask>
      {variant === 'recession' && <>
        <linearGradient id={rootShadeId} x1="108" y1="36" x2="136" y2="66" gradientUnits="userSpaceOnUse">
          <stop stop-color="#72818B" stop-opacity=".55" />
          <stop offset=".42" stop-color="#BBC5CC" stop-opacity=".36" />
          <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
        </linearGradient>
        <linearGradient id={gumShadeId} x1="122" y1="22" x2="122" y2="45" gradientUnits="userSpaceOnUse">
          <stop stop-color="#71808B" stop-opacity="0" />
          <stop offset="1" stop-color="#71808B" stop-opacity=".38" />
        </linearGradient>
      </>}
    </defs>}

    <g mask={modifiesIncisor ? `url(#${maskId})` : undefined}>
      <OrthodonticArchDiagram variant="other" kind="alignment" />
    </g>

    <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      {variant === 'bleeding' && <g fill="var(--brand-blue)" stroke="none">
        <!-- Uneven, localised cervical staining; no continuous scallops or drops. -->
        <path d="M80 57C82 54 81 51 85 51C87 51 87 47 91 48C95 45 97 49 99 49C102 48 103 53 106 54C107 56 106 59 109 61C105 64 104 58 101 59C99 62 97 57 95 58C91 60 92 54 88 55C86 59 84 55 80 57Z" />
        <path d="M133 57C136 54 137 58 140 54C143 51 145 56 148 55C152 54 151 60 155 59C158 57 158 63 161 64C158 68 156 63 153 65C149 66 150 60 146 61C142 64 144 58 140 60C136 63 138 58 133 57Z" />
        <path d="M205 55C208 51 210 54 213 53C217 52 217 57 220 57C223 56 222 61 225 62C222 65 219 59 216 61C212 63 213 56 210 58C208 59 207 55 205 55Z" />
        <path d="M179 134C183 134 181 129 185 132C188 133 188 127 191 129C194 132 195 126 198 129C200 131 202 128 204 130C202 134 198 131 196 134C193 138 191 132 188 135C184 139 184 133 179 134Z" />
      </g>}
      {variant === 'recession' && <>
        <path d="M98 55C104 47 102 32 111 25C117 20 128 20 135 27C142 35 140 49 147 56L139 58C134 51 135 35 128 32Q120 28 113 35C108 43 110 52 105 58Z" fill={`url(#${gumShadeId})`} stroke="none" />
        <path d={exposedIncisor} fill="var(--surface-white)" />
        <path d={exposedIncisor} fill={`url(#${rootShadeId})`} stroke="none" />
        <path d="M108 61C115 55 130 55 138 61" stroke="#72818B" stroke-opacity=".48" stroke-width="1.3" />
        <path d="M74 55Q90 38 103 54C106 49 104 36 111 30Q122 21 133 31C140 39 136 50 143 55Q160 38 178 55Q192 41 207 54" stroke-width="2" />
      </>}
      {variant === 'mobility' && <>
        <path d={centralIncisor} transform="rotate(-8 123 104)" fill="var(--surface-white)" />
        <!-- Paired motion marks above and below the mobile incisor. -->
        <path d="M101 29Q114 22 127 28M106 37Q115 32 124 36M108 154Q121 161 134 155M112 163Q121 168 130 164" />
      </>}
    </g>
  </>}
</svg>
