---
interface Props {
  phase: 'observation' | 'care' | 'outcome';
}

const { phase } = Astro.props;
---

<span class="periodontal-journey-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    {phase === 'observation' && <>
      <path d="M2.25 12S5.5 5.5 12 5.5 21.75 12 21.75 12 18.5 18.5 12 18.5 2.25 12 2.25 12Z" />
      <circle cx="12" cy="12" r="3" />
    </>}
    {phase === 'care' && <>
      <path d="M8.5 4.5h-2a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-13a2 2 0 0 0-2-2h-2" />
      <rect x="8.5" y="2.5" width="7" height="4" rx="1" />
      <path d="M12 10v5m-2.5-2.5h5M9 18h6" />
    </>}
    {phase === 'outcome' && <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="m8.25 12 2.5 2.5 5-5" />
    </>}
  </svg>
</span>

<style>
  .periodontal-journey-icon {
    display: inline-grid;
    flex: 0 0 40px;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid color-mix(in srgb, var(--brand-cta) 20%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--brand-blue) 10%, transparent);
    color: var(--brand-cta);
  }

  svg { display: block; width: 25px; height: 25px; }

  @media (max-width: 720px) {
    .periodontal-journey-icon { flex-basis: 36px; width: 36px; height: 36px; }
    svg { width: 23px; height: 23px; }
  }
</style>
