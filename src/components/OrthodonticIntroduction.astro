---
import OrthodonticLinkArrow from './OrthodonticLinkArrow.astro';

const benefits = [
  {
    icon: 'function',
    title: 'Masticazione più equilibrata',
    text: 'Una corretta occlusione favorisce il modo in cui i denti si incontrano, rendendo la masticazione più funzionale e confortevole.',
  },
  {
    icon: 'hygiene',
    title: 'Igiene orale più semplice',
    text: 'Denti ben allineati sono generalmente più facili da pulire, favorendo una migliore igiene quotidiana e la salute delle gengive.',
  },
  {
    icon: 'protection',
    title: 'Minore usura dentale',
    text: 'Correggere determinate malocclusioni può ridurre i contatti anomali tra i denti e limitare alcune forme di usura irregolare.',
  },
];

const firstVisitSteps = [
  {
    icon: 'smile',
    title: 'Un sorriso senza tempo',
    text: 'Ci racconti cosa vorresti migliorare.',
  },
  {
    icon: 'scan',
    title: 'Verso il risultato che desideri',
    text: 'Valutiamo denti, morso e salute della bocca.',
  },
  {
    icon: 'route',
    title: 'Allineiamo il tuo percorso unico',
    text: 'Ti spieghiamo le soluzioni indicate per il tuo caso.',
  },
];

const steps = [
  {
    title: 'Partiamo dal tuo sorriso',
    text: 'Durante la visita ortodontica valutiamo la posizione dei denti, il modo in cui combaciano e ciò che desideri migliorare.',
  },
  {
    title: 'Individuiamo il percorso più adatto',
    text: 'Sulla base della valutazione clinica, definiamo le possibilità di trattamento e ti illustriamo le soluzioni indicate per le tue esigenze.',
  },
  {
    title: 'Ti accompagniamo nel cambiamento',
    text: "Attraverso controlli periodici seguiamo l'evoluzione del trattamento, con attenzione alla salute orale e agli obiettivi concordati.",
  },
];
---

<section class="ortho-section ortho-functional-benefits" id="benefici-ortodontici" aria-labelledby="ortho-functional-title">
  <div class="ortho-shell">
    <div class="ortho-section-heading ortho-intro-heading">
      <div>
        <p class="ortho-eyebrow"><span class="ortho-benefits-desktop">Salute e funzionalità</span><span class="ortho-first-visit-mobile">La tua prima visita</span></p>
        <h2 id="ortho-functional-title"><span class="ortho-benefits-desktop">Un sorriso più armonioso, un equilibrio che va oltre l'estetica.</span><span class="ortho-first-visit-mobile"><strong>Denti più allineati?</strong> Scopri da dove iniziare.</span></h2>
      </div>
      <p class="ortho-intro-lead"><span class="ortho-benefits-desktop">Un corretto allineamento dei denti può contribuire a migliorare la funzionalità della bocca e a favorire la salute orale nel tempo.</span><span class="ortho-first-visit-mobile">Denti accavallati o spazi che vorresti correggere? Parliamo del sorriso che desideri.</span></p>
    </div>

    <div class="ortho-functional-grid ortho-benefits-desktop">
      {benefits.map((benefit) => (
        <article class="ortho-functional-item">
          <svg class="ortho-benefit-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            {benefit.icon === 'function' && (
              <>
                <path d="M13 10.5c0 8.5 2.3 14.2 6.8 17.2 2.8 1.8 6.1 1.8 8.9.3 3.9-2.1 6.3-6.2 6.3-11.5" />
                <path d="M16.5 17.5c4.8 1.7 9.8 1.7 15 0M18.5 22c3.7 1.3 7.3 1.3 11 0M28.7 28c1.8 2.3 2.3 5.3 1.3 9M19.8 27.7c-1.4 2.5-1.6 5.5-.3 9.1" />
                <circle cx="36.5" cy="11.5" r="3.5" />
              </>
            )}
            {benefit.icon === 'hygiene' && (
              <>
                <path d="M16.2 12.5c2.7 0 4.8 1.8 7.8 1.8s5.1-1.8 7.8-1.8c5 0 8.2 4.2 7.4 9.5-.8 5.7-3.2 14.3-7 14.3-3.1 0-3.4-6.4-8.2-6.4s-5.1 6.4-8.2 6.4c-3.8 0-6.2-8.6-7-14.3-.8-5.3 2.4-9.5 7.4-9.5Z" />
                <path d="M24 6v4M22 8h4M36.5 7.5v5M34 10h5M8.5 30v4M6.5 32h4" />
              </>
            )}
            {benefit.icon === 'protection' && (
              <>
                <path d="M24 6.4 38 12v10.4c0 8.6-5.6 15.4-14 19.2-8.4-3.8-14-10.6-14-19.2V12L24 6.4Z" />
                <path d="m17.2 24.2 4.2 4.2 9.6-10" />
              </>
            )}
          </svg>
          <div class="ortho-functional-copy">
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </div>
        </article>
      ))}
    </div>
    <ol class="ortho-first-visit-list" aria-label="Cosa aspettarti dalla prima visita" role="list">
      {firstVisitSteps.map((step) => (
        <li class="ortho-first-visit-step">
          <span class="ortho-first-visit-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              {step.icon === 'smile' && (
                <>
                  <path d="M5 16c10 4 28 4 38 0-2 12-9 20-19 20S7 28 5 16Z" />
                  <path d="M7 23c9 3 25 3 34 0" />
                </>
              )}
              {step.icon === 'scan' && (
                <>
                  <path d="M6 15V7h8m20 0h8v8m0 18v8h-8m-20 0H6v-8" />
                  <path d="M18 13c2 0 4 1.5 6 1.5s4-1.5 6-1.5c4.5 0 6.5 3.5 5.5 7.5C34.3 26.5 32.8 35 30 35c-2.3 0-2.4-6-6-6s-3.7 6-6 6c-2.8 0-4.3-8.5-5.5-14.5C11.5 16.5 13.5 13 18 13Z" />
                  <path d="M9 24h30" stroke-dasharray="3 3" />
                </>
              )}
              {step.icon === 'route' && (
                <>
                  <circle cx="11" cy="12" r="4" />
                  <path d="M15 12h15a7 7 0 0 1 0 14H18a5 5 0 0 0 0 10h15" />
                  <circle cx="37" cy="36" r="4" />
                </>
              )}
            </svg>
          </span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <a class="ortho-cta ortho-benefits-cta" href="#ortho-final">Prenota la tua prima visita <OrthodonticLinkArrow /></a>
  </div>
</section>

<slot name="after-benefits" />

<section class="ortho-section ortho-personalized-path" id="percorso-ortodontico" aria-labelledby="ortho-personalized-title">
  <div class="ortho-shell">
    <div class="ortho-section-heading ortho-intro-heading">
      <div>
        <p class="ortho-eyebrow">Un percorso su misura</p>
        <h2 id="ortho-personalized-title">Ogni sorriso è unico. Anche il percorso per valorizzarlo.</h2>
      </div>
      <p class="ortho-intro-lead">
        <span class="ortho-personalized-copy-desktop">Non esiste un trattamento ortodontico uguale per tutti. Ogni percorso parte dall'ascolto delle tue esigenze e da un'attenta valutazione della salute e dell'allineamento dei denti, per individuare la soluzione più adatta al tuo sorriso.</span>
        <span class="ortho-personalized-copy-mobile">Durante la prima visita definiamo da dove partire e quali soluzioni possono avvicinarti al sorriso che desideri.</span>
      </p>
    </div>

    <ol class="ortho-personalized-steps" role="list">
      {steps.map((step, index) => (
        <li class="ortho-personalized-step">
          <span class="ortho-personalized-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <a class="ortho-cta ortho-personalized-cta" href="#il-tuo-obiettivo" data-quiz-cta>Prenota una visita ortodontica <OrthodonticLinkArrow /></a>
  </div>
</section>

<style>
  .ortho-functional-benefits {
    padding-block: clamp(48px, 4.5vw, 72px);
    background: var(--surface-white);
  }

  .ortho-benefits-cta {
    display: none;
  }

  .ortho-first-visit-mobile,
  .ortho-first-visit-list,
  .ortho-personalized-copy-mobile {
    display: none;
  }

  .ortho-personalized-path {
    background: var(--soft-blue-bg);
  }

  .ortho-intro-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  .ortho-intro-heading h2 {
    max-width: 32ch;
    text-wrap: balance;
  }

  .ortho-intro-heading > .ortho-intro-lead {
    max-width: 72ch;
    margin: 0;
    color: var(--muted-text);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.5;
  }

  .ortho-functional-grid,
  .ortho-personalized-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 48px);
    margin: 40px 0 0;
    padding: 0;
  }

  .ortho-functional-item,
  .ortho-personalized-step {
    min-width: 0;
  }

  .ortho-benefit-icon {
    display: block;
    width: 44px;
    height: 44px;
    color: var(--brand-cta);
  }

  .ortho-functional-copy {
    margin-top: 16px;
  }

  .ortho-functional-item h3,
  .ortho-personalized-step h3 {
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.2px;
  }

  .ortho-functional-item p,
  .ortho-personalized-step p {
    max-width: 44ch;
    margin: 10px 0 0;
    color: var(--muted-text);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  .ortho-personalized-steps {
    list-style: none;
  }

  .ortho-personalized-number {
    display: block;
    margin-bottom: 18px;
    color: var(--brand-cta);
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.2px;
  }

  .ortho-personalized-cta {
    margin-top: 32px;
    font-size: 16px;
    line-height: 16px;
  }

  @media (max-width: 1000px) {
    .ortho-intro-heading {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .ortho-intro-heading h2 {
      max-width: 32ch;
    }

    .ortho-intro-heading > .ortho-intro-lead {
      max-width: 64ch;
    }
  }

  @media (max-width: 720px) {
    .ortho-benefits-desktop { display: none; }
    .ortho-first-visit-mobile { display: inline; }
    .ortho-personalized-copy-desktop { display: none; }
    .ortho-personalized-copy-mobile { display: inline; }

    .ortho-personalized-path {
      display: block;
      background: var(--surface-white);
      text-align: center;
    }

    .ortho-personalized-path .ortho-intro-heading h2,
    .ortho-personalized-path .ortho-intro-lead,
    .ortho-personalized-step p {
      margin-inline: auto;
    }

    .ortho-personalized-path :global(.ortho-professional) {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 16px;
      margin-top: 32px;
      padding: 28px 0;
      border-block: 1px solid var(--border);
      text-align: center;
    }

    .ortho-personalized-path :global(.ortho-professional > img) {
      width: 88px;
      height: 106px;
      border-radius: 8px;
    }

    .ortho-personalized-path :global(.ortho-professional h3) {
      margin: 0;
      font-size: 20px;
      font-weight: 500;
    }

    .ortho-personalized-path :global(.ortho-professional p) {
      max-width: 35ch;
      margin: 12px auto 0;
      font-size: 15px;
    }

    .ortho-personalized-path :global(.ortho-professional .ortho-text-link) {
      justify-content: center;
      max-width: 100%;
      margin-top: 14px;
      font-size: 13px;
    }

    .ortho-functional-benefits {
      background: var(--brand-primary-dark);
      text-align: center;
    }

    .ortho-functional-benefits h2 strong { font-weight: 700; }

    .ortho-first-visit-list {
      display: grid;
      gap: 12px;
      margin: 28px 0 0;
      padding: 0;
      list-style: none;
    }

    .ortho-first-visit-step {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      align-items: center;
      gap: 14px;
      padding: 20px;
      border: 1px solid rgba(217, 231, 242, .18);
      border-radius: 14px;
      background: rgba(255, 255, 255, .04);
      text-align: center;
    }

    .ortho-first-visit-icon {
      display: grid;
      place-items: center;
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: rgba(var(--brand-blue-rgb), .12);
      color: var(--brand-blue);
    }

    .ortho-first-visit-icon svg { width: 40px; height: 40px; }

    .ortho-first-visit-step h3 {
      margin: 0;
      color: var(--surface-white);
      font-size: 21px;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -.16px;
    }

    .ortho-first-visit-step p {
      margin: 6px 0 0;
      color: var(--soft-blue-bg);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: -.16px;
    }

    .ortho-functional-benefits .ortho-eyebrow,
    .ortho-functional-benefits .ortho-benefit-icon {
      color: var(--brand-blue);
    }

    .ortho-functional-benefits h2,
    .ortho-functional-item h3 {
      color: var(--surface-white);
    }

    .ortho-functional-benefits .ortho-intro-heading > .ortho-intro-lead,
    .ortho-functional-item p {
      color: var(--soft-blue-bg);
    }

    .ortho-functional-benefits .ortho-intro-heading h2,
    .ortho-functional-benefits .ortho-intro-heading > .ortho-intro-lead,
    .ortho-functional-item p {
      margin-inline: auto;
    }

    .ortho-intro-heading {
      gap: 20px;
    }

    .ortho-intro-heading > .ortho-intro-lead {
      font-size: 16px;
    }

    .ortho-functional-grid,
    .ortho-personalized-steps {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 28px;
    }

    .ortho-functional-item,
    .ortho-personalized-step {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      align-items: start;
      gap: 16px;
    }

    .ortho-benefit-icon {
      width: 96px;
      height: 96px;
    }

    .ortho-functional-item {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .ortho-functional-copy {
      margin-top: 0;
    }

    .ortho-functional-benefits .ortho-benefits-cta {
      display: flex;
      width: 100%;
      max-width: 360px;
      min-height: 66px;
      justify-content: center;
      gap: 14px;
      margin: 40px auto 12px;
      padding: 22px 20px;
      border-color: var(--surface-white);
      border-radius: 10px;
      background: var(--surface-white);
      color: var(--brand-cta);
      line-height: 16px;
    }

    .ortho-functional-benefits .ortho-benefits-cta:is(:hover, :focus-visible) {
      border-color: var(--soft-blue-bg);
      background: var(--soft-blue-bg);
      color: var(--brand-cta-hover);
    }

    .ortho-functional-item h3,
    .ortho-personalized-step h3 {
      letter-spacing: -.16px;
    }

    .ortho-personalized-number {
      margin: 0;
      font-size: 56px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -.16px;
    }

    .ortho-personalized-steps {
      gap: 36px;
      margin-top: 32px;
    }

    .ortho-personalized-step {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 14px;
    }

    .ortho-personalized-cta {
      width: 100%;
      justify-content: center;
      gap: 14px;
      margin-top: 28px;
      font-size: 16px;
      line-height: 16px;
      text-align: center;
    }
  }
</style>
