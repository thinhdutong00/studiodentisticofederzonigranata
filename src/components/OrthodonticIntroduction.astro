---
import OrthodonticLinkArrow from './OrthodonticLinkArrow.astro';

const benefits = [
  {
    icon: 'function',
    title: 'Masticazione più equilibrata',
    text: 'Una corretta occlusione favorisce il modo in cui i denti si incontrano, rendendo la masticazione più funzionale e confortevole.',
  },
  {
    icon: 'hygiene',
    title: 'Igiene orale più semplice',
    text: 'Denti ben allineati sono generalmente più facili da pulire, favorendo una migliore igiene quotidiana e la salute delle gengive.',
  },
  {
    icon: 'protection',
    title: 'Minore usura dentale',
    text: 'Correggere determinate malocclusioni può ridurre i contatti anomali tra i denti e limitare alcune forme di usura irregolare.',
  },
];

const firstVisitSteps = [
  {
    icon: 'checkup',
    title: 'Check-up ortodontico',
    text: "Denti storti, affollati o troppo distanziati? Analizziamo l'allineamento dei denti, il morso e la salute orale per individuare il percorso più adatto.",
  },
  {
    icon: 'plan',
    title: 'Piano di trattamento personalizzato',
    text: 'Valutiamo le soluzioni ortodontiche più indicate per te e definiamo obiettivi e tempi indicativi del percorso.',
  },
  {
    icon: 'alignment',
    title: 'Allineamento e monitoraggio',
    text: 'Iniziamo il trattamento e monitoriamo progressivamente gli spostamenti dentali attraverso controlli periodici.',
  },
  {
    icon: 'retention',
    title: 'Risultato e mantenimento',
    text: 'Al termine del trattamento, definiamo la fase di contenzione per aiutarti a mantenere il nuovo allineamento nel tempo.',
  },
];

const steps = [
  {
    title: 'Partiamo dal tuo sorriso',
    text: 'Durante la visita ortodontica valutiamo la posizione dei denti, il modo in cui combaciano e ciò che desideri migliorare.',
  },
  {
    title: 'Individuiamo il percorso più adatto',
    text: 'Sulla base della valutazione clinica, definiamo le possibilità di trattamento e ti illustriamo le soluzioni indicate per le tue esigenze.',
  },
  {
    title: 'Ti accompagniamo nel cambiamento',
    text: "Attraverso controlli periodici seguiamo l'evoluzione del trattamento, con attenzione alla salute orale e agli obiettivi concordati.",
  },
];
---

<slot name="before-first-visit" />

<section class="ortho-section ortho-functional-benefits" id="benefici-ortodontici" aria-labelledby="ortho-functional-title">
  <div class="ortho-shell">
    <div class="ortho-section-heading ortho-intro-heading">
      <div>
        <p class="ortho-eyebrow"><span class="ortho-benefits-desktop">Salute e funzionalità</span><span class="ortho-first-visit-mobile">La tua prima visita</span></p>
        <h2 id="ortho-functional-title"><span class="ortho-benefits-desktop">Un sorriso più armonioso, un equilibrio che va oltre l'estetica.</span><span class="ortho-first-visit-mobile"><strong>Denti più allineati?</strong> Scopri il nostro percorso</span></h2>
      </div>
      <p class="ortho-intro-lead"><span class="ortho-benefits-desktop">Un corretto allineamento dei denti può contribuire a migliorare la funzionalità della bocca e a favorire la salute orale nel tempo.</span><span class="ortho-first-visit-mobile">Hai notato che i tuoi denti si sono spostati nel tempo? Vorresti sorridere sentendoti più a tuo agio? Durante la prima visita ascoltiamo cosa desideri migliorare e costruiamo insieme il percorso più adatto.</span></p>
    </div>

    <div class="ortho-functional-grid ortho-benefits-desktop">
      {benefits.map((benefit) => (
        <article class="ortho-functional-item">
          <svg class="ortho-benefit-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            {benefit.icon === 'function' && (
              <>
                <path d="M13 10.5c0 8.5 2.3 14.2 6.8 17.2 2.8 1.8 6.1 1.8 8.9.3 3.9-2.1 6.3-6.2 6.3-11.5" />
                <path d="M16.5 17.5c4.8 1.7 9.8 1.7 15 0M18.5 22c3.7 1.3 7.3 1.3 11 0M28.7 28c1.8 2.3 2.3 5.3 1.3 9M19.8 27.7c-1.4 2.5-1.6 5.5-.3 9.1" />
                <circle cx="36.5" cy="11.5" r="3.5" />
              </>
            )}
            {benefit.icon === 'hygiene' && (
              <>
                <path d="M16.2 12.5c2.7 0 4.8 1.8 7.8 1.8s5.1-1.8 7.8-1.8c5 0 8.2 4.2 7.4 9.5-.8 5.7-3.2 14.3-7 14.3-3.1 0-3.4-6.4-8.2-6.4s-5.1 6.4-8.2 6.4c-3.8 0-6.2-8.6-7-14.3-.8-5.3 2.4-9.5 7.4-9.5Z" />
                <path d="M24 6v4M22 8h4M36.5 7.5v5M34 10h5M8.5 30v4M6.5 32h4" />
              </>
            )}
            {benefit.icon === 'protection' && (
              <>
                <path d="M24 6.4 38 12v10.4c0 8.6-5.6 15.4-14 19.2-8.4-3.8-14-10.6-14-19.2V12L24 6.4Z" />
                <path d="m17.2 24.2 4.2 4.2 9.6-10" />
              </>
            )}
          </svg>
          <div class="ortho-functional-copy">
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </div>
        </article>
      ))}
    </div>
    <ol class="ortho-first-visit-list ortho-first-visit-list--four" aria-label="Le fasi del tuo percorso ortodontico" role="list">
      {firstVisitSteps.map((step) => (
        <li class="ortho-first-visit-step">
          <span class="ortho-first-visit-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              {step.icon === 'checkup' && (
                <>
                  <path d="M14 5H9a4 4 0 0 0-4 4v5m29-9h5a4 4 0 0 1 4 4v5m0 20v5a4 4 0 0 1-4 4h-5m-20 0H9a4 4 0 0 1-4-4v-5" />
                  <path d="M19 13c-3-2-8-1-8 4 0 5 3 9 4 14 1 3 3 3 4 0l2-6c1-2 5-2 6 0l2 6c1 3 3 3 4 0 1-5 4-9 4-14 0-5-5-6-8-4-3 2-7 2-10 0Z" />
                </>
              )}
              {step.icon === 'plan' && (
                <>
                  <path d="M17 9h-4a3 3 0 0 0-3 3v28a3 3 0 0 0 3 3h22a3 3 0 0 0 3-3V12a3 3 0 0 0-3-3h-4" />
                  <rect x="17" y="5" width="14" height="8" rx="2" />
                  <path d="M17 21h14m-14 7h7m0 8 4 4 7-8" />
                </>
              )}
              {step.icon === 'alignment' && (
                <>
                  <path d="M5 15c-.5-4.5 1.5-7 5-7s5.5 2.5 5 7l-.8 8c-.2 2-7.2 2-7.4 0L5 15Z" />
                  <path d="M18 13c-.4-4.7 1.5-7 5-7s5.4 2.3 5 7l-.6 10c-.1 2-8.7 2-8.8 0L18 13Z" />
                  <path d="M31 15c-.5-4.5 1.5-7 5-7s5.5 2.5 5 7l-1.8 8c-.2 2-7.2 2-7.4 0L31 15Z" />
                  <path d="M7 31c4.8 2.2 10.2 2.7 15.5 1.3" />
                  <circle cx="34" cy="34" r="6.5" />
                  <path d="m38.6 38.6 5.4 5.4" />
                </>
              )}
              {step.icon === 'retention' && (
                <>
                  <path d="M25 9c-3 0-5 2-8 2S12 9 9 9C3 9 4 19 7 25c2 5 1 15 5 15s3-9 6-12" />
                  <path d="M24 12c2-2 4-3 7-3 5 0 7 4 7 8M22 20h19v12c0 7-9.5 11-9.5 11S22 39 22 32V20Z" />
                  <path d="M31.5 25v11M26 30.5h11" />
                </>
              )}
            </svg>
          </span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <a class="ortho-cta ortho-benefits-cta" href="#ortho-final">Prenota la tua prima visita <OrthodonticLinkArrow /></a>
  </div>
</section>

<section class="ortho-section ortho-personalized-path" id="percorso-ortodontico" aria-labelledby="ortho-personalized-title">
  <div class="ortho-shell ortho-professional-card">
    <div class="ortho-section-heading ortho-intro-heading">
      <div>
        <p class="ortho-professional-eyebrow">La professionista al tuo fianco</p>
        <h2 id="ortho-personalized-title"><slot name="personalized-title">Il tuo sorriso merita esperienza.</slot></h2>
      </div>
      <p class="ortho-intro-lead">
        <span class="ortho-personalized-copy-desktop">Non esiste un trattamento ortodontico uguale per tutti. Ogni percorso parte dall'ascolto delle tue esigenze e da un'attenta valutazione della salute e dell'allineamento dei denti, per individuare la soluzione più adatta al tuo sorriso.</span>
        <span class="ortho-personalized-copy-mobile">Durante la prima visita definiamo da dove partire e quali soluzioni possono avvicinarti al sorriso che desideri.</span>
      </p>
    </div>

    <slot name="professional" />
    <ol class="ortho-personalized-steps" role="list">
      {steps.map((step, index) => (
        <li class="ortho-personalized-step">
          <span class="ortho-personalized-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <a class="ortho-cta ortho-personalized-cta" href="#il-tuo-obiettivo" data-quiz-cta>Prenota una visita ortodontica <OrthodonticLinkArrow /></a>
  </div>
</section>

<script>
  const visitCards = document.querySelector<HTMLOListElement>('.ortho-landing-main #benefici-ortodontici .ortho-first-visit-list');
  if (visitCards) {
    const cards = Array.from(visitCards.querySelectorAll<HTMLElement>('.ortho-first-visit-step'));
    const mobile = window.matchMedia('(max-width: 720px)');
    let scheduled = false;
    let illuminatedThrough = -1;

    const updateActiveCard = () => {
      scheduled = false;
      visitCards.classList.add('is-scroll-tracked');
      let activeIndex = -1;
      let nearestDistance = Infinity;

      if (mobile.matches) {
        const readingLine = window.innerHeight * .5;
        cards.forEach((card, index) => {
          const bounds = card.getBoundingClientRect();
          if (bounds.bottom <= 0 || bounds.top >= window.innerHeight) return;
          const distance = Math.abs(bounds.top + bounds.height / 2 - readingLine);
          if (distance < nearestDistance) {
            nearestDistance = distance;
            activeIndex = index;
          }
        });
      } else {
        cards.forEach((card, index) => {
          if (card.getBoundingClientRect().top < window.innerHeight * .82) activeIndex = index;
        });
      }

      illuminatedThrough = Math.max(illuminatedThrough, activeIndex);
      cards.forEach((card, index) => card.classList.toggle('is-scroll-active', index <= illuminatedThrough));
    };

    const requestUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      window.requestAnimationFrame(updateActiveCard);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    window.addEventListener('pageshow', requestUpdate);
    mobile.addEventListener('change', requestUpdate);
    new ResizeObserver(requestUpdate).observe(visitCards);
    requestUpdate();
  }
</script>

<style>
  .ortho-functional-benefits {
    padding-block: clamp(48px, 4.5vw, 72px);
    background: var(--surface-white);
  }

  .ortho-benefits-cta {
    display: none;
  }

  .ortho-first-visit-mobile,
  .ortho-first-visit-list,
  .ortho-personalized-copy-mobile {
    display: none;
  }

  .ortho-personalized-path {
    background: var(--soft-blue-bg);
  }

  .ortho-professional-card {
    display: grid;
    gap: 24px;
    padding: clamp(22px, 3vw, 40px);
    border: 0;
    border-radius: 24px;
    background: var(--surface-white);
    text-align: left;
  }

  .ortho-professional-eyebrow {
    margin: 0 0 14px;
    color: var(--muted-text);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  #percorso-ortodontico #ortho-personalized-title {
    max-width: none;
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 700;
    line-height: 1.15;
    text-wrap: pretty;
  }

  .ortho-intro-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  .ortho-intro-heading h2 {
    max-width: 32ch;
    text-wrap: balance;
  }

  .ortho-intro-heading > .ortho-intro-lead {
    max-width: 72ch;
    margin: 0;
    color: var(--muted-text);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.5;
  }

  .ortho-functional-grid,
  .ortho-personalized-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 48px);
    margin: 40px 0 0;
    padding: 0;
  }

  .ortho-functional-item,
  .ortho-personalized-step {
    min-width: 0;
  }

  .ortho-benefit-icon {
    display: block;
    width: 44px;
    height: 44px;
    color: var(--brand-cta);
  }

  .ortho-functional-copy {
    margin-top: 16px;
  }

  .ortho-functional-item h3,
  .ortho-personalized-step h3 {
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.2px;
  }

  .ortho-functional-item p,
  .ortho-personalized-step p {
    max-width: 44ch;
    margin: 10px 0 0;
    color: var(--muted-text);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  .ortho-personalized-steps {
    list-style: none;
  }

  .ortho-personalized-number {
    display: block;
    margin-bottom: 18px;
    color: var(--brand-cta);
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.2px;
  }

  .ortho-personalized-cta {
    margin-top: 32px;
    font-size: 16px;
    line-height: 16px;
  }

  @media (max-width: 1000px) {
    .ortho-intro-heading {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .ortho-intro-heading h2 {
      max-width: 32ch;
    }

    .ortho-intro-heading > .ortho-intro-lead {
      max-width: 64ch;
    }
  }

  @media (max-width: 720px) {
    .ortho-benefits-desktop { display: none; }
    .ortho-first-visit-mobile { display: inline; }
    .ortho-personalized-copy-desktop { display: none; }
    .ortho-personalized-copy-mobile { display: inline; }

    .ortho-personalized-path {
      display: block;
      background: var(--surface-white);
      text-align: left;
    }

    .ortho-personalized-path .ortho-intro-heading h2,
    .ortho-personalized-path .ortho-intro-lead,
    .ortho-personalized-step p {
      margin-inline: 0;
    }

    .ortho-personalized-path :global(.ortho-professional) {
      grid-template-columns: 104px minmax(0, 1fr);
      align-items: center;
      gap: 18px;
      margin: 0;
      padding: 0;
      border: 0;
      text-align: left;
    }

    .ortho-personalized-path :global(.ortho-professional > div) { display: contents; }

    .ortho-personalized-path :global(.ortho-professional > img) {
      grid-column: 1;
      grid-row: 1;
      width: 104px;
      height: 136px;
      border-radius: 14px;
    }

    .ortho-personalized-path :global(.ortho-professional h3) {
      margin: 0;
      grid-column: 2;
      grid-row: 1;
      font-size: 20px;
      font-weight: 600;
      line-height: 1.25;
    }

    .ortho-personalized-path :global(.ortho-professional p) {
      grid-column: 1 / -1;
      max-width: none;
      margin: 0;
      color: var(--text-dark);
      font-size: 16px;
      line-height: 1.5;
    }

    .ortho-personalized-path :global(.ortho-professional .ortho-text-link) {
      grid-column: 1 / -1;
      justify-content: flex-start;
      justify-self: start;
      max-width: 100%;
      margin-top: 0;
      font-size: 14px;
      text-align: left;
    }

    .ortho-functional-benefits {
      background: var(--brand-primary-dark);
      text-align: center;
    }

    .ortho-functional-benefits h2 strong { font-weight: 700; }

    .ortho-first-visit-list {
      display: grid;
      gap: 12px;
      margin: 28px 0 0;
      padding: 0;
      list-style: none;
    }

    .ortho-first-visit-step {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      align-items: center;
      gap: 14px;
      padding: 20px;
      border: 1px solid rgba(217, 231, 242, .18);
      border-radius: 14px;
      background: rgba(255, 255, 255, .04);
      text-align: center;
    }

    .ortho-first-visit-list.is-scroll-tracked .ortho-first-visit-step {
      border-color: rgba(217, 231, 242, .08);
      background: var(--brand-primary-dark);
      transition: background-color 280ms ease, border-color 280ms ease;
    }

    .ortho-first-visit-list.is-scroll-tracked .ortho-first-visit-step.is-scroll-active {
      border-color: rgba(217, 231, 242, .18);
      background: rgba(255, 255, 255, .04);
    }

    .ortho-first-visit-icon {
      display: grid;
      place-items: center;
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: rgba(var(--brand-blue-rgb), .12);
      color: var(--brand-blue);
    }

    .ortho-first-visit-icon svg { width: 40px; height: 40px; }

    .ortho-first-visit-step h3 {
      margin: 0;
      color: var(--surface-white);
      font-size: 21px;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -.16px;
    }

    .ortho-first-visit-step p {
      margin: 6px 0 0;
      color: var(--soft-blue-bg);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: -.16px;
    }

    .ortho-functional-benefits .ortho-eyebrow,
    .ortho-functional-benefits .ortho-benefit-icon {
      color: var(--brand-blue);
    }

    .ortho-functional-benefits h2,
    .ortho-functional-item h3 {
      color: var(--surface-white);
    }

    .ortho-functional-benefits .ortho-intro-heading > .ortho-intro-lead,
    .ortho-functional-item p {
      color: var(--soft-blue-bg);
    }

    .ortho-functional-benefits .ortho-intro-heading h2,
    .ortho-functional-benefits .ortho-intro-heading > .ortho-intro-lead,
    .ortho-functional-item p {
      margin-inline: auto;
    }

    .ortho-intro-heading {
      gap: 20px;
    }

    .ortho-intro-heading > .ortho-intro-lead {
      font-size: 16px;
    }

    .ortho-functional-grid,
    .ortho-personalized-steps {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 28px;
    }

    .ortho-functional-item,
    .ortho-personalized-step {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      align-items: start;
      gap: 16px;
    }

    .ortho-benefit-icon {
      width: 96px;
      height: 96px;
    }

    .ortho-functional-item {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .ortho-functional-copy {
      margin-top: 0;
    }

    .ortho-functional-benefits .ortho-benefits-cta {
      display: flex;
      width: 100%;
      max-width: 360px;
      min-height: 66px;
      justify-content: center;
      gap: 14px;
      margin: 40px auto 12px;
      padding: 22px 20px;
      border-color: var(--surface-white);
      border-radius: 10px;
      background: var(--surface-white);
      color: var(--brand-cta);
      line-height: 16px;
    }

    .ortho-functional-benefits .ortho-benefits-cta:is(:hover, :focus-visible) {
      border-color: var(--soft-blue-bg);
      background: var(--soft-blue-bg);
      color: var(--brand-cta-hover);
    }

    .ortho-functional-item h3,
    .ortho-personalized-step h3 {
      letter-spacing: -.16px;
    }

    .ortho-personalized-number {
      margin: 0;
      font-size: 56px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -.16px;
    }

    .ortho-personalized-steps {
      gap: 36px;
      margin-top: 32px;
    }

    .ortho-personalized-step {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 14px;
    }

    .ortho-personalized-cta {
      width: 100%;
      justify-content: center;
      gap: 14px;
      margin-top: 0;
      font-size: 16px;
      line-height: 16px;
      text-align: center;
    }
  }

  @media (max-width: 720px) and (prefers-reduced-motion: reduce) {
    .ortho-first-visit-list.is-scroll-tracked .ortho-first-visit-step { transition: none; }
  }
</style>
