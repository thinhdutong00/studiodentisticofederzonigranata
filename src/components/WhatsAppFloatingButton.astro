---
const whatsappNumber = '393516737049';
const whatsappMessage = 'Ciao, ti contatto dal sito https://studiodentisticofederzonigranata.it/';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<div class="whatsapp-floating-widget" data-whatsapp-floating-widget aria-hidden="true">
  <div
    class="whatsapp-message-bubble"
    role="status"
    aria-live="polite"
    aria-hidden="true"
    data-whatsapp-message
  >
    Ciao, come possiamo aiutarti?
  </div>

  <a
    class="whatsapp-floating-button"
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Scrivici su WhatsApp"
  >
    <svg viewBox="120 100 810 810" aria-hidden="true" focusable="false">
      <path d="M783.302 243.246c-69.329-69.387-161.529-107.619-259.763-107.658-202.402 0-367.133 164.668-367.214 367.072-.026 64.699 16.883 127.854 49.017 183.522l-52.096 190.229 194.665-51.047c53.636 29.244 114.022 44.656 175.482 44.682h.151c202.382 0 367.128-164.688 367.21-367.094.039-98.087-38.121-190.319-107.452-259.706zM523.544 808.047h-.125c-54.767-.021-108.483-14.729-155.344-42.529l-11.146-6.612-115.517 30.293 30.834-112.592-7.259-11.544c-30.552-48.579-46.688-104.729-46.664-162.379.066-168.229 136.985-305.096 305.339-305.096 81.521.031 158.154 31.811 215.779 89.482s89.342 134.332 89.312 215.859c-.066 168.243-136.984 305.118-305.209 305.118zm167.415-228.515c-9.177-4.591-54.286-26.782-62.697-29.843-8.41-3.062-14.526-4.592-20.645 4.592-6.115 9.182-23.699 29.843-29.053 35.964-5.352 6.122-10.704 6.888-19.879 2.296-9.176-4.591-38.74-14.277-73.786-45.526-27.275-24.319-45.691-54.359-51.043-63.543-5.352-9.183-.569-14.146 4.024-18.72 4.127-4.109 9.175-10.713 13.763-16.069 4.587-5.355 6.117-9.183 9.175-15.304 3.059-6.122 1.529-11.479-.765-16.07-2.293-4.591-20.644-49.739-28.29-68.104-7.447-17.886-15.013-15.466-20.645-15.747-5.346-.266-11.469-.322-17.585-.322s-16.057 2.295-24.467 11.478-32.113 31.374-32.113 76.521c0 45.147 32.877 88.764 37.465 94.885 4.588 6.122 64.699 98.771 156.741 138.502 21.892 9.45 38.982 15.094 52.308 19.322 21.98 6.979 41.982 5.995 57.793 3.634 17.628-2.633 54.284-22.189 61.932-43.615 7.646-21.427 7.646-39.791 5.352-43.617-2.294-3.826-8.41-6.122-17.585-10.714z" />
    </svg>
    <span class="whatsapp-notification-badge" aria-hidden="true" data-whatsapp-badge>1</span>
  </a>
</div>

<script>
  const setupWhatsAppFloatingButton = () => {
    document.querySelectorAll('[data-whatsapp-floating-widget]').forEach((widget) => {
      if (!(widget instanceof HTMLElement) || widget.dataset.ready === 'true') return;
      widget.dataset.ready = 'true';

      const message = widget.querySelector('[data-whatsapp-message]');
      const badge = widget.querySelector('[data-whatsapp-badge]');
      const firstMessage = 'Ciao, come possiamo aiutarti?';
      const secondMessage = "Hai un dubbio o un'urgenza? Scrivicelo su whatsapp!";
      const widgetDelay = 5000;
      const firstMessageDelay = 8000;
      const secondMessageDelay = 18000;
      const finalMessageCloseDelay = 28000;

      const showMessage = (text, notificationCount) => {
        if (message) {
          message.textContent = text;
          message.removeAttribute('aria-hidden');
        }
        if (badge) {
          badge.textContent = String(notificationCount);
        }
        widget.classList.add('has-notification', 'is-message-visible');
      };

      const hideMessage = ({ hideNotification = false } = {}) => {
        widget.classList.remove('is-message-visible');
        message?.setAttribute('aria-hidden', 'true');
        if (hideNotification) {
          widget.classList.remove('has-notification');
        }
      };

      window.setTimeout(() => {
        widget.classList.add('is-visible');
        widget.removeAttribute('aria-hidden');
      }, widgetDelay);

      window.setTimeout(() => {
        showMessage(firstMessage, 1);
      }, firstMessageDelay);

      window.setTimeout(() => {
        showMessage(secondMessage, 2);
      }, secondMessageDelay);

      window.setTimeout(() => {
        hideMessage();
      }, finalMessageCloseDelay);

      const cookieBanner = document.querySelector('[data-cookie-banner]');
      if (!(cookieBanner instanceof HTMLElement)) return;

      const syncCookieOffset = () => {
        const cookieBannerIsVisible = cookieBanner.classList.contains('is-visible');
        const offset = cookieBannerIsVisible
          ? Math.ceil(cookieBanner.getBoundingClientRect().height) + 12
          : 0;

        widget.style.setProperty('--whatsapp-cookie-offset', `${offset}px`);
      };

      const cookieMutationObserver = new MutationObserver(syncCookieOffset);
      cookieMutationObserver.observe(cookieBanner, {
        attributes: true,
        attributeFilter: ['class'],
      });

      const cookieResizeObserver = new ResizeObserver(syncCookieOffset);
      cookieResizeObserver.observe(cookieBanner);

      window.addEventListener('resize', syncCookieOffset);
      syncCookieOffset();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWhatsAppFloatingButton, { once: true });
  } else {
    setupWhatsAppFloatingButton();
  }
</script>

<style>
  .whatsapp-floating-widget {
    position: fixed;
    right: calc(20px + env(safe-area-inset-right, 0px));
    bottom: calc(20px + env(safe-area-inset-bottom, 0px) + var(--whatsapp-cookie-offset, 0px));
    z-index: 75;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(16px) scale(0.82);
    transform-origin: right bottom;
    transition:
      opacity 320ms ease,
      visibility 320ms ease,
      bottom 220ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .whatsapp-floating-widget.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .whatsapp-floating-button {
    position: relative;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #25d366;
    color: var(--surface-white, #ffffff);
    line-height: 0;
    text-decoration: none;
    box-shadow: 0 7px 20px rgba(16, 40, 61, 0.26);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .whatsapp-floating-button svg {
    width: 42px;
    height: 42px;
    display: block;
    overflow: visible;
    fill: currentColor;
  }

  .whatsapp-floating-button:hover {
    background: #20bd5a;
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 10px 25px rgba(16, 40, 61, 0.32);
  }

  .whatsapp-floating-button:focus-visible {
    outline: 3px solid var(--brand-blue);
    outline-offset: 4px;
  }

  .whatsapp-message-bubble {
    position: absolute;
    right: calc(100% + 16px);
    bottom: 8px;
    width: max-content;
    max-width: min(280px, calc(100vw - 128px));
    box-sizing: border-box;
    padding: 16px 18px;
    border: 1px solid var(--border, #d9e7f2);
    border-radius: 16px 16px 4px 16px;
    background: var(--surface-white, #ffffff);
    box-shadow: 0 10px 30px rgba(16, 40, 61, 0.18);
    color: var(--brand-primary-dark, #10283d);
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.2px;
    line-height: 20px;
    word-spacing: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(14px) scale(0.92);
    transform-origin: right bottom;
    transition:
      opacity 260ms ease,
      visibility 260ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .whatsapp-message-bubble::after {
    content: "";
    position: absolute;
    right: -7px;
    bottom: 17px;
    width: 13px;
    height: 13px;
    border-top: 1px solid var(--border, #d9e7f2);
    border-right: 1px solid var(--border, #d9e7f2);
    background: var(--surface-white, #ffffff);
    transform: rotate(45deg);
  }

  .whatsapp-floating-widget.is-message-visible .whatsapp-message-bubble {
    opacity: 1;
    visibility: visible;
    transform: translateX(0) scale(1);
  }

  .whatsapp-notification-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 22px;
    height: 22px;
    display: grid;
    box-sizing: border-box;
    place-items: center;
    padding: 0 5px;
    border: 2px solid var(--surface-white, #ffffff);
    border-radius: 999px;
    background: var(--error, #c94a4a);
    color: var(--surface-white, #ffffff);
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: normal;
    line-height: 18px;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.4);
    transition:
      opacity 180ms ease,
      visibility 180ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .whatsapp-floating-widget.has-notification .whatsapp-notification-badge {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    animation: whatsapp-notification-pulse 1.6s ease-out 2;
  }

  :global(.site-header.site-menu-open) ~ .whatsapp-floating-widget {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px) scale(0.9);
  }

  @media (max-width: 620px) {
    .whatsapp-floating-widget {
      right: calc(16px + env(safe-area-inset-right, 0px));
      bottom: calc(16px + env(safe-area-inset-bottom, 0px) + var(--whatsapp-cookie-offset, 0px));
    }

    .whatsapp-floating-button {
      width: 58px;
      height: 58px;
    }

    .whatsapp-floating-button svg {
      width: 38px;
      height: 38px;
    }

    .whatsapp-message-bubble {
      right: calc(100% + 12px);
      bottom: 6px;
      max-width: calc(100vw - 112px);
      padding: 14px 16px;
      border-radius: 14px 14px 4px 14px;
      font-size: 14px;
      letter-spacing: -0.16px;
      line-height: 18px;
    }

    .whatsapp-message-bubble::after {
      bottom: 15px;
    }

    .whatsapp-notification-badge {
      top: -4px;
      right: -4px;
      min-width: 21px;
      height: 21px;
    }
  }

  @keyframes whatsapp-notification-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(201, 74, 74, 0);
    }

    35% {
      box-shadow: 0 0 0 7px rgba(201, 74, 74, 0.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-floating-widget,
    .whatsapp-floating-button,
    .whatsapp-message-bubble,
    .whatsapp-notification-badge {
      transition: none;
    }

    .whatsapp-floating-widget.has-notification .whatsapp-notification-badge {
      animation: none;
    }
  }
</style>
