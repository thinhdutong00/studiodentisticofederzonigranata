---
interface Props {
  variant: string;
  kind: 'alignment' | 'bite';
}

const { variant, kind } = Astro.props;
const crowded = kind === 'alignment' && variant === 'crowded';
const gapped = kind === 'alignment' && variant === 'gapped';
const open = variant === 'openbite';
const deep = variant === 'overbite';
const crossed = variant === 'crossbite';
const sideView = variant === 'underbite';

// Individual crown contours, drawn in a frontal arch rather than stretched icons.
// The posterior teeth sit behind the canines; the broad central incisors sit in front.
const upperLeft = [
  'M28 78C25 70 26 69 30 72L42 85L46 103Q41 111 37 107C32 99 29 88 28 78Z',
  'M37 66C34 56 38 54 43 59L59 77L62 99Q56 110 50 106C42 96 39 79 37 66Z',
  'M52 57C50 47 56 46 61 52L79 74L78 95Q72 105 66 102C58 92 54 71 52 57Z',
  'M77 92C76 75 81 49 91 49C101 49 107 72 106 94Q104 100 94 100L82 99Q77 99 77 92Z',
  'M105 97C104 78 110 51 122 51C135 51 141 76 141 98Q141 106 132 106L114 106Q105 106 105 97Z',
];
const lowerLeft = [
  'M35 111Q40 104 47 102L48 115L36 125Q31 127 35 111Z',
  'M46 111Q54 103 62 101L65 119L47 129Q43 132 46 111Z',
  'M61 110Q68 102 78 102L85 121C80 130 70 139 66 135Q60 130 61 110Z',
  'M80 108Q90 102 104 104L110 126C105 137 100 143 96 139Q85 129 80 108Z',
  'M102 106Q111 103 121 105C123 118 121 134 114 138C107 138 102 122 102 106Z',
  'M121 106Q131 104 141 106L141 127C139 139 133 142 128 136Q122 127 121 106Z',
];

const crowdedCentralLeft = 'M105 99C102 82 102 54 115 51C129 47 142 72 151 92Q156 101 146 104L120 112Q109 114 105 99Z';
const crowdedCentralRight = 'M142 97C138 79 147 50 159 50C173 50 181 74 180 98Q180 105 169 105L150 105Q144 105 142 97Z';
const crowdedLowerLeft = [
  ...lowerLeft.slice(0, 3),
  'M80 112Q85 103 101 104L108 126C106 139 98 146 93 140Q81 127 80 112Z',
  'M102 108Q111 101 123 105L130 128Q126 139 120 139C113 137 107 120 102 108Z',
  'M123 108Q132 103 141 105L145 126Q141 137 135 136Q125 132 123 108Z',
];
const openLowerLeft = [
  lowerLeft[0], lowerLeft[1],
  'M61 117Q65 107 76 106L85 117C85 129 72 144 67 143Q60 142 61 117Z',
  'M80 116Q91 109 103 112L109 128C106 145 100 152 95 148Q84 138 80 116Z',
  'M103 115Q113 112 123 115L125 136C122 151 116 154 111 147Q105 136 103 115Z',
  'M123 116Q132 114 141 116L142 137C139 152 133 156 128 148Q122 137 123 116Z',
];
const crossLowerLeft = [
  'M34 106Q40 97 49 97L47 115L35 125Q30 126 34 106Z',
  'M45 101Q53 93 65 94L65 117L47 129Q42 130 45 101Z',
  'M61 101Q70 92 82 94L88 113C83 129 72 141 66 137Q59 130 61 101Z',
  'M82 101Q93 96 106 99L109 119C106 135 100 142 95 138Q85 126 82 101Z',
  'M105 101Q114 98 124 100L125 122Q122 138 116 135Q108 130 105 101Z',
  'M124 102Q132 99 141 102L142 123Q138 138 132 135Q125 130 124 102Z',
];
const lower = open ? openLowerLeft : crowded ? crowdedLowerLeft : lowerLeft;

// A separate lateral drawing makes the forward position of the lower arch visible.
const sideUpper = [
  'M30 52C27 45 31 42 42 43C58 43 69 48 73 56L73 79Q67 86 57 82L40 78Q29 80 29 70Z',
  'M73 56C85 49 101 48 112 54Q119 63 117 84L114 91L74 83Z',
  'M115 57Q132 48 146 54Q154 64 152 86L148 94L117 90Z',
  'M150 56Q167 47 181 53Q191 63 186 88L180 100L151 93Z',
  'M184 57Q203 39 215 43C225 48 227 65 223 81L212 102L184 96Z',
  'M218 46Q235 28 243 39C249 51 250 68 246 84L231 103L216 97Z',
  'M244 38L259 31C265 44 268 64 264 81L249 101L239 93Z',
];
const sideLower = [
  'M72 83Q84 78 105 83L116 89L113 112Q108 119 93 117L78 114Q70 111 72 99Z',
  'M115 89Q135 82 152 89L157 98L152 121Q135 130 115 119Q109 115 115 89Z',
  'M155 92Q175 84 186 91L190 107C187 125 180 140 173 139L153 122Z',
  'M187 94Q203 85 219 90L222 102C220 121 214 137 207 135L185 123Z',
  'M219 91Q232 82 244 86L246 98C244 118 238 133 231 132L216 121Z',
  'M244 86Q255 78 267 81C267 98 261 116 254 122L242 117Z',
  'M267 81Q276 78 277 83C274 100 268 115 259 118L255 113Z',
];

const upperShift = (index: number, right: boolean) => {
  if (!gapped) return '';
  const offset = [0, 0, 1, 7, 4][index] * (right ? 1 : -1);
  return `translate(${offset} 0)`;
};
const lowerShift = (index: number, right: boolean) => {
  const x = gapped ? [0, 0, 0, 4, 3, 2][index] * (right ? 1 : -1) : 0;
  return `translate(${x} ${deep ? -13 : 0})`;
};
---

<svg class="orthodontic-arch-diagram" viewBox="0 0 280 180" width="280" height="180" fill="none" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    {sideView ? <>
      <path d="M25 48C22 58 22 68 24 76M258 14C262 26 264 38 264 49M273 112L260 133" />
      <g fill="var(--surface-white, #FFFFFF)">
        {sideUpper.map(d => <path d={d} />)}
        {sideLower.map(d => <path d={d} />)}
      </g>
    </> : <>
      <path d="M33 41C25 57 28 83 45 105M249 41C257 57 254 83 237 105M34 146C37 132 41 120 49 113M248 146C245 132 241 120 233 113" />
      <g fill="var(--surface-white, #FFFFFF)">
        {lower.map((d, index) => index > 0 && <>
          <path d={d} transform={lowerShift(index, false)} />
          <g transform={lowerShift(index, true)}><path d={d} transform="translate(282 0) scale(-1 1)" /></g>
        </>)}
        {upperLeft.map((d, index) => index > 0 && <>
          <path d={crowded && index === 4 ? crowdedCentralLeft : d} transform={upperShift(index, false)} />
          <g transform={upperShift(index, true)}>
            <path d={crowded && index === 4 ? crowdedCentralRight : d} transform={crowded && index === 4 ? undefined : 'translate(282 0) scale(-1 1)'} />
          </g>
        </>)}
        {crossed && crossLowerLeft.slice(1).map(d => <path d={d} />)}
      </g>
    </>}
  </g>
</svg>
