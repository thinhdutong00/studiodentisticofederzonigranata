---
import { site } from '../data/site';

const locationOffices = site.offices.map((office) => {
  const query = encodeURIComponent(office.address);
  const slug = office.city
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, '-');

  return {
    ...office,
    slug,
    mapEmbed: `https://www.google.com/maps?q=${query}&output=embed`,
    mapHref: `https://www.google.com/maps/search/?api=1&query=${query}`,
    hoursRows: office.hours.split(';').map((row) => {
      const [label, ...value] = row.split(':');

      return {
        label: label.trim(),
        value: value.join(':').trim(),
        closed: /chiuso/i.test(row),
      };
    }),
  };
});
---

<section id="sedi" class="locations-section" aria-labelledby="locations-title" data-locations-map-section>
  <div class="locations-layout">
    <div class="locations-copy">
      <p class="locations-eyebrow">
        <span class="locations-eyebrow-desktop">Sedi e accessibilità</span>
        <span class="locations-eyebrow-mobile">Vicinanza e accessibilità</span>
      </p>
      <h2 id="locations-title">Dove <span>trovarci</span></h2>
      <p class="locations-mobile-description">Scegli la sede più vicina a te e visualizza il percorso interattivo.</p>

      <div class="location-list">
        {locationOffices.map((office, index) => (
          <article
            class:list={['location-card', index === 0 && 'location-card-open']}
            id={office.slug}
            data-location-card
            data-map-src={office.mapEmbed}
            data-map-title={`Mappa dello studio dentistico di ${office.city}`}
            data-map-city={office.city}
            data-map-address={office.address}
            data-map-href={office.mapHref}>
            <button
              class="location-card-trigger"
              type="button"
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`sede-${office.slug}-panel`}>
              <span class="location-card-pin" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="2.5"></circle>
                </svg>
              </span>
              <span class="location-card-title">
                <small class="location-card-kicker">Studio dentistico di</small>
                <strong>{office.city}</strong>
                <span class="location-card-address-mobile">{office.address}</span>
              </span>
              <i aria-hidden="true"></i>
            </button>

            <div class="location-card-panel" id={`sede-${office.slug}-panel`} hidden={index !== 0}>
              <div class="location-detail">
                <span>Indirizzo</span>
                <strong>{office.address}</strong>
              </div>

              <div class="location-detail">
                <span>Telefono</span>
                <a href={office.phoneHref}>{office.phone}</a>
              </div>

              <div class="location-detail">
                <span>Email</span>
                <a href={office.emailHref}>{office.email}</a>
              </div>

              <div class="location-hours" aria-label={`Orari ${office.city}`}>
                <p>Orari</p>
                {office.hoursRows.map((row) => (
                  <div class:list={['location-hours-row', row.closed && 'location-hours-row-closed']}>
                    <span>{row.label}</span>
                    <strong>{row.value}</strong>
                  </div>
                ))}
              </div>

              <a class="location-route" href={office.mapHref} target="_blank" rel="noreferrer">
                Apri percorso
                <span class="ui-glyph" aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      {locationOffices[0] && (
        <details class="locations-mobile-hours">
          <summary>
            <span class="locations-mobile-hours-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="8.5"></circle>
                <path d="M12 7v5l3.5 2"></path>
              </svg>
            </span>
            <strong>Orari di apertura</strong>
            <i aria-hidden="true"></i>
          </summary>
          <div class="locations-mobile-hours-panel">
            {locationOffices[0].hoursRows.map((row) => (
              <div>
                <span>{row.label}</span>
                <strong>{row.value}</strong>
              </div>
            ))}
          </div>
        </details>
      )}
    </div>

    <div class="locations-map-stack" aria-label="Mappa dello studio selezionato">
      {locationOffices[0] && (
        <article class="location-map-card" aria-label={`Mappa ${locationOffices[0].city}`}>
          <iframe
            src={locationOffices[0].mapEmbed}
            title={`Mappa dello studio dentistico di ${locationOffices[0].city}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            data-location-map></iframe>
          <div class="location-map-caption">
            <strong data-location-map-city>{locationOffices[0].city}</strong>
            <span data-location-map-address>{locationOffices[0].address}</span>
            <a href={locationOffices[0].mapHref} target="_blank" rel="noreferrer" data-location-map-link>
              <span class="location-map-link-desktop">Apri su Google Maps</span>
              <span class="location-map-link-mobile">Apri in Maps</span>
              <span class="ui-glyph" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      )}
    </div>
  </div>
</section>

<script>
const locationSections = document.querySelectorAll('[data-locations-map-section]');

locationSections.forEach((section) => {
  const cards = Array.from(section.querySelectorAll('[data-location-card]'));
  const map = section.querySelector('[data-location-map]');
  const mapCity = section.querySelector('[data-location-map-city]');
  const mapAddress = section.querySelector('[data-location-map-address]');
  const mapLink = section.querySelector('[data-location-map-link]');

  const activateCard = (card) => {
    cards.forEach((item) => {
      const isOpen = item === card;
      const button = item.querySelector('.location-card-trigger');
      const panel = item.querySelector('.location-card-panel');

      item.classList.toggle('location-card-open', isOpen);
      button?.setAttribute('aria-expanded', String(isOpen));

      if (panel) {
        panel.hidden = !isOpen;
      }
    });

    if (map instanceof HTMLIFrameElement && card.dataset.mapSrc && map.src !== card.dataset.mapSrc) {
      map.src = card.dataset.mapSrc;
    }

    if (card.dataset.mapTitle) {
      map?.setAttribute('title', card.dataset.mapTitle);
    }

    if (mapCity && card.dataset.mapCity) {
      mapCity.textContent = card.dataset.mapCity;
    }

    if (mapAddress && card.dataset.mapAddress) {
      mapAddress.textContent = card.dataset.mapAddress;
    }

    if (mapLink instanceof HTMLAnchorElement && card.dataset.mapHref) {
      mapLink.href = card.dataset.mapHref;
    }
  };

  cards.forEach((card) => {
    const button = card.querySelector('.location-card-trigger');
    button?.addEventListener('click', () => activateCard(card));
  });
});
</script>

<style>
  /* Markup, interazioni e design della sezione Sedi di ScrapedHome.astro. */
  .locations-mobile-description { margin: 0; }

  .locations-section {
    --cdm-green: var(--brand-primary-dark);
    --cdm-green-deep: var(--brand-primary-dark);
    --cdm-lime: var(--brand-blue);
    --cdm-action: var(--brand-cta);
    --cdm-paper: var(--surface-white);
    --cdm-soft: var(--background);
    --cdm-text: var(--brand-primary-dark);
    background: var(--cdm-paper);
    color: var(--cdm-text);
    font-family: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: -0.01em;
  }

  .locations-section a {
    color: inherit;
  }

  .locations-section {
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }

  .locations-section {
    background: var(--background);
    color: var(--ink);
    font-family: inherit;
  }

  .locations-layout {
    min-height: 780px;
    display: grid;
    grid-template-columns: minmax(430px, 0.78fr) minmax(0, 1.22fr);
  }

  .locations-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(58px, 5vw, 84px) clamp(34px, 6vw, 104px);
    background: linear-gradient(180deg, var(--surface-white) 0%, var(--background) 100%);
  }

  .locations-eyebrow {
    margin: 0 0 18px;
    color: var(--brand-cta);
    font-size: clamp(1rem, 1.1vw, 1.125rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .locations-eyebrow-mobile,
.locations-mobile-description,
.location-card-pin,
.location-card-address-mobile,
.locations-mobile-hours,
.location-map-link-mobile {
    display: none;
  }

  .locations-copy h2 {
    max-width: 12ch;
    margin: 0;
    color: var(--blue-dark);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(2rem, 4.8vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.2px;
    line-height: 1.05;
  }

  .locations-copy h2 span {
    color: inherit;
  }

  .location-list {
    display: grid;
    gap: 16px;
    margin-top: clamp(34px, 4vw, 52px);
  }

  .location-card {
    position: relative;
    border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.22);
    border-radius: 8px;
    background: linear-gradient(180deg, var(--surface-white) 0%, var(--background) 100%);
    box-shadow: 0 16px 42px rgba(var(--brand-primary-dark-rgb), 0.08);
    overflow: hidden;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .location-card-open {
    border-color: rgba(var(--brand-primary-dark-rgb), 0.22);
    background: var(--surface-white);
    box-shadow: 0 24px 58px rgba(var(--brand-primary-dark-rgb), 0.13);
  }

  .location-card-trigger {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 38px;
    gap: 18px;
    align-items: center;
    border: 0;
    padding: clamp(22px, 2.4vw, 30px) clamp(22px, 2.4vw, 30px) clamp(22px, 2.4vw, 30px) clamp(26px, 2.7vw, 36px);
    background: transparent;
    color: var(--blue-dark);
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .location-card-title {
    min-width: 0;
  }

  .location-card-trigger strong {
    display: block;
    margin-top: 5px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.25rem, 1.55vw, 1.75rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .location-card-trigger small {
    display: block;
    color: var(--brand-primary-dark);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .location-card-trigger i {
    position: relative;
    width: 38px;
    height: 38px;
    justify-self: end;
    border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.3);
    border-radius: 999px;
    background: var(--surface-white);
    color: var(--brand-primary-dark);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .location-card-trigger i::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 9px;
    height: 9px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translate(-50%, -62%) rotate(45deg);
    transition: transform 180ms ease;
  }

  .location-card-open .location-card-trigger {
    border-bottom: 1px solid rgba(var(--brand-primary-dark-rgb), 0.18);
    background: var(--surface-white);
    color: var(--blue-dark);
  }

  .location-card-open .location-card-trigger small {
    color: var(--brand-primary-dark);
  }

  .location-card-open .location-card-trigger i {
    border-color: var(--brand-primary-dark);
    background: var(--brand-primary-dark);
    color: var(--surface-white);
  }

  .location-card-open .location-card-trigger i::after {
    transform: translate(-50%, -35%) rotate(225deg);
  }

  .location-card-panel {
    display: grid;
    gap: 18px;
    padding: clamp(18px, 1.8vw, 24px) clamp(22px, 2.4vw, 30px) clamp(22px, 2.4vw, 30px) clamp(26px, 2.7vw, 36px);
  }

  .location-card-panel[hidden] {
    display: none;
  }

  .location-detail {
    display: grid;
    gap: 5px;
  }

  .location-detail span,
.location-hours p {
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .location-detail strong,
.location-detail a {
    color: var(--text-dark);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .location-detail a {
    width: fit-content;
    text-decoration: none;
  }

  .location-detail a:hover {
    color: var(--brand-primary-dark);
  }

  .location-hours {
    display: grid;
    gap: 10px;
    border-top: 1px solid rgba(var(--brand-primary-dark-rgb), 0.16);
    padding-top: 18px;
  }

  .location-hours-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 22px;
    color: var(--text-dark);
    font-size: 0.96rem;
    line-height: 1.3;
  }

  .location-hours-row span {
    color: var(--muted);
    font-weight: 800;
  }

  .location-hours-row strong {
    color: var(--blue-dark);
    font-weight: 400;
    text-align: right;
  }

  .location-hours-row-closed strong {
    color: var(--brand-primary-dark);
    font-weight: 500;
  }

  .location-route {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.28);
    border-radius: 999px;
    padding: 10px 15px;
    color: var(--blue-dark);
    font-weight: 400;
    text-decoration: none;
  }

  .location-route:hover {
    border-color: var(--brand-primary-dark);
    background: rgba(var(--brand-primary-dark-rgb), 0.07);
    color: var(--brand-primary-dark);
  }

  .locations-map-stack {
    min-height: 780px;
    display: block;
    background: var(--blue-dark);
  }

  .location-map-card {
    position: relative;
    min-height: 780px;
    height: 100%;
    margin: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .location-map-card iframe {
    position: absolute;
    top: -120px;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: calc(100% + 120px);
    border: 0;
    filter: saturate(0.9) contrast(0.98);
  }

  .location-map-caption {
    position: absolute;
    top: clamp(18px, 2.5vw, 34px);
    right: clamp(18px, 2.5vw, 34px);
    z-index: 1;
    max-width: min(420px, calc(100% - 36px));
    display: grid;
    gap: 4px;
    border-radius: 8px;
    padding: 16px 18px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 14px 36px rgba(var(--brand-primary-dark-rgb), 0.16);
  }

  .location-map-caption strong {
    color: var(--blue-dark);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .location-map-caption span {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .location-map-caption a {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: var(--brand-blue);
    font-size: 0.9rem;
    font-weight: 400;
    text-decoration: none;
  }

  .location-map-caption a span {
    color: currentColor;
    font-size: 1.05em;
    line-height: 1;
  }

  @media (max-width: 1160px) {
    .locations-layout {
      grid-template-columns: 1fr;
    }

    .locations-layout,
.locations-map-stack {
      min-height: auto;
    }

    .location-map-card {
      min-height: 420px;
    }
  }

  @media (max-width: 720px) {

    .locations-section {
      background: var(--surface-white);
    }

    .locations-copy {
      padding: 64px 20px 38px;
      background: var(--surface-white);
    }

    .locations-eyebrow {
      margin-bottom: 18px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.2em;
    }

    .locations-eyebrow-desktop {
      display: none;
    }

    .locations-eyebrow-mobile {
      display: inline;
    }

    .locations-copy h2 {
      max-width: none;
      font-size: clamp(3rem, 13vw, 3.55rem);
      line-height: 1;
    }

    .locations-copy h2 span {
      color: var(--brand-blue);
    }

    .locations-mobile-description {
      max-width: 31ch;
      display: block;
      margin: 26px 0 0;
      color: var(--muted-text);
      font-size: 1.08rem;
      font-weight: 400;
      line-height: 1.5;
    }

    .location-list {
      gap: 16px;
      margin-top: 42px;
    }

    .location-card,
.location-card-open {
      border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.1);
      border-radius: 32px;
      background: var(--surface-white);
      box-shadow: 0 12px 30px rgba(var(--brand-primary-dark-rgb), 0.07);
    }

    .location-card-trigger {
      min-height: 108px;
      grid-template-columns: 62px minmax(0, 1fr);
      gap: 18px;
      border-bottom: 0;
      padding: 18px 20px;
      color: var(--brand-primary-dark);
    }

    .location-card-pin {
      width: 62px;
      height: 62px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      background: var(--soft-blue-bg);
      color: var(--brand-primary-dark);
    }

    .location-card-pin svg {
      width: 29px;
      height: 29px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .location-card-trigger .location-card-kicker,
.location-card-trigger > i {
      display: none;
    }

    .location-card-trigger strong {
      margin-top: 0;
      color: inherit;
      font-size: 1.18rem;
      font-weight: 600;
      line-height: 1.15;
    }

    .location-card-address-mobile {
      display: block;
      margin-top: 8px;
      color: var(--muted-text);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.13em;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .location-card-open {
      border-color: var(--brand-primary-dark);
      background: var(--brand-primary-dark);
      box-shadow: 0 18px 38px rgba(var(--brand-primary-dark-rgb), 0.2);
    }

    .location-card-open .location-card-trigger {
      border-bottom: 0;
      background: transparent;
      color: var(--surface-white);
    }

    .location-card-open .location-card-pin {
      background: var(--brand-blue);
      color: var(--surface-white);
    }

    .location-card-open .location-card-pin svg {
      stroke: var(--surface-white);
    }

    .location-card-open .location-card-address-mobile {
      color: rgba(255, 255, 255, 0.7);
    }

    .location-card-panel {
      display: none !important;
    }

    .locations-mobile-hours {
      display: block;
      margin-top: 32px;
      overflow: hidden;
      border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.1);
      border-radius: 32px;
      background: var(--surface-white);
      box-shadow: 0 12px 30px rgba(var(--brand-primary-dark-rgb), 0.09);
    }

    .locations-mobile-hours summary {
      min-height: 104px;
      display: grid;
      grid-template-columns: 58px minmax(0, 1fr) 20px;
      gap: 16px;
      align-items: center;
      padding: 18px 20px;
      color: var(--brand-primary-dark);
      cursor: pointer;
      list-style: none;
    }

    .locations-mobile-hours summary::-webkit-details-marker {
      display: none;
    }

    .locations-mobile-hours-icon {
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      background: var(--soft-blue-bg);
      color: var(--brand-cta);
    }

    .locations-mobile-hours-icon svg {
      width: 28px;
      height: 28px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .locations-mobile-hours summary strong {
      font-size: 0.88rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .locations-mobile-hours summary > i {
      width: 11px;
      height: 11px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: translateY(-3px) rotate(45deg);
      transition: transform 180ms ease;
    }

    .locations-mobile-hours[open] summary > i {
      transform: translateY(3px) rotate(225deg);
    }

    .locations-mobile-hours-panel {
      display: grid;
      gap: 12px;
      border-top: 1px solid var(--border);
      padding: 20px 22px 24px;
    }

    .locations-mobile-hours-panel > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 14px;
      align-items: baseline;
      color: var(--muted-text);
      font-size: 0.92rem;
      line-height: 1.4;
    }

    .locations-mobile-hours-panel strong {
      color: var(--brand-primary-dark);
      font-weight: 500;
      text-align: right;
    }

    .location-map-card {
      min-height: 380px;
    }

    .location-map-card iframe {
      top: 0;
      height: 100%;
    }

    .location-map-caption {
      top: 18px;
      right: auto;
      left: 18px;
      gap: 0;
      border-radius: 6px;
      padding: 12px 14px;
    }

    .location-map-caption > strong,
.location-map-caption > span,
.location-map-link-desktop {
      display: none;
    }

    .location-map-caption a {
      margin-top: 0;
      color: var(--brand-cta);
      font-size: 0.95rem;
      font-weight: 500;
    }

    .location-map-link-mobile {
      display: inline;
      color: inherit;
