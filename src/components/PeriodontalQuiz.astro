---
import BookingFields from './BookingFields.astro';
import BookingPrivacy from './BookingPrivacy.astro';
import QuizConsultationDialog from './QuizConsultationDialog.astro';
import { site } from '../data/site';
import { periodontalAgeRanges, periodontalDurations, periodontalObjectives, periodontalSymptoms, getPeriodontalSymptomLabel } from '../data/periodontalQuiz.js';
import { getPeriodontalQuizRecommendation } from '../data/periodontalQuizRecommendation.js';
import '../styles/orthodontic-quiz.css';

interface Props { contextLabel?: string; consultationFlow?: boolean; }
const { contextLabel, consultationFlow = false } = Astro.props;
const initialRecommendation = getPeriodontalQuizRecommendation();
const recessionExample = getPeriodontalQuizRecommendation({ periodontalSymptom: 'Gengive che si ritirano' });
const questions = [
  { number: 1, title: 'Indica la tua età', name: 'ageRange', type: 'age-pills', options: periodontalAgeRanges },
  { number: 2, title: 'Quale segnale hai notato?', name: 'periodontalSymptom', type: 'choices', options: periodontalSymptoms.map(value => ({ value, label: getPeriodontalSymptomLabel(value) })) },
  { number: 3, title: 'Da quanto tempo hai notato questo segnale?', name: 'symptomDuration', type: 'choices', options: periodontalDurations.map(value => ({ value })) },
  { number: 4, title: 'Seleziona uno dei nostri studi dentistici', name: 'office', type: 'select' },
  { number: 5, title: 'Come ti chiami?', name: 'fullName', type: 'text', label: 'Nome e cognome', placeholder: 'Nome e cognome', autocomplete: 'section-periodontal name' },
  { number: 6, title: 'A quale email possiamo scriverti?', name: 'email', type: 'email', label: 'Email', placeholder: 'nome@esempio.it', autocomplete: 'section-periodontal email' },
  { number: 7, title: 'Ultimo passo: a quale numero possiamo chiamarti?', name: 'phone', type: 'tel', label: 'Telefono', placeholder: '333 123 4567', autocomplete: 'section-periodontal tel' },
];
---

<section class="orthodontic-objectives" id="il-tuo-obiettivo" aria-label="Questionario sulla salute delle gengive" data-periodontal-quiz>
  <span id="richiedi" class="ortho-anchor" aria-hidden="true"></span>
  <div class="landing-shell orthodontic-objectives-shell">
    <div class="orthodontic-questionnaire-banner">
      <slot name="questionnaire-icon" />
      <p>Sanguinamento o recessioni gengivali? Rispondi a poche domande e richiedi una valutazione parodontale.</p>
      <button type="button" data-quiz-open aria-haspopup="dialog">
        <span>Compila il questionario</span>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg>
      </button>
    </div>
    <noscript><p>Per compilare il questionario abilita JavaScript oppure <a href="#ortho-final">richiedi una visita dal modulo in fondo alla pagina</a>.</p></noscript>
  </div>
</section>

{consultationFlow && <QuizConsultationDialog treatment="parodontologia" />}
{!consultationFlow && <dialog id="orthodontic-quiz" class="orthodontic-quiz" aria-labelledby="periodontal-objectives-title" data-quiz-dialog data-periodontal-quiz-dialog data-quiz-mobile-objectives-first data-quiz-all-viewports>
  <div class="orthodontic-quiz-header">
    <div class="orthodontic-quiz-progress" style="--quiz-question-count: 8" role="progressbar" aria-label="Avanzamento del questionario" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-quiz-progress>
      {Array.from({ length: 8 }, (_, index) => <span data-progress-segment={index}></span>)}
    </div>
    <img src={site.logo} width="400" height="52" alt={site.name} />
    <button type="button" class="orthodontic-quiz-close" data-quiz-close aria-label="Chiudi il questionario">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
    </button>
  </div>

  <form action="/api/booking" method="post" autocomplete="on" novalidate data-booking-kind="periodontal-quiz" data-periodontal-quiz-form>
    <BookingFields />
    <input type="hidden" name="periodontalObjective" value="" />
    <input type="hidden" name="message" value={contextLabel ? `Richiesta dalla landing parodontologia — ${contextLabel}` : 'Richiesta di valutazione parodontale dal questionario della landing parodontologia.'} />

    <section class="orthodontic-quiz-screen orthodontic-quiz-question orthodontic-quiz-objectives-step" data-quiz-panel data-question="0" data-quiz-objectives-panel>
      <div class="orthodontic-quiz-question-title">
        <h2 id="periodontal-objectives-title" tabindex="-1">Qual è il tuo obiettivo?</h2>
      </div>
      <div class="orthodontic-objectives-grid" role="group" aria-labelledby="periodontal-objectives-title">
        {periodontalObjectives.map(objective => <button class="orthodontic-objective" type="button" data-quiz-objective={objective.title} aria-pressed="false">
          <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
            {objective.icon === 'bleeding' && <><path d="M9 25V14c0-5 4-7 8-5 2 1 4 1 6 0 4-2 8 0 8 5v11M5 29c5-4 10-4 15-1s10 3 14 0M5 29v11h26" /><path d="M38 20c-2 3-6 7-6 11a6 6 0 0 0 12 0c0-4-4-8-6-11Z" /></>}
            {objective.icon === 'gum' && <><path d="M7 25V12c0-5 8-5 8 0v12m5 0V10c0-5 8-5 8 0v14m5 0V12c0-5 8-5 8 0v13M4 28c4-5 9-5 13 0 4-5 10-5 14 0 4-5 9-5 13 0v13H4V28Z" /></>}
            {objective.icon === 'tooth' && <><path d="M19 9c-4-2-8 0-8 5 0 6 3 10 4 16l1 7c.5 4 3 4 4 0l4-11 4 11c1 4 3.5 4 4 0l1-7c1-6 4-10 4-16 0-5-4-7-8-5-4 2-6 2-10 0Z" /><path d="M3 20h5m-3-3-3 3 3 3m35-3h5m-2-3 3 3-3 3" /></>}
            {objective.icon === 'check' && <><path d="M18 10c-4-2-8 0-8 5 0 6 3 10 4 16l1 7c.5 4 3 4 4 0l4-11M31 10c-4 2-6 2-10 0M7 31H4V19m0-7V7h10m24 0h6v6" /><path d="m26 30 6 6 12-14" /></>}
          </svg>
          <span>{objective.title}</span>
        </button>)}
      </div>
      <p class="orthodontic-quiz-error" data-quiz-error role="alert" aria-live="polite"></p>
    </section>

    {questions.map(question => <>
      <section class={`orthodontic-quiz-screen orthodontic-quiz-question orthodontic-quiz-question-${question.type}`} hidden data-quiz-panel data-question={question.number}>
        <div class="orthodontic-quiz-question-title"><h2 id={`periodontal-question-${question.number}`} tabindex="-1">{question.title}</h2></div>
        {question.type === 'select' && <p class="orthodontic-quiz-description">Scegli lo studio che ti è più comodo: Modena o Reggio Emilia.</p>}
        {question.number === 3 && <p class="orthodontic-quiz-description">Se non hai notato segnali particolari, seleziona “Non saprei indicarlo”.</p>}
        {question.type === 'email' && <p class="orthodontic-quiz-description">Useremo questo recapito per gestire la tua richiesta. <a href="/privacy-policy/" target="_blank" rel="noopener noreferrer">Informativa privacy</a>.</p>}
        {question.name === 'fullName' && <p class="orthodontic-quiz-description" data-quiz-guardian hidden>Per un paziente minorenne, inserisci nome e cognome del genitore o del tutore che possiamo contattare.</p>}
        {question.type === 'tel' && <p class="orthodontic-quiz-description">La segreteria ti ricontatterà entro due ore per concordare giorno e orario della visita.<span data-quiz-guardian hidden>Per un paziente minorenne, inserisci il recapito del genitore o del tutore.</span></p>}

        {['choices', 'age-pills'].includes(question.type) ? <div class={question.type === 'age-pills' ? 'orthodontic-quiz-age-options' : 'orthodontic-quiz-options'} role="radiogroup" aria-labelledby={`periodontal-question-${question.number}`}>
          {question.options?.map(option => <label class="orthodontic-quiz-option">
            <input type="radio" name={question.name} value={option.value} required data-quiz-minor={'minor' in option ? String(option.minor) : undefined} />
            <span class="orthodontic-quiz-option-body"><span class="orthodontic-quiz-option-label"><span>{'label' in option ? option.label : option.value}</span><svg class="orthodontic-quiz-check" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg></span></span>
          </label>)}
        </div> : question.type === 'select' ? <label class="orthodontic-quiz-input-label">
          <span class="landing-visually-hidden">Sede preferita</span>
          <select name="office" required aria-labelledby={`periodontal-question-${question.number}`}><option value="">Seleziona uno studio</option>{site.offices.map(office => <option value={office.city}>{office.city}</option>)}</select>
        </label> : <label class="orthodontic-quiz-input-label">
          <span class="landing-visually-hidden">{question.label}</span>
          <div class={question.type === 'tel' ? 'orthodontic-quiz-phone' : ''}>
            {question.type === 'tel' && <span class="orthodontic-quiz-phone-prefix">IT +39</span>}
            <input type={question.type} name={question.name} placeholder={question.placeholder} autocomplete={question.autocomplete} required maxlength={question.name === 'fullName' ? 120 : question.type === 'tel' ? 30 : 254} minlength={question.name === 'fullName' ? 2 : question.type === 'tel' ? 6 : undefined} inputmode={question.type === 'email' ? 'email' : question.type === 'tel' ? 'tel' : 'text'} autocapitalize={question.type === 'email' ? 'none' : undefined} spellcheck={question.type === 'email' ? false : undefined} />
          </div>
        </label>}

        {question.type === 'tel' && <div class="orthodontic-quiz-privacy"><BookingPrivacy /><p>L’invio è una richiesta di ricontatto. Giorno e orario della visita saranno concordati con la segreteria.</p></div>}
        <p class="orthodontic-quiz-error" data-quiz-error role="alert" aria-live="polite"></p>
        <div class="orthodontic-quiz-question-actions">
          {question.type === 'tel' ? <button class="orthodontic-quiz-button" type="submit">Invia la richiesta <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg></button> : <button class="orthodontic-quiz-button" type="button" data-quiz-next>Avanti <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg></button>}
        </div>
      </section>

      {question.number === 3 && <section class="orthodontic-quiz-screen orthodontic-quiz-interlude periodontal-quiz-recommendation" hidden data-quiz-panel data-quiz-information data-periodontal-recommendation data-periodontal-recommendation-kind={initialRecommendation.visualKind}>
        <div class="orthodontic-quiz-question-title"><h2 id="periodontal-quiz-information-title" tabindex="-1" data-periodontal-recommendation-title>{initialRecommendation.title}</h2></div>
        <p class="orthodontic-quiz-description" data-periodontal-recommendation-text>{initialRecommendation.text}</p>
        <div class="periodontal-quiz-visual">
          <figure class="periodontal-quiz-assessment" data-periodontal-recommendation-assessment>
            <img src={initialRecommendation.image.src} alt={initialRecommendation.image.alt} width={initialRecommendation.image.width} height={initialRecommendation.image.height} loading="lazy" decoding="async" />
          </figure>
          <div class="periodontal-quiz-case" hidden data-periodontal-recommendation-case="" role="group" aria-label="Esempio dello studio: prima e dopo un trattamento delle recessioni gengivali">
            <figure><img src={recessionExample.before?.src} alt={recessionExample.before?.alt} width={recessionExample.before?.width} height={recessionExample.before?.height} loading="lazy" decoding="async" data-periodontal-recommendation-before /><figcaption>Prima</figcaption></figure>
            <figure><img src={recessionExample.after?.src} alt={recessionExample.after?.alt} width={recessionExample.after?.width} height={recessionExample.after?.height} loading="lazy" decoding="async" data-periodontal-recommendation-after /><figcaption>Dopo</figcaption></figure>
          </div>
          <p class="orthodontic-quiz-caption periodontal-quiz-visual-caption" data-periodontal-recommendation-caption>{initialRecommendation.visualCaption}</p>
        </div>
        <p class="orthodontic-quiz-caption periodontal-quiz-information-note">Il questionario raccoglie le tue esigenze e non fornisce una diagnosi.</p>
        <button class="orthodontic-quiz-button" type="button" data-quiz-next>Prenota una visita <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg></button>
      </section>}
    </>)}
  </form>
</dialog>}

<style>
  [data-periodontal-quiz-dialog] h2:focus { outline: none; }
  [data-periodontal-quiz-dialog] .orthodontic-quiz-options { width: 100%; max-width: 680px; }
  [data-periodontal-quiz-dialog] .orthodontic-quiz-options .orthodontic-quiz-option-body { min-height: 58px; justify-content: center; padding: 14px 18px; border-radius: 12px; }
  [data-periodontal-quiz-dialog] .orthodontic-objective > svg { display: block; }
  [data-periodontal-quiz-dialog] .periodontal-quiz-recommendation h2 { max-width: 28ch; color: var(--brand-primary-dark); }
  [data-periodontal-quiz-dialog] .periodontal-quiz-recommendation .orthodontic-quiz-description { max-width: 68ch; }
  .periodontal-quiz-assessment { width: min(100%, 440px); margin: 24px 0 0; }
  .periodontal-quiz-assessment img { display: block; width: 100%; height: auto; border-radius: 12px; }
  .periodontal-quiz-case { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 680px; gap: 14px; margin-top: 24px; }
  .periodontal-quiz-case figure { min-width: 0; margin: 0; }
  .periodontal-quiz-case img { display: block; width: 100%; height: auto; aspect-ratio: 600 / 352; border-radius: 10px; background: var(--background); object-fit: contain; }
  .periodontal-quiz-case figcaption { margin-top: 7px; color: var(--muted-text); font-size: 14px; line-height: 1.3; }
  [data-periodontal-quiz-dialog] .periodontal-quiz-visual-caption { max-width: 76ch; margin: 14px 0 0; font-size: 14px; }
  [data-periodontal-quiz-dialog] .periodontal-quiz-information-note { margin: 12px 0 0; font-size: 14px; }
  @media (min-width: 721px) {
    [data-periodontal-quiz-dialog] .periodontal-quiz-recommendation {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas: "title visual" "summary visual" "note visual" "action visual";
      align-items: start;
      gap: 18px 36px;
    }
    .periodontal-quiz-recommendation > .orthodontic-quiz-question-title { grid-area: title; }
    [data-periodontal-quiz-dialog] .periodontal-quiz-recommendation h2 { font-size: clamp(26px, 2.2vw, 32px); }
    [data-periodontal-quiz-dialog] .periodontal-quiz-recommendation > .orthodontic-quiz-description { grid-area: summary; margin: 0; font-size: 18px; }
    .periodontal-quiz-visual { grid-area: visual; min-width: 0; }
    .periodontal-quiz-assessment, .periodontal-quiz-case { width: 100%; margin-top: 0; }
    [data-periodontal-quiz-dialog] .periodontal-quiz-information-note { grid-area: note; margin: 0; }
    [data-periodontal-quiz-dialog] .periodontal-quiz-recommendation > .orthodontic-quiz-button { grid-area: action; justify-self: start; margin-top: 0; }
  }
  @media (max-width: 720px) {
    [data-periodontal-quiz-dialog] .periodontal-quiz-recommendation { width: calc(100% - 48px); padding-top: 36px; }
    .periodontal-quiz-assessment { max-width: 360px; }
    .periodontal-quiz-case { gap: 10px; }
    .periodontal-quiz-case figcaption { font-size: 13px; }
  }
</style>

<script>
  import { bindPeriodontalQuiz } from '../utils/periodontalQuiz';
  bindPeriodontalQuiz();
</script>
