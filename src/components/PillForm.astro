---
import BookingFields from './BookingFields.astro';
import BookingPrivacy from './BookingPrivacy.astro';
import BookingFeedback from './BookingFeedback.astro';
interface Props {
  variant?: 'compact' | 'full';
  title?: string;
  note?: string;
}

const {
  variant = 'compact',
  title = variant === 'compact' ? undefined : 'Compila il modulo contatti per ulteriori informazioni!',
  note = '',
} = Astro.props;
---

<form class:list={['pill-form', `pill-form-${variant}`]} data-contact-form data-booking-kind={variant === 'compact' ? 'callback' : 'contact'} action="/api/booking" method="post">
  <BookingFields />
  {title && <h2>{title}</h2>}

  {variant === 'compact' ? (
    <div class="pill-form-row">
      <label>
        <span>Nome e cognome</span>
        <input type="text" name="fullName" placeholder="Nome e cognome" autocomplete="name" minlength="2" maxlength="120" required />
      </label>
      <label>
        <span>Telefono</span>
        <input type="tel" name="phone" placeholder="Telefono" autocomplete="tel" minlength="6" maxlength="30" required />
      </label>
      <button class="button button-primary" type="submit">Richiedi Info <span aria-hidden="true">↗</span></button>
    </div>
  ) : (
    <>
      <div class="form-grid">
        <label>Nome
          <input type="text" name="fullName" placeholder="Nome" autocomplete="given-name" maxlength="60" required />
        </label>
        <label>Cognome
          <input type="text" name="lastName" placeholder="Cognome" autocomplete="family-name" maxlength="59" required />
        </label>
        <label>Telefono
          <input type="tel" name="phone" placeholder="Telefono" autocomplete="tel" minlength="6" maxlength="30" required />
        </label>
        <label>Email
          <input type="email" name="email" placeholder="Email" autocomplete="email" maxlength="254" required />
        </label>
        <label class="full-span">Messaggio
          <textarea name="message" placeholder="Messaggio" maxlength="3000"></textarea>
        </label>
      </div>
      <BookingPrivacy />
      <button class="button button-primary" type="submit">Richiedi Info <span aria-hidden="true">↗</span></button>
    </>
  )}
  {variant === 'compact' && <BookingPrivacy />}
  <BookingFeedback />
  {note && <p class="form-note">{note}</p>}
</form>

<script>
  import { bindContactForms } from '../utils/submitBooking';
  bindContactForms();
</script>
