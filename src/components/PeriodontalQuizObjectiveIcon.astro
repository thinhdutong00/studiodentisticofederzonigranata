---
interface Props { name: string; }
const { name } = Astro.props;
const tooth = 'M22 9c-4 0-6-3-10-1-5 2-6 7-4 13 1.5 4 3 7 3.5 12 .5 5.5 2 9 4.5 9 2 0 2-12 6-12s4 12 6 12c2.5 0 4-3.5 4.5-9 .5-5 2-8 3.5-12 2-6 1-11-4-13-4-2-6 1-10 1Z';
---

<svg class="pq-objective-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'bleeding' && <>
    <path d={tooth} transform="translate(-1 5) scale(.88)" fill="var(--surface-white)" />
    <path d="M5 28c5-3 10-3 15 0s10 3 15 0" />
    <path d="M36 3c-2 3-6 7.5-6 11a6 6 0 0 0 12 0c0-3.5-4-8-6-11Z" stroke="var(--surface-white)" stroke-width="5" />
    <path d="M36 3c-2 3-6 7.5-6 11a6 6 0 0 0 12 0c0-3.5-4-8-6-11Z" fill="var(--brand-blue)" stroke="var(--brand-blue)" stroke-width="1.4" />
    <path d="M33 13a3 3 0 0 0 3 4" stroke="var(--surface-white)" stroke-width="1.3" />
  </>}
  {name === 'gum' && <>
    <path d={tooth} transform="translate(2 0)" fill="var(--surface-white)" />
    <path d="M5 27c5-4 11-4 19 0 7-4 13-4 19 0v14H5Z" fill="var(--soft-blue-bg)" />
    <path d="M8 34c4-2 9-2 13 0" stroke-opacity=".5" />
    <path d="m35 24 9 3v8c0 5-9 9-9 9s-9-4-9-9v-8Z" fill="var(--surface-white)" />
    <path d="m30.5 33 3 3 6-6" />
  </>}
  {name === 'tooth' && <>
    <path d={tooth} transform="translate(5 4) scale(.8) rotate(-10 22 25)" fill="var(--surface-white)" />
    <path d="M3 23h6m-3-4-4 4 4 4m33-4h6m-3-4 4 4-4 4" />
    <path d="M8 42c9-3 23-3 32 0" stroke-opacity=".5" />
    <path d="M15 5 12 2m20 3 3-3" stroke-opacity=".6" />
  </>}
  {name === 'check' && <>
    <path d={tooth} transform="translate(0 1) scale(.82)" fill="var(--surface-white)" />
    <path d="M12 14c3 1.5 6 1.5 9 0" stroke-opacity=".5" />
    <path d="m38.5 36.5 6 6" stroke-width="2.4" />
    <circle cx="32" cy="30" r="9" fill="var(--surface-white)" />
    <path d="M27 28a5.2 5.2 0 0 1 5-3" stroke-opacity=".45" />
  </>}
</svg>

<style>
  .pq-objective-icon { display: block; width: 48px; height: 48px; color: var(--brand-cta); }
  @media (max-width: 720px) { .pq-objective-icon { width: 42px; height: 42px; } }
</style>
