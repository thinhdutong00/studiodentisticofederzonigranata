---
import { site } from '../data/site';

interface Props { treatmentLabel: string; variant?: 'section' | 'hero'; submitLabel?: string; }
const { treatmentLabel, variant = 'section', submitLabel = 'Continua' } = Astro.props;
const isHero = variant === 'hero';
const idPrefix = isHero ? 'ortho-hero-consultation' : 'ortho-consultation';
const requestReasons = [
  'Allineatori trasparenti',
  'Apparecchio ortodontico tradizionale',
  'Valutazione ortodontica per un bambino o ragazzo',
  'Voglio prima confrontarmi con un vostro specialista',
];
---

<div class:list={['ortho-consultation-mobile', { 'ortho-consultation-hero': isHero }]}>
  {!isHero && <header class="ortho-consultation-heading">
    <img class="ortho-consultation-symbol" src="/assets/original/2020/10/cropped-favicon-180x180.png" width="72" height="72" alt="" aria-hidden="true" decoding="async" />
    <h2 id={`${idPrefix}-title`}>Prenota la tua visita di <strong>valutazione ortodontica</strong></h2>
    <p>Fai il primo passo! Prenota la tua prima visita ortodontica per scoprire la diagnosi e il piano di trattamento più adatto a te.</p>
  </header>}

  <div class="ortho-consultation-surface">
    <form class="ortho-consultation-form" data-landing-request-form action="/richiesta/" method="get" aria-labelledby={isHero ? undefined : `${idPrefix}-title`} aria-label={isHero ? 'Richiedi una visita ortodontica' : undefined} aria-describedby={`${idPrefix}-note`}>
      <input type="hidden" name="trattamento" value={treatmentLabel} />
      {isHero && <p class="ortho-consultation-hero-title">Prenota una visita ortodontica</p>}

      <div class="ortho-consultation-fields">
        <label class="ortho-consultation-office" for={`${idPrefix}-office`}>
          <span class="landing-visually-hidden">Seleziona lo studio dentistico più vicino a te</span>
          <svg class="ortho-consultation-search" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
          <select id={`${idPrefix}-office`} name="sede">
            <option value="" selected>Seleziona lo studio dentistico più vicino a te</option>
            {site.offices.map(office => <option value={office.city}>{office.city}</option>)}
          </select>
          <span class="ortho-consultation-office-placeholder" aria-hidden="true">Seleziona lo studio dentistico più vicino a te</span>
          <svg class="ortho-consultation-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7 5 5 5-5" /></svg>
        </label>

        <label class="ortho-consultation-country" for={`${idPrefix}-reason`}>
          <span class="landing-visually-hidden">Motivo della richiesta</span>
          <select id={`${idPrefix}-reason`} name="motivo">
            <option value="" selected>Motivo della richiesta</option>
            {requestReasons.map(reason => <option value={reason}>{reason}</option>)}
          </select>
          <svg class="ortho-consultation-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7 5 5 5-5" /></svg>
        </label>
      </div>

      <button class="ortho-consultation-submit" type="submit">{submitLabel}</button>
      <p class="ortho-consultation-note" id={`${idPrefix}-note`}>Prosegui per indicarci le tue preferenze e i tuoi recapiti. La segreteria ti ricontatterà entro due ore per concordare giorno e orario della visita.</p>
    </form>
  </div>
</div>

<style>
  .ortho-consultation-office { container-type: inline-size; }
  .ortho-consultation-office-placeholder { position: absolute; inset: 0 24px 1px 30px; display: none; align-items: center; background: var(--surface-white); color: var(--muted-text); font-size: min(14px, calc((100cqi - 54px) / 21)); font-weight: 400; line-height: 1.2; letter-spacing: -.2px; white-space: nowrap; pointer-events: none; }
  .ortho-consultation-office:has(select option[value=""]:checked) .ortho-consultation-office-placeholder { display: flex; }
  .ortho-consultation-hero-title { display: none; }
  .ortho-consultation-mobile { display: none; }

  @media (max-width: 720px) {
    .ortho-consultation-mobile { display: block; }

    .ortho-consultation-hero { margin-top: 24px; }

    .ortho-consultation-hero .ortho-consultation-surface {
      padding: 0;
      background: transparent;
    }

    .ortho-consultation-hero .ortho-consultation-form {
      padding: 0;
      border-radius: 0;
      background: transparent;
    }

    .ortho-consultation-heading {
      margin: 0 34px 32px;
      text-align: center;
    }

    .ortho-consultation-symbol {
      display: block;
      width: 72px;
      height: 72px;
      margin: 0 auto 24px;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }

    .ortho-consultation-mobile .ortho-consultation-heading h2 {
      max-width: none;
      margin: 0;
      color: var(--brand-cta);
      font-size: 34px;
      font-weight: 500;
      line-height: 1.12;
      letter-spacing: -.16px;
      text-wrap: balance;
    }

    .ortho-consultation-heading p {
      margin: 20px 0 0;
      color: var(--text-dark);
      font-size: 17px;
      font-weight: 400;
      line-height: 1.4;
    }

    .ortho-consultation-surface {
      padding: 24px 12px 32px;
      background: var(--background);
    }

    .ortho-consultation-form {
      position: relative;
      padding: 36px 20px 28px;
      border-radius: 24px;
      background: var(--surface-white);
      color: var(--text-dark);
    }

    .ortho-consultation-fields {
      display: grid;
      gap: 20px;
    }

    .ortho-consultation-field { display: block; min-width: 0; }

    .ortho-consultation-form input:not([type="checkbox"]):not([type="hidden"]),
    .ortho-consultation-form select {
      display: block;
      width: 100%;
      min-width: 0;
      min-height: 54px;
      margin: 0;
      padding: 14px 0;
      border: 0;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
      background: transparent;
      color: var(--text-dark);
      font: inherit;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: -.16px;
      box-shadow: none;
    }

    .ortho-consultation-form input::placeholder { color: var(--muted-text); opacity: 1; }
    .ortho-consultation-form select { appearance: none; cursor: pointer; }

    .ortho-consultation-phone {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 12px;
    }

    .ortho-consultation-country,
    .ortho-consultation-office { position: relative; display: block; min-width: 0; }
    .ortho-consultation-country select { padding-right: 20px; }
    .ortho-consultation-office select { padding-inline: 30px 24px; }

    .ortho-consultation-chevron {
      position: absolute;
      top: 19px;
      right: 0;
      width: 18px;
      height: 18px;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
      pointer-events: none;
    }

    .ortho-consultation-search {
      position: absolute;
      top: 16px;
      left: 0;
      width: 22px;
      height: 22px;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      pointer-events: none;
    }

    .ortho-consultation-form :global(.booking-contact-privacy) {
      flex-direction: row-reverse;
      justify-content: space-between;
      gap: 14px;
      margin-top: 24px;
      font-size: 14px;
      line-height: 1.45;
    }

    .ortho-consultation-form :global(.booking-contact-privacy input) {
      flex-basis: 20px;
      width: 20px;
      height: 20px;
      margin-top: 2px;
    }

    .ortho-consultation-submit {
      display: block;
      width: 100%;
      min-height: 52px;
      margin-top: 28px;
      padding: 16px;
      border: 0;
      border-radius: 10px;
      background: var(--brand-cta);
      color: var(--surface-white);
      font: inherit;
      font-size: 16px;
      font-weight: 500;
      line-height: 1;
      text-transform: uppercase;
      cursor: pointer;
    }

    .ortho-consultation-submit:hover { background: var(--brand-cta-hover); }
    .ortho-consultation-submit:disabled { opacity: .65; cursor: wait; }

    .ortho-consultation-note {
      margin: 18px 0 0;
      color: var(--muted-text);
      font-size: 13px;
      line-height: 1.45;
    }

    .ortho-consultation-form :is(input, select, button):focus-visible {
      outline: 2px solid var(--brand-blue);
      outline-offset: 4px;
    }
  }
</style>
