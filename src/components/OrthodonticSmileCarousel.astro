---
import { orthodonticResults } from '../data/orthodonticResults';

const phases = [{ key: 'before', label: 'Prima' }, { key: 'after', label: 'Dopo' }] as const;
---

<section class="ortho-smile-preview" id="sorrisi-prima-dopo" aria-labelledby="ortho-smile-preview-title" data-ortho-smile-carousel>
  <h2 id="ortho-smile-preview-title">Trattamento con allineatori trasparenti Invisalign® per risultati straordinari</h2>

  <div class="ortho-smile-track" id="ortho-smile-track" tabindex="0" role="region" aria-roledescription="carosello" aria-label="Sorrisi prima e dopo il trattamento ortodontico" data-ortho-smile-track>
    {orthodonticResults.map((result, index) => (
      <div class="ortho-smile-slide" role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} di ${orthodonticResults.length}`} data-ortho-smile-slide>
        {phases.map(phase => (
          <figure>
            <img src={result[phase.key].smile} alt={`Sorriso ${phase.key === 'before' ? 'prima del' : 'dopo il'} trattamento ortodontico`} width="600" height="300" loading="lazy" decoding="async" />
            <figcaption>{phase.label}</figcaption>
          </figure>
        ))}
      </div>
    ))}
  </div>

  <div class="ortho-smile-controls">
    <button type="button" aria-label="Mostra il confronto precedente" aria-controls="ortho-smile-track" data-ortho-smile-prev disabled>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h12" /></svg>
    </button>
    <span class="ortho-smile-counter" aria-live="polite" aria-atomic="true" data-ortho-smile-counter>1 / {orthodonticResults.length}</span>
    <button type="button" aria-label="Mostra il confronto successivo" aria-controls="ortho-smile-track" data-ortho-smile-next>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 6 6 6-6 6M4 12h12" /></svg>
    </button>
  </div>

</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ortho-smile-carousel]').forEach(carousel => {
    const track = carousel.querySelector<HTMLElement>('[data-ortho-smile-track]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-ortho-smile-slide]'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-ortho-smile-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-ortho-smile-next]');
    const counter = carousel.querySelector<HTMLElement>('[data-ortho-smile-counter]');
    if (!track || !previous || !next || !counter || !slides.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;

    const updateControls = () => {
      current = slides.reduce((nearest, slide, index) => (
        Math.abs(slide.offsetLeft - track.scrollLeft) < Math.abs(slides[nearest].offsetLeft - track.scrollLeft) ? index : nearest
      ), 0);
      previous.disabled = current === 0;
      next.disabled = current === slides.length - 1;
      const label = `${current + 1} / ${slides.length}`;
      if (counter.textContent !== label) counter.textContent = label;
    };

    const showSlide = (index: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: slides[target].offsetLeft, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    };

    previous.addEventListener('click', () => showSlide(current - 1));
    next.addEventListener('click', () => showSlide(current + 1));
    track.addEventListener('scroll', updateControls, { passive: true });
    track.addEventListener('keydown', event => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        showSlide(current + (event.key === 'ArrowRight' ? 1 : -1));
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        showSlide(event.key === 'Home' ? 0 : slides.length - 1);
      }
    });
    new ResizeObserver(() => {
      if (track.clientWidth > 0) {
        track.scrollTo({ left: slides[current].offsetLeft, behavior: 'instant' });
        updateControls();
      }
    }).observe(track);
  });
</script>

<style>
  .ortho-smile-preview {
    display: none;
  }

  @media (max-width: 720px) {
    .ortho-smile-preview {
      display: block;
      padding-block: 48px;
      background: var(--surface-white);
    }

    .ortho-smile-preview h2 {
      margin: 0 34px 28px;
      color: var(--brand-primary-dark);
      font-size: 30px;
      font-weight: 500;
      line-height: 1.16;
      letter-spacing: -.16px;
      text-wrap: balance;
    }

    .ortho-smile-track {
      position: relative;
      display: flex;
      gap: 16px;
      margin-inline: 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      border-radius: 18px;
    }

    .ortho-smile-track::-webkit-scrollbar {
      display: none;
    }

    .ortho-smile-slide {
      display: grid;
      flex: 0 0 100%;
      min-width: 0;
      gap: 2px;
      overflow: hidden;
      border-radius: 18px;
      background: var(--border);
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .ortho-smile-slide figure {
      position: relative;
      margin: 0;
    }

    .ortho-smile-slide img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 1;
    }

    .ortho-smile-slide figcaption {
      position: absolute;
      bottom: 12px;
      left: 12px;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(16, 40, 61, .9);
      color: var(--surface-white);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: normal;
    }

    .ortho-smile-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin: 16px 12px 0;
    }

    .ortho-smile-controls button {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: var(--surface-white);
      color: var(--brand-cta);
      cursor: pointer;
    }

    .ortho-smile-controls button:disabled {
      opacity: .4;
      cursor: default;
    }

    .ortho-smile-controls button:not(:disabled):hover {
      border-color: var(--brand-cta);
      background: var(--soft-blue-bg);
    }

    .ortho-smile-controls svg {
      width: 24px;
      height: 24px;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .ortho-smile-counter {
      min-width: 44px;
      color: var(--muted-text);
      font-size: 14px;
      line-height: 1.3;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .ortho-smile-controls button:focus-visible,
    .ortho-smile-track:focus-visible {
      outline: 3px solid var(--brand-blue);
      outline-offset: 4px;
    }
  }
</style>
