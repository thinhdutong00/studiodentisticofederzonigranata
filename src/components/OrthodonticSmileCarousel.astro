---
import { orthodonticResults } from '../data/orthodonticResults';

const phases = [{ key: 'before', label: 'Prima' }, { key: 'after', label: 'Dopo' }] as const;
---

<section class="ortho-smile-preview" id="sorrisi-prima-dopo" aria-labelledby="ortho-smile-preview-title" data-ortho-smile-carousel>
  <h2 id="ortho-smile-preview-title">Trattamento con allineatori trasparenti Invisalign® per risultati straordinari</h2>

  <div class="ortho-smile-book">
    {[2, 1].map(offset => (
      <div class="ortho-smile-underlay" data-ortho-smile-underlay={offset} aria-hidden="true">
        {phases.map(phase => (
          <img src={orthodonticResults[offset][phase.key].smile} alt="" width="600" height="300" loading="lazy" decoding="async" />
        ))}
      </div>
    ))}
    <p class="landing-visually-hidden" id="ortho-smile-instructions">Sfoglia con il dito o tocca le immagini sovrapposte per vedere altri sorrisi. Con la tastiera, usa i tasti freccia destra e sinistra.</p>
    <div class="ortho-smile-track" id="ortho-smile-track" tabindex="0" role="region" aria-roledescription="carosello" aria-label="Sorrisi prima e dopo il trattamento ortodontico" aria-describedby="ortho-smile-instructions" data-ortho-smile-track>
      {orthodonticResults.map((result, index) => (
        <div class="ortho-smile-slide" role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} di ${orthodonticResults.length}`} data-ortho-smile-slide>
          {phases.map(phase => (
            <figure>
              <img src={result[phase.key].smile} alt={`Sorriso ${phase.key === 'before' ? 'prima del' : 'dopo il'} trattamento ortodontico`} width="600" height="300" loading="lazy" decoding="async" />
              <figcaption>{phase.label}</figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
    <button class="ortho-smile-page-corner" type="button" aria-label="Sfoglia il prossimo confronto" aria-controls="ortho-smile-track" title="Sfoglia con il dito o tocca le immagini sovrapposte" data-ortho-smile-page-corner></button>
  </div>

</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ortho-smile-carousel]').forEach(carousel => {
    const track = carousel.querySelector<HTMLElement>('[data-ortho-smile-track]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-ortho-smile-slide]'));
    const pageCorner = carousel.querySelector<HTMLButtonElement>('[data-ortho-smile-page-corner]');
    const book = carousel.querySelector<HTMLElement>('.ortho-smile-book');
    const underlays = Array.from(carousel.querySelectorAll<HTMLElement>('[data-ortho-smile-underlay]'));
    if (!track || !pageCorner || !book || slides.length < 2 || track.dataset.loopBound) return;
    track.dataset.loopBound = 'true';

    // Identical end copies let a native finger swipe continue across either boundary.
    const makeLoopCopy = (slide: HTMLElement) => {
      const copy = slide.cloneNode(true) as HTMLElement;
      copy.removeAttribute('data-ortho-smile-slide');
      copy.setAttribute('data-ortho-smile-loop-copy', '');
      copy.setAttribute('aria-hidden', 'true');
      copy.inert = true;
      return copy;
    };
    const leadingCopy = makeLoopCopy(slides[slides.length - 1]);
    const trailingCopy = makeLoopCopy(slides[0]);
    track.prepend(leadingCopy);
    track.append(trailingCopy);
    const loopSlides = [leadingCopy, ...slides, trailingCopy];

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let touchActive = false;
    let settleTimer: ReturnType<typeof setTimeout> | undefined;
    let observedWidth = 0;

    const updateUnderlays = () => {
      underlays.forEach(underlay => {
        const offset = Number(underlay.dataset.orthoSmileUnderlay);
        const nextImages = slides[(current + offset) % slides.length].querySelectorAll('img');
        underlay.querySelectorAll('img').forEach((image, index) => {
          const src = nextImages[index]?.getAttribute('src');
          if (src && image.getAttribute('src') !== src) image.src = src;
        });
      });
    };

    const nearestSlide = () => loopSlides.reduce((nearest, slide, index) => (
      Math.abs(slide.offsetLeft - track.scrollLeft) < Math.abs(loopSlides[nearest].offsetLeft - track.scrollLeft) ? index : nearest
    ), 0);

    const updateCurrent = () => {
      if (!track.clientWidth) return;
      const nextCurrent = (nearestSlide() - 1 + slides.length) % slides.length;
      if (nextCurrent !== current) {
        current = nextCurrent;
        updateUnderlays();
      }
    };

    const normalizeLoop = () => {
      if (touchActive || !track.clientWidth) return;
      if (Math.abs(track.scrollLeft - leadingCopy.offsetLeft) < 2) {
        track.scrollTo({ left: slides[slides.length - 1].offsetLeft, behavior: 'instant' });
      } else if (Math.abs(track.scrollLeft - trailingCopy.offsetLeft) < 2) {
        track.scrollTo({ left: slides[0].offsetLeft, behavior: 'instant' });
      }
      updateCurrent();
    };

    const scheduleNormalization = () => {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(normalizeLoop, 180);
    };

    const showSlide = (index: number) => {
      const target = Math.max(0, Math.min(loopSlides.length - 1, index));
      track.scrollTo({ left: loopSlides[target].offsetLeft, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    };

    const turnPage = (direction: number) => {
      normalizeLoop();
      showSlide(nearestSlide() + direction);
    };

    let cornerTouch: { x: number; y: number } | undefined;
    let ignoreCornerClickUntil = 0;
    pageCorner.addEventListener('touchstart', event => {
      const touch = event.touches[0];
      cornerTouch = touch ? { x: touch.clientX, y: touch.clientY } : undefined;
    }, { passive: true });
    pageCorner.addEventListener('touchend', event => {
      const touch = event.changedTouches[0];
      if (touch && cornerTouch) {
        const dx = touch.clientX - cornerTouch.x;
        const dy = touch.clientY - cornerTouch.y;
        if (Math.abs(dx) > 30 && Math.abs(dx) > Math.abs(dy) * 1.2) {
          ignoreCornerClickUntil = Date.now() + 350;
          turnPage(dx < 0 ? 1 : -1);
        }
      }
      cornerTouch = undefined;
    }, { passive: true });
    pageCorner.addEventListener('touchcancel', () => { cornerTouch = undefined; }, { passive: true });
    pageCorner.addEventListener('click', () => {
      if (Date.now() >= ignoreCornerClickUntil) turnPage(1);
    });

    track.addEventListener('scroll', () => { updateCurrent(); scheduleNormalization(); }, { passive: true });
    track.addEventListener('scrollend', normalizeLoop);
    track.addEventListener('touchstart', () => {
      touchActive = true;
      clearTimeout(settleTimer);
    }, { passive: true });
    const finishTouch = () => { touchActive = false; scheduleNormalization(); };
    track.addEventListener('touchend', finishTouch, { passive: true });
    track.addEventListener('touchcancel', finishTouch, { passive: true });
    track.addEventListener('keydown', event => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        turnPage(event.key === 'ArrowRight' ? 1 : -1);
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        showSlide(event.key === 'Home' ? 1 : slides.length);
      }
    });
    new ResizeObserver(() => {
      if (track.clientWidth > 0 && track.clientWidth !== observedWidth) {
        observedWidth = track.clientWidth;
        clearTimeout(settleTimer);
        track.scrollTo({ left: slides[current].offsetLeft, behavior: 'instant' });
      }
    }).observe(track);
  });
</script>

<style>
  .ortho-smile-preview {
    display: none;
  }

  @media (max-width: 720px) {
    .ortho-smile-preview {
      display: block;
      padding: 48px 0 0;
      background: var(--surface-white);
    }

    .ortho-smile-preview h2 {
      margin: 0 34px 28px;
      color: var(--brand-primary-dark);
      font-size: 30px;
      font-weight: 500;
      line-height: 1.16;
      letter-spacing: -.16px;
      text-wrap: balance;
    }

    .ortho-smile-book {
      position: relative;
      margin-inline: 12px;
      padding: 0 20px 20px 0;
      isolation: isolate;
    }

    .ortho-smile-underlay {
      position: absolute;
      inset: 0 20px 20px 0;
      display: grid;
      grid-template-rows: 1fr 1fr;
      gap: 2px;
      overflow: hidden;
      border-radius: 18px;
      outline: 2px solid var(--surface-white);
      background: var(--border);
      box-shadow: 0 3px 8px rgba(16, 40, 61, .16);
      pointer-events: none;
    }

    .ortho-smile-underlay[data-ortho-smile-underlay="2"] {
      z-index: 0;
      transform: translate(20px, 20px);
    }

    .ortho-smile-underlay[data-ortho-smile-underlay="1"] {
      z-index: 1;
      transform: translate(10px, 10px);
    }

    .ortho-smile-underlay img {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 0;
      object-fit: cover;
    }

    .ortho-smile-track {
      position: relative;
      z-index: 2;
      display: flex;
      gap: 16px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      border-radius: 18px;
      background: var(--surface-white);
      box-shadow: 0 3px 14px rgba(16, 40, 61, .18);
    }

    .ortho-smile-track::-webkit-scrollbar {
      display: none;
    }

    .ortho-smile-slide {
      display: grid;
      flex: 0 0 100%;
      min-width: 0;
      gap: 2px;
      overflow: hidden;
      border-radius: 18px;
      background: var(--border);
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .ortho-smile-slide figure {
      position: relative;
      margin: 0;
    }

    .ortho-smile-slide img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 1;
    }

    .ortho-smile-slide figcaption {
      position: absolute;
      bottom: 12px;
      left: 12px;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(16, 40, 61, .9);
      color: var(--surface-white);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: normal;
    }

    .ortho-smile-page-corner {
      position: absolute;
      right: 0;
      bottom: 0;
      z-index: 3;
      width: 64px;
      height: 64px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--brand-cta);
      cursor: grab;
      touch-action: pan-y;
    }

    .ortho-smile-page-corner:active { cursor: grabbing; }

    .ortho-smile-page-corner:focus-visible,
    .ortho-smile-track:focus-visible {
      outline: 3px solid var(--brand-blue);
      outline-offset: 4px;
    }
  }

</style>
