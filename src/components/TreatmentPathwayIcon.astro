---
import type { TreatmentPathwayIconName } from '../data/treatmentMarketing';

interface Props {
  name: TreatmentPathwayIconName;
}

const { name } = Astro.props;
---

<span class="treatment-pathway-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {name === 'assessment' && (
      <>
        <circle cx="10.5" cy="10.5" r="5.75"></circle>
        <path d="m14.8 14.8 4.7 4.7"></path>
        <path d="M8.1 10.5h4.8M10.5 8.1v4.8"></path>
      </>
    )}
    {name === 'restoration' && (
      <>
        <path d="M8.2 3.5c-2.7 0-4.4 2.2-4.1 5 .2 2 1.2 3.2 1.8 4.8.7 1.8.6 5.2 2.3 6.6 1 .8 1.7-2.2 3.8-2.2s2.8 3 3.8 2.2c1.7-1.4 1.6-4.8 2.3-6.6.6-1.6 1.6-2.8 1.8-4.8.3-2.8-1.4-5-4.1-5-1.6 0-2.4.8-3.8.8s-2.2-.8-3.8-.8Z"></path>
        <path d="M12 8v5M9.5 10.5h5"></path>
      </>
    )}
    {name === 'monitoring' && (
      <>
        <rect x="3.5" y="5.5" width="17" height="15" rx="2.5"></rect>
        <path d="M7.5 3.5v4M16.5 3.5v4M3.5 9.5h17"></path>
        <path d="m8.2 15 2.3 2.2 5-5"></path>
      </>
    )}
    {name === 'child' && (
      <>
        <circle cx="12" cy="12" r="8.5"></circle>
        <path d="M9 10h.01M15 10h.01M8.8 14.2c1.8 2 4.6 2 6.4 0"></path>
        <path d="M8.3 4.5c.8 1.7 2.2 2.6 4.2 2.6 1.4 0 2.6-.5 3.5-1.4"></path>
      </>
    )}
    {name === 'prevention' && (
      <>
        <path d="M12 3.2 19 6v5.2c0 4.3-2.8 7.7-7 9.6-4.2-1.9-7-5.3-7-9.6V6l7-2.8Z"></path>
        <path d="m8.6 12.1 2.1 2.1 4.8-5"></path>
      </>
    )}
    {name === 'growth' && (
      <>
        <path d="M12 20V9.5"></path>
        <path d="M12 12c-4.2.2-6.7-1.8-7.2-5.7 4.1-.4 6.5 1.5 7.2 5.7Z"></path>
        <path d="M12 9.5c.8-3.5 3.2-5.2 7-4.8-.3 3.6-2.7 5.4-7 4.8Z"></path>
        <path d="M8 20h8"></path>
      </>
    )}
    {name === 'alignment' && (
      <>
        <path d="M4 7h13M14 4l3 3-3 3M20 17H7M10 14l-3 3 3 3"></path>
        <circle cx="5" cy="17" r="1.5"></circle>
        <circle cx="19" cy="7" r="1.5"></circle>
      </>
    )}
    {name === 'design' && (
      <>
        <path d="m4 20 4.2-1 10.9-10.9a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"></path>
        <path d="m14.7 6.5 3 3M5.2 16l3 3M12.5 20H20"></path>
      </>
    )}
    {name === 'precision' && (
      <>
        <circle cx="11" cy="13" r="7.5"></circle>
        <circle cx="11" cy="13" r="3.2"></circle>
        <path d="m13.3 10.7 6.2-6.2M16.5 4.5h3v3"></path>
      </>
    )}
    {name === 'inflammation' && (
      <>
        <path d="M12 3.5c3.8 4.4 6 7.1 6 10.1A6 6 0 0 1 6 13.6c0-3 2.2-5.7 6-10.1Z"></path>
        <path d="M9 14.2c.7 1.8 2 2.7 4 2.7"></path>
        <path d="M19 5v4M17 7h4"></path>
      </>
    )}
    {name === 'surgery' && (
      <>
        <path d="m5 4 15 15M15.5 4.5l4 4-9.8 9.8a2.8 2.8 0 0 1-4 0 2.8 2.8 0 0 1 0-4l9.8-9.8Z"></path>
        <path d="m4 20 3-3"></path>
      </>
    )}
    {name === 'healing' && (
      <>
        <path d="M20.2 5.8c-2.1-2.1-5.5-1.8-7.4.5L12 7.2l-.8-.9C9.3 4 5.9 3.7 3.8 5.8c-2.3 2.3-1.8 5.7.2 7.8L12 21l8-7.4c2-2.1 2.5-5.5.2-7.8Z"></path>
        <path d="M6.8 12h3l1.2-2.3 2.1 4.8 1.2-2.5h2.9"></path>
      </>
    )}
    {name === 'implant' && (
      <>
        <path d="M8 4.2h8l1.2 3.4c.5 1.5-.6 3-2.2 3H9c-1.6 0-2.7-1.5-2.2-3L8 4.2Z"></path>
        <path d="M10 10.6v8.2M14 10.6v8.2M9 13h6M9 16h6M10.5 20.5h3"></path>
      </>
    )}
    {name === 'function' && (
      <>
        <path d="M19 8a8 8 0 0 0-13.6-2.2L3.5 8M5 16a8 8 0 0 0 13.6 2.2l1.9-2.2"></path>
        <path d="M3.5 4.5V8H7M20.5 19.5V16H17"></path>
        <circle cx="12" cy="12" r="2.8"></circle>
      </>
    )}
    {name === 'sleep' && (
      <>
        <path d="M18.5 15.5A8 8 0 0 1 8.5 5.2 8 8 0 1 0 18.5 15.5Z"></path>
        <path d="M16.5 4v3M15 5.5h3M20 8.5v2M19 9.5h2"></path>
      </>
    )}
    {name === 'device' && (
      <>
        <path d="M4 8.5c2-2.2 4.7-3.3 8-3.3s6 1.1 8 3.3l-1.3 7.7c-.2 1.5-1.6 2.6-3.1 2.6H8.4c-1.5 0-2.9-1.1-3.1-2.6L4 8.5Z"></path>
        <path d="M6 10.2c1.7 1.2 3.7 1.8 6 1.8s4.3-.6 6-1.8M8 15.2h8"></path>
      </>
    )}
    {name === 'whitening' && (
      <>
        <path d="M8.2 5.5c-2.7 0-4.3 2.2-3.9 4.8.3 1.7 1.2 2.8 1.7 4.2.7 1.7.6 4.3 2.1 5.5 1 .8 1.7-2 3.9-2s2.9 2.8 3.9 2c1.5-1.2 1.4-3.8 2.1-5.5.5-1.4 1.4-2.5 1.7-4.2.4-2.6-1.2-4.8-3.9-4.8-1.6 0-2.4.8-3.8.8s-2.2-.8-3.8-.8Z"></path>
        <path d="M19 2v4M17 4h4M4 3v2M3 4h2"></path>
      </>
    )}
    {name === 'goal' && (
      <>
        <path d="M4 5.5h16v11H9l-5 4v-15Z"></path>
        <path d="M12 14.2 8.7 11c-1.9-2 .9-4.4 3.3-1.8 2.4-2.6 5.2-.2 3.3 1.8L12 14.2Z"></path>
      </>
    )}
    {name === 'history' && (
      <>
        <path d="M5 3.5h10l4 4V20.5H5v-17Z"></path>
        <path d="M15 3.5v4h4M8 10h4"></path>
        <circle cx="12" cy="15" r="3"></circle>
        <path d="M12 13.5v1.7l1.2.8"></path>
      </>
    )}
    {name === 'progress' && (
      <>
        <path d="M4 19h4v-4h4v-4h4V7h4"></path>
        <path d="m15.5 3.5 4.5 3.5-4.5 3.5"></path>
      </>
    )}
  </svg>
</span>

<style>
  .treatment-pathway-icon {
    width: 58px;
    height: 58px;
    display: inline-grid;
    flex: 0 0 58px;
    place-items: center;
    border: 1px solid rgba(var(--brand-blue-rgb), 0.28);
    border-radius: 50%;
    background: var(--soft-blue-bg);
    color: var(--brand-cta);
  }

  svg {
    width: 29px;
    height: 29px;
  }

  @media (max-width: 720px) {
    .treatment-pathway-icon {
      width: 52px;
      height: 52px;
      flex-basis: 52px;
    }

    svg {
      width: 27px;
      height: 27px;
    }
  }
</style>
