---
---

<aside class="cookie-banner" data-cookie-banner role="note" aria-label="GDPR Cookie Banner">
  <div class="cookie-banner-inner">
    <div class="cookie-banner-heading">
      <p class="cookie-banner-title">La tua privacy è importante</p>
    </div>
    <div class="cookie-banner-intro">
      <div class="cookie-banner-copy">
        <p>
          Usiamo cookie necessari e, con il tuo consenso, cookie facoltativi
          per valutare l’efficacia degli annunci e, nelle due landing dedicate, analizzare la navigazione con Microsoft Clarity. Le due scelte sono indipendenti.
          Consulta la <a href="/cookie-privacy/">Cookie Policy</a>.
        </p>
      </div>
      <div class="cookie-actions cookie-primary-actions">
        <button type="button" data-cookie-choice="accept">Accetta tutti</button>
        <button
          type="button"
          class="secondary"
          aria-expanded="false"
          aria-controls="cookie-settings-panel"
          data-cookie-settings-toggle
        >
          Gestisci le preferenze
        </button>
      </div>
    </div>
    <div
      id="cookie-settings-panel"
      class="cookie-settings-panel"
      role="region"
      aria-label="Impostazioni dei cookie"
      data-cookie-settings-panel
      hidden
    >
      <p class="cookie-settings-title">Gestisci le preferenze</p>
      <div class="cookie-settings-row">
        <span>
          <strong>Cookie necessari</strong>
          <small>Essenziali per il corretto funzionamento del sito.</small>
        </span>
        <span class="cookie-settings-status">Sempre attivi</span>
      </div>
      <label class="cookie-settings-row cookie-ads-choice">
        <span>
          <strong>Efficacia degli annunci</strong>
          <small>Con il tuo consenso, questi cookie ci aiutano a capire quali annunci portano visite al sito e richieste di appuntamento. La scelta è facoltativa: la misurazione non include i dati compilati nei moduli e non attiva annunci personalizzati. Puoi cambiare scelta dalle «Preferenze cookie» nel footer. Dettagli nella <a href="/cookie-privacy/">Cookie Policy</a>.</small>
        </span>
        <input type="checkbox" data-cookie-ads aria-label="Consenti i cookie facoltativi per valutare l’efficacia degli annunci" />
      </label>
      <label class="cookie-settings-row cookie-ads-choice">
        <span>
          <strong>Analisi della navigazione (Microsoft Clarity)</strong>
          <small>Facoltativa. Mappe di calore e registrazioni delle interazioni nelle landing di ortodonzia e parodontologia. Moduli e questionari sono mascherati. Il consenso pubblicitario verso Microsoft resta disattivato.</small>
        </span>
        <input type="checkbox" data-cookie-analytics aria-label="Consenti l’analisi della navigazione Microsoft Clarity" />
      </label>
      <div class="cookie-actions cookie-settings-actions">
        <button type="button" class="cookie-settings-back secondary" data-cookie-settings-back>Indietro</button>
        <button type="button" class="secondary" data-cookie-choice="reject">Rifiuta</button>
        <button type="button" data-cookie-settings-save>Salva le preferenze</button>
      </div>
    </div>
  </div>
</aside>

<script>
  import { COOKIE_PREFERENCE_KEY, initGoogleAds } from '../utils/googleAds';
  import { initClarity, isClarityLanding, readClarityConsent, saveClarityConsent, CLARITY_CONSENT_KEY } from '../utils/clarity';
  const banner = document.querySelector('[data-cookie-banner]');
  const settingsToggle = banner?.querySelector('[data-cookie-settings-toggle]');
  const settingsBack = banner?.querySelector('[data-cookie-settings-back]');
  const settingsPanel = banner?.querySelector('[data-cookie-settings-panel]');
  const adsCheckbox = banner?.querySelector<HTMLInputElement>('[data-cookie-ads]');
  const analyticsCheckbox = banner?.querySelector<HTMLInputElement>('[data-cookie-analytics]');
  // Previous consent mentioned necessary cookies only: ask again for Ads.
  const storageKey = COOKIE_PREFERENCE_KEY;

  const readPreference = () => {
    try {
      return localStorage.getItem(storageKey);
    } catch {
      return null;
    }
  };

  const applyPreference = (preference) => {
    if (!preference) return;
    document.documentElement.dataset.cookiePreference = preference;
    if (adsCheckbox) adsCheckbox.checked = preference === 'accept';
    document.dispatchEvent(new CustomEvent('fg-cookie-preference', { detail: { preference } }));
  };

  const setSettingsOpen = (isOpen) => {
    if (!(settingsToggle instanceof HTMLButtonElement) || !(settingsPanel instanceof HTMLElement)) return;
    settingsToggle.setAttribute('aria-expanded', String(isOpen));
    settingsPanel.hidden = !isOpen;
    banner?.classList.toggle('settings-open', isOpen);
  };

  const savePreference = (preference, analytics = analyticsCheckbox?.checked === true) => {
    try {
      localStorage.setItem(storageKey, preference);
    } catch {
      // Il consenso resta valido per la sessione anche se lo storage non è disponibile.
    }

    applyPreference(preference);
    saveClarityConsent(analytics);
    if (analyticsCheckbox) analyticsCheckbox.checked = analytics;
    setSettingsOpen(false);
    banner?.classList.remove('is-visible');
  };

  const storedPreference = readPreference();
  const savedPreference = storedPreference === 'accept' || storedPreference === 'reject' ? storedPreference : null;
  applyPreference(savedPreference);
  initGoogleAds();
  if (analyticsCheckbox) analyticsCheckbox.checked = readClarityConsent() === true;
  initClarity('z6cksjkefy');

  if (banner && (!savedPreference || (isClarityLanding() && readClarityConsent() === null))) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => banner.classList.add('is-visible'));
    });
  }

  settingsToggle?.addEventListener('click', () => {
    const isOpen = settingsToggle.getAttribute('aria-expanded') === 'true';
    setSettingsOpen(!isOpen);
  });

  settingsBack?.addEventListener('click', () => setSettingsOpen(false));
  banner?.querySelector('[data-cookie-settings-save]')?.addEventListener('click', () => {
    savePreference(adsCheckbox?.checked ? 'accept' : 'reject');
  });

  document.addEventListener('fg-cookie-settings-open', () => {
    banner?.classList.add('is-visible');
    setSettingsOpen(true);
  });

  document.querySelectorAll('[data-cookie-settings-open]').forEach((button) => {
    button.addEventListener('click', () => {
      banner?.classList.add('is-visible');
      setSettingsOpen(true);
    });
  });

  banner?.querySelectorAll('[data-cookie-choice]').forEach((button) => {
    button.addEventListener('click', () => {
      const preference = button.getAttribute('data-cookie-choice');
      if (preference === 'accept' || preference === 'reject') savePreference(preference, preference === 'accept');
    });
  });

  window.addEventListener('storage', (event) => {
    if (event.key === CLARITY_CONSENT_KEY || event.key === null) {
      if (analyticsCheckbox) analyticsCheckbox.checked = readClarityConsent() === true;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setSettingsOpen(false);
  });
</script>

<style is:global>
  .cookie-banner {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 80;
    width: 100%;
    max-height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: block;
    border: 0;
    border-top: 1px solid var(--border);
    border-radius: 0;
    padding: 0;
    background: var(--surface-white);
    color: var(--brand-primary-dark);
    box-shadow: 0 -16px 44px rgba(var(--brand-primary-dark-rgb), 0.16);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(calc(100% + 4px));
    transition:
      opacity 240ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 420ms;
  }

  .cookie-banner.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .cookie-banner-inner {
    width: min(100% - 48px, 1280px);
    margin: 0 auto;
    padding: 24px 0 calc(24px + env(safe-area-inset-bottom, 0px));
  }

  .cookie-banner-heading {
    margin-bottom: 12px;
  }

  .cookie-banner-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
  }

  .cookie-banner.settings-open .cookie-banner-heading,
  .cookie-banner.settings-open .cookie-banner-intro {
    display: none;
  }

  .cookie-banner-copy {
    max-width: 720px;
  }

  .cookie-banner .cookie-banner-title {
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: 1.18rem;
    font-weight: 500;
    letter-spacing: -0.2px;
    line-height: 1.2;
  }

  .cookie-banner p {
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: -0.2px;
    line-height: 1.5;
  }

  .cookie-banner a {
    color: var(--brand-cta);
    font-weight: 500;
  }

  .cookie-banner a:hover,
  .cookie-banner a:focus-visible {
    color: var(--brand-cta-hover);
  }

  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cookie-actions button {
    min-height: 48px;
    border: 1px solid var(--brand-cta);
    border-radius: 8px;
    padding: 14px 22px;
    background: var(--brand-cta);
    color: var(--surface-white);
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .cookie-actions button:hover,
  .cookie-actions button:focus-visible {
    border-color: var(--brand-cta-hover);
    background: var(--brand-cta-hover);
    color: var(--surface-white);
    outline: 0;
  }

  .cookie-actions button.secondary {
    border-color: var(--border);
    background: var(--surface-white);
    color: var(--brand-primary-dark);
  }

  .cookie-actions button.secondary:hover,
  .cookie-actions button.secondary:focus-visible {
    border-color: var(--brand-blue);
    background: var(--soft-blue-bg);
    color: var(--brand-primary-dark);
  }

  .cookie-settings-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    align-items: center;
    gap: 24px;
  }

  .cookie-settings-title,
  .cookie-settings-actions {
    grid-column: 1 / -1;
  }

  .cookie-ads-choice { cursor: pointer; }
  .cookie-ads-choice input {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    accent-color: var(--brand-cta);
  }

  .cookie-settings-panel[hidden] {
    display: none;
  }

  .cookie-banner .cookie-settings-title {
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: 1.18rem;
    font-weight: 500;
    letter-spacing: -0.2px;
    line-height: 1.2;
  }

  .cookie-settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
    background: var(--soft-blue-bg);
  }

  .cookie-settings-row > span:first-child {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  .cookie-settings-row strong,
  .cookie-settings-row small {
    display: block;
    color: var(--brand-primary-dark);
  }

  .cookie-settings-row small {
    color: var(--muted-text);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .cookie-settings-status {
    flex: 0 0 auto;
    color: var(--brand-cta);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .cookie-settings-actions {
    justify-content: flex-end;
  }

  .cookie-settings-back { margin-inline-end: auto; }

  @media (max-width: 620px) {
    .cookie-banner {
      font-size: 0.9rem;
    }

    .cookie-banner-inner {
      width: calc(100% - 32px);
      padding: 20px 0 calc(20px + env(safe-area-inset-bottom, 0px));
    }

    .cookie-banner-intro,
    .cookie-settings-panel {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .cookie-banner .cookie-banner-title,
    .cookie-banner .cookie-settings-title {
      font-size: 1.08rem;
      letter-spacing: -0.16px;
    }

    .cookie-banner p {
      letter-spacing: -0.16px;
    }

    .cookie-primary-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .cookie-actions button {
      min-height: 48px;
      padding: 14px 16px;
    }

    .cookie-settings-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cookie-settings-actions button {
      width: 100%;
    }

    .cookie-settings-back { margin-inline-end: 0; }
    .cookie-settings-actions [data-cookie-settings-save] { grid-column: 1 / -1; }
  }

  @media (max-width: 620px) and (prefers-reduced-motion: reduce) {
    .cookie-banner {
      transition: none;
    }
  }
</style>
