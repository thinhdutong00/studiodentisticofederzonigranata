    font-size: 0.96rem;
    line-height: 1.3;
  }

  .location-hours-row span {
    color: var(--muted);
    font-weight: 800;
  }

  .location-hours-row strong {
    color: var(--blue-dark);
    font-weight: 400;
    text-align: right;
  }

  .location-hours-row-closed strong {
    color: var(--brand-primary-dark);
    font-weight: 500;
  }

  .location-route {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.28);
    border-radius: 999px;
    padding: 10px 15px;
    color: var(--blue-dark);
    font-weight: 400;
    text-decoration: none;
  }

  .location-route:hover {
    border-color: var(--brand-primary-dark);
    background: rgba(var(--brand-primary-dark-rgb), 0.07);
    color: var(--brand-primary-dark);
  }

  .locations-map-stack {
    min-height: 780px;
    display: block;
    background: var(--blue-dark);
  }

  .location-map-card {
    position: relative;
    min-height: 780px;
    height: 100%;
    margin: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .location-map-card iframe {
    position: absolute;
    top: -120px;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: calc(100% + 120px);
    border: 0;
    filter: saturate(0.9) contrast(0.98);
  }

  .location-map-caption {
    position: absolute;
    top: clamp(18px, 2.5vw, 34px);
    right: clamp(18px, 2.5vw, 34px);
    z-index: 1;
    max-width: min(420px, calc(100% - 36px));
    display: grid;
    gap: 4px;
    border-radius: 8px;
    padding: 16px 18px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 14px 36px rgba(var(--brand-primary-dark-rgb), 0.16);
  }

  .location-map-caption strong {
    color: var(--blue-dark);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .location-map-caption span {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .location-map-caption a {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: var(--brand-blue);
    font-size: 0.9rem;
    font-weight: 400;
    text-decoration: none;
  }

  .location-map-caption a span {
    color: currentColor;
    font-size: 1.05em;
    line-height: 1;
  }

  @media (max-width: 1160px) {
