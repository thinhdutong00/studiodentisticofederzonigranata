  .review-card-person {
    min-width: 0;
    display: grid;
    gap: 4px;
  }

  .review-card-person strong {
    color: var(--blue-dark);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .review-card-person small {
    color: var(--brand-blue);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .review-stars {
    color: var(--brand-blue);
    font-size: 1.12rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .review-card-copy {
    margin: 0;
    color: var(--text-dark);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.15rem, 1.55vw, 1.45rem);
    font-weight: 500;
    line-height: 1.28;
  }

  .insight-card:hover .review-avatar {
    background: rgba(255, 255, 255, 0.18);
    color: var(--surface-white);
  }

  .insight-card:hover .review-card-person strong,
  .insight-card:hover .review-card-person small,
  .insight-card:hover .review-stars,
  .insight-card:hover .review-card-copy {
    color: var(--surface-white);
  }

  .prefooter-section {
    position: relative;
    padding: clamp(76px, 8vw, 128px) 0;
    overflow: hidden;
    background: var(--background);
    color: var(--brand-primary-dark);
    isolation: isolate;
  }

  .prefooter-section::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    width: min(58vw, 1100px);
    background: url('/assets/cta/dental-instruments-transparent.png') right bottom / contain no-repeat;
    opacity: 0.66;
    pointer-events: none;
  }

  .prefooter-cta {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 3vw, 42px);
    align-items: start;
  }

  .prefooter-copy {
    max-width: 980px;
  }

  .prefooter-eyebrow {
    margin: 0 0 18px;
    color: var(--muted-text);
    font-size: clamp(0.9rem, 1vw, 1.05rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .prefooter-copy h2 {
    max-width: 18ch;
    letter-spacing: -0.025em;
  }

  .prefooter-copy p {
    max-width: 760px;
    margin: 26px 0 0;
    color: var(--muted-text);
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    line-height: 1.45;
  }

  .prefooter-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    justify-self: start;
  }

  .prefooter-section .prefooter-button {
    width: min(100%, 304px);
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.14);
    border-radius: 12px;
    padding: 0 24px;
    background: var(--surface-white);
    color: var(--blue-dark);
    font-size: 1.03rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: none;
    box-shadow: 0 16px 36px rgba(var(--brand-primary-dark-rgb), 0.12);
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .prefooter-section .prefooter-button:hover {
    background: var(--soft-blue-bg);
    color: var(--blue-dark);
    transform: translateY(-1px);
  }

  .prefooter-section .prefooter-button span {
    color: var(--brand-primary-dark);
    font-size: 1.45rem;
    line-height: 1;
  }

  .prefooter-action span {
    color: var(--muted-text);
    font-size: 0.95rem;
    line-height: 1.35;
    text-align: left;
  }

  .locations-section {
    background: var(--background);
    color: var(--ink);
    font-family: inherit;
  }

  .locations-layout {
    min-height: 780px;
    display: grid;
    grid-template-columns: minmax(430px, 0.78fr) minmax(0, 1.22fr);
  }

  .locations-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(58px, 5vw, 84px) clamp(34px, 6vw, 104px);
    background: linear-gradient(180deg, var(--surface-white) 0%, var(--background) 100%);
  }

  .locations-eyebrow {
    margin: 0 0 18px;
    color: var(--blue);
    font-size: clamp(1rem, 1.1vw, 1.125rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .locations-copy h2 {
    max-width: 12ch;
    margin: 0;
    color: var(--blue-dark);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(2rem, 4.8vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.2px;
    line-height: 1.05;
  }

  .location-list {
    display: grid;
    gap: 16px;
    margin-top: clamp(34px, 4vw, 52px);
  }

  .location-card {
    position: relative;
    border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.22);
    border-radius: 8px;
    background: linear-gradient(180deg, var(--surface-white) 0%, var(--background) 100%);
    box-shadow: 0 16px 42px rgba(var(--brand-primary-dark-rgb), 0.08);
    overflow: hidden;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .location-card-open {
    border-color: rgba(var(--brand-primary-dark-rgb), 0.22);
    background: var(--surface-white);
    box-shadow: 0 24px 58px rgba(var(--brand-primary-dark-rgb), 0.13);
  }

  .location-card-trigger {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 38px;
    gap: 18px;
    align-items: center;
    border: 0;
    padding: clamp(22px, 2.4vw, 30px) clamp(22px, 2.4vw, 30px) clamp(22px, 2.4vw, 30px) clamp(26px, 2.7vw, 36px);
    background: transparent;
    color: var(--blue-dark);
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .location-card-title {
    min-width: 0;
  }

  .location-card-trigger strong {
    display: block;
    margin-top: 5px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.25rem, 1.55vw, 1.75rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .location-card-trigger small {
    display: block;
    color: var(--brand-primary-dark);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .location-card-trigger i {
    position: relative;
    width: 38px;
    height: 38px;
    justify-self: end;
    border: 1px solid rgba(var(--brand-primary-dark-rgb), 0.3);
    border-radius: 999px;
    background: var(--surface-white);
    color: var(--brand-primary-dark);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .location-card-trigger i::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 9px;
    height: 9px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translate(-50%, -62%) rotate(45deg);
    transition: transform 180ms ease;
  }

  .location-card-open .location-card-trigger {
    border-bottom: 1px solid rgba(var(--brand-primary-dark-rgb), 0.18);
    background: var(--surface-white);
    color: var(--blue-dark);
  }

  .location-card-open .location-card-trigger small {
    color: var(--brand-primary-dark);
  }

  .location-card-open .location-card-trigger i {
    border-color: var(--brand-primary-dark);
    background: var(--brand-primary-dark);
    color: var(--surface-white);
  }

  .location-card-open .location-card-trigger i::after {
    transform: translate(-50%, -35%) rotate(225deg);
  }

  .location-card-panel {
    display: grid;
    gap: 18px;
    padding: clamp(18px, 1.8vw, 24px) clamp(22px, 2.4vw, 30px) clamp(22px, 2.4vw, 30px) clamp(26px, 2.7vw, 36px);
  }

  .location-card-panel[hidden] {
    display: none;
  }

  .location-detail {
    display: grid;
    gap: 5px;
  }

  .location-detail span,
  .location-hours p {
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
