    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .insight-card:hover {
    background: var(--blue-dark);
    color: var(--surface-white);
  }

  .review-card-head {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
