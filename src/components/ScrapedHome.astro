---
import { site } from '../data/site';
import { videoItems } from '../data/videos';
import { featuredPatientReviews } from '../data/reviews';
import { formatParentheticalDetail } from '../utils/formatParentheticalDetail';
import ClinicalCasesOriginalGrid from './ClinicalCasesOriginalGrid.astro';
import HomeTreatments from './HomeTreatments.astro';

const heroImage = '/assets/original/2021/02/HOME.jpg';
const starsFor = (rating: number) => `${'★'.repeat(rating)}${'☆'.repeat(5 - rating)}`;

const treatmentOrder = [
  'Igiene orale e Prevenzione',
  'Sbiancamento',
  'Conservativa (otturazioni)',
  'Endodonzia (devitalizzazioni)',
  'Pedodonzia (odontoiatria infantile)',
  'Ortodonzia e Allineatori invisibili (adulti e bimbi)',
  'Estetica diretta (faccette in composito)',
  'Parodontologia (cure gengivali)',
  'Protesi fissa e mobile',
  'Estetica Indiretta (faccette in porcellana)',
  'Chirurgia Stomatologica',
  'Implantologia tradizionale e computer guidata',
  'Gnatologia (disturbi articolazione temporo-mandibolare)',
  'Dispositivi contro il russamento e le apnee notturne',
];

const treatmentMenuLabels: Record<string, string> = {
  'Estetica diretta (faccette in composito)': 'Faccette in composito',
  'Estetica Indiretta (faccette in porcellana)': 'Faccette in ceramica',
};

const treatmentDescriptions: Record<string, string> = {
  'Igiene orale e Prevenzione': 'Controlli periodici, sedute di igiene e indicazioni personalizzate per mantenere denti e gengive in salute.',
  Sbiancamento: 'Trattamenti professionali per migliorare il colore del sorriso in modo controllato e rispettoso dei tessuti dentali.',
  'Conservativa (otturazioni)': 'Otturazioni, restauri e ricostruzioni per recuperare i denti danneggiati preservando la struttura naturale.',
  'Endodonzia (devitalizzazioni)': 'Cure canalari e devitalizzazioni per trattare infezioni profonde e salvare il dente quando possibile.',
  'Pedodonzia (odontoiatria infantile)': 'Percorsi dedicati ai bambini, dalla prevenzione alle prime cure, con attenzione a serenità e fiducia.',
  'Ortodonzia e Allineatori invisibili (adulti e bimbi)': 'Soluzioni ortodontiche per adulti e bambini, anche con allineatori trasparenti e piani su misura.',
  'Estetica diretta (faccette in composito)': 'Faccette e restauri diretti in composito per armonizzare forma, proporzioni e naturalezza del sorriso.',
  'Parodontologia (cure gengivali)': 'Diagnosi e terapie per gengive e tessuti di sostegno, pensate per stabilizzare e proteggere il sorriso.',
  'Protesi fissa e mobile': 'Soluzioni protesiche fisse o mobili per recuperare estetica, masticazione e comfort quotidiano.',
  'Estetica Indiretta (faccette in porcellana)': 'Faccette in ceramica e soluzioni estetiche indirette per risultati resistenti, luminosi e naturali.',
  'Chirurgia Stomatologica': 'Interventi chirurgici del cavo orale, comprese estrazioni e procedure specialistiche pianificate con cura.',
  'Implantologia tradizionale e computer guidata': 'Impianti dentali tradizionali o guidati digitalmente per sostituire denti mancanti in modo preciso.',
  'Gnatologia (disturbi articolazione temporo-mandibolare)': 'Valutazione di articolazione, masticazione e bruxismo per migliorare equilibrio e comfort funzionale.',
  'Dispositivi contro il russamento e le apnee notturne': 'Dispositivi intraorali personalizzati per contribuire alla gestione di russamento e apnee notturne.',
};

const services = site.treatmentMenu
  .flatMap((category) => category.items)
  .sort((a, b) => treatmentOrder.indexOf(a.label) - treatmentOrder.indexOf(b.label))
  .map((item) => ({
    title: treatmentMenuLabels[item.label] || formatParentheticalDetail(item.label),
    description: treatmentDescriptions[item.label],
    href: item.href,
  }));

const specialistFeature = {
  title: 'L’attenzione dei migliori specialisti.',
  text: 'Siamo professionisti con oltre 35 anni di esperienza e riconoscimenti dalle più prestigiose società scientifiche nazionali e internazionali.',
  cta: 'Guarda i nostri Cv',
  href: '/chi-siamo/',
  image: '/assets/original/2021/03/IL-DIGITALE-scaled.jpg',
  alt: 'Specialista dello studio durante la pianificazione digitale di una cura dentale',
};

const technologyFeature = {
  titleLead: 'Tecnologia all’avanguardia per una',
  titleAccent: 'cura dentale di precisione.',
  text: 'Scopri di più',
  href: '/strumentazioni-attrezzature-tecniche/',
  image: '/assets/feature-stack/tecnologia-radiografia-mobile.jpg',
  alt: 'Paziente durante un esame diagnostico digitale nello studio dentistico',
};

const workplaceFeature = {
  title: 'La prima visita comincia dall’ascolto.',
  titleEnd: '',
  text: 'Ascoltiamo le tue esigenze, raccogliamo tutte le informazioni necessarie e definiamo insieme un percorso di cura chiaro e personalizzato.',
  image: '/assets/feature-stack/prima-visita-bambina.jpg',
  alt: 'Bambina durante una visita nello studio dentistico',
  links: [
    { label: 'Scopri come si svolge', href: '/prima-visita/' },
  ],
};

const locationOffices = site.offices.map((office) => {
  const query = encodeURIComponent(office.address);
  const slug = office.city
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, '-');

  return {
    ...office,
    slug,
    mapEmbed: `https://www.google.com/maps?q=${query}&output=embed`,
    mapHref: `https://www.google.com/maps/search/?api=1&query=${query}`,
    hoursRows: office.hours.split(';').map((row) => {
      const [label, ...value] = row.split(':');

      return {
        label: label.trim(),
        value: value.join(':').trim(),
        closed: /chiuso/i.test(row),
      };
    }),
  };
});

---

<div class="scraped-home">
  <section class="scraped-hero" aria-label="Studio dentistico Federzoni Granata" style={`--hero-image: url('${heroImage}')`} data-transparent-header-region>
    <div class="scraped-hero-shade" aria-hidden="true"></div>
    <div class="scraped-hero-copy">
      <p class="scraped-pretitle">
        Studio dentistico a Modena e Reggio Emilia <span class="scraped-pretitle-separator">·</span>
        <span class="scraped-pretitle-experience">Oltre 35 anni di esperienza</span>
      </p>
      <h1>
        <span class="scraped-hero-title-line">il tuo benessere</span>
        <span class="scraped-hero-title-line">inizia da un sorriso</span>
      </h1>
      <p class="scraped-hero-description">
        <span class="scraped-hero-description-desktop">
          Curiamo salute, funzione ed estetica della bocca per adulti e bambini con un piano chiaro prima di iniziare,
          spiegazioni semplici e risultati naturali pensati sul tuo viso.
        </span>
        <span class="scraped-hero-description-mobile">
          Da oltre 35 anni curiamo salute, funzione ed estetica della bocca per adulti e bambini.
        </span>
      </p>
      <div class="scraped-hero-actions" aria-label="Azioni principali">
        <a class="scraped-hero-button scraped-hero-button-primary" href="/prenota-prima-visita/">
          <span class="scraped-hero-cta-desktop">Prenota una valutazione</span>
          <span class="scraped-hero-cta-mobile">Inizia il percorso</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="scraped-hero-button scraped-hero-button-secondary" href="/trattamenti/">
          <span>I nostri trattamenti</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <a class="scraped-scroll" href="#trattamenti-home">Scorri</a>
  </section>

  <HomeTreatments services={services} />

  <section class="feature-stack" id="metodo-studio" aria-label="Servizi e valore dello studio">
    <div class="scraped-wrap feature-stack-inner">
      <section class="feature-split feature-specialists">
        <div class="feature-copy">
          <h2>
            {workplaceFeature.title}{workplaceFeature.titleEnd && <> <span class="feature-title-nowrap">{workplaceFeature.titleEnd}</span></>}
          </h2>
          {workplaceFeature.text && <p>{workplaceFeature.text}</p>}
          <div class="feature-button-list">
            {workplaceFeature.links.map((link) => (
              <a class="feature-button" href={link.href}>
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
        <figure class="feature-image">
          <img src={workplaceFeature.image} alt={workplaceFeature.alt} loading="eager" />
        </figure>
      </section>

      <a class="feature-hero" href={technologyFeature.href} aria-label={technologyFeature.text}>
        <img src={technologyFeature.image} alt={technologyFeature.alt} loading="eager" />
        <span class="feature-hero-shade" aria-hidden="true"></span>
        <div class="feature-hero-copy">
          <h2>
            {technologyFeature.titleLead}
            <strong>{technologyFeature.titleAccent}</strong>
          </h2>
          <p>{technologyFeature.text}</p>
        </div>
      </a>

      <section class="feature-split feature-workplace">
        <figure class="feature-image">
          <img src={specialistFeature.image} alt={specialistFeature.alt} loading="eager" />
        </figure>
        <div class="feature-copy">
          <h2>{specialistFeature.title}</h2>
          <p>{specialistFeature.text}</p>
          <a class="feature-button" href={specialistFeature.href}>
            {specialistFeature.cta}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </div>
  </section>

  <ClinicalCasesOriginalGrid />

  <section class="insights-section" aria-labelledby="insights-title">
    <div class="scraped-wrap">
      <div class="insights-head">
        <h2 id="insights-title">
          <span class="insights-title-desktop">I Nostri Pazienti Dicono</span>
          <span class="insights-title-mobile">La parola ai nostri <strong>Pazienti</strong></span>
        </h2>
        <p class="insights-mobile-description">Esperienze reali tratte dal nostro profilo ufficiale Google Business.</p>
        <div class="google-business-summary" aria-label="Eccellenza 5.0 su Google, cinque stelle su cinque">
          <div class="google-business-brand">
            <svg viewBox="0 0 48 48" role="img" aria-label="Google">
              <path fill="#FFC107" d="M43.61 20.08H42V20H24v8h11.3A12 12 0 1 1 31.96 15.04l5.66-5.66A19.92 19.92 0 0 0 24 4 20 20 0 1 0 19.61 39.51 20 20 0 0 0 44 24c0-1.34-.14-2.65-.39-3.92Z"></path>
              <path fill="#FF3D00" d="m6.31 14.69 6.57 4.82A12 12 0 0 1 31.96 15.04l5.66-5.66A20 20 0 0 0 6.31 14.69Z"></path>
              <path fill="#4CAF50" d="M24 44c5.06 0 9.69-1.9 13.21-5.02l-6.19-5.24A11.9 11.9 0 0 1 12.9 28.49l-6.52 5.02A20 20 0 0 0 24 44Z"></path>
              <path fill="#1976D2" d="M43.61 20.08H42V20H24v8h11.3a12.07 12.07 0 0 1-4.29 5.74l6.19 5.24C36.77 39.37 44 34 44 24c0-1.34-.14-2.65-.39-3.92Z"></path>
            </svg>
            <span><strong>Google</strong><small>Business Profile</small></span>
          </div>
          <div class="google-business-rating">
            <span aria-hidden="true">★★★★★</span>
            <strong>Eccellenza 5.0 su Google</strong>
          </div>
        </div>
        <a href="/recensioni/">Tutte le recensioni</a>
      </div>
      <div class="insights-grid">
        {featuredPatientReviews.map((item) => (
          <a class="insight-card" href="/recensioni/">
            <div class="review-card-head">
              {item.avatar ? (
                <img class="review-avatar" src={item.avatar} alt={`Foto profilo di ${item.author}`} loading="lazy" />
              ) : (
                <span class="review-avatar" aria-hidden="true">{item.initials}</span>
              )}
              <div class="review-card-person">
                <strong>{item.author}</strong>
                <small>Recensione Google • {item.relativeTime}</small>
              </div>
            </div>
            <span class="review-stars" aria-label={`${item.rating} stelle su 5`}>{starsFor(item.rating)}</span>
            <p class="review-card-copy">{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="video-home" class="clinical-carousel-section video-carousel-section" aria-labelledby="video-carousel-title" data-clinical-carousel data-carousel-continuous-speed="42" data-video-gallery>
    <div class="clinical-carousel-head">
      <svg class="video-carousel-youtube-logo" viewBox="0 0 68 48" role="img" aria-label="YouTube">
        <path d="M66.6 7.5a8.3 8.3 0 0 0-5.8-5.9C55.6.2 34 .2 34 .2S12.4.2 7.2 1.6a8.3 8.3 0 0 0-5.8 5.9C0 12.7 0 24 0 24s0 11.3 1.4 16.5a8.3 8.3 0 0 0 5.8 5.9C12.4 47.8 34 47.8 34 47.8s21.6 0 26.8-1.4a8.3 8.3 0 0 0 5.8-5.9C68 35.3 68 24 68 24s0-11.3-1.4-16.5Z" fill="#ff0000"></path>
        <path d="m27.2 34.2 17.9-10.2-17.9-10.2v20.4Z" fill="#fff"></path>
      </svg>
      <p class="scraped-eyebrow">Guarda i nostri</p>
      <h2 id="video-carousel-title">Video</h2>
    </div>

    <div class="clinical-carousel-shell">
      <div class="clinical-carousel-track" data-clinical-carousel-track>
        {videoItems.map((video) => (
          <button
            class="clinical-carousel-card video-carousel-card"
            type="button"
            aria-label={`Riproduci il video: ${video.title}`}
            data-video-id={video.id}
            data-video-title={video.title}>
            <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" loading="lazy" />
            <span class="clinical-carousel-shade" aria-hidden="true"></span>
            <span class="video-carousel-play" aria-hidden="true">▶</span>
            <span class="clinical-carousel-card-copy">
              <strong>{video.title}</strong>
              <small>{video.description}</small>
            </span>
          </button>
        ))}
      </div>

      <div class="video-carousel-controls" aria-label="Controlli del carosello video">
        <button class="clinical-carousel-arrow clinical-carousel-arrow-prev" type="button" aria-label="Scorri i video precedenti" data-clinical-carousel-prev>
          <span aria-hidden="true">‹</span>
        </button>

        <button class="clinical-carousel-arrow clinical-carousel-arrow-next" type="button" aria-label="Scorri i video successivi" data-clinical-carousel-next>
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </section>

  <dialog class="video-dialog" aria-labelledby="video-dialog-title" data-video-dialog>
    <div class="video-dialog-panel">
      <div class="video-dialog-toolbar">
        <h2 id="video-dialog-title" data-video-dialog-title>Video</h2>
        <button type="button" aria-label="Chiudi il video" data-video-dialog-close>×</button>
      </div>
      <div class="video-dialog-frame">
        <iframe
          src=""
          title=""
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          data-video-player></iframe>
      </div>
    </div>
  </dialog>

  <section class="prefooter-section" aria-labelledby="prefooter-title">
    <div class="scraped-wrap prefooter-cta">
      <div class="prefooter-copy">
        <p class="prefooter-eyebrow">INIZIA DA QUI</p>
        <h2 id="prefooter-title">Cosa vorresti migliorare del tuo sorriso?</h2>
        <p>
          Raccontaci la tua esigenza. Ti ricontatteremo per indicarti il percorso più adatto e organizzare la tua visita.
        </p>
      </div>
      <div class="prefooter-action">
        <a class="prefooter-button" href="/richiesta/">Raccontaci la tua esigenza <span aria-hidden="true">↗</span></a>
        <span>Studi a Modena e Reggio Emilia</span>
      </div>
    </div>
  </section>

  <section class="locations-section" aria-labelledby="locations-title" data-locations-map-section>
    <div class="locations-layout">
      <div class="locations-copy">
        <p class="locations-eyebrow">
          <span class="locations-eyebrow-desktop">Sedi e accessibilità</span>
          <span class="locations-eyebrow-mobile">Vicinanza e accessibilità</span>
        </p>
        <h2 id="locations-title">Dove <span>trovarci</span></h2>
        <p class="locations-mobile-description">Scegli la sede più vicina a te e visualizza il percorso interattivo.</p>

        <div class="location-list">
          {locationOffices.map((office, index) => (
            <article
              class:list={['location-card', index === 0 && 'location-card-open']}
              id={office.slug}
              data-location-card
              data-map-src={office.mapEmbed}
              data-map-title={`Mappa dello studio dentistico di ${office.city}`}
              data-map-city={office.city}
              data-map-address={office.address}
              data-map-href={office.mapHref}>
              <button
                class="location-card-trigger"
                type="button"
                aria-expanded={index === 0 ? 'true' : 'false'}
                aria-controls={`sede-${office.slug}-panel`}>
                <span class="location-card-pin" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="2.5"></circle>
                  </svg>
                </span>
                <span class="location-card-title">
                  <small class="location-card-kicker">Studio dentistico di</small>
                  <strong>{office.city}</strong>
                  <span class="location-card-address-mobile">{office.address}</span>
                </span>
                <i aria-hidden="true"></i>
              </button>

              <div class="location-card-panel" id={`sede-${office.slug}-panel`} hidden={index !== 0}>
                <div class="location-detail">
                  <span>Indirizzo</span>
                  <strong>{office.address}</strong>
                </div>

                <div class="location-detail">
                  <span>Telefono</span>
                  <a href={office.phoneHref}>{office.phone}</a>
                </div>

                <div class="location-detail">
                  <span>Email</span>
                  <a href={office.emailHref}>{office.email}</a>
                </div>

                <div class="location-hours" aria-label={`Orari ${office.city}`}>
                  <p>Orari</p>
                  {office.hoursRows.map((row) => (
                    <div class:list={['location-hours-row', row.closed && 'location-hours-row-closed']}>
                      <span>{row.label}</span>
                      <strong>{row.value}</strong>
                    </div>
                  ))}
                </div>

                <a class="location-route" href={office.mapHref} target="_blank" rel="noreferrer">
                  Apri percorso
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        {locationOffices[0] && (
          <details class="locations-mobile-hours">
            <summary>
              <span class="locations-mobile-hours-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="8.5"></circle>
                  <path d="M12 7v5l3.5 2"></path>
                </svg>
              </span>
              <strong>Orari di apertura</strong>
              <i aria-hidden="true"></i>
            </summary>
            <div class="locations-mobile-hours-panel">
              {locationOffices[0].hoursRows.map((row) => (
                <div>
                  <span>{row.label}</span>
                  <strong>{row.value}</strong>
                </div>
              ))}
            </div>
          </details>
        )}
      </div>

      <div class="locations-map-stack" aria-label="Mappa dello studio selezionato">
        {locationOffices[0] && (
          <article class="location-map-card" aria-label={`Mappa ${locationOffices[0].city}`}>
            <iframe
              src={locationOffices[0].mapEmbed}
              title={`Mappa dello studio dentistico di ${locationOffices[0].city}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              data-location-map></iframe>
            <div class="location-map-caption">
              <strong data-location-map-city>{locationOffices[0].city}</strong>
              <span data-location-map-address>{locationOffices[0].address}</span>
              <a href={locationOffices[0].mapHref} target="_blank" rel="noreferrer" data-location-map-link>
                <span class="location-map-link-desktop">Apri su Google Maps</span>
                <span class="location-map-link-mobile">Apri in Maps</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        )}
      </div>
    </div>
  </section>

  <script>
    const clinicalCarousels = document.querySelectorAll('[data-clinical-carousel]');

    clinicalCarousels.forEach((carousel) => {
      const track = carousel.querySelector('[data-clinical-carousel-track]');
      const prev = carousel.querySelector('[data-clinical-carousel-prev]');
      const next = carousel.querySelector('[data-clinical-carousel-next]');

      if (!(track instanceof HTMLElement)) return;

      const originalCards = Array.from(track.querySelectorAll('.clinical-carousel-card')).filter(
        (card) => card instanceof HTMLElement,
      );

      if (originalCards.length < 2) return;

      const cloneCard = (card) => {
        const clone = card.cloneNode(true);
        if (clone instanceof HTMLElement) {
          clone.dataset.carouselClone = 'true';
          clone.setAttribute('aria-hidden', 'true');
          clone.setAttribute('tabindex', '-1');
        }
        return clone;
      };

      const beforeClones = originalCards.map(cloneCard);
      const afterClones = originalCards.map(cloneCard);

      beforeClones
        .slice()
        .reverse()
        .forEach((clone) => track.insertBefore(clone, track.firstChild));
      afterClones.forEach((clone) => track.appendChild(clone));

      const firstOriginal = originalCards[0];
      const firstAfterClone = afterClones[0];

      if (!(firstOriginal instanceof HTMLElement) || !(firstAfterClone instanceof HTMLElement)) return;

      const getScrollAmount = () => {
        const card = track.querySelector('.clinical-carousel-card');
        if (!(card instanceof HTMLElement)) return track.clientWidth * 0.78;

        const styles = window.getComputedStyle(track);
        const gap = Number.parseFloat(styles.columnGap || styles.gap || '0');

        return card.offsetWidth + gap;
      };

      const getLoopMetrics = () => {
        const start = firstOriginal.offsetLeft;
        const width = firstAfterClone.offsetLeft - start;

        return { start, width };
      };

      const normalizeLoopPosition = () => {
        const { start, width } = getLoopMetrics();
        if (width <= 0) return;

        while (track.scrollLeft < start) {
          track.scrollLeft += width;
        }

        while (track.scrollLeft >= start + width) {
          track.scrollLeft -= width;
        }
      };

      const setInitialScroll = () => {
        track.scrollLeft = getLoopMetrics().start + firstOriginal.offsetWidth / 2;
      };

      const scrollLoop = (direction) => {
        if (mobileCarousel.matches) {
          stopAutoplay();
          window.clearTimeout(mobileNavigationResumeTimer);
          navigationAutoplayPaused = true;
          normalizeLoopPosition();

          const cards = Array.from(track.querySelectorAll('.clinical-carousel-card')).filter(
            (card) => card instanceof HTMLElement,
          );
          const viewportCenter = track.scrollLeft + track.clientWidth / 2;
          const centeredCardIndex = cards.reduce((closestIndex, card, index) => {
            const cardCenter = card.offsetLeft + card.offsetWidth / 2;
            const closestCard = cards[closestIndex];
            const closestCenter = closestCard.offsetLeft + closestCard.offsetWidth / 2;

            return Math.abs(cardCenter - viewportCenter) < Math.abs(closestCenter - viewportCenter)
              ? index
              : closestIndex;
          }, 0);
          const targetIndex = Math.max(0, Math.min(cards.length - 1, centeredCardIndex + direction));
          const targetCard = cards[targetIndex];
          const targetScrollLeft = targetCard.offsetLeft - (track.clientWidth - targetCard.offsetWidth) / 2;

          track.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });
          mobileNavigationResumeTimer = window.setTimeout(() => {
            normalizeLoopPosition();
            mobileNavigationResumeTimer = window.setTimeout(() => {
              navigationAutoplayPaused = false;
              scheduleAutoplay();
            }, 3000);
          }, 420);

          return;
        }

        normalizeLoopPosition();
        track.scrollBy({ left: direction * getScrollAmount(), behavior: 'smooth' });
        window.setTimeout(normalizeLoopPosition, 420);
      };

      const autoplaySpeed = Number.parseFloat(carousel.getAttribute('data-carousel-continuous-speed') || '');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mobileCarousel = window.matchMedia('(max-width: 720px)');
      let autoplayFrame = 0;
      let previousAutoplayTime = 0;
      let autoplaySuspended = false;
      let navigationAutoplayPaused = false;
      let mobileNavigationResumeTimer = 0;

      const stopAutoplay = () => {
        window.cancelAnimationFrame(autoplayFrame);
        autoplayFrame = 0;
        previousAutoplayTime = 0;
      };

      const isAutoplayBlocked = () =>
        !Number.isFinite(autoplaySpeed) ||
        autoplaySpeed <= 0 ||
        reducedMotion.matches ||
        document.hidden ||
        autoplaySuspended ||
        navigationAutoplayPaused ||
        (!mobileCarousel.matches && carousel.contains(document.activeElement));

      const runAutoplay = (timestamp) => {
        if (isAutoplayBlocked()) {
          stopAutoplay();
          return;
        }

        if (previousAutoplayTime > 0) {
          const elapsed = Math.min(timestamp - previousAutoplayTime, 50);
          track.scrollLeft += autoplaySpeed * (elapsed / 1000);
          normalizeLoopPosition();
        }

        previousAutoplayTime = timestamp;
        autoplayFrame = window.requestAnimationFrame(runAutoplay);
      };

      const scheduleAutoplay = () => {
        stopAutoplay();
        if (isAutoplayBlocked()) return;

        autoplayFrame = window.requestAnimationFrame(runAutoplay);
      };

      let scrollFrame = 0;

      track.addEventListener(
        'scroll',
        () => {
          window.cancelAnimationFrame(scrollFrame);
          scrollFrame = window.requestAnimationFrame(normalizeLoopPosition);
        },
        { passive: true },
      );

      requestAnimationFrame(() => {
        setInitialScroll();
        scheduleAutoplay();
      });
      window.addEventListener('load', setInitialScroll, { once: true });
      window.addEventListener('resize', () => {
        requestAnimationFrame(setInitialScroll);
        scheduleAutoplay();
      });

      prev?.addEventListener('click', () => {
        scrollLoop(-1);

        if (!mobileCarousel.matches) {
          scheduleAutoplay();
        }
      });

      next?.addEventListener('click', () => {
        scrollLoop(1);

        if (!mobileCarousel.matches) {
          scheduleAutoplay();
        }
      });

      carousel.addEventListener('focusin', () => {
        if (!mobileCarousel.matches) {
          stopAutoplay();
        }
      });
      carousel.addEventListener('focusout', () => requestAnimationFrame(scheduleAutoplay));
      carousel.addEventListener('carousel-autoplay-pause', () => {
        autoplaySuspended = true;
        stopAutoplay();
      });
      carousel.addEventListener('carousel-autoplay-resume', () => {
        autoplaySuspended = false;
        scheduleAutoplay();
      });
      document.addEventListener('visibilitychange', scheduleAutoplay);
      reducedMotion.addEventListener('change', scheduleAutoplay);
      mobileCarousel.addEventListener('change', scheduleAutoplay);
    });

    const videoDialog = document.querySelector('[data-video-dialog]');
    const videoPlayer = videoDialog?.querySelector('[data-video-player]');
    const videoDialogTitle = videoDialog?.querySelector('[data-video-dialog-title]');
    const videoDialogClose = videoDialog?.querySelector('[data-video-dialog-close]');
    let activeVideoGallery = null;

    const closeVideoDialog = () => {
      if (videoDialog instanceof HTMLDialogElement && videoDialog.open) {
        videoDialog.close();
      }

      if (videoPlayer instanceof HTMLIFrameElement) {
        videoPlayer.src = '';
      }

      activeVideoGallery?.dispatchEvent(new Event('carousel-autoplay-resume'));
      activeVideoGallery = null;
    };

    document.querySelectorAll('[data-video-gallery]').forEach((gallery) => {
      gallery.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-video-id]') : null;

        if (!(target instanceof HTMLElement) || !(videoDialog instanceof HTMLDialogElement)) return;

        const videoId = target.dataset.videoId;
        const videoTitle = target.dataset.videoTitle || 'Video dello studio';

        if (!videoId || !(videoPlayer instanceof HTMLIFrameElement)) return;

        videoPlayer.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
        videoPlayer.title = videoTitle;

        if (videoDialogTitle) {
          videoDialogTitle.textContent = videoTitle;
        }

        activeVideoGallery = gallery;
        gallery.dispatchEvent(new Event('carousel-autoplay-pause'));
        videoDialog.showModal();
      });
    });

    videoDialogClose?.addEventListener('click', closeVideoDialog);

    videoDialog?.addEventListener('click', (event) => {
      if (event.target === videoDialog) {
        closeVideoDialog();
      }
    });

    videoDialog?.addEventListener('close', () => {
      if (videoPlayer instanceof HTMLIFrameElement) {
        videoPlayer.src = '';
      }

      activeVideoGallery?.dispatchEvent(new Event('carousel-autoplay-resume'));
      activeVideoGallery = null;
    });

    const locationSections = document.querySelectorAll('[data-locations-map-section]');

    locationSections.forEach((section) => {
      const cards = Array.from(section.querySelectorAll('[data-location-card]'));
      const map = section.querySelector('[data-location-map]');
      const mapCity = section.querySelector('[data-location-map-city]');
      const mapAddress = section.querySelector('[data-location-map-address]');
      const mapLink = section.querySelector('[data-location-map-link]');

      const activateCard = (card) => {
        cards.forEach((item) => {
          const isOpen = item === card;
          const button = item.querySelector('.location-card-trigger');
          const panel = item.querySelector('.location-card-panel');

          item.classList.toggle('location-card-open', isOpen);
          button?.setAttribute('aria-expanded', String(isOpen));

          if (panel) {
            panel.hidden = !isOpen;
          }
        });

        if (map instanceof HTMLIFrameElement && card.dataset.mapSrc && map.src !== card.dataset.mapSrc) {
          map.src = card.dataset.mapSrc;
        }

        if (card.dataset.mapTitle) {
          map?.setAttribute('title', card.dataset.mapTitle);
        }

        if (mapCity && card.dataset.mapCity) {
          mapCity.textContent = card.dataset.mapCity;
        }

        if (mapAddress && card.dataset.mapAddress) {
          mapAddress.textContent = card.dataset.mapAddress;
        }

        if (mapLink instanceof HTMLAnchorElement && card.dataset.mapHref) {
          mapLink.href = card.dataset.mapHref;
        }
      };

      cards.forEach((card) => {
        const button = card.querySelector('.location-card-trigger');
        button?.addEventListener('click', () => activateCard(card));
      });
    });
  </script>
</div>

