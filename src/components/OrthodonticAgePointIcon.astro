  {name === 'protrusion' && (
    <>
      <path d="M13 13c4-1.4 8 1 8.5 5l.8 14.5c-3.3 2.1-7 2.1-10.3 0L10.6 19c-.3-2.8.2-5.2 2.4-6Z" transform="rotate(-13 16 24)"></path>
      <path d="M29 13c4-1.4 8 1 8.5 5l.8 14.5c-3.3 2.1-7 2.1-10.3 0L26.6 19c-.3-2.8.2-5.2 2.4-6Z" transform="rotate(-13 32 24)"></path>
    </>
  )}
</svg>
