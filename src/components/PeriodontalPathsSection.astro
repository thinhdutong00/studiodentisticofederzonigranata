---
import PeriodontalPointIcon from './PeriodontalPointIcon.astro';

interface PeriodontalPath {
  id: string;
  label: string;
  title: string;
  subtitle: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  listIntro: string;
  points: { text: string; icon: string }[];
  faqs: { question: string; answer: string }[];
}

// Informazioni per i pazienti verificate sulle fonti EFP e SIdP in periodontalLanding.ts.
const paths: PeriodontalPath[] = [
  {
    id: 'sanguinamento',
    label: 'Sanguinamento',
    title: 'Le gengive sanguinano?',
    subtitle: 'Ascolta i segnali delle tue gengive',
    description: 'Vorresti lavare i denti senza vedere sangue? Partiamo dalla causa: sanguinamento, rossore e gonfiore possono indicare un’infiammazione delle gengive. Con la visita capiamo se riguarda solo la gengiva o anche il sostegno dei denti e definiamo le cure per migliorare la loro salute.',
    imageSrc: '/assets/optimized/parodontologia-controllo-gengive.webp',
    imageAlt: 'Controllo professionale della salute delle gengive',
    listIntro: 'I segnali che possiamo valutare insieme:',
    points: [
      { text: 'Sangue quando lavi i denti o pulisci gli spazi', icon: 'bleeding' },
      { text: 'Gengive arrossate, gonfie o sensibili', icon: 'inflammation' },
      { text: 'Placca e tartaro lungo il bordo gengivale', icon: 'plaque' },
      { text: 'Alito persistente o sapore sgradevole', icon: 'breath' },
    ],
    faqs: [
      {
        question: 'Il sanguinamento significa sempre parodontite?',
        answer: 'No. Può dipendere da una gengivite o da altre condizioni. Se si ripete, una visita aiuta a capirne la causa e a verificare anche i tessuti che sostengono i denti.',
      },
      {
        question: 'Devo smettere di pulire la zona che sanguina?',
        answer: 'La placca può alimentare l’infiammazione. Ti aiutiamo a scegliere strumenti e gesti delicati ma efficaci per pulire denti e spazi interdentali, senza trascurare le zone più sensibili.',
      },
      {
        question: 'Un collutorio è sufficiente?',
        answer: 'Può essere un aiuto quando indicato dal professionista, ma non sostituisce la pulizia e la valutazione della causa. Il percorso si decide dopo aver controllato le gengive.',
      },
    ],
  },
  {
    id: 'gengive-ritirate',
    label: 'Gengive ritirate',
    title: 'I denti sembrano più lunghi?',
    subtitle: 'Valutiamo le recessioni gengivali',
    description: 'Se noti radici più visibili o fastidio con il freddo, potresti avere una recessione gengivale. Valutiamo perché la gengiva si è ritirata, come rendere più confortevole la pulizia e quali cure possono proteggere la zona esposta.',
    imageSrc: '/assets/optimized/parodontologia-landing-recessioni-1-prima.webp',
    imageAlt: 'Recessioni gengivali prima del trattamento nello studio',
    listIntro: 'I segnali da riferire durante la visita:',
    points: [
      { text: 'Denti che sembrano più lunghi o radici visibili', icon: 'recession' },
      { text: 'Sensibilità al freddo o durante la pulizia', icon: 'sensitivity' },
      { text: 'Cambiamenti del bordo della gengiva', icon: 'gumline' },
      { text: 'Difficoltà a pulire le zone esposte', icon: 'hygiene' },
    ],
    faqs: [
      {
        question: 'Le gengive ritirate indicano sempre parodontite?',
        answer: 'No. Possono influire anche uno spazzolamento troppo energico, la posizione dei denti e le caratteristiche della gengiva. La visita serve a distinguere le cause e scegliere come intervenire.',
      },
      {
        question: 'Si può ricoprire la radice esposta?',
        answer: 'Nei casi indicati si può valutare un trattamento mucogengivale. La possibilità e l’entità della copertura dipendono dal tipo di recessione e dai tessuti disponibili: te ne spieghiamo benefici e limiti.',
      },
      {
        question: 'Come si affronta la sensibilità?',
        answer: 'Controlliamo la zona esposta e la causa del fastidio. Possiamo consigliarti una tecnica di pulizia adatta e valutare prodotti o trattamenti desensibilizzanti, secondo le tue necessità.',
      },
    ],
  },
  {
    id: 'supporto-dei-denti',
    label: 'Supporto dei denti',
    title: 'Denti meno stabili?',
    subtitle: 'Valutiamo il sostegno dei denti',
    description: 'Sentire un dente meno stabile può preoccupare. La visita ci aiuta a capire quanto sostegno conserva e quali cure possono essere utili. Se è presente una parodontite, lavoriamo per controllare l’infiammazione e conservare i denti naturali quando possibile, seguendoti anche nel mantenimento.',
    imageSrc: '/assets/optimized/parodontologia-equipe-clinica.webp',
    imageAlt: 'Équipe dello studio durante una cura odontoiatrica',
    listIntro: 'La visita può essere utile in presenza di:',
    points: [
      { text: 'Denti che si muovono o cambiano posizione', icon: 'mobility' },
      { text: 'Spazi tra i denti comparsi nel tempo', icon: 'spacing' },
      { text: 'Una precedente diagnosi di parodontite', icon: 'history' },
      { text: 'Controlli e mantenimento da riprendere', icon: 'maintenance' },
    ],
    faqs: [
      {
        question: 'Un dente che si muove va sempre estratto?',
        answer: 'Non automaticamente. Consideriamo il sostegno residuo, la funzione e la risposta alle cure. La valutazione ci permette di spiegarti quali possibilità ci sono per conservarlo e quali limiti presenta il caso.',
      },
      {
        question: 'Per curare la parodontite serve la chirurgia?',
        answer: 'Il percorso parte generalmente dalla terapia non chirurgica e dall’igiene quotidiana. Dopo la rivalutazione, solo se indicato, consideriamo ulteriori trattamenti, compresa la chirurgia.',
      },
      {
        question: 'Ogni quanto dovrò fare i controlli?',
        answer: 'La frequenza dipende dalla salute delle gengive, dalla risposta alla terapia e dai fattori di rischio. Concordiamo richiami personalizzati per seguire la stabilità nel tempo e aggiornare le indicazioni per casa.',
      },
    ],
  },
];
---

<section class="ortho-age-section periodontal-paths-section" id="ortodonzia-tutte-le-eta" aria-labelledby="ortho-age-title">
  <span id="percorsi-ortodontici" class="ortho-age-anchor" aria-hidden="true"></span>
  <div class="periodontal-paths-copy">
    <h2 id="ortho-age-title">Le gengive sanguinano? <strong>Prendiamocene cura.</strong></h2>
    <p class="ortho-age-intro">Noti sangue sullo spazzolino, gengive che si ritirano o denti meno stabili? Durante la visita partiamo da ciò che hai notato, valutiamo la salute delle gengive e ti aiutiamo a capire come prendertene cura.</p>
  </div>
  <ul class="ortho-age-list">
    {paths.map(path => <li>
      <button type="button" data-ortho-age-open={path.id} aria-haspopup="dialog" aria-controls="ortho-age-sheet" aria-expanded="false">
        <span>{path.label}</span>
        <span class="ortho-age-open-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6 12h12m-5-5 5 5-5 5" /></svg></span>
      </button>
    </li>)}
  </ul>
  <noscript><a class="ortho-cta" href="#ortho-final">Prenota una visita</a></noscript>
</section>

<dialog class="ortho-age-sheet" id="ortho-age-sheet" aria-labelledby="ortho-age-sanguinamento-title" data-ortho-age-sheet>
  <button class="ortho-age-close" type="button" aria-label="Chiudi la scheda" data-ortho-age-close>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
  </button>
  {paths.map(path => <article class="ortho-age-content" data-ortho-age-content={path.id} hidden>
    <header class="ortho-age-heading">
      <img class="ortho-age-photo" src={path.imageSrc} alt={path.imageAlt} width="88" height="88" loading="lazy" decoding="async" />
      <p class="ortho-age-label">{path.label}</p>
      <h2 id={`ortho-age-${path.id}-title`} tabindex="-1">{path.title}</h2>
      <p class="ortho-age-range">{path.subtitle}</p>
    </header>
    <div class="ortho-age-copy" tabindex="0" role="region" aria-label={`Informazioni: ${path.label.toLowerCase()}`}>
      <p class="ortho-age-description" id={`ortho-age-${path.id}-description`}>{path.description}</p>
      <p class="ortho-age-list-intro">{path.listIntro}</p>
      <ul class="ortho-age-points" role="list">
        {path.points.map(point => <li>
          <span class="ortho-age-point-symbol" aria-hidden="true"><PeriodontalPointIcon name={point.icon} /></span>
          <span>{point.text}</span>
        </li>)}
      </ul>
      <section class="ortho-age-faq" aria-labelledby={`ortho-age-${path.id}-faq-title`}>
        <h3 id={`ortho-age-${path.id}-faq-title`}>Domande frequenti</h3>
        <div class="ortho-age-faq-list">
          {path.faqs.map(faq => <details name={`ortho-age-${path.id}-faq`}>
            <summary>
              <span>{faq.question}</span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M5 12h14" />
                <path class="ortho-age-faq-plus" d="M12 5v14" />
              </svg>
            </summary>
            <p>{faq.answer}</p>
          </details>)}
        </div>
      </section>
    </div>
    <footer class="ortho-age-actions">
      <a class="ortho-age-visit" href="#ortho-final" data-ortho-age-visit>
        Prenota una visita
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg>
      </a>
    </footer>
  </article>)}
</dialog>

<script>
  const ageSheet = document.querySelector<HTMLDialogElement>('[data-ortho-age-sheet]');
  const ageTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ortho-age-open]'));
  const agePanels = Array.from(ageSheet?.querySelectorAll<HTMLElement>('[data-ortho-age-content]') || []);

  if (ageSheet && ageTriggers.length) {
    const mobileViewport = window.matchMedia('(max-width: 720px)');
    const enabled = () => document.body.classList.contains('ortho-unified') || mobileViewport.matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeTrigger: HTMLButtonElement | null = null;
    let previousOverflow = '';
    let visitRequested = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const finishClose = () => {
      clearTimeout(closeTimer);
      ageSheet.classList.remove('is-closing');
      ageSheet.close();
    };

    const closeSheet = (visit = false, immediate = false) => {
      if (!ageSheet.open) return;
      visitRequested = visit;
      if (immediate || reducedMotion.matches) {
        finishClose();
      } else if (!ageSheet.classList.contains('is-closing')) {
        ageSheet.classList.add('is-closing');
        closeTimer = setTimeout(finishClose, 260);
      }
    };

    ageTriggers.forEach(trigger => trigger.addEventListener('click', () => {
      if (!enabled() || ageSheet.open) return;
      const selectedPanel = agePanels.find(panel => panel.dataset.orthoAgeContent === trigger.dataset.orthoAgeOpen);
      const heading = selectedPanel?.querySelector<HTMLHeadingElement>('h2');
      const description = selectedPanel?.querySelector<HTMLElement>('.ortho-age-description');
      if (!selectedPanel || !heading || !description) return;
      agePanels.forEach(panel => { panel.hidden = panel !== selectedPanel; });
      ageSheet.setAttribute('aria-labelledby', heading.id);
      ageSheet.setAttribute('aria-describedby', description.id);
      activeTrigger = trigger;
      activeTrigger.setAttribute('aria-expanded', 'true');
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      visitRequested = false;
      ageSheet.showModal();
      ageSheet.scrollTop = 0;
      const scrollableCopy = selectedPanel.querySelector<HTMLElement>('.ortho-age-copy');
      if (scrollableCopy) scrollableCopy.scrollTop = 0;
      heading.focus({ preventScroll: true });
    }));

    ageSheet.querySelector('[data-ortho-age-close]')?.addEventListener('click', () => closeSheet());
    ageSheet.addEventListener('cancel', event => { event.preventDefault(); closeSheet(); });
    ageSheet.addEventListener('click', event => {
      const bounds = ageSheet.getBoundingClientRect();
      if (event.target === ageSheet && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) closeSheet();
    });
    ageSheet.addEventListener('animationend', event => {
      if (event.target === ageSheet && event.animationName === 'ortho-age-sheet-out') finishClose();
    });
    ageSheet.querySelectorAll<HTMLAnchorElement>('[data-ortho-age-visit]').forEach(link => link.addEventListener('click', event => {
      event.preventDefault();
      closeSheet(true);
    }));
    ageSheet.addEventListener('close', () => {
      clearTimeout(closeTimer);
      ageSheet.classList.remove('is-closing');
      document.body.style.overflow = previousOverflow;
      activeTrigger?.setAttribute('aria-expanded', 'false');
      if (visitRequested) {
        const destination = document.querySelector<HTMLElement>('#ortho-final');
        destination?.setAttribute('tabindex', '-1');
        destination?.focus({ preventScroll: true });
        destination?.scrollIntoView({ behavior: reducedMotion.matches ? 'instant' : 'smooth', block: 'start' });
      } else if (enabled()) {
        activeTrigger?.focus({ preventScroll: true });
      }
      visitRequested = false;
    });
    mobileViewport.addEventListener('change', () => { if (!enabled()) closeSheet(false, true); });
  }
</script>

<style>
  .ortho-age-section { position: relative; display: none; }
  .ortho-age-anchor { position: absolute; top: 0; left: 0; width: 1px; height: 1px; }
  .ortho-age-braces { display: none; }
  .ortho-age-sheet { position: fixed; inset: auto 0 0; width: 100%; max-width: 720px; max-height: 88svh; margin: 0 auto; padding: 0; overflow: hidden; border: 0; border-radius: 28px 28px 0 0; background: var(--surface-white); color: var(--brand-primary-dark); font: inherit; }
  .ortho-age-sheet::backdrop { background: rgba(16, 40, 61, .48); backdrop-filter: blur(3px); }
  .ortho-age-sheet[open] { animation: ortho-age-sheet-in 360ms cubic-bezier(.22, 1, .36, 1) both; }
  .ortho-age-sheet[open]::backdrop { animation: ortho-age-backdrop-in 220ms ease both; }
  .ortho-age-sheet.is-closing { animation: ortho-age-sheet-out 220ms ease-in both; }
  .ortho-age-sheet.is-closing::backdrop { animation: ortho-age-backdrop-out 220ms ease both; }
  .ortho-age-sheet [hidden] { display: none !important; }
  .ortho-age-close { position: absolute; z-index: 1; top: 16px; right: 16px; display: grid; place-items: center; width: 44px; height: 44px; padding: 11px; border: 1px solid var(--border); border-radius: 50%; background: var(--surface-white); color: var(--muted-text); cursor: pointer; }
  .ortho-age-close svg, .ortho-age-visit svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ortho-age-content { display: flex; flex-direction: column; min-height: 0; max-height: inherit; text-align: center; }
  .ortho-age-heading { flex: 0 0 auto; display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: center; column-gap: 16px; row-gap: 4px; padding: 28px 72px 22px 24px; border-bottom: 1px solid var(--border); text-align: left; }
  .ortho-age-photo { grid-column: 1; grid-row: 1 / span 3; display: block; width: 64px; height: 64px; margin: 0; border-radius: 18px; background: var(--soft-blue-bg); object-fit: cover; }
  .ortho-age-label { grid-column: 2; grid-row: 1; margin: 0; color: var(--brand-cta); font-size: 12px; font-weight: 500; line-height: 1.3; letter-spacing: normal; text-transform: uppercase; }
  .ortho-age-content h2 { grid-column: 2; grid-row: 2; margin: 0; color: var(--brand-primary-dark); font-size: 24px; font-weight: 500; line-height: 1.18; letter-spacing: -.16px; text-wrap: balance; }
  .ortho-age-range { grid-column: 2; grid-row: 3; margin: 0; color: var(--brand-cta); font-size: 14px; font-weight: 500; line-height: 1.3; }
  .ortho-age-copy { min-height: 0; padding: 24px 28px; overflow-y: auto; overscroll-behavior-y: contain; text-align: left; }
  .ortho-age-description { margin: 0; color: var(--muted-text); font-size: 17px; font-weight: 400; line-height: 1.5; letter-spacing: -.16px; }
  .ortho-age-list-intro { margin: 24px 0 14px; color: var(--brand-primary-dark); font-size: 16px; font-weight: 500; line-height: 1.4; }
  .ortho-age-points { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 24px; margin: 24px 0 0; padding: 0; list-style: none; }
  .ortho-age-points li { display: flex; min-width: 0; flex-direction: column; align-items: center; gap: 12px; color: var(--brand-primary-dark); font-size: 15px; font-weight: 400; line-height: 1.45; text-align: center; }
  .ortho-age-point-symbol { display: block; flex: 0 0 auto; width: 42px; height: 42px; color: var(--brand-cta); }
  .ortho-age-point-symbol :global(svg) { display: block; width: 100%; height: 100%; }
  .ortho-age-faq { margin-top: 32px; }
  .ortho-age-faq h3 { margin: 0 0 12px; color: var(--brand-primary-dark); font-size: 20px; font-weight: 500; line-height: 1.3; }
  .ortho-age-faq-list { border-top: 1px solid var(--border); }
  .ortho-age-faq details { border-bottom: 1px solid var(--border); }
  .ortho-age-faq summary { display: flex; min-height: 54px; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 0; color: var(--brand-primary-dark); font-size: 15px; font-weight: 500; line-height: 1.4; cursor: pointer; list-style: none; }
  .ortho-age-faq summary::-webkit-details-marker { display: none; }
  .ortho-age-faq summary svg { flex: 0 0 20px; width: 20px; height: 20px; color: var(--brand-cta); stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .ortho-age-faq summary:hover { color: var(--brand-cta); }
  .ortho-age-faq summary:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 3px; border-radius: 3px; }
  .ortho-age-faq details[open] .ortho-age-faq-plus { opacity: 0; }
  .ortho-age-faq details > p { margin: 0; padding: 0 36px 18px 0; color: var(--muted-text); font-size: 15px; font-weight: 400; line-height: 1.5; }
  .ortho-age-copy:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: -3px; }
  .ortho-age-actions { flex: 0 0 auto; padding: 20px 28px calc(24px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--border); background: var(--surface-white); }
  .ortho-age-visit { display: flex; min-height: 54px; align-items: center; justify-content: center; gap: 14px; padding: 17px 16px; border-radius: 10px; background: var(--brand-cta); color: var(--surface-white); font-size: 16px; font-weight: 500; line-height: 16px; letter-spacing: normal; text-decoration: none; text-transform: uppercase; }
  .ortho-age-visit svg { flex: 0 0 22px; }
  .ortho-age-visit:hover { background: var(--brand-cta-hover); }
  .ortho-age-close:hover { background: var(--soft-blue-bg); }
  .ortho-age-sheet :is(button, a):focus-visible { outline: 3px solid var(--brand-blue); outline-offset: 4px; }
  .ortho-age-content h2:focus { outline: none; }
  :global(.ortho-landing-main:has(.ortho-age-sheet[open]) .treatment-sticky-cta) { visibility: hidden; pointer-events: none; }

  @media (max-width: 720px) {
    .ortho-age-actions { padding: 14px 28px max(8px, env(safe-area-inset-bottom, 0px)); }
    .ortho-age-points { gap: 26px 18px; }
    .ortho-age-section { position: relative; isolation: isolate; display: block; overflow: hidden; padding: 48px 34px; background: var(--brand-primary-dark); color: var(--surface-white); }
    .ortho-age-section > :not(.ortho-age-braces, .ortho-age-anchor) { position: relative; z-index: 1; }
    .ortho-age-braces { position: absolute; z-index: 0; bottom: -1px; left: 50%; display: block; width: max(100%, 480px); max-width: none; height: auto; transform: translateX(-50%); pointer-events: none; }
    .ortho-age-enamel { stroke: var(--border); stroke-width: 1.4; stroke-linejoin: round; }
    .ortho-age-enamel-shine, .ortho-age-enamel-glint { stroke: var(--surface-white); stroke-linecap: round; }
    .ortho-age-enamel-shine { stroke-width: 5; opacity: .8; }
    .ortho-age-enamel-glint { stroke-width: 3; opacity: .55; }
    .ortho-age-wire-halo { stroke: var(--brand-primary-dark); stroke-width: 6; stroke-linecap: round; opacity: .25; }
    .ortho-age-wire { stroke: var(--border); stroke-width: 3; stroke-linecap: round; }
    .ortho-age-wire-shine { stroke: var(--surface-white); stroke-width: .8; stroke-linecap: round; opacity: .85; }
    .ortho-age-bracket { stroke: var(--brand-cta); stroke-width: 1.6; stroke-linejoin: round; }
    .ortho-age-ligature { fill: none; stroke: var(--brand-blue); stroke-width: 2; }
    .ortho-age-section h2 { max-width: 14ch; margin: 0; color: var(--surface-white); font-size: 34px; font-weight: 500; line-height: 1.15; letter-spacing: -.16px; text-wrap: balance; }
    .ortho-age-section h2 strong { display: block; margin-bottom: 4px; font-size: clamp(36px, 10vw, 44px); font-weight: 700; line-height: 1.1; }
    .ortho-age-intro { margin: 20px 0 0; color: var(--surface-white); font-size: 17px; font-weight: 400; line-height: 1.5; letter-spacing: -.16px; }
    .ortho-age-list { margin: 28px 0 0; padding: 0; border-top: 1px solid rgba(255, 255, 255, .35); list-style: none; }
    .ortho-age-list li { border-bottom: 1px solid rgba(255, 255, 255, .35); }
    .ortho-age-list button { display: flex; width: 100%; min-height: 84px; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 0; border: 0; background: transparent; color: var(--surface-white); font: inherit; font-size: 24px; font-weight: 500; line-height: 1.2; letter-spacing: -.16px; text-align: left; cursor: pointer; }
    .ortho-age-open-icon { display: grid; flex: 0 0 40px; place-items: center; width: 40px; height: 40px; border: 1px solid rgba(255, 255, 255, .65); border-radius: 50%; color: var(--surface-white); transition: background 160ms ease, color 160ms ease; }
    .ortho-age-open-icon svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .ortho-age-list button:hover .ortho-age-open-icon, .ortho-age-list button[aria-expanded="true"] .ortho-age-open-icon { background: rgba(255, 255, 255, .16); color: var(--surface-white); }
    .ortho-age-list button:focus-visible { outline: 3px solid var(--surface-white); outline-offset: 4px; border-radius: 4px; }
  }

  :global(.ortho-landing-main.ortho-unified) .periodontal-paths-section h2 { max-width: none; margin: 0; text-align: left; }
  :global(.ortho-landing-main.ortho-unified) .periodontal-paths-section h2 strong { display: block; margin: 0; font-size: inherit; line-height: inherit; }
  :global(.ortho-landing-main.ortho-unified) .periodontal-paths-copy .ortho-age-intro { margin: 24px 0 0; }

  @media (min-width: 721px) {
    :global(.ortho-landing-main.ortho-unified) .periodontal-paths-copy { grid-column: 1; align-self: start; }
