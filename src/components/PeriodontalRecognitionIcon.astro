---
interface Props {
  name: string;
}

const { name } = Astro.props;
const tooth = 'M24 11c-3 0-5-2-8-1-4.5 1.4-5 5.8-3.6 10.1 1 3 2.1 5.2 2.7 8.8.6 3.7 1.1 8.1 3.3 8.1 2 0 2.1-8 5.6-8s3.6 8 5.6 8c2.2 0 2.7-4.4 3.3-8.1.6-3.6 1.7-5.8 2.7-8.8C37 15.8 36.5 11.4 32 10c-3-1-5 1-8 1Z';
---

<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'morning' && <>
    <path d="M4 32h24M8 27a9 9 0 0 1 18 0M17 9v5M5 16l3 3m18-3-3 3M3 26h3M9 38h13" />
    <path d="M36 20s-6 7.8-6 11a6 6 0 0 0 12 0c0-3.2-6-11-6-11Z" />
  </>}
  {name === 'apple' && <>
    <path d="M22 15c-4-4-12-3-15 2-4 7 1 21 7 22 3 .5 4-1 7-1s4 1.5 7 1c4-.7 7-6 8-11M22 15c3-3 8-4 12-1M22 15c-1-4-1-7-4-9M23 11c0-5 5-7 10-6-1 5-4 8-10 6Z" />
    <path d="M39 16s-4 5.2-4 7.5a4 4 0 0 0 8 0C43 21.2 39 16 39 16Z" />
  </>}
  {name === 'brush' && <>
    <path d="m9 37 17-17a3 3 0 0 1 4.2 4.2l-17 17A3 3 0 0 1 9 37ZM26 20l-5-5a3 3 0 0 1 0-4l4-4a3 3 0 0 1 4 0l5 5-8 8ZM23 9l4 4m0-8 4 4m0 0 4 4" />
    <path d="M37 27s-4 5.2-4 7.5a4 4 0 0 0 8 0c0-2.3-4-7.5-4-7.5Z" />
  </>}
  {name === 'floss' && <>
    <rect x="7" y="17" width="21" height="23" rx="6" />
    <path d="M8 25h19M13 17v-4h10v4M18 13V9h15c5 0 7 3 7 7v3M13 34h7" />
    <path d="M38 25s-4 5.2-4 7.5a4 4 0 0 0 8 0c0-2.3-4-7.5-4-7.5Z" />
  </>}
  {name === 'taste' && <>
    <path d="M6 23c5-2 7-7 12-6l6 3 6-3c5-1 7 4 12 6-7 2-11 2-18 2S13 25 6 23ZM6 23c4 9 10 14 18 14s14-5 18-14M18 28c2-1 4-1 6 0s4 1 6 0" />
    <path d="m36 5 1.7 4.3L42 11l-4.3 1.7L36 17l-1.7-4.3L30 11l4.3-1.7L36 5Z" />
  </>}
  {name === 'mirror' && <>
    <ellipse cx="22" cy="19" rx="13" ry="15" />
    <path d="M19 34v8a3 3 0 0 0 6 0v-8M13 13l3-4" />
    <path d={tooth} transform="translate(10 6) scale(.5)" />
  </>}
  {name === 'breath' && <>
    <path d="M6 23c3-4 7-6 12-6M6 23c3 4 7 6 12 6M6 23h12M24 15h9a3 3 0 1 0-2.2-5M24 23h15a3 3 0 1 1-2.2 5M24 32h6a3 3 0 1 1-2.2 5" />
  </>}
  {name === 'swelling' && <>
    <path d={tooth} transform="translate(2 -3) scale(.92)" />
    <path d="M6 31c5-6 10-7 17-3 7-4 14-3 19 3M6 38c5-6 10-7 17-3 7-4 14-3 19 3M6 17l-3-2m38 2 3-2" />
  </>}
  {name === 'avoid-floss' && <>
    <rect x="7" y="20" width="21" height="22" rx="6" />
    <path d="M8 28h19M13 20v-4h10v4M18 16v-5M13 36h7M37 8v5" />
    <path d="M18 11c1-5 7-7 11-4 3 2 2 7 5 10 2 2 5 3 8 2" stroke-dasharray="3 4" />
  </>}
  {name === 'recurring' && <>
    <path d="m7 32 15-15a2.5 2.5 0 0 1 3.5 3.5l-15 15A2.5 2.5 0 0 1 7 32ZM22 17l-4-4a2.5 2.5 0 0 1 0-3.5L21.5 6a2.5 2.5 0 0 1 3.5 0l4 4-7 7ZM20 8l3 3m1-7 3 3m0 0 4 4" />
    <path d="M23 31a9 9 0 0 1 16-5M39 21v5h-5M41 34a9 9 0 0 1-16 5M25 44v-5h5" />
  </>}
</svg>
