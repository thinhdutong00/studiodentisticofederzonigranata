---
// Modulo breve della hero per "Guide e consigli".
// Non invia la richiesta: passa sede e percorso a /richiesta/ con gli stessi parametri
// usati dalle pagine trattamento (trattamento, sede, motivo), letti da /richiesta/.
import CtaArrowIcon from './CtaArrowIcon.astro';
import { site } from '../data/site';

interface GuideForm {
  treatment?: string;
  reasonLabel?: string;
  reasons?: string[];
  treatmentLabel?: string;
  treatmentOptions?: string[];
}

interface Props {
  form: GuideForm;
  idPrefix: string;
  title?: string;
}

const { form, idPrefix, title = 'Parliamo delle tue esigenze' } = Astro.props;
const hasFixedTreatment = Boolean(form.treatment);
---

<form
  class="guide-request-form"
  action="/richiesta/"
  method="get"
  aria-labelledby={`${idPrefix}-form-title`}
  aria-describedby={`${idPrefix}-form-note`}
  data-guide-request-form
>
  {hasFixedTreatment && <input type="hidden" name="trattamento" value={form.treatment} />}
  <p class="guide-request-eyebrow">Richiedi una visita</p>
  <h2 id={`${idPrefix}-form-title`}>{title}</h2>

  <label for={`${idPrefix}-office`}>Sede preferita</label>
  <div class="guide-request-select">
    <select id={`${idPrefix}-office`} name="sede">
      <option value="">Scegli una sede</option>
      {site.offices.map((office) => <option value={office.city}>{office.city}</option>)}
    </select>
  </div>

  {hasFixedTreatment ? (
    <>
      <label for={`${idPrefix}-reason`}>{form.reasonLabel || 'Motivo della richiesta'}</label>
      <div class="guide-request-select">
        <select id={`${idPrefix}-reason`} name="motivo">
          <option value="">Da valutare insieme</option>
          {(form.reasons || []).map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>
    </>
  ) : (
    <>
      <label for={`${idPrefix}-treatment`}>{form.treatmentLabel || 'Tipo di percorso'}</label>
      <div class="guide-request-select">
        <select id={`${idPrefix}-treatment`} name="trattamento">
          <option value="">Da valutare insieme</option>
          {(form.treatmentOptions || []).map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>
    </>
  )}

  <button type="submit">
    Richiedi una visita <CtaArrowIcon className="ui-glyph" />
  </button>
  <p class="guide-request-note" id={`${idPrefix}-form-note`}>
    Prosegui per indicarci le tue preferenze e i tuoi recapiti. La richiesta viene inviata solo al termine del passaggio successivo.
  </p>
</form>

<style>
  .guide-request-form {
    align-self: center;
    padding: clamp(28px, 3vw, 42px);
    border-radius: 10px;
    background: var(--surface-white);
    box-shadow: 0 22px 70px rgba(5, 20, 33, 0.22);
    color: var(--text-dark);
    font-family: Inter, sans-serif;
    letter-spacing: -0.2px;
  }

  .guide-request-eyebrow {
    margin: 0 0 10px;
    color: var(--brand-cta);
    font-size: 16px;
    font-weight: 500;
    line-height: 16px;
    text-transform: uppercase;
  }

  .guide-request-form h2 {
    margin: 0 0 26px;
    color: var(--brand-primary-dark);
    font-size: clamp(26px, 2.1vw, 34px);
    font-weight: 500;
    line-height: 1.15;
  }

  .guide-request-form label {
    display: block;
    margin: 18px 0 8px;
    color: var(--muted-text);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
  }

  .guide-request-select {
    position: relative;
  }

  .guide-request-select::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 20px;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--brand-primary-dark);
    border-bottom: 2px solid var(--brand-primary-dark);
    pointer-events: none;
    transform: translateY(-70%) rotate(45deg);
  }

  .guide-request-form select {
    width: 100%;
    min-height: 62px;
    appearance: none;
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0 52px 0 18px;
    background: var(--surface-white);
    color: var(--text-dark);
    font: inherit;
    font-size: 16px;
    font-weight: 400;
  }

  .guide-request-form select:focus-visible {
    border-color: var(--brand-cta);
    outline: 3px solid rgba(var(--brand-cta-rgb), 0.18);
  }

  .guide-request-form button {
    width: 100%;
    min-height: 64px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    border: 1px solid var(--brand-cta);
    border-radius: 7px;
    padding: 0 20px;
    background: var(--brand-cta);
    color: var(--surface-white);
    cursor: pointer;
    font-family: Inter, sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 16px;
    text-transform: uppercase;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .guide-request-form button:hover,
  .guide-request-form button:focus-visible {
    border-color: var(--brand-cta-hover);
    background: var(--brand-cta-hover);
  }

  .guide-request-form button:focus-visible {
    outline: 3px solid var(--brand-blue);
    outline-offset: 4px;
  }

  .guide-request-note {
    margin: 14px 0 0;
    color: var(--muted-text);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 980px) {
    .guide-request-form {
      width: min(100%, 660px);
    }
  }

  @media (max-width: 720px) {
    .guide-request-form {
      padding: 24px 20px;
      border-radius: 8px;
      letter-spacing: -0.16px;
    }

    .guide-request-eyebrow {
      font-size: 14px;
      line-height: 14px;
    }

    .guide-request-form h2 {
      margin-bottom: 20px;
      font-size: 26px;
      line-height: 30px;
    }

    .guide-request-form select,
    .guide-request-form button {
      min-height: 58px;
    }
  }
</style>
