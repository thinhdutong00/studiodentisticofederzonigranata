---
import { site } from '../data/site';
import type { TreatmentClinicalCase } from '../data/treatmentMarketing';

interface Props {
  initialCase?: TreatmentClinicalCase;
}

const { initialCase } = Astro.props;

const caseDetails: Record<string, { description: string; image: string; imageAlt: string; imagePosition: string }> = {
  Estetica: {
    description: 'Casi dedicati all’armonia del sorriso, al colore, alla forma e alla naturalezza del risultato finale.',
    image: '/assets/menu/casi-clinici-estetica.jpg',
    imageAlt: 'Donna che sorride allo specchio durante una visita estetica',
    imagePosition: '45% 52%',
  },
  Protesi: {
    description: 'Riabilitazioni protesiche fisse e mobili per recuperare funzione masticatoria, stabilità ed estetica.',
    image: '/assets/menu/casi-clinici-protesi.png',
    imageAlt: 'Progettazione digitale di una protesi dentale al computer',
    imagePosition: '54% 50%',
  },
  Parodontologia: {
    description: 'Percorsi dedicati alla salute delle gengive e dei tessuti di sostegno del sorriso.',
    image: '/assets/menu/casi-clinici-parodontologia.png',
    imageAlt: 'Controllo parodontale su gengive e denti',
    imagePosition: '54% 48%',
  },
  Implantologia: {
    description: 'Casi con impianti dentali, dalla progettazione alla riabilitazione anche con approccio digitale.',
    image: '/assets/menu/casi-clinici-implantologia.png',
    imageAlt: 'Impianto dentale con corona e gengiva',
    imagePosition: '50% 52%',
  },
  Ortodonzia: {
    description: 'Allineamenti dentali e correzioni funzionali per adulti e bambini, anche con allineatori.',
    image: '/assets/menu/casi-clinici-ortodonzia.png',
    imageAlt: 'Allineatore trasparente applicato sul sorriso',
    imagePosition: '52% 50%',
  },
  Conservativa: {
    description: 'Restauri, otturazioni e ricostruzioni conservative per recuperare i denti naturali.',
    image: '/assets/menu/casi-clinici-conservativa.png',
    imageAlt: 'Restauro conservativo su molare',
    imagePosition: '52% 48%',
  },
  Endodonzia: {
    description: 'Cure canalari e salvataggio del dente quando carie profonde o traumi compromettono la polpa.',
    image: '/assets/menu/casi-clinici-endodonzia.png',
    imageAlt: 'Trattamento endodontico su sezione di dente',
    imagePosition: '50% 48%',
  },
  Video: {
    description: 'Contenuti video per osservare da vicino percorsi, risultati e dettagli dei trattamenti eseguiti.',
    image: '/assets/menu/casi-clinici-video.jpg',
    imageAlt: 'Equipe odontoiatrica durante una procedura clinica',
    imagePosition: '48% 45%',
  },
};

const caseOrder = ['Video', 'Estetica', 'Protesi', 'Parodontologia', 'Implantologia', 'Conservativa', 'Ortodonzia', 'Endodonzia'];
const cases = caseOrder.flatMap((label) => {
  const item = site.clinicalLinks.find((link) => link.label === label);
  const details = caseDetails[label];
  return item && details ? [{ ...item, ...details }] : [];
});
---

<section
  class="clinical-carousel-section"
  aria-labelledby="clinical-carousel-title"
  data-cases-carousel
  data-initial-case={initialCase}
>
  <div class="clinical-carousel-head">
    <p>Guarda i nostri</p>
    <h2 id="clinical-carousel-title">Casi clinici</h2>
  </div>

  <div class="clinical-carousel-shell">
    <button class="clinical-carousel-arrow clinical-carousel-arrow-prev" type="button" aria-label="Scorri i casi clinici precedenti" data-cases-carousel-prev>
      <span aria-hidden="true">‹</span>
    </button>

    <div class="clinical-carousel-track" data-cases-carousel-track>
      {cases.map((item) => (
        <a
          class="clinical-carousel-card"
          href={item.href}
          data-case-label={item.label}
          style={`--clinical-card-position: ${item.imagePosition};`}
        >
          <img src={item.image} alt={item.imageAlt} loading="lazy" />
          <span class="clinical-carousel-shade" aria-hidden="true"></span>
          <span class="clinical-carousel-card-copy">
            <strong>{item.label}</strong>
            <small>{item.description}</small>
          </span>
        </a>
      ))}
    </div>

    <button class="clinical-carousel-arrow clinical-carousel-arrow-next" type="button" aria-label="Scorri i casi clinici successivi" data-cases-carousel-next>
      <span aria-hidden="true">›</span>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll('[data-cases-carousel]').forEach((carousel) => {
    if (carousel instanceof HTMLElement && carousel.dataset.casesCarouselReady === 'true') return;
    if (carousel instanceof HTMLElement) carousel.dataset.casesCarouselReady = 'true';

    const track = carousel.querySelector('[data-cases-carousel-track]');
    const previous = carousel.querySelector('[data-cases-carousel-prev]');
    const next = carousel.querySelector('[data-cases-carousel-next]');
    if (!(track instanceof HTMLElement)) return;

    const originalCards = Array.from(track.querySelectorAll('.clinical-carousel-card')).filter(
      (card) => card instanceof HTMLElement,
    );
    if (originalCards.length < 2) return;

    const cloneCard = (card: Element) => {
      const clone = card.cloneNode(true);
      if (clone instanceof HTMLElement) {
        clone.dataset.carouselClone = 'true';
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('tabindex', '-1');
      }
      return clone;
    };

    const beforeClones = originalCards.map(cloneCard);
    const afterClones = originalCards.map(cloneCard);
    beforeClones.slice().reverse().forEach((clone) => track.insertBefore(clone, track.firstChild));
    afterClones.forEach((clone) => track.appendChild(clone));

    const firstOriginal = originalCards[0];
    const firstAfterClone = afterClones[0];
    if (!(firstOriginal instanceof HTMLElement) || !(firstAfterClone instanceof HTMLElement)) return;

    const getScrollAmount = () => {
      const card = track.querySelector('.clinical-carousel-card');
      if (!(card instanceof HTMLElement)) return track.clientWidth * 0.78;
      const styles = window.getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap || '0');
      return card.offsetWidth + gap;
    };

    const getTrackGap = () => {
      const styles = window.getComputedStyle(track);
      return Number.parseFloat(styles.columnGap || styles.gap || '0');
    };

    const getLoopMetrics = () => ({
      start: firstOriginal.offsetLeft,
      width: firstAfterClone.offsetLeft - firstOriginal.offsetLeft,
    });

    const normalizeLoopPosition = () => {
      const { start, width } = getLoopMetrics();
      if (width <= 0) return;
      while (track.scrollLeft < start) track.scrollLeft += width;
      while (track.scrollLeft >= start + width) track.scrollLeft -= width;
    };

    const setInitialScroll = () => {
      const requestedCase = carousel instanceof HTMLElement ? carousel.dataset.initialCase : undefined;
      const requestedCard = requestedCase
        ? originalCards.find(
            (card) => card instanceof HTMLElement && card.dataset.caseLabel === requestedCase,
          )
        : undefined;

      if (requestedCard instanceof HTMLElement) {
        const isMobile = window.matchMedia('(max-width: 720px)').matches;
        const leadingInset = isMobile ? 15 : requestedCard.offsetWidth / 2 + getTrackGap();
        track.scrollLeft = requestedCard.offsetLeft - leadingInset;
        return;
      }

      track.scrollLeft = getLoopMetrics().start + firstOriginal.offsetWidth / 2;
    };

    const scrollLoop = (direction: number) => {
      normalizeLoopPosition();
      track.scrollBy({ left: direction * getScrollAmount(), behavior: 'smooth' });
      window.setTimeout(normalizeLoopPosition, 420);
    };

    let scrollFrame = 0;
    track.addEventListener('scroll', () => {
      window.cancelAnimationFrame(scrollFrame);
      scrollFrame = window.requestAnimationFrame(normalizeLoopPosition);
    }, { passive: true });

    requestAnimationFrame(setInitialScroll);
    window.addEventListener('load', setInitialScroll, { once: true });
    window.addEventListener('resize', () => requestAnimationFrame(setInitialScroll));
    previous?.addEventListener('click', () => scrollLoop(-1));
    next?.addEventListener('click', () => scrollLoop(1));
  });
</script>

<style>
  .clinical-carousel-section {
    padding: clamp(96px, 9vw, 148px) 0 clamp(74px, 7vw, 108px);
    background: var(--surface-white);
    color: var(--brand-primary-dark);
    overflow: hidden;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    letter-spacing: -0.2px;
    word-spacing: 0;
  }

  .clinical-carousel-head {
    width: min(1510px, calc(100% - 30px));
    margin: 0 auto clamp(54px, 5vw, 78px);
    text-align: center;
  }

  .clinical-carousel-head p {
    margin: 0;
    color: var(--brand-blue);
    font-size: clamp(1rem, 1.1vw, 1.125rem);
    font-weight: 500;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .clinical-carousel-head h2 {
    margin: 18px 0 0;
    color: var(--brand-primary-dark);
    font: 400 clamp(3.4rem, 6.2vw, 7rem) / 0.95 "Inter", ui-sans-serif, system-ui, sans-serif;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .clinical-carousel-shell { position: relative; }

  .clinical-carousel-track {
    display: flex;
    gap: clamp(18px, 1.8vw, 32px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .clinical-carousel-track::-webkit-scrollbar { display: none; }

  .clinical-carousel-card {
    position: relative;
    flex: 0 0 clamp(330px, 28vw, 490px);
    min-height: clamp(440px, 44vw, 610px);
    display: block;
    overflow: hidden;
    border-radius: 8px;
    color: var(--surface-white);
    text-decoration: none;
    isolation: isolate;
  }

  .clinical-carousel-card:focus-visible {
    outline: 3px solid var(--brand-blue);
    outline-offset: -3px;
  }

  .clinical-carousel-card img,
  .clinical-carousel-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .clinical-carousel-card img {
    z-index: -2;
    object-fit: cover;
    object-position: var(--clinical-card-position, center);
    transform: scale(1.01);
    transition: transform 260ms ease;
  }

  .clinical-carousel-shade {
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, 0.62) 100%),
      linear-gradient(90deg, rgba(var(--brand-primary-dark-rgb), 0.12), rgba(var(--brand-primary-dark-rgb), 0.28));
  }

  .clinical-carousel-card-copy {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(24px, 2vw, 34px);
  }

  .clinical-carousel-card-copy strong {
    display: block;
    max-width: 11ch;
    color: var(--surface-white);
    font-size: clamp(2rem, 2.65vw, 3.1rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .clinical-carousel-card-copy small {
    display: block;
    max-width: 34ch;
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.05vw, 1.15rem);
    font-weight: 400;
    line-height: 1.25;
  }

  .clinical-carousel-card:hover img,
  .clinical-carousel-card:focus-visible img { transform: scale(1.055); }

  .clinical-carousel-arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    width: clamp(54px, 4.1vw, 72px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.96);
    color: var(--brand-blue);
    box-shadow: 0 18px 44px rgba(var(--brand-primary-dark-rgb), 0.16);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .clinical-carousel-arrow:hover,
  .clinical-carousel-arrow:focus-visible {
    background: var(--brand-blue);
    color: var(--surface-white);
    transform: translateY(-50%) scale(1.04);
  }

  .clinical-carousel-arrow:focus-visible {
    outline: 3px solid rgba(var(--brand-cta-rgb), 0.28);
    outline-offset: 3px;
  }

  .clinical-carousel-arrow span {
    display: block;
    margin-top: -2px;
    font-size: clamp(2rem, 2.4vw, 2.7rem);
    font-weight: 300;
    line-height: 1;
  }

  .clinical-carousel-arrow-prev { left: clamp(24px, 4.5vw, 88px); }
  .clinical-carousel-arrow-next { right: clamp(24px, 4.5vw, 88px); }

  @media (max-width: 1160px) {
    .clinical-carousel-card {
      flex-basis: clamp(310px, 42vw, 430px);
      min-height: 500px;
    }
  }

  @media (max-width: 720px) {
    .clinical-carousel-section {
      padding: 58px 0;
      letter-spacing: -0.16px;
    }

    .clinical-carousel-head { margin-bottom: 34px; }
    .clinical-carousel-head h2 { font-size: clamp(3rem, 16vw, 4.8rem); }
    .clinical-carousel-track { gap: 16px; }

    .clinical-carousel-card {
      flex-basis: min(82vw, 360px);
      min-height: 430px;
    }

    .clinical-carousel-card-copy { padding: 24px; }
    .clinical-carousel-card-copy strong { font-size: clamp(1.9rem, 9vw, 2.7rem); }
    .clinical-carousel-card-copy small { font-size: 0.98rem; }
    .clinical-carousel-arrow { width: 50px; }
    .clinical-carousel-arrow-prev { left: 18px; }
    .clinical-carousel-arrow-next { right: 18px; }
  }
</style>
