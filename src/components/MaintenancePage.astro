---
import { site } from '../data/site';
---

<main class="maintenance-page" data-maintenance-page>
  <div class="maintenance-page__glow maintenance-page__glow--top" aria-hidden="true"></div>
  <div class="maintenance-page__glow maintenance-page__glow--bottom" aria-hidden="true"></div>

  <section class="maintenance-card" aria-labelledby="maintenance-title">
    <img
      class="maintenance-card__logo"
      src={site.logo}
      alt={site.name}
      width="400"
      height="52"
    />

    <div class="maintenance-card__rule" aria-hidden="true"></div>

    <p class="maintenance-card__eyebrow">Aggiornamento in corso</p>
    <h1 id="maintenance-title">Sito in manutenzione</h1>
    <p class="maintenance-card__copy">
      Stiamo lavorando per migliorare la tua esperienza. Torneremo online al più presto.
    </p>

    <div class="maintenance-card__status" role="status">
      <span class="maintenance-card__status-dot" aria-hidden="true"></span>
      <span>Intervento programmato</span>
    </div>
  </section>

  <p class="maintenance-page__locations">Modena <span aria-hidden="true">·</span> Reggio Emilia</p>
</main>

<style>
  .maintenance-page {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 28px;
    padding: 48px 24px;
    background:
      linear-gradient(135deg, rgba(238, 246, 251, 0.96), rgba(247, 250, 252, 0.92)),
      var(--background);
    color: var(--text-dark);
    font-family: "Inter", sans-serif;
    letter-spacing: -0.2px;
    word-spacing: 0;
  }

  .maintenance-page__glow {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    filter: blur(2px);
    pointer-events: none;
  }

  .maintenance-page__glow--top {
    top: -24vw;
    right: -17vw;
    width: min(56vw, 760px);
    aspect-ratio: 1;
    background: rgba(94, 154, 204, 0.16);
  }

  .maintenance-page__glow--bottom {
    bottom: -30vw;
    left: -20vw;
    width: min(66vw, 900px);
    aspect-ratio: 1;
    background: rgba(37, 109, 149, 0.1);
  }

  .maintenance-card {
    width: min(720px, 100%);
    padding: clamp(36px, 6vw, 68px);
    border: 1px solid var(--border);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 24px 70px rgba(16, 40, 61, 0.12);
    backdrop-filter: blur(14px);
  }

  .maintenance-card__logo {
    width: min(100%, 360px);
    height: auto;
  }

  .maintenance-card__rule {
    width: 72px;
    height: 2px;
    margin: clamp(34px, 5vw, 52px) 0 26px;
    background: var(--brand-blue);
  }

  .maintenance-card__eyebrow {
    margin: 0 0 18px;
    color: var(--brand-cta);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
  }

  h1 {
    max-width: 590px;
    margin: 0;
    color: var(--brand-primary-dark);
    font-size: clamp(2.7rem, 7vw, 5.4rem);
    font-weight: 400;
    letter-spacing: -0.2px;
    line-height: 0.95;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .maintenance-card__copy {
    max-width: 570px;
    margin: 28px 0 0;
    color: var(--muted-text);
    font-size: clamp(1.125rem, 2.4vw, 1.45rem);
    font-weight: 500;
    line-height: 1.3;
    text-wrap: balance;
  }

  .maintenance-card__status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(36px, 5vw, 54px);
    color: var(--brand-primary-dark);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .maintenance-card__status-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--warning);
    box-shadow: 0 0 0 5px rgba(183, 121, 31, 0.12);
  }

  .maintenance-page__locations {
    margin: 0;
    color: var(--muted-text);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .maintenance-page {
      gap: 22px;
      padding: 24px 16px;
      letter-spacing: -0.16px;
    }

    .maintenance-card {
      padding: 34px 26px 38px;
    }

    .maintenance-card__logo {
      width: min(100%, 290px);
    }

    .maintenance-card__rule {
      margin: 34px 0 24px;
    }

    h1 {
      font-size: clamp(2.35rem, 12vw, 3.5rem);
      letter-spacing: -0.16px;
      line-height: 0.98;
    }

    .maintenance-card__copy {
      margin-top: 22px;
      font-size: 1.125rem;
    }

    .maintenance-card__status {
      margin-top: 36px;
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .maintenance-card {
      backdrop-filter: none;
    }
  }
</style>
