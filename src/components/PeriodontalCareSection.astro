---
import CtaArrowIcon from './CtaArrowIcon.astro';

// Fonti SIdP, EFP e AAP raccolte in periodontalContentSources e nella documentazione delle immagini.
const phases = ['Identificazione del problema', 'Analisi e cura', 'Risultati'];
const careJourneys = [
  {
    id: 'periodontal-bleeding-title',
    title: 'Perché le gengive sanguinano e come si curano?',
    open: false,
    lead: 'Il sanguinamento è un segnale da approfondire. La visita serve a capire se l’infiammazione riguarda solo la gengiva oppure anche i tessuti che sostengono i denti. Le immagini mostrano un esempio di gengivite da placca.',
    listLabel: 'Sanguinamento: dal problema ai risultati delle cure',
    steps: [
      {
        title: 'Sangue e gengive arrossate',
        image: '/assets/optimized/parodontologia-sanguinamento-problema.webp',
        alt: 'Illustrazione di placca lungo i denti, gengive arrossate e piccole tracce di sanguinamento al margine gengivale',
        caption: 'Placca e infiammazione possono causare sanguinamento.',
        description: 'Noti sangue quando lavi i denti, rossore o gonfiore? Sono segnali di possibile infiammazione gengivale, anche senza dolore. Il solo sanguinamento non basta per diagnosticare la parodontite.',
      },
      {
        title: 'Valutazione e pulizia',
        image: '/assets/optimized/parodontologia-sanguinamento-cura.webp',
        alt: 'La stessa porzione di arcata durante la rimozione professionale dei depositi vicino al bordo gengivale',
        caption: 'Pulizia professionale dopo la valutazione delle gengive.',
        description: 'Controlliamo gengive, sanguinamento e profondità del solco. In base alla diagnosi rimuoviamo placca e tartaro e ti mostriamo come pulire bene anche gli spazi tra i denti.',
      },
      {
        title: 'Meno infiammazione',
        image: '/assets/optimized/parodontologia-sanguinamento-risultato.webp',
        alt: 'La stessa zona dopo le cure, con denti puliti, gengive meno arrossate e senza sanguinamento visibile',
        caption: 'Possibile recupero della salute gengivale nella gengivite.',
        description: 'Nella gengivite da placca, le cure e l’igiene quotidiana possono risolvere l’infiammazione e il sanguinamento. Verifichiamo la risposta e programmiamo i controlli per mantenere le gengive sane.',
      },
    ],
    note: 'Se la visita evidenzia anche parodontite, il percorso comprende la cura delle tasche e il controllo dei tessuti di sostegno.',
  },
  {
    id: 'periodontal-pockets-title',
    title: 'Che cosa sono le tasche parodontali e come si curano?',
    open: true,
    lead: 'La parodontite, chiamata anche piorrea, può creare spazi più profondi tra dente e gengiva: le tasche parodontali. Le cure puntano a ridurne la profondità e a controllare l’infiammazione.',
    listLabel: 'Tasche parodontali: dal problema ai risultati delle cure',
    steps: [
      {
        title: 'Batteri sotto gengiva',
        image: '/assets/optimized/parodontologia-tasche-problema.webp',
        alt: 'La stessa arcata con uno spaccato locale che mostra una tasca parodontale, depositi sulla radice e perdita di sostegno',
        caption: 'Lo spaccato mostra la tasca accanto alla radice.',
        description: 'Tra dente e gengiva si forma uno spazio più profondo, dove si accumulano batteri e depositi. La parodontite può danneggiare l’osso e gli altri tessuti che sostengono il dente.',
      },
      {
        title: 'Sondaggio e terapia',
        image: '/assets/optimized/parodontologia-tasche-cura.webp',
        alt: 'Una sonda millimetrata misura la tasca tra la radice e la gengiva nello stesso spaccato dell’arcata',
        caption: 'Il sondaggio misura la profondità prima delle cure.',
        description: 'Misuriamo le tasche con una sonda millimetrata e, quando indicate, eseguiamo radiografie. Rimuoviamo poi placca e tartaro dalle radici, anche sotto gengiva.',
      },
      {
        title: 'Tasche meno profonde',
        image: '/assets/optimized/parodontologia-tasche-risultato.webp',
        alt: 'Lo stesso spaccato dopo le cure, con radice pulita, meno infiammazione e tasca ridotta, senza ricrescita dell’osso',
        caption: 'Possibile riduzione della tasca dopo la terapia.',
        description: 'L’infiammazione e la profondità delle tasche possono ridursi. Ripetiamo il sondaggio e valutiamo se servono altre terapie, anche chirurgiche, per mantenere stabile la situazione.',
      },
    ],
    note: 'Ridurre una tasca non significa far ricrescere automaticamente l’osso perduto. La rivalutazione permette di decidere come proseguire le cure.',
  },
  {
    id: 'periodontal-recessions-title',
    title: 'Come si curano le recessioni gengivali?',
    open: false,
    lead: 'Quando la gengiva si ritira, lascia scoperta una parte della radice. Può accadere anche senza parodontite. Valutiamo la causa e se è indicato un trattamento di ricopertura.',
    listLabel: 'Recessioni gengivali: dal problema ai risultati delle cure',
    steps: [
      {
        title: 'La radice esposta',
        image: '/assets/optimized/parodontologia-recessioni-problema.webp',
        alt: 'La stessa porzione di arcata con una recessione gengivale localizzata e la radice di un dente scoperta',
        caption: 'La gengiva ritirata lascia visibile una parte della radice.',
        description: 'Il dente può sembrare più lungo e risultare sensibile. Una recessione può dipendere da diversi fattori, come uno spazzolamento traumatico o le caratteristiche dei tessuti gengivali.',
      },
      {
        title: 'Valutazione e ricopertura',
        image: '/assets/optimized/parodontologia-recessioni-cura.webp',
        alt: 'La gengiva viene riposizionata sulla radice della stessa arcata e stabilizzata con piccoli punti di sutura',
        caption: 'Esempio di gengiva riposizionata e stabilizzata con suture.',
        description: 'Valutiamo causa, gengiva e sostegno del dente. Nei casi indicati ricopriamo la radice con chirurgia mucogengivale, eventualmente associata a un innesto di tessuto connettivo.',
      },
      {
        title: 'La radice ricoperta',
        image: '/assets/optimized/parodontologia-recessioni-risultato.webp',
        alt: 'La stessa zona dopo la guarigione, con la radice prima esposta completamente ricoperta dalla gengiva',
        caption: 'Ricopertura completa in un esempio clinicamente favorevole.',
        description: 'Nei casi favorevoli possiamo eliminare la recessione ricoprendo completamente la radice. In altri, la copertura può essere parziale. Verifichiamo guarigione e stabilità del risultato nel tempo.',
      },
    ],
    note: 'Non tutte le recessioni richiedono chirurgia: in alcuni casi bastano correzione dello spazzolamento e controlli. Se è presente parodontite, controlliamo prima l’infiammazione.',
  },
];
---

<section class="periodontal-care" id="tasche-e-recessioni" aria-labelledby="periodontal-care-title">
  <div class="ortho-shell periodontal-care-shell">
    <header class="periodontal-care-heading">
      <p class="periodontal-care-eyebrow">Dai sintomi alle cure</p>
      <h2 id="periodontal-care-title">La salute delle gengive,<span>spiegata in tre passaggi.</span></h2>
      <p class="periodontal-care-comparison">Sanguinamento, tasche e recessioni richiedono valutazioni diverse. Scopri come <strong>identifichiamo il problema</strong>, scegliamo <strong>analisi e cure</strong> e controlliamo <strong>i risultati</strong>.</p>
    </header>

    <div class="periodontal-care-accordions">
      {careJourneys.map((journey) => <details class="periodontal-care-accordion" open={journey.open}>
        <summary>
          <h3 id={journey.id}>{journey.title}</h3>
          <span class="periodontal-care-toggle" aria-hidden="true"></span>
        </summary>
        <div class="periodontal-care-answer">
          <p class="periodontal-journey-lead">{journey.lead}</p>
          <ol class="periodontal-care-journey" aria-label={journey.listLabel} role="list">
            {journey.steps.map((step, index) => <li>
              <article class="periodontal-journey-card">
                <header class="periodontal-journey-heading">
                  <p class="periodontal-journey-phase"><span aria-hidden="true">{index + 1}</span>{phases[index]}</p>
                  <h4>{step.title}</h4>
                </header>
                <figure class="periodontal-journey-figure">
                  <img src={step.image} alt={step.alt} width="1536" height="1024" loading="lazy" decoding="async" />
                  <figcaption>{step.caption}</figcaption>
                </figure>
                <p class="periodontal-journey-description">{step.description}</p>
              </article>
            </li>)}
          </ol>
          <p class="periodontal-journey-note">{journey.note}</p>
        </div>
      </details>)}
    </div>

    <aside class="periodontal-care-note" aria-label="Mantenimento dei risultati">
      <h4>Il risultato continua con la cura quotidiana.</h4>
      <p>Spazzolamento corretto, pulizia interdentale e controlli personalizzati aiutano a mantenere la salute delle gengive e a intercettare nuovi cambiamenti.</p>
    </aside>
    <p class="periodontal-journey-schematic">Illustrazioni schematiche di possibili percorsi di cura. Indicazioni e risultati variano in base alla situazione clinica e alla risposta individuale.</p>
    <button class="periodontal-care-cta" type="button" data-landing-booking-open aria-haspopup="dialog" aria-controls="landing-booking-dialog">
      <span>Prenota una visita parodontale</span>
      <CtaArrowIcon direction="right" />
    </button>
  </div>
</section>

<style>
  .periodontal-care {
    padding: 88px 0;
    background: var(--soft-blue-bg);
    color: var(--brand-primary-dark);
    font-family: Inter, sans-serif;
    letter-spacing: -.2px;
    word-spacing: 0;
  }
  .periodontal-care-shell { display: grid; gap: 40px; }
  .periodontal-care-heading { text-align: center; }
  .periodontal-care-eyebrow { margin: 0 0 20px; color: var(--brand-cta); font-size: 13px; font-weight: 500; line-height: 1.4; letter-spacing: normal; text-transform: uppercase; }
  .periodontal-care-heading h2 { margin: 0; font-size: clamp(36px, 3.35vw, 48px); font-weight: 500; line-height: 1.14; text-wrap: balance; }
  .periodontal-care-heading h2 span { display: block; color: var(--brand-cta); }
  .periodontal-care-comparison { max-width: 72ch; margin: 24px auto 0; color: var(--muted-text); font-size: 18px; font-weight: 400; line-height: 1.5; }
  .periodontal-care-accordion { border-bottom: 2px solid color-mix(in srgb, var(--brand-cta) 72%, transparent); }
  .periodontal-care-accordion:first-child { border-top: 2px solid color-mix(in srgb, var(--brand-cta) 72%, transparent); }
  /* Stessa scala e stessi controlli delle fisarmoniche in TreatmentMarketingPage.astro. */
  .periodontal-care-accordion summary { display: grid; grid-template-columns: minmax(0, 1fr) 40px; align-items: center; gap: 24px; padding: clamp(24px, 3vw, 42px) 0; color: var(--brand-cta-hover); list-style: none; cursor: pointer; }
  .periodontal-care-accordion summary::-webkit-details-marker { display: none; }
  .periodontal-care-accordion summary h3 { margin: 0; color: inherit; font-size: clamp(36px, 4vw, 64px); font-weight: 500; line-height: 1.08; text-wrap: initial; }
  .periodontal-care-accordion summary:hover { color: var(--brand-cta); }
  .periodontal-care-accordion summary:focus-visible { outline: 3px solid rgba(var(--brand-cta-rgb), .24); outline-offset: 7px; }
  .periodontal-care-toggle { position: relative; display: block; width: 36px; height: 36px; border-radius: 50%; background: var(--brand-cta); }
  .periodontal-care-toggle::before, .periodontal-care-toggle::after { position: absolute; top: 50%; left: 50%; width: 15px; height: 2px; background: var(--surface-white); transform: translate(-50%, -50%); content: ''; }
  .periodontal-care-toggle::after { transform: translate(-50%, -50%) rotate(90deg); transition: opacity 140ms ease; }
  .periodontal-care-accordion[open] > summary .periodontal-care-toggle::after { opacity: 0; }
  .periodontal-care-answer { padding-bottom: clamp(36px, 5vw, 70px); }
  .periodontal-journey-lead, .periodontal-journey-description, .periodontal-care-note p { margin: 0; color: var(--muted-text); font-size: 18px; font-weight: 400; line-height: 1.5; }
  .periodontal-journey-lead { max-width: 76ch; margin-bottom: 28px; }
  .periodontal-care-journey { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .periodontal-care-journey > li { min-width: 0; }
  .periodontal-journey-card { display: grid; grid-template-areas: 'heading' 'figure' 'copy'; grid-template-rows: auto auto 1fr; gap: 22px; height: 100%; padding: 24px; border: 1px solid var(--border); border-radius: 24px; background: var(--surface-white); }
  .periodontal-journey-heading { grid-area: heading; }
  .periodontal-journey-phase { display: flex; align-items: center; gap: 12px; min-height: 34px; margin: 0 0 16px; color: var(--brand-cta); font-size: 12px; font-weight: 500; line-height: 1.4; letter-spacing: normal; text-transform: uppercase; }
  .periodontal-journey-phase span { display: grid; flex: 0 0 34px; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--soft-blue-bg); font-size: 16px; }
  .periodontal-care .periodontal-journey-heading h4 { min-height: 2.4em; margin: 0; font-size: 25px; font-weight: 500; line-height: 1.2; text-wrap: balance; }
  .periodontal-journey-figure { grid-area: figure; margin: 0; }
  .periodontal-journey-figure img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; border-radius: 14px; }
  .periodontal-journey-figure figcaption { min-height: 2.9em; margin-top: 10px; color: var(--muted-text); font-size: 12px; font-weight: 400; line-height: 1.45; text-align: center; letter-spacing: normal; }
  .periodontal-journey-description { grid-area: copy; }
  .periodontal-journey-note { max-width: 95ch; margin: 24px 0 0; color: var(--muted-text); font-size: 16px; font-weight: 400; line-height: 1.5; }
  .periodontal-journey-schematic { margin: 0; color: var(--muted-text); font-size: 13px; font-weight: 400; line-height: 1.5; }
  .periodontal-care strong { color: var(--brand-primary-dark); font-weight: 600; }
  .periodontal-care-note { padding: 24px; border-left: 3px solid var(--brand-blue); border-radius: 0 16px 16px 0; background: var(--surface-white); }
  .periodontal-care-note h4 { margin: 0 0 10px; font-size: 18px; font-weight: 500; line-height: 1.4; }
  .periodontal-care-cta { display: inline-flex; justify-self: center; align-items: center; justify-content: center; gap: 18px; max-width: 100%; min-height: 56px; padding: 20px 28px; border: 0; border-radius: 999px; background: var(--brand-cta); color: var(--surface-white); font: inherit; font-size: 16px; font-weight: 500; line-height: 16px; letter-spacing: normal; text-align: center; text-transform: uppercase; cursor: pointer; }
  .periodontal-care-cta:hover { background: var(--brand-cta-hover); }
  .periodontal-care-cta:focus-visible { outline: 3px solid var(--brand-blue); outline-offset: 4px; }

  @media (min-width: 721px) and (max-width: 1099px) {
    .periodontal-care-journey { grid-template-columns: minmax(0, 1fr); }
    .periodontal-journey-card { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); grid-template-areas: 'figure heading' 'figure copy'; grid-template-rows: auto 1fr; align-items: start; gap: 18px 28px; }
    .periodontal-care .periodontal-journey-heading h4 { min-height: 0; }
  }

  @media (max-width: 720px) {
    .periodontal-care { padding: 48px 0; letter-spacing: -.16px; }
    .periodontal-care-shell { gap: 28px; }
    .periodontal-care-heading h2 { font-size: 30px; line-height: 1.16; }
    .periodontal-care-eyebrow { margin-bottom: 16px; }
    .periodontal-care-accordion summary { grid-template-columns: minmax(0, 1fr) 32px; gap: 16px; padding: 24px 0; }
    .periodontal-care-accordion summary h3 { font-size: 28px; line-height: 30px; }
    .periodontal-care-toggle { width: 30px; height: 30px; }
    .periodontal-care-answer { padding-bottom: 36px; }
    .periodontal-care-journey { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .periodontal-journey-card { gap: 20px; padding: 20px; }
    .periodontal-care .periodontal-journey-heading h4 { min-height: 0; font-size: 24px; }
    .periodontal-journey-figure figcaption { min-height: 0; }
    .periodontal-care-comparison, .periodontal-journey-lead, .periodontal-journey-description, .periodontal-care-note p { font-size: 17px; }
    .periodontal-care-note { padding: 20px; }
    .periodontal-care-cta { width: 100%; gap: 12px; padding-inline: 22px; }
    .periodontal-care-cta span { min-width: 0; line-height: 1.3; }
  }
</style>
