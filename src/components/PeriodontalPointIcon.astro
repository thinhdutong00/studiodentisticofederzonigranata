---
interface Props {
  name: string;
}

const { name } = Astro.props;
const tooth = 'M24 11c-3 0-5-2-8-1-4.5 1.4-5 5.8-3.6 10.1 1 3 2.1 5.2 2.7 8.8.6 3.7 1.1 8.1 3.3 8.1 2 0 2.1-8 5.6-8s3.6 8 5.6 8c2.2 0 2.7-4.4 3.3-8.1.6-3.6 1.7-5.8 2.7-8.8C37 15.8 36.5 11.4 32 10c-3-1-5 1-8 1Z';
const crown = 'M2 1h6a2 2 0 0 1 2 2v3.5L9 16a2 2 0 0 1-2 1.8H3A2 2 0 0 1 1 16L0 6.5V3a2 2 0 0 1 2-2Z';
---

<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'bleeding' && <>
    <path d={tooth} transform="translate(-3 3) scale(.9)" />
    <path d="M7 25c5-3 9-3 14 0 4 2 7 2 10 1M36 6s-4 5-4 7a4 4 0 0 0 8 0c0-2-4-7-4-7Z" />
  </>}
  {name === 'inflammation' && <>
    <path d={tooth} />
    <path d="M6 25c6-5 11-5 18-2 7-3 12-3 18 2M7 16l-3-2m37 2 3-2M24 5V2" />
  </>}
  {name === 'plaque' && <>
    <path d={tooth} />
    <path d="M7 25c6-3 11-3 17 0s11 3 17 0" />
    <circle cx="17" cy="22" r="1.3" />
    <circle cx="23" cy="23.5" r="1.3" />
    <circle cx="29" cy="25" r="1.3" />
  </>}
  {name === 'breath' && <>
    <path d="M7 20c3-4 7-6 11-6m-11 6c3 4 7 6 11 6M7 20h11M24 13h9a3 3 0 1 0-2.2-5M24 21h15a3 3 0 1 1-2.2 5M24 30h6a3 3 0 1 1-2.2 5" />
  </>}
  {name === 'recession' && <>
    <path d={tooth} />
    <path d="M7 30c7 0 10-5 17-5s10 5 17 5M17 31v6m14-6v6" />
  </>}
  {name === 'sensitivity' && <>
    <path d={tooth} transform="translate(5 8) scale(.77)" />
    <path d="M37 6v12m-6-6h12m-10-4 8 8m-8 0 8-8M8 26l-4 2m6 6-3 4" />
  </>}
  {name === 'gumline' && <>
    <path d={crown} transform="translate(11 7) scale(1.05)" />
    <path d={crown} transform="translate(26 7) scale(1.05)" />
    <path d="M6 29c8 0 10-7 18-7s10 7 18 7M6 35c8 0 10-7 18-7s10 7 18 7" />
  </>}
  {name === 'hygiene' && <>
    <path d="m10 38 18-18a3 3 0 0 1 4.2 4.2l-18 18a3 3 0 0 1-4.2-4.2ZM28 20l-5-5a3 3 0 0 1 0-4l4-4a3 3 0 0 1 4 0l5 5-8 8ZM25 9l4 4m0-8 4 4m0 0 4 4M36 26l2 2m-6 2 2 2m-5 1 2 2" />
  </>}
  {name === 'mobility' && <>
    <path d={tooth} transform="rotate(-7 24 24)" />
    <path d="M7 17H2m3-3-3 3 3 3m36-3h5m-3-3 3 3-3 3M9 40c8-3 22-3 30 0" />
  </>}
  {name === 'spacing' && <>
    <path d={crown} transform="translate(7 11) scale(1.15)" />
    <path d={crown} transform="translate(29.5 11) scale(1.15)" />
    <path d="M18 38h12m-9-3-3 3 3 3m6-6 3 3-3 3" />
  </>}
  {name === 'history' && <>
    <path d="M18 9h-5a3 3 0 0 0-3 3v27a3 3 0 0 0 3 3h22a3 3 0 0 0 3-3V12a3 3 0 0 0-3-3h-5" />
    <rect x="18" y="6" width="12" height="7" rx="2" />
    <path d="m17 25 4 4 9-9M18 35h12" />
  </>}
  {name === 'maintenance' && <>
    <path d={tooth} transform="translate(6 8) scale(.75)" />
    <path d="M38 32a17 17 0 1 0-27-19M11 6.5V13h6M35 35l4 4 7-8" />
  </>}
</svg>
