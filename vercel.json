{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/booking.js": { "maxDuration": 20 }
  },
  "redirects": [
    {
      "source": "/prima-visita-odontoiatrica/",
      "destination": "/visita-parodontologia/",
      "permanent": true
    },
    {
      "source": "/parodontologia-cure-gengivali/",
      "destination": "/visita-parodontologia/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/optimized/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/video-thumbnails/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
